#pragma code_page(65001)

#include "windef.h"
#include "winbase.h"
#include "winuser.h"
#include "winnls.h"
#include "commctrl.h"
#include "resource.h"

/* @makedep: taskmgr.ico */
IDI_TASKMGR ICON taskmgr.ico

/* @makedep: taskmgr.manifest */
1 24 taskmgr.manifest

IDR_ACCEL ACCELERATORS
BEGIN
    VK_F5, IDM_REFRESH, VIRTKEY
    VK_DELETE, IDM_END_TASK, VIRTKEY
END

LANGUAGE LANG_UKRAINIAN, SUBLANG_DEFAULT

IDR_MENU MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Запустити нове завдання", IDM_RUN
        MENUITEM SEPARATOR
        MENUITEM "&Вихід", IDM_EXIT
    END
    POPUP "&Параметри"
    BEGIN
        MENUITEM "&Завжди зверху", IDM_ALWAYS_ON_TOP
        MENUITEM "З&гортати під час використання", IDM_MINIMIZE_ON_USE
        MENUITEM "&Приховувати згорнутим", IDM_HIDE_WHEN_MIN
    END
    POPUP "&Вигляд"
    BEGIN
        MENUITEM "&Оновити зараз\tF5", IDM_REFRESH
        POPUP "&Швидкість оновлення"
        BEGIN
            MENUITEM "&Висока", IDM_SPEED_HIGH
            MENUITEM "&Звичайна", IDM_SPEED_NORMAL
            MENUITEM "&Низька", IDM_SPEED_LOW
            MENUITEM "&Призупинено", IDM_SPEED_PAUSED
        END
        MENUITEM SEPARATOR
        MENUITEM "&Групувати за типом", IDM_GROUP_BY_TYPE
        MENUITEM "&Розгорнути все", IDM_EXPAND_ALL
        MENUITEM "З&горнути все", IDM_COLLAPSE_ALL
    END
END

IDR_POPUP MENU
BEGIN
    POPUP "processes"
    BEGIN
        MENUITEM "Розгорнути", IDM_EXPAND_ALL
        MENUITEM "&Перейти", IDM_SWITCH_TO
        MENUITEM "Зн&яти завдання", IDM_END_TASK
        MENUITEM SEPARATOR
        MENUITEM "Відкрити &розташування файлу", IDM_OPEN_LOCATION
        MENUITEM "&Пошук в Інтернеті", IDM_SEARCH_ONLINE
        MENUITEM "&Властивості", IDM_PROPERTIES
        MENUITEM "Перейти до &подробиць", IDM_GO_TO_DETAILS
    END
    POPUP "details"
    BEGIN
        MENUITEM "Зн&яти завдання", IDM_END_TASK
        MENUITEM "Завершити &дерево процесів", IDM_END_TREE
        MENUITEM SEPARATOR
        POPUP "&Задати пріоритет"
        BEGIN
            MENUITEM "&Реального часу", IDM_PRIO_REALTIME
            MENUITEM "&Високий", IDM_PRIO_HIGH
            MENUITEM "В&ище звичайного", IDM_PRIO_ABOVE
            MENUITEM "&Звичайний", IDM_PRIO_NORMAL
            MENUITEM "&Нижче звичайного", IDM_PRIO_BELOW
            MENUITEM "Н&изький", IDM_PRIO_IDLE
        END
        MENUITEM SEPARATOR
        MENUITEM "Відкрити &розташування файлу", IDM_OPEN_LOCATION
        MENUITEM "&Пошук в Інтернеті", IDM_SEARCH_ONLINE
        MENUITEM "&Властивості", IDM_PROPERTIES
    END
    POPUP "services"
    BEGIN
        MENUITEM "&Запустити", IDM_SERVICE_START
        MENUITEM "З&упинити", IDM_SERVICE_STOP
        MENUITEM "П&ерезапустити", IDM_SERVICE_RESTART
        MENUITEM SEPARATOR
        MENUITEM "Відкрити &служби", IDM_OPEN_SERVICES
        MENUITEM "&Пошук в Інтернеті", IDM_SEARCH_ONLINE
        MENUITEM "Перейти до &подробиць", IDM_GO_TO_DETAILS
    END
    POPUP "startup"
    BEGIN
        MENUITEM "Вимкнути", IDM_STARTUP_TOGGLE
        MENUITEM "Відкрити &розташування файлу", IDM_OPEN_LOCATION
        MENUITEM "&Пошук в Інтернеті", IDM_SEARCH_ONLINE
        MENUITEM "&Властивості", IDM_PROPERTIES
    END
    POPUP "performance"
    BEGIN
        POPUP "&Змінити графік на"
        BEGIN
            MENUITEM "&Загальне використання", IDM_CPU_OVERALL
            MENUITEM "&Логічні процесори", IDM_CPU_LOGICAL
        END
        MENUITEM SEPARATOR
        MENUITEM "&Копіювати\tCtrl+C", IDM_COPY
    END
END

IDD_RUN DIALOGEX 0, 0, 280, 104
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Створити нове завдання"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    LTEXT "Введіть ім'я програми, папки, документа або ресурсу Інтернету, і Windows відкриє його.", -1, 40, 10, 230, 20
    LTEXT "&Відкрити:", -1, 8, 39, 30, 10
    EDITTEXT IDC_RUN_EDIT, 40, 37, 232, 13, ES_AUTOHSCROLL
    AUTOCHECKBOX "Створити це завдання з правами &адміністратора.", IDC_RUN_ADMIN, 40, 56, 230, 10
    DEFPUSHBUTTON "OK", IDOK, 112, 82, 50, 14
    PUSHBUTTON "Скасувати", IDCANCEL, 166, 82, 50, 14
    PUSHBUTTON "&Огляд...", IDC_RUN_BROWSE, 220, 82, 52, 14
    ICON IDI_TASKMGR, -1, 8, 8, 20, 20
END

