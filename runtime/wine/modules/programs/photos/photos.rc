#pragma code_page(65001)

#include "windef.h"
#include "winbase.h"
#include "winuser.h"
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* tools/paint-app-icons: the Win11 icon theme's (GPL-3.0) */
/* @makedep: photos.ico */
IDI_PHOTOS ICON photos.ico

/* tools/paint-icons.py */
/* @makedep: icons.bin */
IDR_ICONS RCDATA icons.bin

/* @makedep: photos.manifest */
1 RT_MANIFEST photos.manifest
