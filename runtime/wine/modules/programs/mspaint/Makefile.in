MODULE    = mspaint.exe
IMPORTS   = windowscodecs uuid ole32 oleaut32 shell32 shlwapi comctl32 comdlg32 dwmapi user32 gdi32 advapi32
EXTRADLLFLAGS = -mwindows -municode

VER_FILEDESCRIPTION_STR = "Paint"

SOURCES = \
	canvas.c \
	dialogs.c \
	draw.c \
	image.c \
	main.c \
	mspaint.rc \
	paintops.c \
	ribbon.c
