#pragma code_page(65001)

#include "windef.h"
#include "winbase.h"
#include "winuser.h"
#include "commctrl.h"
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* tools/paint-app-icons: the Win11 icon theme's (GPL-3.0) */
/* @makedep: mspaint.ico */
IDI_PAINT ICON mspaint.ico

/* tools/paint-icons.py */
/* @makedep: icons.bin */
IDR_ICONS RCDATA icons.bin

/* @makedep: mspaint.manifest */
1 RT_MANIFEST mspaint.manifest

IDA_ACCEL ACCELERATORS
{
    "N", IDM_NEW, VIRTKEY, CONTROL
    "O", IDM_OPEN, VIRTKEY, CONTROL
    "S", IDM_SAVE, VIRTKEY, CONTROL
    "S", IDM_SAVEAS, VIRTKEY, CONTROL, SHIFT
    VK_F12, IDM_SAVEAS, VIRTKEY
    "P", IDM_PRINT, VIRTKEY, CONTROL
    "E", IDM_PROPERTIES, VIRTKEY, CONTROL
    "Z", IDM_UNDO, VIRTKEY, CONTROL
    "Y", IDM_REDO, VIRTKEY, CONTROL
    "X", IDM_CUT, VIRTKEY, CONTROL
    "C", IDM_COPY, VIRTKEY, CONTROL
    "V", IDM_PASTE, VIRTKEY, CONTROL
    "A", IDM_SELECT_ALL, VIRTKEY, CONTROL
    "W", IDM_RESIZE, VIRTKEY, CONTROL
    "X", IDM_CROP, VIRTKEY, CONTROL, SHIFT
    "R", IDM_ROTATE_RIGHT, VIRTKEY, CONTROL
    "G", IDM_GRID, VIRTKEY, CONTROL
    "1", IDM_ZOOM_100, VIRTKEY, CONTROL
    "0", IDM_ZOOM_FIT, VIRTKEY, CONTROL, SHIFT
    VK_ADD, IDM_ZOOM_IN, VIRTKEY, CONTROL
    VK_SUBTRACT, IDM_ZOOM_OUT, VIRTKEY, CONTROL
    VK_OEM_PLUS, IDM_ZOOM_IN, VIRTKEY, CONTROL
    VK_OEM_MINUS, IDM_ZOOM_OUT, VIRTKEY, CONTROL
    VK_PRIOR, IDM_ZOOM_IN, VIRTKEY, CONTROL
    VK_NEXT, IDM_ZOOM_OUT, VIRTKEY, CONTROL
    VK_F11, IDM_FULLSCREEN, VIRTKEY
}

IDD_RESIZE DIALOGEX 0, 0, 220, 190
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Resize and skew"
FONT 9, "MS Shell Dlg", 400, 0, 1
{
    GROUPBOX        "Resize", 100, 7, 7, 206, 92
    AUTORADIOBUTTON "Percentage", IDC_BY_PERCENT, 16, 20, 80, 10, WS_GROUP
    AUTORADIOBUTTON "Pixels", IDC_BY_PIXELS, 110, 20, 80, 10
    LTEXT           "Horizontal:", 101, 16, 40, 90, 8
    EDITTEXT        IDC_HORZ, 120, 38, 80, 13, ES_NUMBER | WS_GROUP
    LTEXT           "Vertical:", 102, 16, 58, 90, 8
    EDITTEXT        IDC_VERT, 120, 56, 80, 13, ES_NUMBER
    AUTOCHECKBOX    "Maintain aspect ratio", IDC_KEEP_RATIO, 16, 78, 180, 10
    GROUPBOX        "Skew (degrees)", 103, 7, 104, 206, 56
    LTEXT           "Horizontal:", 104, 16, 120, 90, 8
    EDITTEXT        IDC_SKEW_H, 120, 118, 80, 13
    LTEXT           "Vertical:", 105, 16, 140, 90, 8
    EDITTEXT        IDC_SKEW_V, 120, 138, 80, 13
    DEFPUSHBUTTON   "OK", IDOK, 106, 168, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 168, 50, 15
}

IDD_PROPERTIES DIALOGEX 0, 0, 200, 80
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Image properties"
FONT 9, "MS Shell Dlg", 400, 0, 1
{
    LTEXT           "Width (pixels):", 100, 10, 12, 90, 8
    EDITTEXT        IDC_WIDTH, 110, 10, 80, 13, ES_NUMBER
    LTEXT           "Height (pixels):", 101, 10, 32, 90, 8
    EDITTEXT        IDC_HEIGHT, 110, 30, 80, 13, ES_NUMBER
    DEFPUSHBUTTON   "OK", IDOK, 86, 58, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 140, 58, 50, 15
}
