/*
 * consent.exe: resources
 *
 * The window of User Account Control, asking for the Linux subsystem
 * (docs/linux-gate.md). It is an ordinary dialog: the frame, the caption and
 * the controls are the system's own, in the visual style of the system - as
 * the window of Windows 7 is. The texts are Windows' where it has them.
 *
 * This library is free software; you can redistribute it and/or
 * modify it under the terms of the GNU Lesser General Public
 * License as published by the Free Software Foundation; either
 * version 2.1 of the License, or (at your option) any later version.
 */

#pragma code_page(65001)

#include "windef.h"
#include "winbase.h"
#include "winuser.h"
#include "winnls.h"
#include "resource.h"

/* the visual style of the system, as every window of Windows has it: without
 * the manifest the buttons and the box are the classic grey ones */
/* @makedep: consent.manifest */
1 24 consent.manifest

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

STRINGTABLE
{
    IDS_TITLE            "User Account Control"
    IDS_HEADING          "Administrator rights are needed to confirm this action."
    IDS_PROGRAM          "Program:"
    IDS_PROGRAM_WSL      "Windows Subsystem for Linux"
    IDS_PROGRAM_SETTINGS "User Account Control settings"
    IDS_PUBLISHER        "Verified publisher:"
    IDS_PUBLISHER_NAME   "Project Arctic"
    IDS_PUBLISHER_UNKNOWN "Unknown"
    IDS_REQUESTER        "Requested by:"
    IDS_LOCATION         "Program location:"
    IDS_COMMAND          "Command:"
    IDS_SHOW_DETAILS     "Show &details"
    IDS_HIDE_DETAILS     "Hide &details"
    IDS_PASSWORD_PROMPT  "Type the password of the Linux subsystem, and then click Yes."
    IDS_PASSWORD_CUE     "Password"
    IDS_WRONG            "The password is incorrect."
    IDS_WAIT             "Too many incorrect passwords. Try again in %d s."
    IDS_YES              "&Yes"
    IDS_NO               "&No"
    IDS_PROGRAM_HAMAM    "HAMAM"
    IDS_HEADING_HOST     "Do you want to allow ""%s"" direct root access to the system kernel?"
    IDS_HEADING_SETTINGS "Do you want to change the settings of direct access to the kernel?"
    IDS_ACCESS           "Access:"
    IDS_ACCESS_HOST      "root on the host kernel, outside the WSL containers: disks, drivers, firmware, every process"
    IDS_ACCESS_SETTINGS  "the HAMAM password and whether it is asked for"
    IDS_ACCESS_ADMIN     "the administrator's rights in Windows"
    IDS_VIA              "%s, through %s"
    IDS_PASSWORD_PROMPT_HOST "Type the HAMAM password, and then click Yes."
}

IDD_CONSENT DIALOGEX 0, 0, 290, 226
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "User Account Control"
FONT 8, "MS Shell Dlg"
{
    ICON "", IDC_SHIELD, 10, 12, 21, 20, SS_ICON | SS_REALSIZEIMAGE
    LTEXT "", IDC_HEADING, 40, 10, 242, 20
    LTEXT "", IDC_PROGRAM_LABEL, 40, 38, 88, 9
    LTEXT "", IDC_PROGRAM, 132, 38, 150, 9, SS_ENDELLIPSIS
    LTEXT "", IDC_PUBLISHER_LABEL, 40, 50, 88, 9
    LTEXT "", IDC_PUBLISHER, 132, 50, 150, 9
    LTEXT "", IDC_ACCESS_LABEL, 40, 62, 88, 9
    LTEXT "", IDC_ACCESS, 132, 62, 150, 18
    LTEXT "", IDC_REQUESTER_LABEL, 40, 82, 88, 9
    LTEXT "", IDC_REQUESTER, 132, 82, 150, 18
    LTEXT "", IDC_COMMAND_LABEL, 40, 102, 88, 9
    LTEXT "", IDC_COMMAND, 132, 102, 150, 18
    LTEXT "", IDC_LOCATION_LABEL, 40, 122, 88, 9
    LTEXT "", IDC_LOCATION, 132, 122, 150, 9, SS_PATHELLIPSIS
    PUSHBUTTON "", IDC_DETAILS, 40, 136, 90, 14
    LTEXT "", IDC_PASSWORD_PROMPT, 40, 156, 242, 9
    EDITTEXT IDC_PASSWORD, 40, 168, 130, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_MESSAGE, 40, 186, 242, 9
    DEFPUSHBUTTON "", IDC_ANSWER_YES, 174, 202, 52, 14
    PUSHBUTTON "", IDC_ANSWER_NO, 230, 202, 52, 14
}

LANGUAGE LANG_UKRAINIAN, SUBLANG_DEFAULT

STRINGTABLE
{
    IDS_TITLE            "Контроль облікових записів користувачів"
    IDS_HEADING          "Для підтвердження цієї дії потрібні права адміністратора."
    IDS_PROGRAM          "Програма:"
    IDS_PROGRAM_WSL      "Підсистема Windows для Linux"
    IDS_PROGRAM_SETTINGS "Параметри контролю облікових записів користувачів"
    IDS_PUBLISHER        "Перевірений видавець:"
    IDS_PUBLISHER_NAME   "Project Arctic"
    IDS_PUBLISHER_UNKNOWN "Невідомо"
    IDS_REQUESTER        "Запит від:"
    IDS_LOCATION         "Розташування програми:"
    IDS_COMMAND          "Команда:"
    IDS_SHOW_DETAILS     "Показати &подробиці"
    IDS_HIDE_DETAILS     "Приховати &подробиці"
    IDS_PASSWORD_PROMPT  "Введіть пароль підсистеми Linux і натисніть «Так»."
    IDS_PASSWORD_CUE     "Пароль"
    IDS_WRONG            "Неправильний пароль."
    IDS_WAIT             "Забагато неправильних паролів. Спробуйте за %d с."
    IDS_YES              "&Так"
    IDS_NO               "&Ні"
    IDS_PROGRAM_HAMAM    "HAMAM"
    IDS_HEADING_HOST     "Дозволити «%s» прямий доступ root до ядра системи?"
    IDS_HEADING_SETTINGS "Змінити параметри прямого доступу до ядра?"
    IDS_ACCESS           "Доступ:"
    IDS_ACCESS_HOST      "root на ядрі хоста, поза контейнерами WSL: диски, драйвери, прошивка, усі процеси"
    IDS_ACCESS_SETTINGS  "пароль HAMAM і те, чи його питати"
    IDS_ACCESS_ADMIN     "права адміністратора Windows"
    IDS_VIA              "%s, через %s"
    IDS_PASSWORD_PROMPT_HOST "Введіть пароль HAMAM і натисніть «Так»."
}

IDD_CONSENT DIALOGEX 0, 0, 310, 226
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Контроль облікових записів користувачів"
FONT 8, "MS Shell Dlg"
{
    ICON "", IDC_SHIELD, 10, 12, 21, 20, SS_ICON | SS_REALSIZEIMAGE
    LTEXT "", IDC_HEADING, 40, 10, 262, 20
    LTEXT "", IDC_PROGRAM_LABEL, 40, 38, 96, 9
    LTEXT "", IDC_PROGRAM, 140, 38, 162, 9, SS_ENDELLIPSIS
    LTEXT "", IDC_PUBLISHER_LABEL, 40, 50, 96, 9
    LTEXT "", IDC_PUBLISHER, 140, 50, 162, 9
    LTEXT "", IDC_ACCESS_LABEL, 40, 62, 96, 9
    LTEXT "", IDC_ACCESS, 140, 62, 162, 18
    LTEXT "", IDC_REQUESTER_LABEL, 40, 82, 96, 9
    LTEXT "", IDC_REQUESTER, 140, 82, 162, 18
    LTEXT "", IDC_COMMAND_LABEL, 40, 102, 96, 9
    LTEXT "", IDC_COMMAND, 140, 102, 162, 18
    LTEXT "", IDC_LOCATION_LABEL, 40, 122, 96, 9
    LTEXT "", IDC_LOCATION, 140, 122, 162, 9, SS_PATHELLIPSIS
    PUSHBUTTON "", IDC_DETAILS, 40, 136, 100, 14
    LTEXT "", IDC_PASSWORD_PROMPT, 40, 156, 262, 9
    EDITTEXT IDC_PASSWORD, 40, 168, 140, 14, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_MESSAGE, 40, 186, 262, 9
    DEFPUSHBUTTON "", IDC_ANSWER_YES, 190, 202, 54, 14
    PUSHBUTTON "", IDC_ANSWER_NO, 248, 202, 54, 14
}
