IDD_PARAGRAPH DIALOGEX 0, 0, 300, 196
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Абзац"
FONT 9, "MS Shell Dlg"
{
    LTEXT "Вирівнювання:", -1, 10, 12, 66, 10
    COMBOBOX IDC_PARA_ALIGN, 80, 10, 90, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    GROUPBOX "Відступ (см)", -1, 6, 30, 288, 52
    LTEXT "Ліворуч:", -1, 14, 44, 44, 10
    EDITTEXT IDC_PARA_LEFT, 60, 42, 50, 13
    LTEXT "Праворуч:", -1, 14, 62, 44, 10
    EDITTEXT IDC_PARA_RIGHT, 60, 60, 50, 13
    LTEXT "Перший рядок:", -1, 130, 44, 80, 10
    COMBOBOX IDC_PARA_SPECIAL, 130, 56, 80, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "На (см):", -1, 220, 44, 60, 10
    EDITTEXT IDC_PARA_BY, 220, 56, 50, 13
    GROUPBOX "Інтервал", -1, 6, 88, 288, 52
    LTEXT "Перед (пт):", -1, 14, 102, 44, 10
    EDITTEXT IDC_PARA_BEFORE, 60, 100, 50, 13
    LTEXT "Після (пт):", -1, 14, 120, 44, 10
    EDITTEXT IDC_PARA_AFTER, 60, 118, 50, 13
    LTEXT "Міжрядковий:", -1, 130, 102, 80, 10
    COMBOBOX IDC_PARA_LINE, 130, 114, 80, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Значення:", -1, 220, 102, 60, 10
    EDITTEXT IDC_PARA_AT, 220, 114, 50, 13
    AUTOCHECKBOX "З нової сторінки", IDC_PARA_PAGEBREAK, 10, 148, 140, 12
    AUTOCHECKBOX "Не відривати від наступного", IDC_PARA_KEEPNEXT, 150, 148, 140, 12
    DEFPUSHBUTTON "OK", IDOK, 184, 174, 52, 15
    PUSHBUTTON "Скасувати", IDCANCEL, 242, 174, 52, 15
}

IDD_LINK DIALOGEX 0, 0, 280, 80
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Вставлення посилання"
FONT 9, "MS Shell Dlg"
{
    LTEXT "Текст:", -1, 8, 10, 70, 10
    EDITTEXT IDC_LINK_TEXT, 80, 8, 192, 13, ES_AUTOHSCROLL
    LTEXT "Адреса:", -1, 8, 30, 70, 10
    EDITTEXT IDC_LINK_URL, 80, 28, 192, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 164, 58, 52, 15
    PUSHBUTTON "Скасувати", IDCANCEL, 220, 58, 52, 15
}

IDD_DATETIME DIALOGEX 0, 0, 200, 150
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Дата й час"
FONT 9, "MS Shell Dlg"
{
    LTEXT "Доступні формати:", -1, 8, 6, 180, 10
    LISTBOX IDC_DATETIME_LIST, 8, 18, 184, 102, LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 84, 128, 52, 15
    PUSHBUTTON "Скасувати", IDCANCEL, 140, 128, 52, 15
}

IDD_ZOOM DIALOGEX 0, 0, 200, 120
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Масштаб"
FONT 9, "MS Shell Dlg"
{
    AUTORADIOBUTTON "200%", IDC_ZOOM_200, 10, 10, 80, 12, WS_GROUP
    AUTORADIOBUTTON "100%", IDC_ZOOM_100, 10, 26, 80, 12
    AUTORADIOBUTTON "75%", IDC_ZOOM_75, 10, 42, 80, 12
    AUTORADIOBUTTON "Ширина сторінки", IDC_ZOOM_WIDTH, 100, 10, 90, 12
    AUTORADIOBUTTON "Сторінка цілком", IDC_ZOOM_WHOLE, 100, 26, 90, 12
    LTEXT "Відсотки:", -1, 10, 66, 40, 10
    EDITTEXT IDC_ZOOM_PERCENT, 52, 64, 40, 13, ES_NUMBER
    CONTROL "", IDC_ZOOM_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS, 92, 64, 10, 13
    DEFPUSHBUTTON "OK", IDOK, 84, 98, 52, 15
    PUSHBUTTON "Скасувати", IDCANCEL, 140, 98, 52, 15
}
