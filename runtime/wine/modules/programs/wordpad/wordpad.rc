#include "windef.h"
#include "winbase.h"
#include "winuser.h"
#include "winnls.h"
#include "commctrl.h"
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* @makedep: wordpad.ico */
IDI_WORDPAD ICON wordpad.ico
/* @makedep: document.ico */
IDI_DOCUMENT ICON document.ico
/* @makedep: rtf.ico */
IDI_RTF ICON rtf.ico

/* tools/wordpad-icons.py */
/* @makedep: icons.bin */
IDR_ICONS RCDATA icons.bin

/* @makedep: wordpad.manifest */
1 RT_MANIFEST wordpad.manifest

IDA_ACCEL ACCELERATORS
{
    "N", IDM_NEW, VIRTKEY, CONTROL
    "O", IDM_OPEN, VIRTKEY, CONTROL
    "S", IDM_SAVE, VIRTKEY, CONTROL
    VK_F12, IDM_SAVEAS, VIRTKEY
    "P", IDM_PRINT, VIRTKEY, CONTROL
    "W", IDM_CLOSE, VIRTKEY, CONTROL
    "Z", IDM_UNDO, VIRTKEY, CONTROL
    "Y", IDM_REDO, VIRTKEY, CONTROL
    "F", IDM_FIND, VIRTKEY, CONTROL
    "H", IDM_REPLACE, VIRTKEY, CONTROL
    VK_F3, IDM_FINDNEXT, VIRTKEY
    "B", IDM_BOLD, VIRTKEY, CONTROL
    "I", IDM_ITALIC, VIRTKEY, CONTROL
    "U", IDM_UNDERLINE, VIRTKEY, CONTROL
    "D", IDM_FONTDIALOG, VIRTKEY, CONTROL
    "E", IDM_ALIGN_CENTER, VIRTKEY, CONTROL
    "L", IDM_ALIGN_LEFT, VIRTKEY, CONTROL
    "R", IDM_ALIGN_RIGHT, VIRTKEY, CONTROL
    "J", IDM_ALIGN_JUSTIFY, VIRTKEY, CONTROL
    "M", IDM_INDENT, VIRTKEY, CONTROL
    "M", IDM_OUTDENT, VIRTKEY, CONTROL, SHIFT
    "L", IDM_BULLETS, VIRTKEY, CONTROL, SHIFT
    "K", IDM_LINK, VIRTKEY, CONTROL
    VK_OEM_PERIOD, IDM_GROW, VIRTKEY, CONTROL, SHIFT
    VK_OEM_COMMA, IDM_SHRINK, VIRTKEY, CONTROL, SHIFT
    VK_OEM_6, IDM_GROW, VIRTKEY, CONTROL
    VK_OEM_4, IDM_SHRINK, VIRTKEY, CONTROL
    VK_OEM_PLUS, IDM_SUBSCRIPT, VIRTKEY, CONTROL
    VK_OEM_PLUS, IDM_SUPERSCRIPT, VIRTKEY, CONTROL, SHIFT
    VK_SPACE, IDM_CLEARFORMAT, VIRTKEY, CONTROL
    VK_RETURN, IDM_PAGEBREAK, VIRTKEY, CONTROL
    VK_F3, IDM_CASE_TOGGLE, VIRTKEY, SHIFT
    "1", IDM_LS_100, VIRTKEY, CONTROL
    "2", IDM_LS_200, VIRTKEY, CONTROL
    "5", IDM_LS_150, VIRTKEY, CONTROL
    "1", IDM_STYLE_FIRST + 2, VIRTKEY, CONTROL, ALT
    "2", IDM_STYLE_FIRST + 3, VIRTKEY, CONTROL, ALT
    "3", IDM_STYLE_FIRST + 4, VIRTKEY, CONTROL, ALT
    "N", IDM_STYLE_FIRST, VIRTKEY, CONTROL, SHIFT
    VK_ADD, IDM_ZOOM_IN, VIRTKEY, CONTROL
    VK_SUBTRACT, IDM_ZOOM_OUT, VIRTKEY, CONTROL
}

