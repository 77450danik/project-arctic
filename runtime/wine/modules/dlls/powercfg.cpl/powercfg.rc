#pragma code_page(65001)

#include "windef.h"
#include "winbase.h"
#include "winuser.h"
#include "winnls.h"

/* @makedep: power.ico */
1 ICON power.ico

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

STRINGTABLE
{
    1 "Power Options"
    2 "Conserve energy or maximize performance by choosing how your computer manages power."
}

LANGUAGE LANG_UKRAINIAN, SUBLANG_DEFAULT

STRINGTABLE
{
    1 "Електроживлення"
    2 "Настроювання параметрів енергозбереження комп’ютера."
}
