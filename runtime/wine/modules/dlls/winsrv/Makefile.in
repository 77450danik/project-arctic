MODULE    = winsrv.dll
UNIXLIB   = winsrv.so
IMPORTS   = uuid ole32 rpcrt4 user32 gdi32 shcore advapi32 win32u
UNIX_CFLAGS = $(LIBINPUT_CFLAGS) $(UDEV_CFLAGS)
UNIX_LIBS   = $(LIBINPUT_LIBS) $(UDEV_LIBS)

VER_FILEDESCRIPTION_STR = "Arctic window server"

SOURCES = \
	capture.c \
	desktop.c \
	hung.c \
	libinput.c \
	rit.c \
	winsrv.rc
