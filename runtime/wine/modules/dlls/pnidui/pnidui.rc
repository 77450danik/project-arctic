#pragma code_page(65001)

#include "windef.h"
#include "winbase.h"
#include "winuser.h"
#include "winnls.h"
#include "commctrl.h"
#include "pnidui.h"

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

STRINGTABLE
{
    IDS_NOT_CONNECTED         "Not connected"
    IDS_CONNECTIONS_AVAILABLE "Not connected - Connections are available"
    IDS_INTERNET_ACCESS       "Internet access"
    IDS_WIRELESS_GROUP        "Wireless Network Connection"
    IDS_WIRED_GROUP           "Local Area Connection"
    IDS_CONNECTED             "Connected"
    IDS_CONNECTING            "Connecting..."
    IDS_CABLE_UNPLUGGED       "Network cable unplugged"
    IDS_CONNECT               "&Connect"
    IDS_DISCONNECT            "&Disconnect"
    IDS_OPEN_CONNECTIONS      "Open Network Connections"
    IDS_CONNECT_FAILED        "Windows was unable to connect to %s."
    IDS_KEY_MISMATCH          "The network security key is not correct."
    IDS_NETWORK               "Network"
    IDS_NO_NETWORKS           "No connections are available"
}

IDD_NETWORK_KEY DIALOGEX 0, 0, 260, 84
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connect to a Network"
FONT 9, "MS Shell Dlg"
{
    LTEXT "Type the network security key", -1, 10, 8, 240, 10
    LTEXT "&Security key:", -1, 10, 26, 56, 10
    EDITTEXT IDC_KEY, 68, 24, 182, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "&Hide characters", IDC_HIDE_KEY, 68, 42, 182, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 146, 64, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 200, 64, 50, 14
}

LANGUAGE LANG_UKRAINIAN, SUBLANG_DEFAULT

STRINGTABLE
{
    IDS_NOT_CONNECTED         "Немає підключення"
    IDS_CONNECTIONS_AVAILABLE "Немає підключення - Доступні підключення"
    IDS_INTERNET_ACCESS       "Доступ до Інтернету"
    IDS_WIRELESS_GROUP        "Бездротове мережне підключення"
    IDS_WIRED_GROUP           "Підключення за локальною мережею"
    IDS_CONNECTED             "Підключено"
    IDS_CONNECTING            "Підключення..."
    IDS_CABLE_UNPLUGGED       "Мережний кабель не підключено"
    IDS_CONNECT               "&Підключитися"
    IDS_DISCONNECT            "&Відключитися"
    IDS_OPEN_CONNECTIONS      "Відкрити мережні підключення"
    IDS_CONNECT_FAILED        "Windows не вдалося підключитися до %s."
    IDS_KEY_MISMATCH          "Ключ безпеки мережі неправильний."
    IDS_NETWORK               "Мережа"
    IDS_NO_NETWORKS           "Немає доступних підключень"
}

IDD_NETWORK_KEY DIALOGEX 0, 0, 260, 84
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Підключення до мережі"
FONT 9, "MS Shell Dlg"
{
    LTEXT "Введіть ключ безпеки мережі", -1, 10, 8, 240, 10
    LTEXT "&Ключ безпеки:", -1, 10, 26, 56, 10
    EDITTEXT IDC_KEY, 68, 24, 182, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "&Приховати символи", IDC_HIDE_KEY, 68, 42, 182, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 146, 64, 50, 14
    PUSHBUTTON "Скасувати", IDCANCEL, 200, 64, 50, 14
}
