LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* the question after a change: its words come from the string table */
IDD_KEEP DIALOGEX 0, 0, 264, 86
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "MS Shell Dlg", 400, 0, 1
{
    LTEXT           "", IDC_KEEP_TITLE, 12, 10, 240, 16
    LTEXT           "", IDC_KEEP_TEXT, 12, 32, 240, 18
    DEFPUSHBUTTON   "", IDOK, 86, 62, 84, 15
    PUSHBUTTON      "", IDCANCEL, 176, 62, 76, 15
}

