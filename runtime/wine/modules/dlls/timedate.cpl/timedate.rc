#include "windef.h"
#include "winbase.h"
#include "winuser.h"
#include "winnls.h"
#include "timedate.h"

/* tools/cpl-icons.py: Longhorn's date and time */
/* @makedep: timedate.ico */
IDI_TIMEDATE ICON timedate.ico

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

STRINGTABLE
{
    0xf000                  "Control Panel Home"
    0xf001                  "See also"
    IDS_NAME                "Date and Time"
    IDS_TIP                 "Set the date, time and time zone."
    IDS_TITLE               "Date, time and time zone"
    IDS_TIME_GROUP          "Internet time"
    IDS_AUTO_TIME           "Set the time automatically"
    IDS_AUTO_TIME_HINT      "At every start and after sleep the clock is set from a time server."
    IDS_SERVER              "Server:"
    IDS_SYNC_NOW            "Synchronize now"
    IDS_SYNCED              "Synchronized with %1 on %2."
    IDS_NEVER_SYNCED        "Not synchronized yet."
    IDS_SYNCING             "Synchronizing…"
    IDS_SYNC_FAILED         "%1 did not answer."
    IDS_SYNC_OFF            "The time is set by hand."
    IDS_MANUAL_GROUP        "Date and time by hand"
    IDS_CHANGE              "Change"
    IDS_MANUAL_HINT         "Available when the time is not set automatically."
    IDS_ZONE_GROUP          "Time zone"
    IDS_AUTO_ZONE           "Set the time zone automatically"
    IDS_AUTO_ZONE_HINT      "At every start, by the computer's address on the Internet (ip-api.com)."
    IDS_DST_START           "Daylight saving time begins on %1 at %2: the clock goes an hour forward."
    IDS_DST_END             "Daylight saving time ends on %1 at %2: the clock goes an hour back."
    IDS_NO_DST              "This time zone has no daylight saving time."
    IDS_NOTIFICATIONS       "Notifications"
    IDS_SYSTEM              "System"
    IDS_ZONE_FAILED         "The time zone could not be changed."
    IDS_TIME_SET            "The time was changed."
    IDS_TIME_FAILED         "The time could not be changed."
}

