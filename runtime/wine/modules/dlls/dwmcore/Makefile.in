MODULE    = dwmcore.dll
UNIXLIB   = dwmcore.so
IMPORTS   = advapi32 ntdll
UNIX_CFLAGS = $(WAYLAND_SERVER_CFLAGS)
UNIX_LIBS   = $(WAYLAND_SERVER_LIBS) -lEGL -lGLESv2 -lgbm

VER_FILEDESCRIPTION_STR = "Arctic desktop composition engine"

SOURCES = \
	arctic-display-v1-protocol.c \
	arctic-shell-v1-protocol.c \
	compositor.c \
	dmabuf.c \
	dwmcore.c \
	kms.c \
	linux-dmabuf-v1-protocol.c \
	viewporter-protocol.c \
	xdg-output-unstable-v1-protocol.c \
	xdg-shell-protocol.c
