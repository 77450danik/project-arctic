+/******************************************************************************
+ * LsaManageSidNameMapping [ADVAPI32.@]
+ *
+ * Arctic: names of virtual accounts are not mapped to SIDs; OpenSSH imports it
+ * and goes on without the mapping when it fails.
+ */
+NTSTATUS WINAPI LsaManageSidNameMapping( DWORD type, void *input, void **output )
+{
+    FIXME( "type %lu, input %p, output %p: not supported\n", type, input, output );
+    if (output) *output = NULL;
+    return STATUS_NOT_SUPPORTED;
+}
