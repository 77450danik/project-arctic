@@ -5387,3 +5387,46 @@ DWORD WINAPI SetCurrentThreadCompartmentId( NET_IF_COMPARTMENT_ID id )
     FIXME( "(%x): stub\n", id );
     return ERROR_SUCCESS;
 }
+
+/******************************************************************
+ *    InitializeIpInterfaceEntry (IPHLPAPI.@)
+ *
+ * Arctic: as in Windows, every field "unspecified" before SetIpInterfaceEntry.
+ */
+void WINAPI InitializeIpInterfaceEntry( MIB_IPINTERFACE_ROW *row )
+{
+    TRACE( "row %p\n", row );
+    memset( row, 0, sizeof(*row) );
+    row->Family = AF_UNSPEC;
+    row->SitePrefixLength = 0xff;
+    row->Metric = ~0u;
+    row->NlMtu = ~0u;
+    row->BaseReachableTime = ~0u;
+    row->ReachableTime = ~0u;
+    row->RetransmitTime = ~0u;
+    row->PathMtuDiscoveryTimeout = ~0u;
+    row->DadTransmits = ~0u;
+    row->LinkLocalAddressTimeout = ~0u;
+    row->ZoneIndices[0] = ~0u;
+}
+
+/******************************************************************
+ *    GetIpNetEntry2 (IPHLPAPI.@)
+ *
+ * Arctic: one neighbour of the table is not looked up; programs (msquic) take
+ * the address without its link-layer details then.
+ */
+DWORD WINAPI GetIpNetEntry2( MIB_IPNET_ROW2 *row )
+{
+    TRACE( "row %p\n", row );
+    return row ? ERROR_NOT_FOUND : ERROR_INVALID_PARAMETER;
+}
+
+/******************************************************************
+ *    ResolveIpNetEntry2 (IPHLPAPI.@)
+ */
+DWORD WINAPI ResolveIpNetEntry2( MIB_IPNET_ROW2 *row, const SOCKADDR_INET *source )
+{
+    TRACE( "row %p, source %p\n", row, source );
+    return row ? ERROR_NOT_FOUND : ERROR_INVALID_PARAMETER;
+}
