+/******************************************************************************
+ * SaferiSearchMatchingHashRules [ADVAPI32.@]
+ *
+ * Arctic: there are no software restriction hash rules, so none matches.
+ */
+BOOL WINAPI SaferiSearchMatchingHashRules( ALG_ID alg, BYTE *hash, DWORD hash_size, DWORD image_size,
+                                           DWORD *level, DWORD *flags )
+{
+    TRACE( "alg %#x, hash %p, size %lu, image %lu, level %p, flags %p\n", alg, hash, hash_size, image_size, level, flags );
+    SetLastError( ERROR_NOT_FOUND );
+    return FALSE;
+}
