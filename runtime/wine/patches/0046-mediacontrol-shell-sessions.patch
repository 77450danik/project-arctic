+
+/* a press from the shell goes on to the thread of its control */
+static LRESULT CALLBACK notify_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == button_message())
+    {
+        struct media_control *impl;
+        HWND target = NULL;
+
+        EnterCriticalSection( &controls_cs );
+        LIST_FOR_EACH_ENTRY( impl, &controls, struct media_control, entry )
+            if (impl->session == lparam) { target = impl->press_window; break; }
+        LeaveCriticalSection( &controls_cs );
+        if (!target || !PostMessageW( target, msg, wparam, lparam )) press_button( lparam, wparam );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+/* the shell's presses come to a thread of their own, which passes them on */
+static DWORD WINAPI notify_thread( void *arg )
+{
+    WNDCLASSW cls = { .lpfnWndProc = notify_proc, .lpszClassName = L"ArcticMediaNotify" };
+    HANDLE ready = arg;
+    MSG msg;
+
+    cls.hInstance = GetModuleHandleW( NULL );
+    RegisterClassW( &cls );
+    notify_window = CreateWindowExW( 0, cls.lpszClassName, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, cls.hInstance, NULL );
+    SetEvent( ready );
+    while (GetMessageW( &msg, NULL, 0, 0 )) DispatchMessageW( &msg );
+    return 0;
+}
+
+static void start_notify_thread(void)
+{
+    HANDLE ready, thread;
+
+    if (notify_window) return;
+    ready = CreateEventW( NULL, TRUE, FALSE, NULL );
+    if ((thread = CreateThread( NULL, 0, notify_thread, ready, 0, NULL )))
+    {
+        WaitForSingleObject( ready, 5000 );
+        CloseHandle( thread );
+    }
+    CloseHandle( ready );
+}
