+static void destroy_press_window( HWND hwnd )
+{
+    if (!hwnd) return;
+    if (GetWindowThreadProcessId( hwnd, NULL ) == GetCurrentThreadId()) DestroyWindow( hwnd );
+    else PostMessageW( hwnd, WM_CLOSE, 0, 0 );
