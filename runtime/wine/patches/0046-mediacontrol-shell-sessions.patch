+static void withdraw( struct media_control *impl )
+{
+    struct arctic_media_shared *shared = get_shared();
+    HANDLE mutex;
+
+    if (!shared || !impl->session) return;
+    mutex = lock_shared();
+    for (UINT i = 0; i < ARCTIC_MEDIA_SESSIONS; i++)
