+        if (shared->sessions[i].id) continue;
+        row = &shared->sessions[i];
+        memset( row, 0, sizeof(*row) );
+        if (!++shared->next_id) ++shared->next_id;
+        row->id = impl->session = shared->next_id;
+        row->process = GetCurrentProcessId();
+        row->window = HandleToULong( impl->window );
+        with_display = TRUE;
