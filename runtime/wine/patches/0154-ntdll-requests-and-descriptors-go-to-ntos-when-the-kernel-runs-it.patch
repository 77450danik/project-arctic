From: Project Arctic
Subject: [PATCH] ntdll: requests and descriptors go to ntos when the kernel runs it

NT's executive is in the kernel (kernel/drivers/ntos). A request is the
system call nt_call, served in the calling thread; descriptors go through
nt_send_fd and nt_receive_fd; a process and each new thread say what they
are with nt_hello. Without it (ENOSYS, or ENOENT with arctic.ntos=0)
wineserver serves, as before; so it does outside NT's namespaces (EPERM:
a container, the image's build chroot on a running Arctic).
---
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index 59619ec..3de93eb 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -101,6 +101,7 @@ timeout_t server_start_time = 0;  /* time of server startup */
 
 sigset_t server_block_set;  /* signals to block during server calls */
 static int fd_socket = -1;  /* socket to exchange file descriptors with the server */
+static int ntos_active;     /* Arctic: the kernel serves the requests (ntos), not wineserver */
 static int initial_cwd = -1;
 static pid_t server_pid;
 pthread_mutex_t fd_cache_mutex = PTHREAD_MUTEX_INITIALIZER;
@@ -379,6 +380,7 @@ static void fastcall_init_thread( struct thread_data *data, BOOL first )
     fastcall_slot_t *slot;
     unsigned int status;
 
+    if (ntos_active) return;  /* Arctic: a request already is a call into the kernel */
     if (first && (area_fd = fastcall_init_process()) == -1) return;
     if (!fastcall_area) return;
     if ((index = fastcall_alloc_slot()) == -1) return;
@@ -737,6 +739,93 @@ static BOOL win32k_call( struct thread_data *data, struct __server_request_info
 #endif
 
 
+/***********************************************************************
+ * Arctic: ntos, NT's executive in the kernel (kernel/drivers/ntos)
+ *
+ * When the kernel runs it there is no wineserver. A request is the system
+ * call nt_call, served in the calling thread; the descriptors that went to
+ * and came from the server on the process's socket go through nt_send_fd and
+ * nt_receive_fd; a process says what it is with nt_hello instead of reaching
+ * the master socket (or, a child, with its end of the socket pair), and so
+ * does each new thread. The socket, the pipes and the protocol stay as they
+ * are: the executive watches the pipes as wineserver did. ENOSYS (a kernel
+ * without it), ENOENT (arctic.ntos=0) or EPERM (a container or the image's
+ * build chroot, outside NT's namespaces): wineserver serves, as before.
+ */
+
+/* as include/uapi/linux/ntos.h of the kernel (x86_64) */
+#define __NR_nt_hello       0x0f00
+#define __NR_nt_call        0x0f01
+#define __NR_nt_send_fd     0x0f02
+#define __NR_nt_receive_fd  0x0f03
+
+#if defined(__linux__) && defined(__x86_64__)
+
+enum nt_hello_kind
+{
+    NT_HELLO_CONNECT = 1,
+    NT_HELLO_PROCESS,
+    NT_HELLO_THREAD,
+};
+
+struct nt_hello
+{
+    UINT32 protocol;
+    UINT32 kind;
+    INT32  fd;
+    UINT32 thread_id;
+};
+
+struct nt_call
+{
+    UINT64 request;
+    UINT64 data;
+    UINT32 data_count;
+    UINT32 status;
+    UINT64 reply;
+    UINT64 reply_data;
+    UINT32 reply_data_size;
+    UINT32 pad;
+};
+
+/* NT_HELLO_CONNECT: the process's socket; the others: 0; -1 and errno if it failed */
+static int ntos_hello( UINT32 kind, int fd, UINT32 tid )
+{
+    struct nt_hello hello = { .protocol = SERVER_PROTOCOL_VERSION, .kind = kind, .fd = fd, .thread_id = tid };
+
+    if (syscall( __NR_nt_hello, &hello )) return -1;
+    return kind == NT_HELLO_CONNECT ? hello.fd : 0;
+}
+
+static unsigned int ntos_call( struct __server_request_info *req )
+{
+    struct iovec vec[__SERVER_MAX_DATA];
+    struct nt_call call;
+    unsigned int i;
+
+    for (i = 0; i < req->data_count; i++)
+    {
+        vec[i].iov_base = (void *)req->data[i].ptr;
+        vec[i].iov_len  = req->data[i].size;
+    }
+    memset( &call, 0, sizeof(call) );
+    call.request    = (ULONG_PTR)&req->u.req;
+    call.data       = (ULONG_PTR)vec;
+    call.data_count = req->data_count;
+    call.reply      = (ULONG_PTR)&req->u.reply;
+    call.reply_data = (ULONG_PTR)req->reply_data;
+    if (!syscall( __NR_nt_call, &call )) return req->u.reply.reply_header.error;
+    if (errno == EFAULT) return STATUS_ACCESS_VIOLATION;
+    if (errno == ESRCH) abort_thread(0);  /* the thread is gone from the executive, as a closed pipe was */
+    server_protocol_perror( "nt_call" );
+}
+
+#else
+static int ntos_hello( UINT32 kind, int fd, UINT32 tid ) { errno = ENOSYS; return -1; }
+static unsigned int ntos_call( struct __server_request_info *req ) { return STATUS_NOT_IMPLEMENTED; }
+#endif
+
+
 /***********************************************************************
  *           server_call_unlocked
  */
@@ -747,6 +835,7 @@ unsigned int server_call_unlocked( void *req_ptr )
     unsigned int ret;
 
     if (data->win32k && win32k_call( data, req, &ret )) return ret;
+    if (ntos_active) return ntos_call( req );
 #ifdef __linux__
     if (data->fastcall && fastcall( data, req, &ret )) return ret;
 #endif
@@ -1424,6 +1513,13 @@ void CDECL wine_server_send_fd( int fd )
     data.tid = GetCurrentThreadId();
     data.fd  = fd;
 
+    if (ntos_active)
+    {
+        if (!syscall( __NR_nt_send_fd, fd, data.tid )) return;
+        if (errno == ESRCH) abort_thread(0);
+        server_protocol_perror( "nt_send_fd" );
+    }
+
     cmsg = CMSG_FIRSTHDR( &msghdr );
     cmsg->cmsg_len   = CMSG_LEN( sizeof(fd) );
     cmsg->cmsg_level = SOL_SOCKET;
@@ -1465,6 +1561,14 @@ int wine_server_receive_fd( obj_handle_t *handle )
     vec.iov_base = (void *)handle;
     vec.iov_len  = sizeof(*handle);
 
+    if (ntos_active)
+    {
+        /* given before the reply that names it: it is there */
+        if ((fd = syscall( __NR_nt_receive_fd, handle )) >= 0) return fd;
+        if (errno == ESRCH) abort_thread(0);
+        server_protocol_perror( "nt_receive_fd" );
+    }
+
     for (;;)
     {
         if ((ret = recvmsg( fd_socket, &msghdr, MSG_CMSG_CLOEXEC )) > 0)
@@ -2082,6 +2186,9 @@ void server_init_process( struct thread_data *data )
         if (fcntl( fd_socket, F_SETFD, FD_CLOEXEC ) == -1)
             fatal_perror( "Bad server socket %d", fd_socket );
         unsetenv( "WINESERVERSOCKET" );
+        /* Arctic: the process new_process made in ntos, found by its socket */
+        if (ntos_hello( NT_HELLO_PROCESS, fd_socket, 0 ) != -1) ntos_active = 1;
+        else if (errno != ENOSYS && errno != ENOENT && errno != EPERM) fatal_perror( "nt_hello" );
     }
     else
     {
@@ -2092,7 +2199,16 @@ void server_init_process( struct thread_data *data )
         if (arch && strcmp( arch, "win32" ) && strcmp( arch, "win64" ) && strcmp( arch, "wow64" ))
             fatal_error( "WINEARCH set to invalid value '%s', it must be win32, win64, or wow64.\n", arch );
 
-        fd_socket = server_connect();
+        /* Arctic: a process of ntos, made as wineserver's master socket made one */
+        if ((fd_socket = ntos_hello( NT_HELLO_CONNECT, -1, 0 )) != -1)
+        {
+            ntos_active = 1;
+            initial_cwd = setup_config_dir();
+            fchdir( initial_cwd );  /* back to the starting directory, as server_connect */
+            fcntl( fd_socket, F_SETFD, FD_CLOEXEC );
+        }
+        else if (errno != ENOSYS && errno != ENOENT && errno != EPERM) fatal_perror( "nt_hello" );
+        else fd_socket = server_connect();
     }
 
     /* setup the signal mask */
@@ -2249,6 +2365,9 @@ void server_init_thread( struct thread_data *data )
     data->pthread_id = pthread_self();
     pthread_setspecific( thread_data_key, data );
 
+    /* Arctic: the thread new_thread made, in ntos */
+    if (ntos_active && ntos_hello( NT_HELLO_THREAD, -1, data->tid ) == -1)
+        server_protocol_perror( "nt_hello" );
     reply_pipe = init_thread_pipe( data );
     SERVER_START_REQ( init_thread )
     {
