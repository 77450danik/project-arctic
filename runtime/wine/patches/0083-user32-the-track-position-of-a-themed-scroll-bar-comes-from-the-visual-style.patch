From 40bdd56ec55f7609760e0f663345c800b97a024b Mon Sep 17 00:00:00 2001
From: 77450danik <dnsystems@email.ua>
Date: Sun, 11 Oct 2026 01:40:32 +0200
Subject: [PATCH] user32: The track position of a themed scroll bar comes from
 the visual style.

A visual style tracks the thumb of a frame's scroll bar itself
(uxtheme's NC_TrackScrollBar), and only it knows where the thumb is
dragged to. GetScrollInfo now goes through its hook, as in Windows: a
program that scrolls to nTrackPos on SB_THUMBTRACK got the old position
from win32u, stayed where it was, and the thumb jumped back.
---
 dlls/user32/hook.c         |  2 +-
 dlls/user32/scroll.c       | 15 ++++++++++++++-
 dlls/user32/user_private.h |  1 +
 3 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/dlls/user32/hook.c b/dlls/user32/hook.c
index 9f5a8db..b91b960 100644
--- a/dlls/user32/hook.c
+++ b/dlls/user32/hook.c
@@ -576,7 +576,7 @@ static BOOL init_theme_api_hook( const WCHAR *dll_name, const WCHAR *func_name )
     theme_api.size = sizeof(theme_api);
     theme_api.DefWindowProcA = USER_DefWindowProcA;
     theme_api.DefWindowProcW = USER_DefWindowProcW;
-    theme_api.GetScrollInfo = GetScrollInfo;
+    theme_api.GetScrollInfo = USER_GetScrollInfo;
     theme_api.SetScrollInfo = NtUserSetScrollInfo;
     theme_api.EnableScrollBar = NtUserEnableScrollBar;
     theme_api.AdjustWindowRectEx = AdjustWindowRectEx;
diff --git a/dlls/user32/scroll.c b/dlls/user32/scroll.c
index b0e46a5..49ff7fd 100644
--- a/dlls/user32/scroll.c
+++ b/dlls/user32/scroll.c
@@ -311,7 +311,7 @@ LRESULT ScrollBarWndProc_common( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lPar
  *  ( if nBar is SB_CTL, GetScrollInfo returns TRUE even if nothing
  *  is filled)
  */
-BOOL WINAPI DECLSPEC_HOTPATCH GetScrollInfo(HWND hwnd, INT nBar, LPSCROLLINFO info)
+BOOL WINAPI USER_GetScrollInfo( HWND hwnd, INT nBar, LPSCROLLINFO info )
 {
     TRACE("hwnd=%p nBar=%d info=%p\n", hwnd, nBar, info);
 
@@ -324,6 +324,19 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetScrollInfo(HWND hwnd, INT nBar, LPSCROLLINFO in
     return NtUserGetScrollInfo( hwnd, nBar, info );
 }
 
+BOOL WINAPI DECLSPEC_HOTPATCH GetScrollInfo(HWND hwnd, INT nBar, LPSCROLLINFO info)
+{
+    /* Arctic: a visual style tracks the thumb of a frame's scroll bar itself,
+       and only it knows where the thumb is dragged to: SIF_TRACKPOS goes
+       through it, as in Windows. Without it a program that scrolls to
+       nTrackPos on SB_THUMBTRACK stayed where it was, the thumb jumping back */
+    USERAPIHOOK *hook = nBar != SB_CTL ? get_theme_api_hook() : NULL;
+
+    if (hook && hook->GetScrollInfo && hook->GetScrollInfo != USER_GetScrollInfo)
+        return hook->GetScrollInfo( hwnd, nBar, info );
+    return USER_GetScrollInfo( hwnd, nBar, info );
+}
+
 
 /*************************************************************************
  *           SetScrollPos   (USER32.@)
diff --git a/dlls/user32/user_private.h b/dlls/user32/user_private.h
index 4f6c266..50a8a51 100644
--- a/dlls/user32/user_private.h
+++ b/dlls/user32/user_private.h
@@ -168,6 +168,7 @@ extern struct user_api_hook *user_api;
 extern LRESULT WINAPI USER_DefWindowProcA(HWND,UINT,WPARAM,LPARAM);
 extern LRESULT WINAPI USER_DefWindowProcW(HWND,UINT,WPARAM,LPARAM);
 extern BOOL in_classic_frame_painting(void);
+extern BOOL WINAPI USER_GetScrollInfo( HWND hwnd, INT bar, LPSCROLLINFO info );
 LRESULT WINAPI USER_DefDlgProc(HWND, UINT, WPARAM, LPARAM, BOOL);
 LRESULT WINAPI USER_ScrollBarProc(HWND, UINT, WPARAM, LPARAM, BOOL);
 void WINAPI USER_NonClientButtonDraw(HWND, HDC, enum NONCLIENT_BUTTON_TYPE, RECT, BOOL, BOOL);
