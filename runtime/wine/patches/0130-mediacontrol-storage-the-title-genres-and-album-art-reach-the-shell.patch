+
+/**********************************************************************
+ *          The album art
+ *
+ * DisplayUpdater.Thumbnail is a RandomAccessStreamReference, made from a Uri
+ * (Spotify: the cover on i.scdn.co) or from a stream the program filled. At
+ * Update the image is fetched on the thread pool and written to a file of
+ * %TEMP%\ArcticMedia, whose name goes into the session's row for the shell.
+ */
+
+static BOOL art_file_name( WCHAR *path, UINT size, UINT32 serial )
+{
+    WCHAR dir[MAX_PATH];
+
+    if (!GetTempPathW( ARRAY_SIZE(dir), dir )) return FALSE;
+    lstrcatW( dir, L"ArcticMedia" );
+    CreateDirectoryW( dir, NULL );
+    swprintf( path, size, L"%s\\%08x-%08x.img", dir, GetCurrentProcessId(), serial );
+    return TRUE;
+}
+
+/* the whole stream: its bytes from the start, through IInputStream.ReadAsync */
+static BOOL write_stream_art( IUnknown *unknown, const WCHAR *path )
+{
+    static const WCHAR buffer_class[] = L"Windows.Storage.Streams.Buffer";
+    IAsyncOperationWithProgress_IBuffer_UINT32 *operation = NULL;
+    IRandomAccessStream *stream = NULL;
+    IBufferFactory *factory = NULL;
+    IBufferByteAccess *bytes = NULL;
+    IInputStream *input = NULL;
+    IBuffer *buffer = NULL, *result = NULL;
+    IAsyncInfo *info = NULL;
+    AsyncStatus status = Started;
+    UINT32 length = 0;
+    BOOL written = FALSE;
+    HSTRING class = NULL;
+    UINT64 size = 0;
+    BYTE *data;
+    HANDLE file;
+    DWORD done;
+
+    if (FAILED(IUnknown_QueryInterface( unknown, &IID_IRandomAccessStream, (void **)&stream ))) return FALSE;
+    if (FAILED(IRandomAccessStream_get_Size( stream, &size )) || !size || size > 32 * 1024 * 1024) goto done;
+    if (FAILED(IRandomAccessStream_GetInputStreamAt( stream, 0, &input )))
+    {
+        /* the memory stream of windows.storage reads from where it is */
+        if (FAILED(IRandomAccessStream_Seek( stream, 0 )) ||
+            FAILED(IRandomAccessStream_QueryInterface( stream, &IID_IInputStream, (void **)&input )))
+            goto done;
+    }
+    if (FAILED(WindowsCreateString( buffer_class, ARRAY_SIZE(buffer_class) - 1, &class )) ||
+        FAILED(RoGetActivationFactory( class, &IID_IBufferFactory, (void **)&factory )) ||
+        FAILED(IBufferFactory_Create( factory, (UINT32)size, &buffer )) ||
+        FAILED(IInputStream_ReadAsync( input, buffer, (UINT32)size, InputStreamOptions_None, &operation )) ||
+        FAILED(IAsyncOperationWithProgress_IBuffer_UINT32_QueryInterface( operation, &IID_IAsyncInfo, (void **)&info )))
+        goto done;
+    for (int i = 0; i < 500 && status == Started; i++)
+    {
+        if (FAILED(IAsyncInfo_get_Status( info, &status ))) break;
+        if (status == Started) Sleep( 10 );
+    }
+    if (status != Completed ||
+        FAILED(IAsyncOperationWithProgress_IBuffer_UINT32_GetResults( operation, &result )) ||
+        FAILED(IBuffer_get_Length( result, &length )) || !length ||
+        FAILED(IBuffer_QueryInterface( result, &IID_IBufferByteAccess, (void **)&bytes )) ||
+        FAILED(IBufferByteAccess_Buffer( bytes, &data )))
+        goto done;
+    file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_TEMPORARY, NULL );
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        written = WriteFile( file, data, length, &done, NULL ) && done == length;
+        CloseHandle( file );
+        if (!written) DeleteFileW( path );
+    }
+
+done:
+    if (bytes) IBufferByteAccess_Release( bytes );
+    if (result) IBuffer_Release( result );
+    if (info) IAsyncInfo_Release( info );
+    if (operation) IAsyncOperationWithProgress_IBuffer_UINT32_Release( operation );
+    if (buffer) IBuffer_Release( buffer );
+    if (factory) IBufferFactory_Release( factory );
+    WindowsDeleteString( class );
+    if (input) IInputStream_Release( input );
+    IRandomAccessStream_Release( stream );
+    return written;
+}
+
+struct art_work
+{
+    struct media_control *impl;
+    IRandomAccessStreamReference *thumbnail;
+};
+
+static void CALLBACK fetch_art( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    struct art_work *work = context;
+    struct media_control *impl = work->impl;
+    IArcticStreamReferenceSource *source;
+    static LONG files;
+    WCHAR path[MAX_PATH], old[MAX_PATH];
+    BOOL written = FALSE;
+    HRESULT init;
+
+    init = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    if (art_file_name( path, ARRAY_SIZE(path), InterlockedIncrement( &files ) ) &&
+        SUCCEEDED(IRandomAccessStreamReference_QueryInterface( work->thumbnail, &IID_IArcticStreamReferenceSource, (void **)&source )))
+    {
+        HSTRING uri = NULL;
+        IUnknown *stream = NULL;
+
+        if (SUCCEEDED(source->lpVtbl->GetUri( source, &uri )) && uri)
+        {
+            const WCHAR *text = WindowsGetStringRawBuffer( uri, NULL );
+            written = SUCCEEDED(URLDownloadToFileW( NULL, text, path, 0, NULL ));
+            TRACE( "album art %s -> %s: %d\n", debugstr_w( text ), debugstr_w( path ), written );
+            WindowsDeleteString( uri );
+        }
+        else if (SUCCEEDED(source->lpVtbl->GetStream( source, &stream )) && stream)
+        {
+            written = write_stream_art( stream, path );
+            TRACE( "album art from a stream -> %s: %d\n", debugstr_w( path ), written );
+            IUnknown_Release( stream );
+        }
+        source->lpVtbl->Release( source );
+    }
+    else FIXME( "album art from a stream reference windows.storage did not make\n" );
+    if (SUCCEEDED(init)) CoUninitialize();
+
+    /* the art the program set last wins */
+    EnterCriticalSection( &controls_cs );
+    if (written && impl->fetched_thumbnail == work->thumbnail)
+    {
+        lstrcpyW( old, impl->art );
+        lstrcpyW( impl->art, path );
+        impl->art_serial++;
+        if (old[0]) DeleteFileW( old );
+    }
+    else
+    {
+        if (written) DeleteFileW( path );
+        written = FALSE;
+    }
+    LeaveCriticalSection( &controls_cs );
+    if (written) publish( impl, FALSE );
+
+    IRandomAccessStreamReference_Release( work->thumbnail );
+    ISystemMediaTransportControls_Release( &impl->ISystemMediaTransportControls_iface );
+    free( work );
+}
+
+/* at Update: a new thumbnail is fetched, no thumbnail takes the art away */
+static void update_art( struct media_control *impl )
+{
+    struct art_work *work;
+
+    if (impl->thumbnail == impl->fetched_thumbnail) return;
+    if (impl->fetched_thumbnail) IRandomAccessStreamReference_Release( impl->fetched_thumbnail );
+    if ((impl->fetched_thumbnail = impl->thumbnail)) IRandomAccessStreamReference_AddRef( impl->fetched_thumbnail );
+
+    if (!impl->thumbnail)
+    {
+        EnterCriticalSection( &controls_cs );
+        if (impl->art[0]) DeleteFileW( impl->art );
+        impl->art[0] = 0;
+        impl->art_serial++;
+        LeaveCriticalSection( &controls_cs );
+        return;
+    }
+    if (!(work = malloc( sizeof(*work) ))) return;
+    work->impl = impl;
+    work->thumbnail = impl->thumbnail;
+    IRandomAccessStreamReference_AddRef( work->thumbnail );
+    ISystemMediaTransportControls_AddRef( &impl->ISystemMediaTransportControls_iface );
+    if (!TrySubmitThreadpoolCallback( fetch_art, work, NULL ))
+    {
+        IRandomAccessStreamReference_Release( work->thumbnail );
+        ISystemMediaTransportControls_Release( &impl->ISystemMediaTransportControls_iface );
+        free( work );
+    }
 }
 
