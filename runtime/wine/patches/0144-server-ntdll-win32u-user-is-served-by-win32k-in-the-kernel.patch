+/* Arctic: a copy of the ntsync fd of an event, for win32k to set it from the
+ * kernel (docs/win32k.md); -1 if it has none. The caller closes it. */
+int dup_inproc_event_fd( HANDLE handle )
+{
+    struct inproc_sync stack, *sync;
+    int fd;
+
+    if (inproc_device_fd < 0) return -1;
+    if (get_inproc_sync( handle, INPROC_SYNC_EVENT, EVENT_MODIFY_STATE, &stack, &sync )) return -1;
+    fd = fcntl( sync->fd, F_DUPFD_CLOEXEC, 0 );
+    release_inproc_sync( sync );
+    return fd;
+}
