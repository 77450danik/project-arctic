From: Project Arctic
Subject: server, ntdll, win32u: USER is served by win32k in the kernel.

As in Windows, USER (windows, message queues, hooks, classes, atoms, the
clipboard) lives in the kernel, in win32k (kernel/drivers/win32k,
docs/win32k.md), and its handlers run in the calling thread instead of a
round trip to wineserver.

ntdll: a thread says who it is to win32k (win32k_hello) once wineserver has
made it; win32k says which requests it serves, and those go to it by its
system call. Three requests name an object of wineserver: the queue's event
(get_msg_queue_handle) is made through wineserver and given as its ntsync fd,
which win32k sets from the kernel; the driver's connection (set_queue_fd) as
its unix fd; a desktop (get_window_list) as the id wineserver gave it
(get_desktop_id).

server: the object manager of win32k. Window stations and desktops stay its
objects, with names, handles and security; it gives them ids and tells
win32k what happens to them and to processes and threads (win32k_callout),
as Windows' object manager calls win32k's callouts. A socket's
WSAAsyncSelect message goes through it too.

win32u: the shared objects of USER are in win32k's session memory.

Without win32k in the kernel, or with arctic.win32k=0 (NT_WIN32K=0), USER
stays in wineserver as before.
---
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -526,6 +526,218 @@
 
 
 /***********************************************************************
+ * Arctic: win32k
+ *
+ * The requests of USER (windows, queues, hooks, classes, atoms, the
+ * clipboard) go to win32k, USER in the kernel (docs/win32k.md), by its own
+ * system call, and are served in this thread; the rest go to wineserver. A
+ * thread says who it is to win32k when wineserver has made it
+ * (win32k_hello), which also says which requests win32k serves. When no
+ * wineserver uses win32k (arctic.win32k=0, or a kernel without it), all of
+ * them go to wineserver as before.
+ *
+ * Three requests name an object of wineserver by its handle; ntdll gives
+ * win32k what it stands for: the queue's event (get_msg_queue_handle), made
+ * here through wineserver, as its ntsync fd; the driver's connection
+ * (set_queue_fd) as its unix fd; a desktop (get_window_list) as the id
+ * wineserver gave it.
+ */
+#if defined(__linux__) && defined(__x86_64__)
+
+/* as include/uapi/linux/win32k.h of the kernel (kernel/drivers/win32k) */
+#define __NR_win32k_hello   0x1000
+#define __NR_win32k_call    0x1001
+
+struct win32k_hello
+{
+    UINT32 protocol;
+    UINT32 process_id;
+    UINT32 thread_id;
+    UINT32 requests_size;
+    UINT64 requests;
+};
+
+struct win32k_call
+{
+    UINT64 request;
+    UINT64 request_data;
+    UINT32 request_size;
+    UINT32 request_data_size;
+    UINT64 reply;
+    UINT64 reply_data;
+    UINT32 reply_size;
+    UINT32 reply_data_max;
+    UINT32 reply_data_size;
+    UINT32 status;
+    INT32  fd;
+    UINT32 pad;
+};
+
+static unsigned char win32k_requests[(REQ_NB_REQUESTS + 7) / 8];
+static int win32k_unused;  /* no wineserver uses win32k */
+
+static void win32k_init_thread( struct thread_data *data, process_id_t pid, thread_id_t tid )
+{
+    struct win32k_hello hello =
+    {
+        .protocol      = SERVER_PROTOCOL_VERSION,
+        .process_id    = pid,
+        .thread_id     = tid,
+        .requests_size = sizeof(win32k_requests),
+        .requests      = (ULONG_PTR)win32k_requests,
+    };
+
+    if (win32k_unused) return;
+    if (!syscall( __NR_win32k_hello, &hello ))
+    {
+        data->win32k = 1;
+        return;
+    }
+    /* ENOSYS: a kernel without win32k; ENOENT: wineserver keeps USER */
+    if (errno == ENOSYS || errno == ENOENT) win32k_unused = 1;
+    else ERR( "win32k_hello failed: %s; USER stays with wineserver for thread %04x\n", strerror(errno), tid );
+}
+
+static inline BOOL is_win32k_request( enum request code )
+{
+    return code < REQ_NB_REQUESTS && (win32k_requests[code / 8] & (1 << (code % 8)));
+}
+
+/* the id of a desktop, for win32k, as wineserver checks its handle */
+static unsigned int win32k_desktop_id( obj_handle_t handle, unsigned int access, unsigned int *status )
+{
+    unsigned int id = 0;
+
+    SERVER_START_REQ( get_desktop_id )
+    {
+        req->handle = handle;
+        req->access = access;
+        if (!(*status = wine_server_call( req ))) id = reply->id;
+    }
+    SERVER_END_REQ;
+    return id;
+}
+
+/* the process's idle event, which wineserver keeps */
+static obj_handle_t win32k_idle_event(void)
+{
+    obj_handle_t event = 0;
+
+    SERVER_START_REQ( get_process_idle_event )
+    {
+        req->handle = wine_server_obj_handle( GetCurrentProcess() );
+        if (!wine_server_call( req )) event = reply->event;
+    }
+    SERVER_END_REQ;
+    return event;
+}
+
+/* the request to win32k, if it serves it; FALSE if it goes to wineserver */
+static BOOL win32k_call( struct thread_data *data, struct __server_request_info *info, unsigned int *ret )
+{
+    enum request code = info->u.req.request_header.req;
+    unsigned int size = info->u.req.request_header.request_size, i;
+    unsigned int status = STATUS_SUCCESS;
+    struct win32k_call call;
+    HANDLE event = 0;
+    int fd = -1, needs_close = 0;
+    char *buffer = NULL;
+
+    if (!data->win32k || !is_win32k_request( code )) return FALSE;
+
+    memset( &call, 0, sizeof(call) );
+    call.request        = (ULONG_PTR)&info->u.req;
+    call.request_size   = sizeof(info->u.req);
+    call.reply          = (ULONG_PTR)&info->u.reply;
+    call.reply_size     = sizeof(info->u.reply);
+    call.reply_data     = (ULONG_PTR)info->reply_data;
+    call.reply_data_max = info->u.req.request_header.reply_size;
+
+    /* the request's data in one piece */
+    call.request_data_size = size;
+    if (info->data_count == 1) call.request_data = (ULONG_PTR)info->data[0].ptr;
+    else if (info->data_count > 1)
+    {
+        char *ptr;
+
+        if (!(buffer = malloc( size )))
+        {
+            *ret = STATUS_NO_MEMORY;
+            return TRUE;
+        }
+        for (i = 0, ptr = buffer; i < info->data_count; i++)
+        {
+            memcpy( ptr, info->data[i].ptr, info->data[i].size );
+            ptr += info->data[i].size;
+        }
+        call.request_data = (ULONG_PTR)buffer;
+    }
+
+    switch (code)
+    {
+    case REQ_get_msg_queue_handle:
+        /* an event of wineserver's (one device of ntsync for all the objects a
+         * thread waits on), which win32k then sets and resets */
+        if (!(status = NtCreateEvent( &event, SYNCHRONIZE | EVENT_QUERY_STATE | EVENT_MODIFY_STATE,
+                                      NULL, NotificationEvent, FALSE )) &&
+            (fd = dup_inproc_event_fd( event )) == -1)
+            status = STATUS_NOT_SUPPORTED;
+        needs_close = 1;
+        break;
+    case REQ_set_queue_fd:
+        status = server_get_unix_fd( wine_server_ptr_handle( info->u.req.set_queue_fd_request.handle ),
+                                     0, &fd, &needs_close, NULL, NULL );
+        break;
+    case REQ_get_window_list:
+        if (info->u.req.get_window_list_request.desktop)
+            info->u.req.get_window_list_request.desktop =
+                win32k_desktop_id( info->u.req.get_window_list_request.desktop, DESKTOP_READOBJECTS, &status );
+        break;
+    default:
+        break;
+    }
+
+    if (!status)
+    {
+        call.fd = fd;
+        if (!syscall( __NR_win32k_call, &call )) status = call.status;
+        else
+        {
+            if (errno == EFAULT) status = STATUS_ACCESS_VIOLATION;
+            else
+            {
+                ERR( "win32k_call of request %u failed: %s\n", code, strerror(errno) );
+                status = STATUS_INTERNAL_ERROR;
+            }
+            memset( &info->u.reply, 0, sizeof(info->u.reply) );
+            call.reply_data_size = 0;
+        }
+    }
+    else memset( &info->u.reply, 0, sizeof(info->u.reply) );
+    /* as wineserver: the data a handler gave goes back with its error too */
+    info->u.reply.reply_header.error = status;
+    info->u.reply.reply_header.reply_size = call.reply_data_size;
+
+    if (code == REQ_get_msg_queue_handle && !status)
+    {
+        info->u.reply.get_msg_queue_handle_reply.handle = wine_server_obj_handle( event );
+        info->u.reply.get_msg_queue_handle_reply.idle_event = win32k_idle_event();
+        event = 0;  /* the caller's now */
+    }
+    if (event) NtClose( event );
+    if (needs_close && fd != -1) close( fd );
+    free( buffer );
+    *ret = status;
+    return TRUE;
+}
+
+#else
+static void win32k_init_thread( struct thread_data *data, process_id_t pid, thread_id_t tid ) { }
+static BOOL win32k_call( struct thread_data *data, struct __server_request_info *req, unsigned int *ret ) { return FALSE; }
+#endif
+
