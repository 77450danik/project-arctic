+/* Arctic: when win32k (USER in the kernel, docs/win32k.md) serves this
+ * thread's requests, the shared objects of USER are in its session memory,
+ * which win32k_session gives as a read-only file; a section of it is made
+ * once. NULL when wineserver keeps USER. Called with session_lock held. */
+static HANDLE get_win32k_session_section(void)
+{
+#if defined(__linux__) && defined(__x86_64__)
+    static HANDLE section;
+    static BOOL tried;
+    HANDLE file;
+    int fd;
+
+    if (tried) return section;
+    tried = TRUE;
+    if ((fd = syscall( 0x1002 /* __NR_win32k_session */ )) == -1) return NULL;
+    if (!wine_server_fd_to_handle( fd, GENERIC_READ | SYNCHRONIZE, 0, &file ))
+    {
+        if (NtCreateSection( &section, SECTION_MAP_READ | SECTION_QUERY, NULL, NULL,
+                             PAGE_READONLY, SEC_COMMIT, file ))
+        {
+            ERR( "no section of win32k's session memory\n" );
+            section = NULL;
+        }
+        NtClose( file );
+    }
+    close( fd );
+    return section;
+#else
+    return NULL;
+#endif
+}
