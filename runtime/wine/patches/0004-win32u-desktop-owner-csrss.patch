From 8d214df67dd319155e764b198576d7e83261b09c Mon Sep 17 00:00:00 2001
From: 77450danik <dnsystems@email.ua>
Date: Sat, 19 Sep 2026 19:34:50 +0300
Subject: [PATCH] win32u: Start csrss.exe, not explorer.exe, when the desktop
 window is missing.

The desktop belongs to csrss.exe (winsrv.dll), as in Windows; explorer.exe
is only the shell.
---
 dlls/win32u/winstation.c | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/dlls/win32u/winstation.c b/dlls/win32u/winstation.c
index 3c55a80c..f56ccbf1 100644
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -825,11 +825,11 @@ HWND get_desktop_window(void)
 
     if (!thread_info->top_window)
     {
+        /* the desktop belongs to csrss.exe, as in Windows; explorer.exe is only the shell */
         static const WCHAR appnameW[] = {'\\','?','?','\\','C',':','\\','w','i','n','d','o','w','s',
-            '\\','s','y','s','t','e','m','3','2','\\','e','x','p','l','o','r','e','r','.','e','x','e',0};
-        static const WCHAR cmdlineW[] = {'"','C',':','\\','w','i','n','d','o','w','s','\\',
-            's','y','s','t','e','m','3','2','\\','e','x','p','l','o','r','e','r','.','e','x','e','"',
-            ' ','/','d','e','s','k','t','o','p',0};
+            '\\','s','y','s','t','e','m','3','2','\\','c','s','r','s','s','.','e','x','e',0};
+        static const WCHAR cmdlineW[] = {'C',':','\\','w','i','n','d','o','w','s','\\',
+            's','y','s','t','e','m','3','2','\\','c','s','r','s','s','.','e','x','e',0};
         static const WCHAR system_dir[] = {'C',':','\\','w','i','n','d','o','w','s','\\',
             's','y','s','t','e','m','3','2','\\',0};
         RTL_USER_PROCESS_PARAMETERS params = { sizeof(params), sizeof(params) };
@@ -851,7 +851,7 @@ HWND get_desktop_window(void)
             {
                 size_t size = wine_server_reply_size( reply );
                 desktop[size / sizeof(WCHAR)] = 0;
-                TRACE( "starting explorer for desktop %s\n", debugstr_w(desktop) );
+                TRACE( "starting csrss for desktop %s\n", debugstr_w(desktop) );
             }
             else
                 desktop[0] = 0;
@@ -893,12 +893,12 @@ HWND get_desktop_window(void)
         if (!status)
         {
             NtResumeThread( thread, NULL );
-            TRACE_(win)( "started explorer\n" );
+            TRACE_(win)( "started csrss\n" );
             NtUserWaitForInputIdle( process, 10000, FALSE );
             NtClose( thread );
             NtClose( process );
         }
-        else ERR_(win)( "failed to start explorer %x\n", status );
+        else ERR_(win)( "failed to start csrss %x\n", status );
 
         SERVER_START_REQ( get_desktop_window )
         {
-- 
