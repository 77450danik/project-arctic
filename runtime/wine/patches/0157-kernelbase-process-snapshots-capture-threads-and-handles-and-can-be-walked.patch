@@ -2202,6 +2488,124 @@ DWORD WINAPI PssFreeSnapshot( HANDLE hprocess, HPSS handle )
  */
 DWORD WINAPI PssCaptureSnapshot( HANDLE hprocess, PSS_CAPTURE_FLAGS flags, DWORD ctx_flags, HPSS *handle )
 {
-    FIXME( "(%p %u %lu %p)\n", hprocess , flags, ctx_flags, handle );
-    return ERROR_NOT_FOUND;
+    struct pss_snapshot *snapshot;
+    FILETIME now;
+    DWORD pid;
+
+    TRACE( "(%p %#x %#lx %p)\n", hprocess, flags, ctx_flags, handle );
+
+    if (!handle) return ERROR_INVALID_PARAMETER;
+    if (!(pid = GetProcessId( hprocess ))) return GetLastError();
+    if (flags & (PSS_CAPTURE_VA_CLONE | PSS_CAPTURE_VA_SPACE | PSS_CAPTURE_THREAD_CONTEXT | PSS_CAPTURE_IPT_TRACE))
+        FIXME( "flags %#x: not captured\n", flags & (PSS_CAPTURE_VA_CLONE | PSS_CAPTURE_VA_SPACE |
+               PSS_CAPTURE_THREAD_CONTEXT | PSS_CAPTURE_IPT_TRACE) );
+    if (!(snapshot = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*snapshot) )))
+        return ERROR_NOT_ENOUGH_MEMORY;
+    snapshot->magic = PSS_SNAPSHOT_MAGIC;
+    snapshot->flags = flags;
+    GetSystemTimeAsFileTime( &now );
+    pss_capture_process( snapshot, hprocess );
+    if (flags & PSS_CAPTURE_THREADS) pss_capture_threads( snapshot, pid, &now );
+    if (flags & PSS_CAPTURE_HANDLES) pss_capture_handles( snapshot, hprocess, pid, flags, &now );
+    *handle = (HPSS)snapshot;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *           PssWalkMarkerCreate   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkMarkerCreate( const PSS_ALLOCATOR *allocator, HPSSWALK *marker )
+{
+    struct pss_walk_marker *walk;
+
+    TRACE( "(%p %p)\n", allocator, marker );
+
+    if (!marker) return ERROR_INVALID_PARAMETER;
+    if (allocator && allocator->AllocRoutine)
+        walk = allocator->AllocRoutine( allocator->Context, sizeof(*walk) );
+    else
+        walk = HeapAlloc( GetProcessHeap(), 0, sizeof(*walk) );
+    if (!walk) return ERROR_NOT_ENOUGH_MEMORY;
+    walk->position = 0;
+    if (allocator) walk->allocator = *allocator;
+    else memset( &walk->allocator, 0, sizeof(walk->allocator) );
+    *marker = (HPSSWALK)walk;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *           PssWalkMarkerFree   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkMarkerFree( HPSSWALK marker )
+{
+    struct pss_walk_marker *walk = (struct pss_walk_marker *)marker;
+
+    TRACE( "(%p)\n", marker );
+
+    if (!walk) return ERROR_INVALID_PARAMETER;
+    if (walk->allocator.FreeRoutine) walk->allocator.FreeRoutine( walk->allocator.Context, walk );
+    else HeapFree( GetProcessHeap(), 0, walk );
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *           PssWalkMarkerGetPosition   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkMarkerGetPosition( HPSSWALK marker, ULONG_PTR *position )
+{
+    struct pss_walk_marker *walk = (struct pss_walk_marker *)marker;
+
+    if (!walk || !position) return ERROR_INVALID_PARAMETER;
+    *position = walk->position;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *           PssWalkMarkerSetPosition   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkMarkerSetPosition( HPSSWALK marker, ULONG_PTR position )
+{
+    struct pss_walk_marker *walk = (struct pss_walk_marker *)marker;
+
+    if (!walk) return ERROR_INVALID_PARAMETER;
+    walk->position = position;
+    return ERROR_SUCCESS;
+}
+
+/***********************************************************************
+ *           PssWalkMarkerSeekToBeginning   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkMarkerSeekToBeginning( HPSSWALK marker )
+{
+    return PssWalkMarkerSetPosition( marker, 0 );
+}
+
+/***********************************************************************
+ *           PssWalkSnapshot   (kernelbase.@)
+ */
+DWORD WINAPI PssWalkSnapshot( HPSS handle, PSS_WALK_INFORMATION_CLASS class, HPSSWALK marker,
+                              void *buffer, DWORD len )
+{
+    struct pss_snapshot *snapshot = pss_get( handle );
+    struct pss_walk_marker *walk = (struct pss_walk_marker *)marker;
+
+    TRACE( "(%p %u %p %p %lu)\n", handle, class, marker, buffer, len );
+
+    if (!snapshot || !walk) return ERROR_INVALID_PARAMETER;
+    switch (class)
+    {
+    case PSS_WALK_THREADS:
+        if (walk->position >= snapshot->thread_count) return ERROR_NO_MORE_ITEMS;
+        if (!buffer || len < sizeof(PSS_THREAD_ENTRY)) return ERROR_BAD_LENGTH;
+        memcpy( buffer, &snapshot->threads[walk->position++], sizeof(PSS_THREAD_ENTRY) );
+        return ERROR_SUCCESS;
+    case PSS_WALK_HANDLES:
+        if (walk->position >= snapshot->handle_count) return ERROR_NO_MORE_ITEMS;
+        if (!buffer || len < sizeof(PSS_HANDLE_ENTRY)) return ERROR_BAD_LENGTH;
+        memcpy( buffer, &snapshot->handles[walk->position++], sizeof(PSS_HANDLE_ENTRY) );
+        return ERROR_SUCCESS;
+    default:
+        /* the address space and auxiliary pages are not captured */
+        return ERROR_NO_MORE_ITEMS;
+    }
 }
