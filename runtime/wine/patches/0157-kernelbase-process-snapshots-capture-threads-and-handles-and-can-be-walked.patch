+/* A process snapshot: the process's information, and its threads and
+ * handles as they were, kept in this process until PssFreeSnapshot. The
+ * address space is not cloned (PSS_CAPTURE_VA_CLONE): nothing walks it. */
+#define PSS_SNAPSHOT_MAGIC 0x53535050  /* "PPSS" */
+
+struct pss_snapshot
+{
+    DWORD                   magic;
+    PSS_CAPTURE_FLAGS       flags;
+    PSS_PROCESS_INFORMATION process;
+    DWORD                   thread_count;
+    PSS_THREAD_ENTRY       *threads;
+    DWORD                   handle_count;
+    PSS_HANDLE_ENTRY       *handles;
+};
+
+struct pss_walk_marker
+{
+    ULONG_PTR     position;
+    PSS_ALLOCATOR allocator;
+};
+
+static struct pss_snapshot *pss_get( HPSS handle )
+{
+    struct pss_snapshot *snapshot = (struct pss_snapshot *)handle;
+    if (!snapshot || snapshot->magic != PSS_SNAPSHOT_MAGIC) return NULL;
+    return snapshot;
+}
+
+static void *pss_query_system( SYSTEM_INFORMATION_CLASS class )
+{
+    ULONG size = 0x10000, needed;
+    void *buffer;
+    NTSTATUS status;
+
+    for (;;)
+    {
+        if (!(buffer = HeapAlloc( GetProcessHeap(), 0, size ))) return NULL;
+        status = NtQuerySystemInformation( class, buffer, size, &needed );
+        if (!status) return buffer;
+        HeapFree( GetProcessHeap(), 0, buffer );
+        if (status != STATUS_INFO_LENGTH_MISMATCH && status != STATUS_BUFFER_TOO_SMALL) return NULL;
+        size = max( size * 2, needed + 0x1000 );
+    }
+}
+
+static void pss_filetime( FILETIME *ft, const LARGE_INTEGER *li )
+{
+    ft->dwLowDateTime = li->u.LowPart;
+    ft->dwHighDateTime = li->u.HighPart;
+}
+
+static void pss_capture_process( struct pss_snapshot *snapshot, HANDLE process )
+{
+    PSS_PROCESS_INFORMATION *info = &snapshot->process;
+    PROCESS_BASIC_INFORMATION basic;
+    KERNEL_USER_TIMES times;
+    VM_COUNTERS_EX vm;
+    ULONG_PTR wow64 = 0;
+    DWORD size = ARRAY_SIZE(info->ImageFileName);
+
+    if (!NtQueryInformationProcess( process, ProcessBasicInformation, &basic, sizeof(basic), NULL ))
+    {
+        info->ExitStatus = basic.ExitStatus;
+        info->PebBaseAddress = basic.PebBaseAddress;
+        info->AffinityMask = basic.AffinityMask;
+        info->BasePriority = basic.BasePriority;
+        info->ProcessId = basic.UniqueProcessId;
+        info->ParentProcessId = basic.InheritedFromUniqueProcessId;
+    }
+    if (!NtQueryInformationProcess( process, ProcessTimes, &times, sizeof(times), NULL ))
+    {
+        pss_filetime( &info->CreateTime, &times.CreateTime );
+        pss_filetime( &info->ExitTime, &times.ExitTime );
+        pss_filetime( &info->KernelTime, &times.KernelTime );
+        pss_filetime( &info->UserTime, &times.UserTime );
+    }
+    if (!NtQueryInformationProcess( process, ProcessVmCounters, &vm, sizeof(vm), NULL ))
+    {
+        info->PeakVirtualSize = vm.PeakVirtualSize;
+        info->VirtualSize = vm.VirtualSize;
+        info->PageFaultCount = vm.PageFaultCount;
+        info->PeakWorkingSetSize = vm.PeakWorkingSetSize;
+        info->WorkingSetSize = vm.WorkingSetSize;
+        info->QuotaPeakPagedPoolUsage = vm.QuotaPeakPagedPoolUsage;
+        info->QuotaPagedPoolUsage = vm.QuotaPagedPoolUsage;
+        info->QuotaPeakNonPagedPoolUsage = vm.QuotaPeakNonPagedPoolUsage;
+        info->QuotaNonPagedPoolUsage = vm.QuotaNonPagedPoolUsage;
+        info->PagefileUsage = vm.PagefileUsage;
+        info->PeakPagefileUsage = vm.PeakPagefileUsage;
+        info->PrivateUsage = vm.PrivateUsage;
+    }
+    if (!NtQueryInformationProcess( process, ProcessWow64Information, &wow64, sizeof(wow64), NULL ) && wow64)
+        info->Flags |= PSS_PROCESS_FLAGS_WOW64;
+    info->PriorityClass = GetPriorityClass( process );
+    if (!QueryFullProcessImageNameW( process, 0, info->ImageFileName, &size )) info->ImageFileName[0] = 0;
+}
+
+static void pss_capture_threads( struct pss_snapshot *snapshot, DWORD pid, const FILETIME *now )
+{
+    SYSTEM_PROCESS_INFORMATION *spi, *all = pss_query_system( SystemProcessInformation );
+    DWORD i;
+
+    if (!all) return;
+    for (spi = all; ; spi = (SYSTEM_PROCESS_INFORMATION *)((char *)spi + spi->NextEntryOffset))
+    {
+        if (HandleToUlong( spi->UniqueProcessId ) == pid)
+        {
+            snapshot->threads = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY,
+                                           max( spi->dwThreadCount, 1 ) * sizeof(*snapshot->threads) );
+            if (!snapshot->threads) break;
+            for (i = 0; i < spi->dwThreadCount; i++)
+            {
+                PSS_THREAD_ENTRY *entry = &snapshot->threads[i];
+                const SYSTEM_THREAD_INFORMATION *ti = &spi->ti[i];
+                THREAD_BASIC_INFORMATION basic;
+                HANDLE thread;
+
+                entry->ExitStatus = STILL_ACTIVE;
+                entry->ProcessId = pid;
+                entry->ThreadId = HandleToUlong( ti->ClientId.UniqueThread );
+                entry->Priority = ti->dwCurrentPriority;
+                entry->BasePriority = ti->dwBasePriority;
+                pss_filetime( &entry->CreateTime, &ti->CreateTime );
+                pss_filetime( &entry->KernelTime, &ti->KernelTime );
+                pss_filetime( &entry->UserTime, &ti->UserTime );
+                entry->Win32StartAddress = ti->StartAddress;
+                entry->CaptureTime = *now;
+                if ((thread = OpenThread( THREAD_QUERY_LIMITED_INFORMATION, FALSE, entry->ThreadId )))
+                {
+                    if (!NtQueryInformationThread( thread, ThreadBasicInformation, &basic, sizeof(basic), NULL ))
+                    {
+                        entry->ExitStatus = basic.ExitStatus;
+                        entry->TebBaseAddress = basic.TebBaseAddress;
+                        entry->AffinityMask = basic.AffinityMask;
+                    }
+                    CloseHandle( thread );
+                }
+            }
+            snapshot->thread_count = spi->dwThreadCount;
+            break;
+        }
+        if (!spi->NextEntryOffset) break;
+    }
+    HeapFree( GetProcessHeap(), 0, all );
+}
+
+static const WCHAR *pss_copy_string( const UNICODE_STRING *str, WORD *len )
+{
+    WCHAR *copy;
+
+    *len = 0;
+    if (!str->Length || !(copy = HeapAlloc( GetProcessHeap(), 0, str->Length + sizeof(WCHAR) ))) return NULL;
+    memcpy( copy, str->Buffer, str->Length );
+    copy[str->Length / sizeof(WCHAR)] = 0;
+    *len = str->Length;
+    return copy;
+}
+
+static PSS_OBJECT_TYPE pss_object_type( const WCHAR *name )
+{
+    static const struct { const WCHAR *name; PSS_OBJECT_TYPE type; } types[] =
+    {
+        { L"Process", PSS_OBJECT_TYPE_PROCESS }, { L"Thread", PSS_OBJECT_TYPE_THREAD },
+        { L"Mutant", PSS_OBJECT_TYPE_MUTANT }, { L"Event", PSS_OBJECT_TYPE_EVENT },
+        { L"Section", PSS_OBJECT_TYPE_SECTION }, { L"Semaphore", PSS_OBJECT_TYPE_SEMAPHORE },
+    };
+    unsigned int i;
+
+    if (name)
+        for (i = 0; i < ARRAY_SIZE(types); i++)
+            if (!wcscmp( name, types[i].name )) return types[i].type;
+    return PSS_OBJECT_TYPE_UNKNOWN;
+}
+
+static void pss_capture_handles( struct pss_snapshot *snapshot, HANDLE process, DWORD pid,
+                                 PSS_CAPTURE_FLAGS flags, const FILETIME *now )
+{
+    SYSTEM_HANDLE_INFORMATION_EX *all = pss_query_system( SystemExtendedHandleInformation );
+    BYTE buffer[sizeof(OBJECT_TYPE_INFORMATION) + 1024];
+    ULONG_PTR i, count = 0;
+
+    if (!all) return;
+    for (i = 0; i < all->NumberOfHandles; i++)
+        if (all->Handles[i].UniqueProcessId == pid) count++;
+    if (!(snapshot->handles = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, max( count, 1 ) * sizeof(*snapshot->handles) )))
+    {
+        HeapFree( GetProcessHeap(), 0, all );
+        return;
+    }
+    for (i = 0; i < all->NumberOfHandles; i++)
+    {
+        const SYSTEM_HANDLE_TABLE_ENTRY_INFO_EX *src = &all->Handles[i];
+        PSS_HANDLE_ENTRY *entry;
+        HANDLE dup = NULL;
+
+        if (src->UniqueProcessId != pid) continue;
+        entry = &snapshot->handles[snapshot->handle_count++];
+        entry->Handle = (HANDLE)src->HandleValue;
+        entry->CaptureTime = *now;
+        entry->Attributes = src->HandleAttributes;
+        entry->GrantedAccess = src->GrantedAccess;
+
+        if (!(flags & (PSS_CAPTURE_HANDLE_NAME_INFORMATION | PSS_CAPTURE_HANDLE_BASIC_INFORMATION |
+                       PSS_CAPTURE_HANDLE_TYPE_SPECIFIC_INFORMATION)))
+            continue;
+        if (!DuplicateHandle( process, entry->Handle, GetCurrentProcess(), &dup, 0, FALSE, DUPLICATE_SAME_ACCESS ))
+            continue;
+        if (!NtQueryObject( dup, ObjectTypeInformation, buffer, sizeof(buffer), NULL ))
+        {
+            entry->TypeName = pss_copy_string( &((OBJECT_TYPE_INFORMATION *)buffer)->TypeName, &entry->TypeNameLength );
+            if (entry->TypeName) entry->Flags |= PSS_HANDLE_HAVE_TYPE;
+            entry->ObjectType = pss_object_type( entry->TypeName );
+        }
+        if (flags & PSS_CAPTURE_HANDLE_BASIC_INFORMATION)
+        {
+            OBJECT_BASIC_INFORMATION basic;
+            if (!NtQueryObject( dup, ObjectBasicInformation, &basic, sizeof(basic), NULL ))
+            {
+                entry->HandleCount = basic.HandleCount;
+                entry->PointerCount = basic.PointerCount;
+                entry->PagedPoolCharge = basic.PagedPoolUsage;
+                entry->NonPagedPoolCharge = basic.NonPagedPoolUsage;
+                entry->Flags |= PSS_HANDLE_HAVE_BASIC_INFORMATION;
+            }
+        }
+        /* names of files are asked of their objects; a pipe's could block, as in Windows */
+        if ((flags & PSS_CAPTURE_HANDLE_NAME_INFORMATION) && entry->ObjectType != PSS_OBJECT_TYPE_UNKNOWN)
+        {
+            OBJECT_NAME_INFORMATION *name = (OBJECT_NAME_INFORMATION *)buffer;
+            if (!NtQueryObject( dup, ObjectNameInformation, name, sizeof(buffer), NULL ))
+            {
+                entry->ObjectName = pss_copy_string( &name->Name, &entry->ObjectNameLength );
+                if (entry->ObjectName) entry->Flags |= PSS_HANDLE_HAVE_NAME;
+            }
+        }
+        CloseHandle( dup );
+    }
+    HeapFree( GetProcessHeap(), 0, all );
+}
+
+static void pss_free( struct pss_snapshot *snapshot )
+{
+    DWORD i;
+
+    for (i = 0; i < snapshot->handle_count; i++)
+    {
+        HeapFree( GetProcessHeap(), 0, (void *)snapshot->handles[i].TypeName );
+        HeapFree( GetProcessHeap(), 0, (void *)snapshot->handles[i].ObjectName );
+    }
+    HeapFree( GetProcessHeap(), 0, snapshot->handles );
+    HeapFree( GetProcessHeap(), 0, snapshot->threads );
+    snapshot->magic = 0;
+    HeapFree( GetProcessHeap(), 0, snapshot );
+}
+
 /***********************************************************************
  *           PssQuerySnapshot   (kernelbase.@)
  */
 DWORD WINAPI PssQuerySnapshot( HPSS handle, PSS_QUERY_INFORMATION_CLASS class, void *buffer, DWORD len )
 {
-    FIXME( "(%p %u %p %lu)\n", handle ,class, buffer, len );
-    return ERROR_NOT_FOUND;
+    struct pss_snapshot *snapshot = pss_get( handle );
+
+    TRACE( "(%p %u %p %lu)\n", handle, class, buffer, len );
+
+    if (!snapshot || !buffer) return ERROR_INVALID_PARAMETER;
+    switch (class)
+    {
+    case PSS_QUERY_PROCESS_INFORMATION:
+        if (len < sizeof(PSS_PROCESS_INFORMATION)) return ERROR_BAD_LENGTH;
+        memcpy( buffer, &snapshot->process, sizeof(snapshot->process) );
+        return ERROR_SUCCESS;
+    case PSS_QUERY_HANDLE_INFORMATION:
+        if (len < sizeof(PSS_HANDLE_INFORMATION)) return ERROR_BAD_LENGTH;
+        if (!(snapshot->flags & PSS_CAPTURE_HANDLES)) return ERROR_NOT_FOUND;
+        ((PSS_HANDLE_INFORMATION *)buffer)->HandlesCaptured = snapshot->handle_count;
+        return ERROR_SUCCESS;
+    case PSS_QUERY_THREAD_INFORMATION:
+        if (len < sizeof(PSS_THREAD_INFORMATION)) return ERROR_BAD_LENGTH;
+        if (!(snapshot->flags & PSS_CAPTURE_THREADS)) return ERROR_NOT_FOUND;
+        ((PSS_THREAD_INFORMATION *)buffer)->ThreadsCaptured = snapshot->thread_count;
+        ((PSS_THREAD_INFORMATION *)buffer)->ContextLength = 0;
+        return ERROR_SUCCESS;
+    default:
+        FIXME( "class %u not captured\n", class );
+        return ERROR_NOT_FOUND;
+    }
 }
 
