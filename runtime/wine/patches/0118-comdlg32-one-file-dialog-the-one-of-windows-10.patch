+static void select_all(FileDialogImpl *This, BOOL rename_focused)
+{
+    IShellView *psv = current_view(This);
+    IFolderView *pfv = NULL;
+    int count = 0, i;
+
+    if (!psv)
+        return;
+    if (SUCCEEDED(IShellView_QueryInterface(psv, &IID_IFolderView, (void **)&pfv)))
+    {
+        if (rename_focused)
+        {
+            int focused = -1;
+            LPITEMIDLIST pidl = NULL;
+            if (SUCCEEDED(IFolderView_GetFocusedItem(pfv, &focused)) && focused >= 0 &&
+                SUCCEEDED(IFolderView_Item(pfv, focused, &pidl)))
+            {
+                IShellView_SelectItem(psv, pidl, SVSI_EDIT | SVSI_SELECT | SVSI_DESELECTOTHERS | SVSI_ENSUREVISIBLE);
+                ILFree(pidl);
+            }
+        }
+        else if (SUCCEEDED(IFolderView_ItemCount(pfv, SVGIO_ALLVIEW, &count)))
+        {
+            for (i = 0; i < count; i++)
+                IFolderView_SelectItem(pfv, i, SVSI_SELECT);
+        }
+        IFolderView_Release(pfv);
+    }
+    IShellView_Release(psv);
+}
