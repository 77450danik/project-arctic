+/* A verb of the selection's menu (or of the folder's, for Paste) */
+static void invoke_view_verb(FileDialogImpl *This, LPCSTR verb, BOOL background)
+{
+    IShellView *psv = current_view(This);
+    IContextMenu *pcm = NULL;
+    HMENU hmenu;
+
+    if (!psv)
+        return;
+    if (SUCCEEDED(IShellView_GetItemObject(psv, background ? SVGIO_BACKGROUND : SVGIO_SELECTION,
+                                           &IID_IContextMenu, (void **)&pcm)) && pcm)
+    {
+        hmenu = CreatePopupMenu();
+        if (hmenu && SUCCEEDED(IContextMenu_QueryContextMenu(pcm, hmenu, 0, 1, 0x7fff, CMF_NORMAL)))
+        {
+            CMINVOKECOMMANDINFO ici = { sizeof(ici) };
+            ici.hwnd = This->dlg_hwnd;
+            ici.lpVerb = verb;
+            ici.nShow = SW_SHOWNORMAL;
+            IContextMenu_InvokeCommand(pcm, &ici);
+        }
+        if (hmenu)
+            DestroyMenu(hmenu);
+        IContextMenu_Release(pcm);
+    }
+    IShellView_Release(psv);
+}
