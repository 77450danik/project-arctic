+/* Arctic: the keys of Windows' dialog, whichever of its controls has the
+ * focus: Alt+Left, Alt+Right, Alt+Up, Backspace in the view, F5, Alt+D or F4
+ * for the address, Ctrl+E or Ctrl+F for the search */
+static BOOL dialog_key(FileDialogImpl *This, const MSG *msg)
+{
+    BOOL alt = msg->message == WM_SYSKEYDOWN, ctrl = GetKeyState(VK_CONTROL) < 0;
+    WCHAR cls[32] = L"";
+    IShellView *psv;
+
+    if (alt)
+    {
+        switch (msg->wParam)
+        {
+        case VK_LEFT:  on_browse_back(This); return TRUE;
+        case VK_RIGHT: on_browse_forward(This); return TRUE;
+        case VK_UP:    on_browse_up(This); return TRUE;
+        case 'D':      chrome_address_edit(This->hwnd_address); return TRUE;
+        }
+        return FALSE;
+    }
+    switch (msg->wParam)
+    {
+    case VK_F5:
+        if ((psv = current_view(This)))
+        {
+            IShellView_Refresh(psv);
+            IShellView_Release(psv);
+        }
+        return TRUE;
+    case VK_F4:
+        if (GetAncestor(msg->hwnd, GA_PARENT) == This->hwnd_address || msg->hwnd == This->hwnd_address)
+            return FALSE;
+        chrome_address_edit(This->hwnd_address);
+        return TRUE;
+    case 'E':
+    case 'F':
+        if (!ctrl) return FALSE;
+        chrome_search_focus(This->hwnd_search);
+        return TRUE;
+    case VK_BACK:
+        GetClassNameW(msg->hwnd, cls, ARRAY_SIZE(cls));
+        if (lstrcmpiW(cls, WC_LISTVIEWW)) return FALSE;
+        on_browse_back(This);
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static LRESULT CALLBACK key_hook_proc(int code, WPARAM wparam, LPARAM lparam)
+{
+    MSG *msg = (MSG *)lparam;
+
+    if (code == HC_ACTION && wparam == PM_REMOVE && msg->hwnd &&
+        (msg->message == WM_KEYDOWN || msg->message == WM_SYSKEYDOWN))
+    {
+        FileDialogImpl *This = GetPropW(GetAncestor(msg->hwnd, GA_ROOT), L"itemdlg_keys");
+
+        if (This && This->dlg_hwnd && dialog_key(This, msg))
+            msg->message = WM_NULL;
+    }
+    return CallNextHookEx(NULL, code, wparam, lparam);
 }
 
