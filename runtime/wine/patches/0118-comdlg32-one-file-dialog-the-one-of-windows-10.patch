+/*
+ * Arctic: the folder picker of Windows 10, as Arctic NT's shell32 has it: the
+ * Open dialog choosing a folder (FOS_PICKFOLDERS). The program's BFFCALLBACK
+ * is told BFFM_INITIALIZED and BFFM_SELCHANGED, and the BFFM_ messages it
+ * sends to the dialog are answered. The tree stays for files, computers and
+ * printers, which the dialog does not pick.
+ */
+struct pick_events
+{
+    IFileDialogEvents IFileDialogEvents_iface;
+    LONG ref;
+    BROWSEINFOW *bi;
+    IFileDialog *pfd;
+    HWND hwnd;
+};
+
+static inline struct pick_events *impl_from_pick_events(IFileDialogEvents *iface)
+{
+    return CONTAINING_RECORD(iface, struct pick_events, IFileDialogEvents_iface);
+}
+
+static HRESULT WINAPI pick_QueryInterface(IFileDialogEvents *iface, REFIID riid, void **ppv)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IFileDialogEvents))
+    {
+        *ppv = iface;
+        IFileDialogEvents_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI pick_AddRef(IFileDialogEvents *iface)
+{
+    return InterlockedIncrement(&impl_from_pick_events(iface)->ref);
+}
+
+static ULONG WINAPI pick_Release(IFileDialogEvents *iface)
+{
+    struct pick_events *This = impl_from_pick_events(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref) free(This);
+    return ref;
+}
+
+static void pick_callback(struct pick_events *This, UINT msg, LPARAM lparam)
+{
+    if (This->bi->lpfn && This->hwnd)
+        This->bi->lpfn(This->hwnd, msg, lparam, This->bi->lParam);
+}
+
+static void pick_selchanged(struct pick_events *This, IFileDialog *pfd)
+{
+    IShellItem *psi = NULL;
+    LPITEMIDLIST pidl;
+
+    if (FAILED(IFileDialog_GetCurrentSelection(pfd, &psi)) || !psi)
+    {
+        psi = NULL;
+        if (FAILED(IFileDialog_GetFolder(pfd, &psi)) || !psi) return;
+    }
+    if (SUCCEEDED(SHGetIDListFromObject((IUnknown *)psi, &pidl)))
+    {
+        pick_callback(This, BFFM_SELCHANGED, (LPARAM)pidl);
+        ILFree(pidl);
+    }
+    IShellItem_Release(psi);
+}
+
+static LRESULT CALLBACK pick_subclass(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, UINT_PTR id, DWORD_PTR data)
+{
+    struct pick_events *This = (struct pick_events *)data;
+
+    switch (msg)
+    {
+    case BFFM_SETSELECTIONA:
+    case BFFM_SETSELECTIONW:
+    case BFFM_SETEXPANDED:
+    {
+        LPITEMIDLIST pidl = NULL;
+        IShellItem *psi;
+
+        if (wparam && lparam)
+        {
+            WCHAR path[MAX_PATH];
+
+            if (msg == BFFM_SETSELECTIONA)
+                MultiByteToWideChar(CP_ACP, 0, (LPCSTR)lparam, -1, path, MAX_PATH);
+            else
+                lstrcpynW(path, (LPCWSTR)lparam, MAX_PATH);
+            SHParseDisplayName(path, NULL, &pidl, 0, NULL);
+        }
+        else if (lparam)
+            pidl = ILClone((LPCITEMIDLIST)lparam);
+        if (pidl && SUCCEEDED(SHCreateItemFromIDList(pidl, &IID_IShellItem, (void **)&psi)))
+        {
+            IFileDialog_SetFolder(This->pfd, psi);
+            IShellItem_Release(psi);
+        }
+        ILFree(pidl);
+        return TRUE;
+    }
+    case BFFM_ENABLEOK:
+        EnableWindow(GetDlgItem(hwnd, IDOK), (BOOL)lparam);
+        return 0;
+    case BFFM_SETOKTEXT:
+        if (lparam) SetDlgItemTextW(hwnd, IDOK, (LPCWSTR)lparam);
+        return 0;
+    case BFFM_SETSTATUSTEXTA:
+    case BFFM_SETSTATUSTEXTW:
+        return 0;
+    case WM_NCDESTROY:
+        RemoveWindowSubclass(hwnd, pick_subclass, id);
+        break;
+    }
+    return DefSubclassProc(hwnd, msg, wparam, lparam);
+}
+
+/* the dialog's window, the first time it says anything */
+static void pick_attach(struct pick_events *This, IFileDialog *pfd)
+{
+    IOleWindow *pow;
+
+    if (This->hwnd || FAILED(IFileDialog_QueryInterface(pfd, &IID_IOleWindow, (void **)&pow)))
+        return;
+    IOleWindow_GetWindow(pow, &This->hwnd);
+    IOleWindow_Release(pow);
+    if (!This->hwnd) return;
+    SetWindowSubclass(This->hwnd, pick_subclass, 0, (DWORD_PTR)This);
+    pick_callback(This, BFFM_INITIALIZED, 0);
+}
+
+static HRESULT WINAPI pick_OnFileOk(IFileDialogEvents *iface, IFileDialog *pfd)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI pick_OnFolderChanging(IFileDialogEvents *iface, IFileDialog *pfd, IShellItem *psi)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI pick_OnFolderChange(IFileDialogEvents *iface, IFileDialog *pfd)
+{
+    struct pick_events *This = impl_from_pick_events(iface);
+
+    pick_attach(This, pfd);
+    pick_selchanged(This, pfd);
+    return S_OK;
+}
+
+static HRESULT WINAPI pick_OnSelectionChange(IFileDialogEvents *iface, IFileDialog *pfd)
+{
+    struct pick_events *This = impl_from_pick_events(iface);
+
+    pick_attach(This, pfd);
+    pick_selchanged(This, pfd);
+    return S_OK;
+}
+
+static HRESULT WINAPI pick_OnShareViolation(IFileDialogEvents *iface, IFileDialog *pfd, IShellItem *psi,
+                                            FDE_SHAREVIOLATION_RESPONSE *response)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI pick_OnTypeChange(IFileDialogEvents *iface, IFileDialog *pfd)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI pick_OnOverwrite(IFileDialogEvents *iface, IFileDialog *pfd, IShellItem *psi,
+                                       FDE_OVERWRITE_RESPONSE *response)
+{
+    return E_NOTIMPL;
+}
+
+static const IFileDialogEventsVtbl pick_events_vtbl =
+{
+    pick_QueryInterface, pick_AddRef, pick_Release,
+    pick_OnFileOk, pick_OnFolderChanging, pick_OnFolderChange, pick_OnSelectionChange,
+    pick_OnShareViolation, pick_OnTypeChange, pick_OnOverwrite,
+};
+
+/* TRUE when the dialog was shown: *ret is what was picked, or NULL */
+static BOOL pick_folder(BROWSEINFOW *lpbi, LPITEMIDLIST *ret)
+{
+    struct pick_events *events;
+    IFileDialog *pfd = NULL;
+    IShellItem *psi = NULL;
+    LPITEMIDLIST pidl = NULL, root = NULL;
+    DWORD cookie = 0;
+    HRESULT hr, init;
+
+    *ret = NULL;
+    init = OleInitialize(NULL);
+    hr = CoCreateInstance(&CLSID_FileOpenDialog, NULL, CLSCTX_INPROC_SERVER, &IID_IFileDialog, (void **)&pfd);
+    if (FAILED(hr))
+    {
+        ERR("No file dialog to pick a folder with: %#lx\n", hr);
+        if (SUCCEEDED(init)) OleUninitialize();
+        return FALSE;
+    }
+
+    IFileDialog_SetOptions(pfd, FOS_PICKFOLDERS | FOS_PATHMUSTEXIST | FOS_NOCHANGEDIR |
+                           ((lpbi->ulFlags & BIF_RETURNONLYFSDIRS) ? FOS_FORCEFILESYSTEM : FOS_ALLNONSTORAGEITEMS));
+    if (lpbi->lpszTitle)
+        IFileDialog_SetTitle(pfd, lpbi->lpszTitle);
+    if (lpbi->pidlRoot && IS_INTRESOURCE(lpbi->pidlRoot))
+        SHGetFolderLocation(NULL, LOWORD(lpbi->pidlRoot), NULL, 0, &root);
+    else if (lpbi->pidlRoot)
+        root = ILClone(lpbi->pidlRoot);
+    if (root && root->mkid.cb && SUCCEEDED(SHCreateItemFromIDList(root, &IID_IShellItem, (void **)&psi)))
+    {
+        IFileDialog_SetFolder(pfd, psi);
+        IShellItem_Release(psi);
+        psi = NULL;
+    }
+    ILFree(root);
+
+    if ((events = calloc(1, sizeof(*events))))
+    {
+        events->IFileDialogEvents_iface.lpVtbl = &pick_events_vtbl;
+        events->ref = 1;
+        events->bi = lpbi;
+        events->pfd = pfd;
+        if (FAILED(IFileDialog_Advise(pfd, &events->IFileDialogEvents_iface, &cookie)))
+        {
+            IFileDialogEvents_Release(&events->IFileDialogEvents_iface);
+            events = NULL;
+        }
+    }
+
+    hr = IFileDialog_Show(pfd, lpbi->hwndOwner);
+    if (events)
+    {
+        IFileDialog_Unadvise(pfd, cookie);
+        IFileDialogEvents_Release(&events->IFileDialogEvents_iface);
+    }
+
+    if (SUCCEEDED(hr) && SUCCEEDED(IFileDialog_GetResult(pfd, &psi)) &&
+        SUCCEEDED(SHGetIDListFromObject((IUnknown *)psi, &pidl)))
+    {
+        SHFILEINFOW sfi;
+        WCHAR *name;
+
+        if (lpbi->pszDisplayName)
+        {
+            lpbi->pszDisplayName[0] = 0;
+            if (SUCCEEDED(IShellItem_GetDisplayName(psi, SIGDN_NORMALDISPLAY, &name)))
+            {
+                lstrcpynW(lpbi->pszDisplayName, name, MAX_PATH);
+                CoTaskMemFree(name);
+            }
+        }
+        if (SHGetFileInfoW((LPCWSTR)pidl, 0, &sfi, sizeof(sfi), SHGFI_PIDL | SHGFI_SYSICONINDEX))
+            lpbi->iImage = sfi.iIcon;
+    }
+    if (psi) IShellItem_Release(psi);
+    IFileDialog_Release(pfd);
+    if (SUCCEEDED(init)) OleUninitialize();
+    *ret = pidl;
+    return TRUE;
+}
