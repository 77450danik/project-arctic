+    if (psv && SUCCEEDED(IShellView_QueryInterface(psv, &IID_IFolderView, (void **)&pfv)))
+    {
+        IFolderView_GetCurrentViewMode(pfv, &mode);
+        IFolderView_Release(pfv);
+    }
+    if (psv)
+        IShellView_Release(psv);
+    for (i = 0; i < ARRAY_SIZE(view_modes); i++)
+    {
+        if (LoadStringW(COMDLG32_hInstance, view_modes[i].text, text, ARRAY_SIZE(text)))
+            AppendMenuW(hmenu, MF_STRING | (view_modes[i].mode == mode && (mode != FVM_ICON || view_modes[i].size == 48) ?
+                        MF_CHECKED : 0), IDM_VIEW_FIRST + i, text);
+    }
+    if (!chrome_buttons_rect(htb, id, &rc))
+        GetWindowRect(htb, &rc);
+    cmd = TrackPopupMenu(hmenu, TPM_RETURNCMD | TPM_RIGHTALIGN | TPM_TOPALIGN, rc.right, rc.bottom, 0, This->dlg_hwnd, NULL);
+    DestroyMenu(hmenu);
