+/* Arctic: the user's folders go by the names This PC has for them, in the
+ * language of the system, as Windows shows them */
+static BOOL user_folder_name(IShellItem *psi, WCHAR *name, int count)
+{
+    static const struct { int csidl; const WCHAR *sub, *clsid; } folders[] =
+    {
+        { CSIDL_DESKTOPDIRECTORY, NULL, L"B4BFCC3A-DB2C-424C-B029-7FE99A87C641" },
+        { CSIDL_PROFILE, L"\\Downloads", L"088E3905-0323-4B02-9826-5D99428E115F" },
+        { CSIDL_PERSONAL, NULL, L"D3162B92-9365-467A-956B-92703ACA08AF" },
+        { CSIDL_MYPICTURES, NULL, L"24AD3AD4-A569-4530-98E1-AB02F9417AA8" },
+    };
+    WCHAR *path, known[MAX_PATH + 16], parsing[128];
+    BOOL found = FALSE;
+    unsigned int i;
+
+    if (FAILED(IShellItem_GetDisplayName(psi, SIGDN_FILESYSPATH, &path)))
+        return FALSE;
+    for (i = 0; i < ARRAY_SIZE(folders); i++)
+    {
+        LPITEMIDLIST pidl = NULL;
+        WCHAR *display = NULL;
+
+        if (FAILED(SHGetFolderPathW(NULL, folders[i].csidl, NULL, SHGFP_TYPE_CURRENT, known)))
+            continue;
+        if (folders[i].sub)
+            lstrcatW(known, folders[i].sub);
+        if (lstrcmpiW(path, known))
+            continue;
+        wsprintfW(parsing, L"::{20D04FE0-3AEA-1069-A2D8-08002B30309D}\\::{%s}", folders[i].clsid);
+        if (SUCCEEDED(SHParseDisplayName(parsing, NULL, &pidl, 0, NULL)) && pidl)
+        {
+            if (SUCCEEDED(SHGetNameFromIDList(pidl, SIGDN_NORMALDISPLAY, &display)))
+            {
+                lstrcpynW(name, display, count);
+                CoTaskMemFree(display);
+                found = TRUE;
+            }
+            ILFree(pidl);
+        }
+        break;
+    }
+    CoTaskMemFree(path);
+    return found;
+}
