+/* New folder: made in the folder, then named in place */
+static void on_new_folder(FileDialogImpl *This)
+{
+    WCHAR *dir = NULL, name[MAX_PATH], path[MAX_PATH], base[64];
+    IShellView *psv;
+    LPITEMIDLIST pidl = NULL;
+    UINT n;
+
+    if (!This->psi_folder || FAILED(IShellItem_GetDisplayName(This->psi_folder, SIGDN_FILESYSPATH, &dir)))
+    {
+        MessageBeep(MB_ICONWARNING);
+        return;
+    }
+    if (!LoadStringW(COMDLG32_hInstance, IDS_ITEMDLG_NEW_FOLDER_NAME, base, ARRAY_SIZE(base)))
+        lstrcpyW(base, L"New folder");
+    lstrcpyW(name, base);
+    PathCombineW(path, dir, name);
+    for (n = 2; PathFileExistsW(path) && n < 1000; n++)
+    {
+        wsprintfW(name, L"%s (%u)", base, n);
+        PathCombineW(path, dir, name);
+    }
+    CoTaskMemFree(dir);
+    if (!CreateDirectoryW(path, NULL))
+    {
+        MessageBeep(MB_ICONWARNING);
+        return;
+    }
+    SHChangeNotify(SHCNE_MKDIR, SHCNF_PATHW | SHCNF_FLUSH, path, NULL);
+    if ((psv = current_view(This)))
+    {
+        IShellView_Refresh(psv);
+        if (SUCCEEDED(SHParseDisplayName(path, NULL, &pidl, 0, NULL)) && pidl)
+        {
+            IShellView_SelectItem(psv, ILFindLastID(pidl),
+                                  SVSI_EDIT | SVSI_SELECT | SVSI_DESELECTOTHERS | SVSI_ENSUREVISIBLE | SVSI_FOCUSED);
+            ILFree(pidl);
+        }
+        IShellView_Release(psv);
+    }
+}
