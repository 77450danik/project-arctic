+            SUCCEEDED(IShellFolder_GetDisplayNameOf(psf, pidl, SHGDN_INFOLDER, &str)) &&
+            SUCCEEDED(StrRetToBufW(&str, pidl, name, ARRAY_SIZE(name))))
+            keep = StrStrIW(name, This->search) != NULL;
+        if (psf) IShellFolder_Release(psf);
+        if (pfv) IFolderView_Release(pfv);
+        if (!keep)
+            return S_FALSE;
+    }
+
     if(!This->current_filter && !(This->options & FOS_PICKFOLDERS))
         return S_OK;
 
