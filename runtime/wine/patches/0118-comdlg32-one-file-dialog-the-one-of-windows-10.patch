+
+static LRESULT cdm_copy(LPCWSTR text, WPARAM cch, LPARAM buf, BOOL ansi)
+{
+    int len = lstrlenW(text) + 1;
+    if (ansi)
+    {
+        int need = WideCharToMultiByte(CP_ACP, 0, text, -1, NULL, 0, NULL, NULL);
+        if (buf && (int)cch > 0)
+            WideCharToMultiByte(CP_ACP, 0, text, -1, (LPSTR)buf, cch, NULL, NULL);
+        return need;
+    }
+    if (buf && (int)cch > 0)
+        lstrcpynW((LPWSTR)buf, text, cch);
+    return len;
+}
