+static void notify_callbacks( AEVImpl *This, const struct endpoint_volume *entry )
+{
+    AUDIO_VOLUME_NOTIFICATION_DATA *data;
+    UINT i;
+
+    if (!(data = malloc( offsetof( AUDIO_VOLUME_NOTIFICATION_DATA, afChannelVolumes[CHANNELS] ) ))) return;
+    data->guidEventContext = entry->context;
+    data->bMuted = !!entry->mute;
+    data->fMasterVolume = entry->level;
+    data->nChannels = CHANNELS;
+    for (i = 0; i < CHANNELS; i++) data->afChannelVolumes[i] = entry->level;
+    for (i = 0; i < This->callback_count; i++)
+        IAudioEndpointVolumeCallback_OnNotify( This->callbacks[i], data );
+    free( data );
+}
+
+static DWORD WINAPI watch_proc( void *arg )
+{
+    LONG serial = endpoint_volume_serial();
+
+    SetThreadDescription( GetCurrentThread(), L"wine_mmdevapi_endpoint_volume" );
+    for (;;)
+    {
+        AEVImpl *aev, *next;
+        LONG now;
+
+        Sleep( 200 );
+        if ((now = endpoint_volume_serial()) == serial) continue;
+        serial = now;
+
+        EnterCriticalSection( &watch_lock );
+        LIST_FOR_EACH_ENTRY_SAFE( aev, next, &watched, AEVImpl, entry )
+        {
+            struct endpoint_volume *entry = find_entry( &aev->device, aev->flow );
+
+            if (!entry || (entry->level == aev->notified_level && !!entry->mute == aev->notified_mute)) continue;
+            aev->notified_level = entry->level;
+            aev->notified_mute = !!entry->mute;
+            IAudioEndpointVolumeEx_AddRef( &aev->IAudioEndpointVolumeEx_iface );
+            notify_callbacks( aev, entry );
+            IAudioEndpointVolumeEx_Release( &aev->IAudioEndpointVolumeEx_iface );
+        }
+        LeaveCriticalSection( &watch_lock );
+    }
+    return 0;
+}
+
 static void AudioEndpointVolume_Destroy(AEVImpl *This)
 {
+    UINT i;
+
+    EnterCriticalSection( &watch_lock );
+    if (This->callback_count) list_remove( &This->entry );
+    LeaveCriticalSection( &watch_lock );
+    for (i = 0; i < This->callback_count; i++) IAudioEndpointVolumeCallback_Release( This->callbacks[i] );
+    free( This->callbacks );
     free(This);
 }
 
