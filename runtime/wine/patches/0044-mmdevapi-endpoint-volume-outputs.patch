+/* Arctic: the volume of an endpoint is the whole system's, as in Windows.
+ * Every process sees it in a shared section, keyed by the endpoint's GUID;
+ * the audio clients of all processes scale what they play by it (client.c),
+ * and it is kept in HKCU\Software\Arctic\Audio across sessions. The scalar
+ * maps to decibels the way Windows' does, so that half is half as loud:
+ * dB = 33.22 * log10(scalar). Callbacks hear of changes made anywhere, a
+ * fifth of a second later at most. */
+#define AUDIO_SECTION     L"Global\\__arctic_audio"
+#define AUDIO_MUTEX       L"Global\\__arctic_audio_lock"
+#define AUDIO_KEY         L"Software\\Arctic\\Audio"
+#define AUDIO_VERSION     1
+#define AUDIO_ENDPOINTS   64
+#define TAPER_DB          33.22f
+#define MIN_DB            -96.f
+#define VOLUME_STEPS      51       /* 2% a step, as the volume keys go */
+#define CHANNELS          2
+
+struct endpoint_volume
+{
+    GUID  device;
+    float level;                   /* 0-1 */
+    LONG  mute;
+    GUID  context;                 /* of the last change */
+};
+
+struct endpoint_volume_shared
+{
+    UINT32        version;
+    volatile LONG serial;          /* moves after every change */
+    volatile LONG count;
+    struct endpoint_volume entries[AUDIO_ENDPOINTS];
+};
+
+static struct endpoint_volume_shared *get_shared(void)
+{
+    static struct endpoint_volume_shared *shared;
+    struct endpoint_volume_shared *view;
+    HANDLE mapping;
+
+    if (shared) return shared;
+    if (!(mapping = CreateFileMappingW( INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, sizeof(*view), AUDIO_SECTION )))
+        return NULL;
+    view = MapViewOfFile( mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, sizeof(*view) );
+    CloseHandle( mapping );
+    if (!view) return NULL;
+    InterlockedCompareExchange( (LONG *)&view->version, AUDIO_VERSION, 0 );
+    if (view->version != AUDIO_VERSION)
+    {
+        UnmapViewOfFile( view );
+        return NULL;
+    }
+    if (InterlockedCompareExchangePointer( (void **)&shared, view, NULL )) UnmapViewOfFile( view );
+    return shared;
+}
+
+/* changes go one at a time, across processes; a mutex outlives a process
+ * that dies holding it */
+static HANDLE lock_shared(void)
+{
+    HANDLE mutex = CreateMutexW( NULL, FALSE, AUDIO_MUTEX );
+
+    if (mutex) WaitForSingleObject( mutex, INFINITE );
+    return mutex;
+}
+
+static void unlock_shared( HANDLE mutex )
+{
+    if (!mutex) return;
+    ReleaseMutex( mutex );
+    CloseHandle( mutex );
+}
+
+static HKEY open_endpoint_key( const GUID *device, REGSAM access )
+{
+    WCHAR name[ARRAY_SIZE(AUDIO_KEY) + 40];
+    HKEY key;
+
+    lstrcpyW( name, AUDIO_KEY L"\\" );
+    StringFromGUID2( device, name + lstrlenW( name ), 39 );
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, name, 0, NULL, 0, access, NULL, &key, NULL )) return NULL;
+    return key;
+}
+
+static void save_entry( const struct endpoint_volume *entry )
+{
+    DWORD level = (DWORD)(entry->level * 100000.f + 0.5f), mute = !!entry->mute;
+    HKEY key;
+
+    if (!(key = open_endpoint_key( &entry->device, KEY_SET_VALUE ))) return;
+    RegSetValueExW( key, L"Volume", 0, REG_DWORD, (BYTE *)&level, sizeof(level) );
+    RegSetValueExW( key, L"Mute", 0, REG_DWORD, (BYTE *)&mute, sizeof(mute) );
+    RegCloseKey( key );
+}
+
+/* a new output starts at half, a microphone at full, as Windows has them */
+static void load_entry( struct endpoint_volume *entry, EDataFlow flow )
+{
+    DWORD value, size = sizeof(value);
+    HKEY key;
+
+    entry->level = flow == eCapture ? 1.f : 0.5f;
+    entry->mute = FALSE;
+    if (!(key = open_endpoint_key( &entry->device, KEY_QUERY_VALUE ))) return;
+    if (!RegQueryValueExW( key, L"Volume", NULL, NULL, (BYTE *)&value, &size ) && size == sizeof(value))
+        entry->level = min( value, 100000 ) / 100000.f;
+    size = sizeof(value);
+    if (!RegQueryValueExW( key, L"Mute", NULL, NULL, (BYTE *)&value, &size ) && size == sizeof(value))
+        entry->mute = !!value;
+    RegCloseKey( key );
+}
+
+static struct endpoint_volume *find_entry( const GUID *device, EDataFlow flow )
+{
+    struct endpoint_volume_shared *shared = get_shared();
+    struct endpoint_volume *entry = NULL;
+    LONG count, i;
+    HANDLE mutex;
+
+    if (!shared) return NULL;
+    count = ReadAcquire( &shared->count );
+    for (i = 0; i < count && i < AUDIO_ENDPOINTS; i++)
+        if (IsEqualGUID( &shared->entries[i].device, device )) return &shared->entries[i];
+
+    /* the first process to ask brings it in from the registry */
+    mutex = lock_shared();
+    count = shared->count;
+    for (i = 0; i < count && i < AUDIO_ENDPOINTS; i++)
+        if (IsEqualGUID( &shared->entries[i].device, device )) entry = &shared->entries[i];
+    if (!entry && count < AUDIO_ENDPOINTS)
+    {
+        entry = &shared->entries[count];
+        entry->device = *device;
+        load_entry( entry, flow );
+        WriteRelease( &shared->count, count + 1 );
+    }
+    unlock_shared( mutex );
+    return entry;
+}
+
+static void change_entry( const GUID *device, EDataFlow flow, const float *level, const BOOL *mute,
+                          const GUID *context )
+{
+    struct endpoint_volume_shared *shared = get_shared();
+    struct endpoint_volume *entry = find_entry( device, flow );
+    HANDLE mutex;
+
+    if (!entry) return;
+    mutex = lock_shared();
+    if (level) entry->level = max( 0.f, min( 1.f, *level ) );
+    if (mute) entry->mute = !!*mute;
+    entry->context = context ? *context : GUID_NULL;
+    save_entry( entry );
+    InterlockedIncrement( &shared->serial );
+    unlock_shared( mutex );
+}
+
+LONG endpoint_volume_serial(void)
+{
+    struct endpoint_volume_shared *shared = get_shared();
+    return shared ? ReadAcquire( &shared->serial ) : 0;
+}
+
+/* what the endpoint's volume and mute make of a sample's amplitude */
+float endpoint_volume_amplitude( const GUID *device, EDataFlow flow )
+{
+    struct endpoint_volume *entry = find_entry( device, flow );
+
+    if (!entry) return 1.f;
+    if (entry->mute || entry->level <= 0.f) return 0.f;
+    return powf( entry->level, TAPER_DB / 20.f );
+}
