+            if (dev->flow == flow && dev->state == DEVICE_STATE_ACTIVE)
+                dev->state = DEVICE_STATE_NOTPRESENT;
+        if (flow == eRender) MMDevice_def_play = NULL;
+        else MMDevice_def_rec = NULL;
+        load_driver_devices(flow);
+    }
+    LeaveCriticalSection(&refresh_lock);
+}
