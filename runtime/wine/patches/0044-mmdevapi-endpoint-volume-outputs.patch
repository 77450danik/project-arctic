+    if (!entry) return E_FAIL;
+    step = (int)(entry->level * (VOLUME_STEPS - 1) + 0.5f) + direction;
+    step = max( 0, min( VOLUME_STEPS - 1, step ) );
+    level = (float)step / (VOLUME_STEPS - 1);
+    change_entry( &This->device, This->flow, &level, NULL, ctx );
+    return S_OK;
