+/* Arctic: endpoints come and go (a USB headset, a monitor with speakers) and
+ * a process such as explorer lives long, so the driver is asked for them
+ * again when they are enumerated, at most every two seconds. Those it no
+ * longer has are not present. */
+static void refresh_driver_devices(EDataFlow flow)
+{
+    MMDevice *dev;
+
+    if (!drvs.module_unixlib || flow >= EDataFlow_enum_count)
+        return;
+    EnterCriticalSection(&refresh_lock);
+    if (GetTickCount() - devices_loaded[flow] >= 2000)
+    {
