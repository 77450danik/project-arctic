+/* Arctic: the outputs as Windows lists them. Each output device of each card
+ * is an endpoint of its own, played to through dmix so that programs share
+ * it (the device alone takes one program at a time); an HDMI or DisplayPort
+ * output is one only while a monitor that takes sound is on it. The
+ * endpoint's name is its adapter's (the HD Audio codec, or the card), and
+ * DEVPKEY_Device_DeviceDesc says what it is: Speakers, Headphones, Digital
+ * Output, or the monitor's name. The default is the output arctic-init made
+ * ALSA's default. */
+#define ARCTIC_OUTPUT_FORMAT "plug:'dmix:CARD=%u,DEV=%u'"
+
+static const PROPERTYKEY devicedesc_key = { /* DEVPKEY_Device_DeviceDesc */
+    {0xa45c254e, 0xdf1c, 0x4efd, {0x80, 0x20, 0x67, 0xd1, 0x46, 0xa8, 0x50, 0xe0}}, 2
+};
+
+enum output_kind { OUTPUT_ANALOG, OUTPUT_SPDIF, OUTPUT_HDMI };
+
+static BOOL parse_card_device(const char *name, unsigned int *card, unsigned int *device)
+{
+    return sscanf(name, "plughw:%u,%u", card, device) == 2 ||
+           sscanf(name, "plug:'dmix:CARD=%u,DEV=%u'", card, device) == 2;
+}
+
+static enum output_kind get_output_kind(const char *pcm_name)
+{
+    if (strstr(pcm_name, "HDMI") || strstr(pcm_name, "DP") || strstr(pcm_name, "DisplayPort"))
+        return OUTPUT_HDMI;
+    if (strstr(pcm_name, "Digital") || strstr(pcm_name, "IEC958") || strstr(pcm_name, "SPDIF") ||
+        strstr(pcm_name, "S/PDIF"))
+        return OUTPUT_SPDIF;
+    return OUTPUT_ANALOG;
+}
+
+/* 1: a monitor is on the HDMI/DP output, 0: nothing, -1: the card does not say */
+static int hdmi_monitor_present(snd_ctl_t *ctl, int device)
+{
+    snd_ctl_elem_value_t *value;
+    char name[64];
+
+    snd_ctl_elem_value_alloca(&value);
+    snd_ctl_elem_value_set_interface(value, SND_CTL_ELEM_IFACE_CARD);
+    snprintf(name, sizeof(name), "HDMI/DP,pcm=%d Jack", device);
+    snd_ctl_elem_value_set_name(value, name);
+    if (snd_ctl_elem_read(ctl, value) < 0)
+        return -1;
+    return snd_ctl_elem_value_get_boolean(value, 0) ? 1 : 0;
+}
+
+/* the monitor's name from the ELD the card keeps for the output: its
+ * baseline block starts at byte 4, whose low five bits are the name's length,
+ * and the name itself at byte 20 */
+static BOOL hdmi_monitor_name(snd_ctl_t *ctl, int device, char *buf, size_t size)
+{
+    snd_ctl_elem_value_t *value;
+    snd_ctl_elem_info_t *info;
+    const unsigned char *eld;
+    unsigned int count, len;
+
+    snd_ctl_elem_info_alloca(&info);
+    snd_ctl_elem_value_alloca(&value);
+    snd_ctl_elem_info_set_interface(info, SND_CTL_ELEM_IFACE_PCM);
+    snd_ctl_elem_info_set_name(info, "ELD");
+    snd_ctl_elem_info_set_device(info, device);
+    if (snd_ctl_elem_info(ctl, info) < 0 || snd_ctl_elem_info_get_type(info) != SND_CTL_ELEM_TYPE_BYTES)
+        return FALSE;
+    count = snd_ctl_elem_info_get_count(info);
+    snd_ctl_elem_value_set_interface(value, SND_CTL_ELEM_IFACE_PCM);
+    snd_ctl_elem_value_set_name(value, "ELD");
+    snd_ctl_elem_value_set_device(value, device);
+    if (snd_ctl_elem_read(ctl, value) < 0 || count < 21)
+        return FALSE;
+    eld = snd_ctl_elem_value_get_bytes(value);
+    len = eld[4] & 0x1f;
+    if (!len || 20 + len > count)
+        return FALSE;
+    if (len > size - 1) len = size - 1;
+    memcpy(buf, eld + 20, len);
+    while (len && (buf[len - 1] == ' ' || !buf[len - 1])) len--;
+    buf[len] = 0;
+    return len > 0;
+}
+
+/* "Realtek ALC892": the HD Audio codec behind the analog and S/PDIF outputs */
+static BOOL hda_codec_name(unsigned int card, char *buf, size_t size)
+{
+    char path[64], line[128];
+    FILE *f;
+
+    for (int codec = 0; codec < 4; codec++)
+    {
+        BOOL found = FALSE;
+
+        snprintf(path, sizeof(path), "/proc/asound/card%u/codec#%d", card, codec);
+        if (!(f = fopen(path, "r"))) continue;
+        if (fgets(line, sizeof(line), f) && !strncmp(line, "Codec: ", 7) &&
+            !strstr(line, "HDMI") && !strstr(line, "DisplayPort"))
+        {
+            size_t len = strcspn(line + 7, "\n");
+            if (len > size - 1) len = size - 1;
+            memcpy(buf, line + 7, len);
+            buf[len] = 0;
+            found = len > 0;
+        }
+        fclose(f);
+        if (found) return TRUE;
+    }
+    return FALSE;
+}
+
+/* the card and device arctic-init made ALSA's default (/etc/asound.conf) */
+static void get_default_output(int *card, int *device)
+{
+    snd_config_t *node;
+    const char *str;
+    long value;
+
+    *card = -1;
+    *device = 0;
+    if (snd_config_update() < 0)
+        return;
+    if (!snd_config_search(snd_config, "defaults.pcm.card", &node))
+    {
+        if (!snd_config_get_integer(node, &value)) *card = value;
+        else if (!snd_config_get_string(node, &str)) *card = snd_card_get_index(str);
+    }
+    if (!snd_config_search(snd_config, "defaults.pcm.device", &node) && !snd_config_get_integer(node, &value))
+        *device = value;
+}
+
+/* what the output is, as DEVPKEY_Device_DeviceDesc says it; FALSE: no such output */
+static BOOL get_output_description(unsigned int card, unsigned int device, char *buf, size_t size)
+{
+    snd_pcm_info_t *info;
+    snd_ctl_t *ctl;
+    char cardpath[16], *cardname = NULL;
+    BOOL ret = FALSE;
+
+    snprintf(cardpath, sizeof(cardpath), "hw:%u", card);
+    if (snd_ctl_open(&ctl, cardpath, 0) < 0)
+        return FALSE;
+    snd_pcm_info_alloca(&info);
+    snd_pcm_info_set_device(info, device);
+    snd_pcm_info_set_subdevice(info, 0);
+    snd_pcm_info_set_stream(info, SND_PCM_STREAM_PLAYBACK);
+    if (snd_ctl_pcm_info(ctl, info) >= 0)
+    {
+        ret = TRUE;
+        switch (get_output_kind(snd_pcm_info_get_name(info)))
+        {
+        case OUTPUT_HDMI:
+            if (!hdmi_monitor_name(ctl, device, buf, size))
+                snprintf(buf, size, "Digital Display");
+            break;
+        case OUTPUT_SPDIF:
+            snprintf(buf, size, "Digital Output");
+            break;
+        case OUTPUT_ANALOG:
+            snd_card_get_name(card, &cardname);
+            snprintf(buf, size, cardname && (strstr(cardname, "Headset") || strstr(cardname, "Headphone")) ?
+                     "Headphones" : "Speakers");
+            free(cardname);
+            break;
+        }
+    }
+    snd_ctl_close(ctl);
+    return ret;
+}
+
+static void alsa_get_outputs(struct endpoints_info *endpoints_info, unsigned int *default_idx)
+{
+    int card = -1, def_card, def_device, err;
+    unsigned int first_analog = ~0u;
+
+    *default_idx = ~0u;
+    get_default_output(&def_card, &def_device);
+
+    for (err = snd_card_next(&card); card != -1 && err >= 0; err = snd_card_next(&card))
+    {
+        snd_pcm_info_t *info;
+        char cardpath[16], codec[64];
+        WCHAR *cardname;
+        snd_ctl_t *ctl;
+        int device = -1;
+        BOOL has_codec;
+
+        snprintf(cardpath, sizeof(cardpath), "hw:%u", card);
+        if (snd_ctl_open(&ctl, cardpath, 0) < 0)
+            continue;
+        cardname = alsa_get_card_name(card);
+        has_codec = hda_codec_name(card, codec, sizeof(codec));
+        snd_pcm_info_alloca(&info);
+
+        while (snd_ctl_pcm_next_device(ctl, &device) >= 0 && device >= 0)
+        {
+            enum output_kind kind;
+            char devnode[64];
+            WCHAR *name;
+
+            snd_pcm_info_set_device(info, device);
+            snd_pcm_info_set_subdevice(info, 0);
+            snd_pcm_info_set_stream(info, SND_PCM_STREAM_PLAYBACK);
+            if (snd_ctl_pcm_info(ctl, info) < 0)
+                continue;
+            kind = get_output_kind(snd_pcm_info_get_name(info));
+            if (kind == OUTPUT_HDMI && !hdmi_monitor_present(ctl, device))
+                continue;
+            snprintf(devnode, sizeof(devnode), ARCTIC_OUTPUT_FORMAT, card, device);
+            if (!alsa_try_open(devnode, eRender))
+                continue;
+
+            if (has_codec && kind != OUTPUT_HDMI)
+                name = strdupAtoW(codec);
+            else if ((name = malloc((wcslen(cardname) + 1) * sizeof(WCHAR))))
+                memcpy(name, cardname, (wcslen(cardname) + 1) * sizeof(WCHAR));
+            if (!name)
+                continue;
+            if (card == def_card && device == def_device)
+                *default_idx = endpoints_info->num;
+            if (kind == OUTPUT_ANALOG && first_analog == ~0u)
+                first_analog = endpoints_info->num;
+            TRACE("output %s: %s\n", devnode, wine_dbgstr_w(name));
+            endpoints_add(endpoints_info, name, strdup(devnode));
+        }
+        free(cardname);
+        snd_ctl_close(ctl);
+    }
+
+    if (*default_idx == ~0u)
+        *default_idx = first_analog != ~0u ? first_analog : 0;
+}
