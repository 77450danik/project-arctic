+    {
+        UnmapViewOfFile( view );
+        CloseHandle( mapping );
+    }
     return shared;
 }
 
@@ -156,13 +166,15 @@ static void prepare_button( struct taskbar_list *list, struct arctic_thumb_butto
     button->id = from->iId;
