+           from->iBitmap, list->image_list, button->has_icon );
 }
 
 /* what the mask names goes into the table's button */
@@ -224,6 +236,7 @@ static ULONG STDMETHODCALLTYPE taskbar_list_Release(ITaskbarList4 *iface)
 
     if (!refcount)
     {
