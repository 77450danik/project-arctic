@@ -6460,6 +6460,7 @@ ULONG_PTR WINAPI NtUserCallHwndParam( HWND hwnd, DWORD_PTR param, DWORD code )
         return set_window_long_internal( hwnd, params->offset, params->size, params->value, FALSE, TRUE );
     }
 
+
     default:
         FIXME( "invalid code %u\n", code );
         return 0;
@@ -6525,6 +6526,31 @@ DWORD WINAPI NtUserDragObject( HWND parent, HWND hwnd, UINT fmt, ULONG_PTR data,
 }
 
 
+/***********************************************************************
+ *           NtUserRegisterShellHookWindow    (win32u.@)
+ *
+ * The shell asks for the messages win32k sends about windows.
+ */
+BOOL WINAPI NtUserRegisterShellHookWindow( HWND hwnd, BOOL register_window )
+{
+    static const WCHAR shell_hookW[] = {'S','H','E','L','L','H','O','O','K'};
+    UNICODE_STRING name = { sizeof(shell_hookW), sizeof(shell_hookW), (WCHAR *)shell_hookW };
+    UINT message = NtUserRegisterWindowMessage( &name );
+    BOOL ret = FALSE;
+
+    TRACE( "hwnd %p, register %u, message %#x\n", hwnd, register_window, message );
+    if (!message) return FALSE;
+
+    SERVER_START_REQ( register_shell_hook_window )
+    {
+        req->window = wine_server_user_handle( hwnd );
+        req->message = register_window ? message : 0;
+        if (!wine_server_call( req )) ret = register_window || reply->previous;
+    }
+    SERVER_END_REQ;
+    return ret;
+}
+
 HWND get_shell_window(void)
 {
     HWND hwnd = 0;
diff --git a/dlls/wow64win/user.c b/dlls/wow64win/user.c
index 92c18775..5a1b3865 100644
