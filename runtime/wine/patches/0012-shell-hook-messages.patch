+++ b/dlls/user32/misc.c
@@ -243,8 +243,8 @@ void WINAPI RegisterSystemThread(DWORD flags, DWORD reserved)
  */
 BOOL WINAPI RegisterShellHookWindow(HWND hWnd)
 {
-    FIXME("(%p): stub\n", hWnd);
-    return FALSE;
+    TRACE("(%p)\n", hWnd);
+    return NtUserRegisterShellHookWindow( hWnd, TRUE );
 }
 
 
@@ -253,8 +253,8 @@ BOOL WINAPI RegisterShellHookWindow(HWND hWnd)
  */
 BOOL WINAPI DeregisterShellHookWindow(HWND hWnd)
 {
-    FIXME("(%p): stub\n", hWnd);
-    return FALSE;
+    TRACE("(%p)\n", hWnd);
+    return NtUserRegisterShellHookWindow( hWnd, FALSE );
 }
 
 
