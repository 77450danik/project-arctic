 dlls/win32u/win32u.spec |  2 +-
 dlls/win32u/window.c    | 26 +++++++++++++
 dlls/wow64win/user.c    |  8 ++++
 include/ntuser.h        |  1 +
 server/protocol.def     |  9 +++++
 server/queue.c          |  2 +
 server/user.h           |  3 ++
 server/window.c         | 83 ++++++++++++++++++++++++++++++++++++++++-
 server/winstation.c     |  2 +
 10 files changed, 137 insertions(+), 7 deletions(-)

