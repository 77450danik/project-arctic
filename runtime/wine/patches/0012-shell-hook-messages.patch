 }
 
+NTSTATUS WINAPI wow64_NtUserRegisterShellHookWindow( UINT *args )
+{
+    HWND hwnd = get_handle( &args );
+    BOOL register_window = get_ulong( &args );
+
+    return NtUserRegisterShellHookWindow( hwnd, register_window );
+}
