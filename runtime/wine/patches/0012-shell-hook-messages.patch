 @REPLY
diff --git a/server/queue.c b/server/queue.c
index b1f367e1..fedcba10 100644
--- a/server/queue.c
+++ b/server/queue.c
@@ -3819,6 +3819,8 @@ DECL_HANDLER(set_foreground_window)
     reply->send_msg_old = (reply->previous && desktop->foreground_input != queue->input);
     set_foreground_input( desktop, thread->process, req->internal || !is_desktop ? thread->queue->input : NULL );
     reply->send_msg_new = (desktop->foreground_input != queue->input);
+    /* the shell follows the active window, as in Windows */
+    shell_hook_notify( desktop, HSHELL_WINDOWACTIVATED, req->handle );
 
 done:
     if (thread) release_object( thread );
diff --git a/server/user.h b/server/user.h
index f1a1f07d..a3c2e725 100644
--- a/server/user.h
+++ b/server/user.h
@@ -76,6 +76,7 @@ struct desktop
     struct window       *taskman_window;   /* taskman window for this desktop */
     struct hook_table   *global_hooks;     /* table of global hooks on this desktop */
     struct list          hotkeys;          /* list of registered hotkeys */
+    struct list          shell_hooks;      /* list of windows that get shell hook messages */
     struct list          pointers;         /* list of active pointers */
     struct timeout_user *close_timeout;    /* timeout before closing the desktop */
     struct thread_input *foreground_input; /* thread input of foreground thread */
@@ -124,6 +125,8 @@ extern void detach_thread_input( struct msg_queue *queue_from, struct msg_queue
 extern void set_clip_rectangle( struct desktop *desktop, const struct rectangle *rect,
                                 unsigned int flags, int reset );
 extern void update_cursor_pos( struct desktop *desktop );
+extern void shell_hook_notify( struct desktop *desktop, unsigned int code, user_handle_t window );
+extern void free_shell_hooks( struct desktop *desktop );
 extern void post_message( user_handle_t win, unsigned int message,
                           lparam_t wparam, lparam_t lparam );
 extern void send_notify_message( user_handle_t win, unsigned int message,
diff --git a/server/window.c b/server/window.c
index 7b3d2726..7d7cd9e3 100644
--- a/server/window.c
+++ b/server/window.c
@@ -1930,6 +1930,41 @@ static struct region *expose_window( struct window *win, const struct rectangle
 
 /* set the window and client rectangles, updating the update region if necessary */
 /* the compositor (dwm.exe) re-reads the toplevel list whenever this serial moves */
+/* a window that asked for shell hook messages (RegisterShellHookWindow) */
+struct shell_hook
+{
+    struct list   entry;
+    user_handle_t window;
+    unsigned int  message;
+};
+
+/* Tells the shell what happened to a window, as win32k does in Windows */
+void shell_hook_notify( struct desktop *desktop, unsigned int code, user_handle_t window )
+{
+    struct shell_hook *hook;
+
+    if (!desktop) return;
+    LIST_FOR_EACH_ENTRY( hook, &desktop->shell_hooks, struct shell_hook, entry )
+        post_message( hook->window, hook->message, code, window );
+}
+
+void free_shell_hooks( struct desktop *desktop )
+{
+    struct shell_hook *hook, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( hook, next, &desktop->shell_hooks, struct shell_hook, entry )
+    {
+        list_remove( &hook->entry );
+        free( hook );
+    }
+}
+
+/* the shell hears about a toplevel window with no owner, as in Windows */
+static int is_shell_hook_window( struct window *win )
+{
+    return win->parent && win->parent == win->desktop->top_window && !win->owner;
+}
+
 static void bump_composition_serial( struct desktop *desktop )
 {
     SHARED_WRITE_BEGIN( desktop->shared, desktop_shm_t )
@@ -1969,8 +2004,18 @@ static void set_window_pos( struct window *win, struct window *previous,
     win->surface_rect = *surface_rect;
     win->client_rect  = *client_rect;
     if (!(swp_flags & SWP_NOZORDER) && win->parent) zorder_changed |= link_window( win, previous );
-    if (swp_flags & SWP_SHOWWINDOW) win->style |= WS_VISIBLE;
-    else if (swp_flags & SWP_HIDEWINDOW) win->style &= ~WS_VISIBLE;
+    if (swp_flags & SWP_SHOWWINDOW)
+    {
+        if (!(win->style & WS_VISIBLE) && is_shell_hook_window( win ))
+            shell_hook_notify( win->desktop, HSHELL_WINDOWCREATED, win->handle );
+        win->style |= WS_VISIBLE;
+    }
+    else if (swp_flags & SWP_HIDEWINDOW)
+    {
+        if ((win->style & WS_VISIBLE) && is_shell_hook_window( win ))
+            shell_hook_notify( win->desktop, HSHELL_WINDOWDESTROYED, win->handle );
+        win->style &= ~WS_VISIBLE;
+    }
     composition_changed( win );
 
     /* update window monitor dpi for toplevel windows */
@@ -2157,6 +2202,8 @@ void free_window_handle( struct window *win )
 
     assert( win->handle );
     composition_changed( win );
+    if (is_visible( win ) && is_shell_hook_window( win ))
+        shell_hook_notify( win->desktop, HSHELL_WINDOWDESTROYED, win->handle );
 
     /* hide the window */
     if (is_visible(win))
@@ -2680,6 +2727,38 @@ DECL_HANDLER(get_window_children_from_point)
 }
 
 
+/* register a window to receive shell hook messages */
+DECL_HANDLER(register_shell_hook_window)
+{
+    struct desktop *desktop = get_thread_desktop( current, 0 );
+    struct shell_hook *hook, *next;
+
+    if (!desktop) return;
+
+    LIST_FOR_EACH_ENTRY_SAFE( hook, next, &desktop->shell_hooks, struct shell_hook, entry )
+    {
+        if (hook->window != req->window) continue;
+        reply->previous = 1;
+        if (req->message) hook->message = req->message;
+        else
+        {
+            list_remove( &hook->entry );
+            free( hook );
+        }
+        release_object( desktop );
+        return;
+    }
+
+    if (req->message && (hook = mem_alloc( sizeof(*hook) )))
+    {
+        hook->window = req->window;
+        hook->message = req->message;
+        list_add_tail( &desktop->shell_hooks, &hook->entry );
+    }
+    release_object( desktop );
+}
+
+
 /* get the toplevel windows of the thread desktop in z-order, for the compositor */
 DECL_HANDLER(get_composition_list)
 {
diff --git a/server/winstation.c b/server/winstation.c
index e2aad1ed..21103a7c 100644
--- a/server/winstation.c
+++ b/server/winstation.c
@@ -286,6 +286,7 @@ static bool desktop_init( struct object *obj, const void *init_data )
     memset( &desktop->key_repeat, 0, sizeof(desktop->key_repeat) );
     list_init( &desktop->threads );
     list_init( &desktop->hotkeys );
+    list_init( &desktop->shell_hooks );
     list_init( &desktop->pointers );
     list_add_tail( &winstation->desktops, &desktop->entry );
 
@@ -368,6 +369,7 @@ static void desktop_destroy( struct object *obj )
     }
 
     free_hotkeys( desktop, 0 );
+    free_shell_hooks( desktop );
     free_pointers( desktop );
     if (desktop->top_window) free_window_handle( desktop->top_window );
     if (desktop->msg_window) free_window_handle( desktop->msg_window );
