+static struct arctic_disk *find_arctic_disk( const char *name )
+{
+    struct arctic_disk *disk;
+
+    LIST_FOR_EACH_ENTRY( disk, &arctic_disks, struct arctic_disk, entry )
+        if (!strcmp( disk->rec.name, name )) return disk;
