+/* a record of /run/arctic/disks */
+NTSTATUS arctic_disk_record( void *args )
+{
+    const struct arctic_disk_record_params *params = args;
+    struct arctic_disk_record *rec = params->record;
+    char path[PATH_MAX], line[256];
+    FILE *f;
+
+    memset( rec, 0, sizeof(*rec) );
+    if (strchr( params->name, '/' ) || strlen( params->name ) >= sizeof(rec->name)) return STATUS_INVALID_PARAMETER;
+    snprintf( path, sizeof(path), DISKS_DIR "/%s", params->name );
+    if (!(f = fopen( path, "r" ))) return STATUS_NOT_FOUND;
+    strcpy( rec->name, params->name );
+    while (fgets( line, sizeof(line), f ))
+    {
+        char *value = strchr( line, '=' );
+
+        if (!value) continue;
+        *value++ = 0;
+        value[strcspn( value, "\n" )] = 0;
+        if (!strcmp( line, "vendor" )) snprintf( rec->vendor, sizeof(rec->vendor), "%s", value );
+        else if (!strcmp( line, "model" )) snprintf( rec->model, sizeof(rec->model), "%s", value );
+        else if (!strcmp( line, "rev" )) snprintf( rec->rev, sizeof(rec->rev), "%s", value );
+        else if (!strcmp( line, "serial" )) snprintf( rec->serial, sizeof(rec->serial), "%s", value );
+        else if (!strcmp( line, "sector" )) rec->sector = strtoul( value, NULL, 10 );
+        else if (!strcmp( line, "sectors" )) rec->sectors = strtoull( value, NULL, 10 );
+        else if (!strcmp( line, "removable" )) rec->removable = !strcmp( value, "1" );
+    }
+    fclose( f );
+    if (!rec->sector) rec->sector = 512;
+    /* sysfs counts the size in 512-byte units whatever the disk's sectors */
+    rec->sectors = rec->sectors * 512 / rec->sector;
+    rec->number = disk_rank( rec->name );
+    return STATUS_SUCCESS;
+}
+
+/* the sectors of the partition tables */
+NTSTATUS arctic_disk_io( void *args )
+{
+    const struct arctic_disk_io_params *params = args;
+    char path[64];
+    ssize_t done;
+    int fd;
+
+    if (strchr( params->name, '/' ) || strlen( params->name ) > 32) return STATUS_INVALID_PARAMETER;
+    snprintf( path, sizeof(path), "/dev/%s", params->name );
+    if ((fd = open( path, (params->write ? O_WRONLY | O_DSYNC : O_RDONLY) | O_CLOEXEC )) == -1)
+        return errno_to_status( errno );
+    if (params->write) done = pwrite( fd, params->buffer, params->size, params->offset );
+    else done = pread( fd, params->buffer, params->size, params->offset );
+    if (done == -1)
+    {
+        NTSTATUS status = errno_to_status( errno );
+
+        close( fd );
+        return status;
+    }
+    close( fd );
+    return done == params->size ? STATUS_SUCCESS : STATUS_END_OF_FILE;
+}
+
+NTSTATUS arctic_disk_command( void *args )
+{
+    const struct arctic_disk_command_params *params = args;
+    struct sockaddr_un addr = { .sun_family = AF_UNIX, .sun_path = DISK_SOCKET };
+    struct timeval limit = { 30, 0 };
+    char line[128], answer[16];
+    ssize_t len;
+    int fd;
+
+    if ((fd = socket( AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0 )) == -1) return errno_to_status( errno );
+    setsockopt( fd, SOL_SOCKET, SO_RCVTIMEO, &limit, sizeof(limit) );
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ))
+    {
+        WARN( "%s: %s\n", DISK_SOCKET, strerror(errno) );
+        close( fd );
+        return STATUS_DEVICE_NOT_READY;
+    }
+    len = snprintf( line, sizeof(line), "%s %s\n", params->command, params->name );
+    if (write( fd, line, len ) != len || (len = read( fd, answer, sizeof(answer) - 1 )) <= 0)
+    {
+        close( fd );
+        return STATUS_IO_TIMEOUT;
+    }
+    close( fd );
+    answer[len] = 0;
+    TRACE( "%s: %s\n", line, answer );
+    if (!strcmp( answer, "ok" )) return STATUS_SUCCESS;
+    if (!strcmp( answer, "busy" )) return STATUS_DEVICE_BUSY;
+    if (!strcmp( answer, "none" )) return STATUS_UNRECOGNIZED_VOLUME;
+    return STATUS_UNSUCCESSFUL;
+}
+
+/* arctic-volume mounts nothing that has a file here: a program has it locked */
+NTSTATUS arctic_hold( void *args )
+{
+    const struct arctic_hold_params *params = args;
+    char path[PATH_MAX];
+    int fd;
+
+    if (strchr( params->name, '/' )) return STATUS_INVALID_PARAMETER;
+    snprintf( path, sizeof(path), HOLD_DIR "/%s", params->name );
+    if (!params->hold)
+    {
+        unlink( path );
+        return STATUS_SUCCESS;
+    }
+    if ((fd = open( path, O_WRONLY | O_CREAT | O_CLOEXEC, 0644 )) == -1) return errno_to_status( errno );
+    close( fd );
+    return STATUS_SUCCESS;
+}
