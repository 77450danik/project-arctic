+/* Arctic: User Account Control. A program whose manifest needs the administrator
+ * asks the Application Information service before it goes on (docs/disks.md).
+ * args: the program's path in UTF-8 */
+static NTSTATUS arctic_consent( void *args )
+{
+    const char *program = args, *name = strrchr( program, '\\' );
+    char session[64] = "", token[64], *path, line[8192];
+    struct sockaddr_in addr;
+    unsigned int port;
+    int fd, i, len, sock = -1;
+    FILE *f;
+
+    if (!(path = malloc( strlen( config_dir ) + 64 ))) return STATUS_NO_MEMORY;
+    sprintf( path, "%s/dosdevices/c:/ProgramData/Arctic/Appinfo/session", config_dir );
+    f = fopen( path, "r" );
+    free( path );
+    if (!f) return STATUS_SUCCESS; /* no such service here: not an installed system */
+    fd = fgets( session, sizeof(session), f ) && sscanf( session, "%u %63s", &port, token ) == 2;
+    fclose( f );
+    if (!fd) return STATUS_ACCESS_DENIED;
+
+    memset( &addr, 0, sizeof(addr) );
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons( port );
+    addr.sin_addr.s_addr = htonl( INADDR_LOOPBACK );
+    /* the service may still be starting */
+    for (i = 0; i < 40 && sock < 0; i++)
+    {
+        if ((sock = socket( AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0 )) < 0) return STATUS_ACCESS_DENIED;
+        if (connect( sock, (struct sockaddr *)&addr, sizeof(addr) ))
+        {
+            close( sock );
+            sock = -1;
+            usleep( 500000 );
+        }
+    }
+    if (sock < 0) return STATUS_ACCESS_DENIED;
+
+    len = snprintf( line, sizeof(line), "%s\nprompt\t0\t%s\t%s\tprogram\n", token, name ? name + 1 : program, program );
+    if (len >= sizeof(line) || write( sock, line, len ) != len)
+    {
+        close( sock );
+        return STATUS_ACCESS_DENIED;
+    }
+    for (i = 0; i < sizeof(line) - 1; i++)
+    {
+        if (read( sock, line + i, 1 ) != 1) break;
+        if (line[i] == '\n') break;
+    }
+    line[i] = 0;
+    if (strncmp( line, "yes", 3 ))
+    {
+        close( sock );
+        return STATUS_CANCELLED;
+    }
+    write( sock, "ok\n", 3 );
+    close( sock );
+    return STATUS_SUCCESS;
+}
