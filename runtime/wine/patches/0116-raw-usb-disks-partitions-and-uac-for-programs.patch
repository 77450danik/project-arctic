+/* a drive letter is the mount manager's to give: "E:\\" for "\\\\?\\Volume{...}\\" */
+static BOOL set_drive_letter( const WCHAR *link, const WCHAR *target )
+{
+    struct
+    {
+        MOUNTMGR_CREATE_POINT_INPUT input;
+        WCHAR names[80];
+    } request;
+    WCHAR *device;
+    DWORD size, link_len, device_len;
+    HANDLE mgr;
+    BOOL ret;
+
+    if (wcsncmp( target, L"\\\\?\\Volume{", 11 ) || wcslen( target ) > 60)
+    {
+        SetLastError( ERROR_INVALID_NAME );
+        return FALSE;
+    }
+    memset( &request, 0, sizeof(request) );
+    swprintf( request.names, ARRAY_SIZE(request.names), L"\\DosDevices\\%c:", link[0] );
+    link_len = lstrlenW( request.names );
+    device = request.names + link_len + 1;
+    lstrcpyW( device, L"\\??\\" );
+    lstrcatW( device, target + 4 );
+    device_len = lstrlenW( device );
+    if (device_len && device[device_len - 1] == '\\') device[--device_len] = 0;
+
+    request.input.SymbolicLinkNameOffset = offsetof( typeof(request), names );
+    request.input.SymbolicLinkNameLength = link_len * sizeof(WCHAR);
+    request.input.DeviceNameOffset = request.input.SymbolicLinkNameOffset + (link_len + 1) * sizeof(WCHAR);
+    request.input.DeviceNameLength = device_len * sizeof(WCHAR);
+
+    mgr = CreateFileW( MOUNTMGR_DOS_DEVICE_NAME, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                       NULL, OPEN_EXISTING, 0, 0 );
+    if (mgr == INVALID_HANDLE_VALUE) return FALSE;
+    ret = DeviceIoControl( mgr, IOCTL_MOUNTMGR_CREATE_POINT, &request, sizeof(request), NULL, 0, &size, NULL );
+    CloseHandle( mgr );
+    return ret;
+}
