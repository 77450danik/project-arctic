+#include "pshpack1.h"
+struct mbr_entry
+{
+    BYTE  boot;
+    BYTE  chs_first[3];
+    BYTE  type;
+    BYTE  chs_last[3];
+    DWORD first;
+    DWORD count;
+};
+
+struct gpt_header
+{
+    char      signature[8];
+    DWORD     revision;
+    DWORD     header_size;
+    DWORD     header_crc;
+    DWORD     reserved;
+    ULONGLONG my_lba;
+    ULONGLONG alternate_lba;
+    ULONGLONG first_usable;
+    ULONGLONG last_usable;
+    GUID      disk_guid;
+    ULONGLONG entries_lba;
+    DWORD     entries_count;
+    DWORD     entry_size;
+    DWORD     entries_crc;
+};
+
+struct gpt_entry
+{
+    GUID      type;
+    GUID      id;
+    ULONGLONG first;
+    ULONGLONG last;
+    ULONGLONG attributes;
+    WCHAR     name[36];
+};
+#include "poppack.h"
+
+#define GPT_ENTRIES 128
+
+static BOOL guid_empty( const GUID *guid )
+{
+    static const GUID zero;
+
+    return !memcmp( guid, &zero, sizeof(zero) );
+}
