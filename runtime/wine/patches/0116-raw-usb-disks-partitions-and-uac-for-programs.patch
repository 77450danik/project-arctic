+
+/* what follows waits for the disk and must not keep the driver's other requests waiting */
+struct arctic_later
+{
+    char command[16];
+    char name[32];
+    int  tries;
+};
+
+static DWORD WINAPI arctic_later_thread( void *arg )
+{
+    struct arctic_later *later = arg;
+    int i;
+
+    for (i = 0; i < later->tries; i++)
+    {
+        if (arctic_command( later->command, later->name ) != STATUS_DEVICE_BUSY) break;
+        Sleep( 300 );
+    }
+    free( later );
+    return 0;
+}
+
+static void arctic_command_later( const char *command, const char *name, int tries )
+{
+    struct arctic_later *later = malloc( sizeof(*later) );
+    HANDLE thread;
+
+    if (!later) return;
+    strcpy( later->command, command );
+    strcpy( later->name, name );
+    later->tries = tries;
+    if ((thread = CreateThread( NULL, 0, arctic_later_thread, later, 0, NULL ))) CloseHandle( thread );
+    else free( later );
+}
+
+/* What a partition table says about where the partitions are: the type, start
+ * and size of the four MBR entries and GPT's header (whose CRC covers its
+ * entries). Boot code and the active flag are not part of it: a program that
+ * writes its MBR leaves the volumes as they are, as on Windows. */
+static DWORD arctic_table_crc( struct arctic_disk *disk )
+{
+    ULONG size = disk->rec.sector * 2, i;
+    BYTE *buf = malloc( size );
+    DWORD crc = 0;
+
+    if (buf && !arctic_read( disk, 0, buf, size ))
+    {
+        BYTE *entry = buf + 0x1be;
+
+        for (i = 0; i < 4; i++, entry += 16)
+        {
+            crc = RtlComputeCrc32( crc, entry + 4, 1 );   /* type */
+            crc = RtlComputeCrc32( crc, entry + 8, 8 );   /* first sector, count */
+        }
+        crc = RtlComputeCrc32( crc, buf + 510, 2 );
+        crc = RtlComputeCrc32( crc, buf + disk->rec.sector, 92 );
+    }
+    free( buf );
+    return crc;
+}
+
+/* the kernel reads the disk's partition table again, once the partitions in use are free */
+static void arctic_rescan( struct arctic_disk *disk )
+{
+    disk->table_crc = arctic_table_crc( disk );
+    if (arctic_command( "rescan", disk->rec.name ) == STATUS_DEVICE_BUSY)
+        arctic_command_later( "rescan", disk->rec.name, 30 );
+}
+
+static BOOL arctic_recognized( BYTE type )
+{
+    switch (type)
+    {
+    case 0x01: case 0x04: case 0x06: case 0x07: case 0x0b: case 0x0c: case 0x0e: case 0x11: case 0x14: case 0x16: case 0x1b: case 0x1c: case 0x1e:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static ULONG layout_size( ULONG count )
+{
+    return FIELD_OFFSET( DRIVE_LAYOUT_INFORMATION_EX, PartitionEntry[count] );
+}
+
+static NTSTATUS arctic_read_layout( struct arctic_disk *disk, DRIVE_LAYOUT_INFORMATION_EX *layout, ULONG max, ULONG *used )
+{
+    ULONG sector = disk->rec.sector, count = 0, i;
+    struct gpt_header *header;
+    struct mbr_entry *mbr;
+    BYTE *buf = NULL, *table = NULL;
+    NTSTATUS status;
+
+    if (max < layout_size( 0 )) return STATUS_BUFFER_TOO_SMALL;
+    if (!(buf = malloc( sector * 2 ))) return STATUS_NO_MEMORY;
+    if ((status = arctic_read( disk, 0, buf, sector * 2 ))) goto done;
+    memset( layout, 0, layout_size( 0 ) );
+    mbr = (struct mbr_entry *)(buf + 0x1be);
+
+    if (buf[510] != 0x55 || buf[511] != 0xaa)
+    {
+        layout->PartitionStyle = PARTITION_STYLE_RAW;
+    }
+    else if (mbr[0].type == 0xee && !memcmp( buf + sector, "EFI PART", 8 ))
+    {
+        struct gpt_entry *entry;
+        ULONG table_size, n = 0;
+
+        header = (struct gpt_header *)(buf + sector);
+        table_size = header->entries_count * header->entry_size;
+        if (header->entry_size < sizeof(*entry) || table_size > 0x100000)
+        {
+            status = STATUS_DISK_CORRUPT_ERROR;
+            goto done;
+        }
+        table_size = (table_size + sector - 1) / sector * sector;
+        if (!(table = malloc( table_size )))
+        {
+            status = STATUS_NO_MEMORY;
+            goto done;
+        }
+        if ((status = arctic_read( disk, header->entries_lba * sector, table, table_size ))) goto done;
+        for (i = 0; i < header->entries_count; i++)
+        {
+            entry = (struct gpt_entry *)(table + i * header->entry_size);
+            if (!guid_empty( &entry->type )) count++;
+        }
+        if (max < layout_size( count ))
+        {
+            *used = layout_size( count );
+            status = STATUS_BUFFER_TOO_SMALL;
+            goto done;
+        }
+        layout->PartitionStyle = PARTITION_STYLE_GPT;
+        layout->Gpt.DiskId = header->disk_guid;
+        layout->Gpt.StartingUsableOffset.QuadPart = header->first_usable * sector;
+        layout->Gpt.UsableLength.QuadPart = (header->last_usable - header->first_usable + 1) * sector;
+        layout->Gpt.MaxPartitionCount = header->entries_count;
+        for (i = 0; i < header->entries_count; i++)
+        {
+            PARTITION_INFORMATION_EX *info = &layout->PartitionEntry[n];
+
+            entry = (struct gpt_entry *)(table + i * header->entry_size);
+            if (guid_empty( &entry->type )) continue;
+            memset( info, 0, sizeof(*info) );
+            info->PartitionStyle = PARTITION_STYLE_GPT;
+            info->StartingOffset.QuadPart = entry->first * sector;
+            info->PartitionLength.QuadPart = (entry->last - entry->first + 1) * sector;
+            info->PartitionNumber = ++n;
+            info->Gpt.PartitionType = entry->type;
+            info->Gpt.PartitionId = entry->id;
+            info->Gpt.Attributes = entry->attributes;
+            memcpy( info->Gpt.Name, entry->name, sizeof(info->Gpt.Name) );
+        }
+    }
+    else
+    {
+        ULONG number = 0;
+
+        count = 4;
+        if (max < layout_size( count ))
+        {
+            *used = layout_size( count );
+            status = STATUS_BUFFER_TOO_SMALL;
+            goto done;
+        }
+        layout->PartitionStyle = PARTITION_STYLE_MBR;
+        layout->Mbr.Signature = *(DWORD *)(buf + 0x1b8);
+        for (i = 0; i < 4; i++)
+        {
+            PARTITION_INFORMATION_EX *info = &layout->PartitionEntry[i];
+
+            memset( info, 0, sizeof(*info) );
+            info->PartitionStyle = PARTITION_STYLE_MBR;
+            if (!mbr[i].type || !mbr[i].count) continue;
+            info->StartingOffset.QuadPart = (ULONGLONG)mbr[i].first * sector;
+            info->PartitionLength.QuadPart = (ULONGLONG)mbr[i].count * sector;
+            info->PartitionNumber = ++number;
+            info->Mbr.PartitionType = mbr[i].type;
+            info->Mbr.BootIndicator = mbr[i].boot == 0x80;
+            info->Mbr.RecognizedPartition = arctic_recognized( mbr[i].type );
+            info->Mbr.HiddenSectors = mbr[i].first;
+        }
+    }
+    layout->PartitionCount = count;
+    *used = layout_size( count );
+
+done:
+    free( table );
+    free( buf );
+    return status;
+}
+
+static void chs_of( ULONGLONG lba, BYTE *chs )
+{
+    ULONG cylinder = lba / (255 * 63);
+
+    if (cylinder >= 1024)
+    {
+        chs[0] = 0xfe;
+        chs[1] = 0xff;
+        chs[2] = 0xff;
+        return;
+    }
+    chs[0] = (lba / 63) % 255;
+    chs[1] = ((lba % 63) + 1) | ((cylinder >> 2) & 0xc0);
+    chs[2] = cylinder & 0xff;
+}
+
+/* the first sector with its boot code kept and a new table */
+static NTSTATUS write_mbr( struct arctic_disk *disk, DWORD signature, const struct mbr_entry *entries )
+{
+    ULONG sector = disk->rec.sector;
+    BYTE *buf = malloc( sector );
+    NTSTATUS status;
+
+    if (!buf) return STATUS_NO_MEMORY;
+    if (!(status = arctic_read( disk, 0, buf, sector )))
+    {
+        *(DWORD *)(buf + 0x1b8) = signature;
+        buf[0x1bc] = buf[0x1bd] = 0;
+        memcpy( buf + 0x1be, entries, 4 * sizeof(*entries) );
+        buf[510] = 0x55;
+        buf[511] = 0xaa;
+        status = arctic_write( disk, 0, buf, sector );
+    }
+    free( buf );
+    return status;
+}
+
+/* the protective MBR, the header and table at the start and again at the end */
+static NTSTATUS write_gpt( struct arctic_disk *disk, const GUID *disk_guid, ULONGLONG first_usable, ULONGLONG last_usable,
+                           const struct gpt_entry *entries )
+{
+    ULONG sector = disk->rec.sector, table_sectors = (GPT_ENTRIES * sizeof(struct gpt_entry) + sector - 1) / sector;
+    ULONGLONG last_lba = disk->rec.sectors - 1;
+    struct mbr_entry protect[4];
+    struct gpt_header *header;
+    NTSTATUS status;
+    BYTE *buf;
+
+    memset( protect, 0, sizeof(protect) );
+    protect[0].type = 0xee;
+    protect[0].chs_first[1] = 2;
+    memset( protect[0].chs_last, 0xff, 3 );
+    protect[0].first = 1;
+    protect[0].count = min( last_lba, 0xffffffffull );
+    if ((status = write_mbr( disk, 0, protect ))) return status;
+
+    if (!(buf = calloc( sector, table_sectors + 1 ))) return STATUS_NO_MEMORY;
+    memcpy( buf + sector, entries, GPT_ENTRIES * sizeof(*entries) );
+    header = (struct gpt_header *)buf;
+    memcpy( header->signature, "EFI PART", 8 );
+    header->revision = 0x00010000;
+    header->header_size = sizeof(*header);
+    header->first_usable = first_usable;
+    header->last_usable = last_usable;
+    header->disk_guid = *disk_guid;
+    header->entries_count = GPT_ENTRIES;
+    header->entry_size = sizeof(struct gpt_entry);
+    header->entries_crc = RtlComputeCrc32( 0, buf + sector, GPT_ENTRIES * sizeof(*entries) );
+
+    /* the copy at the end first: a table with no backup is what a disk cut short looks like */
+    header->my_lba = last_lba;
+    header->alternate_lba = 1;
+    header->entries_lba = last_lba - table_sectors;
+    header->header_crc = 0;
+    header->header_crc = RtlComputeCrc32( 0, buf, sizeof(*header) );
+    if (!(status = arctic_write( disk, header->entries_lba * sector, buf + sector, table_sectors * sector )) &&
+        !(status = arctic_write( disk, last_lba * sector, buf, sector )))
+    {
+        header->my_lba = 1;
+        header->alternate_lba = last_lba;
+        header->entries_lba = 2;
+        header->header_crc = 0;
+        header->header_crc = RtlComputeCrc32( 0, buf, sizeof(*header) );
+        if (!(status = arctic_write( disk, 2 * (ULONGLONG)sector, buf + sector, table_sectors * sector )))
+            status = arctic_write( disk, sector, buf, sector );
+    }
+    free( buf );
+    return status;
+}
+
+static NTSTATUS arctic_write_layout( struct arctic_disk *disk, const DRIVE_LAYOUT_INFORMATION_EX *layout, ULONG size )
+{
+    ULONG sector = disk->rec.sector, i;
+
+    if (size < layout_size( 0 ) || size < layout_size( layout->PartitionCount )) return STATUS_INVALID_PARAMETER;
+
+    if (layout->PartitionStyle == PARTITION_STYLE_MBR)
+    {
+        struct mbr_entry entries[4];
+
+        memset( entries, 0, sizeof(entries) );
+        for (i = 0; i < layout->PartitionCount && i < 4; i++)
+        {
+            const PARTITION_INFORMATION_EX *info = &layout->PartitionEntry[i];
+            ULONGLONG first = info->StartingOffset.QuadPart / sector, count = info->PartitionLength.QuadPart / sector;
+
+            if (!count || !info->Mbr.PartitionType) continue;
+            entries[i].boot = info->Mbr.BootIndicator ? 0x80 : 0;
+            entries[i].type = info->Mbr.PartitionType;
+            entries[i].first = first;
+            entries[i].count = count;
+            chs_of( first, entries[i].chs_first );
+            chs_of( first + count - 1, entries[i].chs_last );
+        }
+        return write_mbr( disk, layout->Mbr.Signature, entries );
+    }
+    if (layout->PartitionStyle == PARTITION_STYLE_GPT)
+    {
+        ULONG table_sectors = (GPT_ENTRIES * sizeof(struct gpt_entry) + sector - 1) / sector, n = 0;
+        ULONGLONG first_usable = 2 + table_sectors, last_usable = disk->rec.sectors - 2 - table_sectors;
+        struct gpt_entry *entries = calloc( GPT_ENTRIES, sizeof(*entries) );
+        NTSTATUS status;
+
+        if (!entries) return STATUS_NO_MEMORY;
+        if (layout->Gpt.StartingUsableOffset.QuadPart) first_usable = layout->Gpt.StartingUsableOffset.QuadPart / sector;
+        if (layout->Gpt.UsableLength.QuadPart)
+            last_usable = first_usable + layout->Gpt.UsableLength.QuadPart / sector - 1;
+        for (i = 0; i < layout->PartitionCount && n < GPT_ENTRIES; i++)
+        {
+            const PARTITION_INFORMATION_EX *info = &layout->PartitionEntry[i];
+
+            if (!info->PartitionLength.QuadPart) continue;
+            entries[n].type = info->Gpt.PartitionType;
+            entries[n].id = info->Gpt.PartitionId;
+            entries[n].first = info->StartingOffset.QuadPart / sector;
+            entries[n].last = entries[n].first + info->PartitionLength.QuadPart / sector - 1;
+            entries[n].attributes = info->Gpt.Attributes;
+            memcpy( entries[n].name, info->Gpt.Name, sizeof(entries[n].name) );
+            n++;
+        }
+        status = write_gpt( disk, &layout->Gpt.DiskId, first_usable, last_usable, entries );
+        free( entries );
+        return status;
+    }
+    return STATUS_INVALID_PARAMETER;
+}
+
+static NTSTATUS arctic_create_disk( struct arctic_disk *disk, const CREATE_DISK *create, ULONG size )
+{
+    ULONG sector = disk->rec.sector;
+
+    if (size < sizeof(*create)) return STATUS_INVALID_PARAMETER;
+    switch (create->PartitionStyle)
+    {
+    case PARTITION_STYLE_MBR:
+    {
+        struct mbr_entry entries[4];
+
+        memset( entries, 0, sizeof(entries) );
+        return write_mbr( disk, create->Mbr.Signature, entries );
+    }
+    case PARTITION_STYLE_GPT:
+    {
+        ULONG table_sectors = (GPT_ENTRIES * sizeof(struct gpt_entry) + sector - 1) / sector;
+        struct gpt_entry *entries = calloc( GPT_ENTRIES, sizeof(*entries) );
+        NTSTATUS status;
+
+        if (!entries) return STATUS_NO_MEMORY;
+        status = write_gpt( disk, &create->Gpt.DiskId, 2 + table_sectors, disk->rec.sectors - 2 - table_sectors, entries );
+        free( entries );
+        return status;
+    }
+    case PARTITION_STYLE_RAW:
+    {
+        /* no table at all: the first sector's signature goes, and GPT's headers */
+        BYTE *buf = calloc( 1, sector * 2 );
+        NTSTATUS status;
+
+        if (!buf) return STATUS_NO_MEMORY;
+        status = arctic_write( disk, 0, buf, sector * 2 );
+        if (!status) status = arctic_write( disk, (disk->rec.sectors - 1) * sector, buf, sector );
+        free( buf );
+        return status;
+    }
+    }
+    return STATUS_INVALID_PARAMETER;
+}
+
+static NTSTATUS output( IRP *irp, const void *data, ULONG size )
+{
+    IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation( irp );
+
+    if (irpsp->Parameters.DeviceIoControl.OutputBufferLength < size) return STATUS_BUFFER_TOO_SMALL;
+    memcpy( irp->AssociatedIrp.SystemBuffer, data, size );
+    irp->IoStatus.Information = size;
+    return STATUS_SUCCESS;
+}
+
+static void fill_geometry( struct arctic_disk *disk, DISK_GEOMETRY *geometry )
+{
+    geometry->BytesPerSector = disk->rec.sector;
+    geometry->SectorsPerTrack = 63;
+    geometry->TracksPerCylinder = 255;
+    geometry->Cylinders.QuadPart = disk->rec.sectors / (255 * 63);
+    geometry->MediaType = disk->rec.removable ? RemovableMedia : FixedMedia;
+}
+
+static NTSTATUS disk_property( struct arctic_disk *disk, IRP *irp )
+{
+    IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation( irp );
+    STORAGE_PROPERTY_QUERY *query = irp->AssociatedIrp.SystemBuffer;
+    ULONG outsize = irpsp->Parameters.DeviceIoControl.OutputBufferLength;
+    STORAGE_DEVICE_DESCRIPTOR *descriptor;
+    ULONG len = sizeof(*descriptor) + strlen( disk->rec.vendor ) + strlen( disk->rec.model ) + strlen( disk->rec.rev ) +
+                strlen( disk->rec.serial ) + 4;
+    char *p;
+
+    if (irpsp->Parameters.DeviceIoControl.InputBufferLength < sizeof(STORAGE_PROPERTY_QUERY))
+        return STATUS_INVALID_PARAMETER;
+    if (query->PropertyId != StorageDeviceProperty) return STATUS_NOT_SUPPORTED;
+    if (query->QueryType == PropertyExistsQuery) return STATUS_SUCCESS;
+    if (query->QueryType != PropertyStandardQuery) return STATUS_NOT_SUPPORTED;
+    if (outsize < sizeof(STORAGE_DESCRIPTOR_HEADER)) return STATUS_INVALID_PARAMETER;
+
+    descriptor = irp->AssociatedIrp.SystemBuffer;
+    if (outsize < len)
+    {
+        memset( descriptor, 0, sizeof(STORAGE_DESCRIPTOR_HEADER) );
+        descriptor->Version = sizeof(STORAGE_DEVICE_DESCRIPTOR);
+        descriptor->Size = len;
+        irp->IoStatus.Information = sizeof(STORAGE_DESCRIPTOR_HEADER);
+        return STATUS_SUCCESS;
+    }
+    memset( descriptor, 0, len );
+    descriptor->Version = sizeof(STORAGE_DEVICE_DESCRIPTOR);
+    descriptor->Size = len;
+    descriptor->DeviceType = 0; /* direct access */
+    descriptor->RemovableMedia = disk->rec.removable;
+    descriptor->BusType = BusTypeUsb;
+    p = (char *)(descriptor + 1);
+    descriptor->VendorIdOffset = p - (char *)descriptor;
+    strcpy( p, disk->rec.vendor );
+    p += strlen( p ) + 1;
+    descriptor->ProductIdOffset = p - (char *)descriptor;
+    strcpy( p, disk->rec.model );
+    p += strlen( p ) + 1;
+    descriptor->ProductRevisionOffset = p - (char *)descriptor;
+    strcpy( p, disk->rec.rev );
+    p += strlen( p ) + 1;
+    descriptor->SerialNumberOffset = p - (char *)descriptor;
+    strcpy( p, disk->rec.serial );
+    irp->IoStatus.Information = len;
+    return STATUS_SUCCESS;
+}
+
+/* the requests of a USB disk and of its volumes; returns FALSE for others */
+static BOOL arctic_ioctl( struct disk_device *dev, IRP *irp, NTSTATUS *status )
+{
+    IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation( irp );
+    ULONG code = irpsp->Parameters.DeviceIoControl.IoControlCode;
+    ULONG insize = irpsp->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG outsize = irpsp->Parameters.DeviceIoControl.OutputBufferLength;
+    void *buffer = irp->AssociatedIrp.SystemBuffer;
+    struct arctic_volume_info vol;
+    struct arctic_disk *disk = dev->arctic;
+    BOOL is_volume = FALSE;
+
+    if (!disk)
+    {
+        if (!get_arctic_info( dev, &vol ) || !vol.managed || !(disk = find_arctic_disk( vol.disk ))) return FALSE;
+        is_volume = TRUE;
+    }
+
+    switch (code)
+    {
+    case IOCTL_DISK_GET_DRIVE_GEOMETRY:
+    {
+        DISK_GEOMETRY geometry;
+
+        fill_geometry( disk, &geometry );
+        *status = output( irp, &geometry, sizeof(geometry) );
+        return TRUE;
+    }
+    case IOCTL_DISK_GET_DRIVE_GEOMETRY_EX:
+    {
+        DISK_GEOMETRY_EX info;
+
+        memset( &info, 0, sizeof(info) );
+        fill_geometry( disk, &info.Geometry );
+        info.DiskSize.QuadPart = is_volume ? vol.length : disk->rec.sectors * disk->rec.sector;
+        *status = output( irp, &info, sizeof(info) );
+        return TRUE;
+    }
+    case IOCTL_DISK_GET_LENGTH_INFO:
+    {
+        GET_LENGTH_INFORMATION info;
+
+        info.Length.QuadPart = is_volume ? vol.length : disk->rec.sectors * disk->rec.sector;
+        *status = output( irp, &info, sizeof(info) );
+        return TRUE;
+    }
+    case IOCTL_DISK_GET_PARTITION_INFO:
+    {
+        PARTITION_INFORMATION info;
+
+        memset( &info, 0, sizeof(info) );
+        info.StartingOffset.QuadPart = is_volume ? vol.offset : 0;
+        info.PartitionLength.QuadPart = is_volume ? vol.length : disk->rec.sectors * disk->rec.sector;
+        info.PartitionNumber = is_volume ? vol.partnum : 0;
+        info.HiddenSectors = info.StartingOffset.QuadPart / disk->rec.sector;
+        info.RecognizedPartition = TRUE;
+        *status = output( irp, &info, sizeof(info) );
+        return TRUE;
+    }
+    case IOCTL_DISK_GET_PARTITION_INFO_EX:
+    {
+        PARTITION_INFORMATION_EX info;
+
+        memset( &info, 0, sizeof(info) );
+        info.PartitionStyle = PARTITION_STYLE_MBR;
+        info.StartingOffset.QuadPart = is_volume ? vol.offset : 0;
+        info.PartitionLength.QuadPart = is_volume ? vol.length : disk->rec.sectors * disk->rec.sector;
+        info.PartitionNumber = is_volume ? vol.partnum : 0;
+        info.Mbr.RecognizedPartition = TRUE;
+        info.Mbr.HiddenSectors = info.StartingOffset.QuadPart / disk->rec.sector;
+        *status = output( irp, &info, sizeof(info) );
+        return TRUE;
+    }
+    case IOCTL_DISK_IS_WRITABLE:
+    case IOCTL_DISK_CHECK_VERIFY:
+    case IOCTL_STORAGE_CHECK_VERIFY:
+    case IOCTL_STORAGE_CHECK_VERIFY2:
+    case IOCTL_DISK_MEDIA_REMOVAL:
+    case IOCTL_STORAGE_MEDIA_REMOVAL:
+        irp->IoStatus.Information = 0;
+        *status = STATUS_SUCCESS;
+        return TRUE;
+
+    case IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS:
+    {
+        VOLUME_DISK_EXTENTS extents;
+
+        if (!is_volume) return FALSE;
+        memset( &extents, 0, sizeof(extents) );
+        extents.NumberOfDiskExtents = 1;
+        extents.Extents[0].DiskNumber = disk->rec.number;
+        extents.Extents[0].StartingOffset.QuadPart = vol.offset;
+        extents.Extents[0].ExtentLength.QuadPart = vol.length;
+        *status = output( irp, &extents, sizeof(extents) );
+        return TRUE;
+    }
+    case IOCTL_STORAGE_GET_DEVICE_NUMBER:
+    {
+        STORAGE_DEVICE_NUMBER number;
+
+        number.DeviceType = FILE_DEVICE_DISK;
+        number.DeviceNumber = disk->rec.number;
+        number.PartitionNumber = is_volume ? vol.partnum : 0;
+        *status = output( irp, &number, sizeof(number) );
+        return TRUE;
+    }
+    case IOCTL_STORAGE_QUERY_PROPERTY:
+        if (is_volume) return FALSE;
+        *status = disk_property( disk, irp );
+        return TRUE;
+
+    case IOCTL_DISK_GET_DRIVE_LAYOUT_EX:
+    {
+        ULONG used = 0;
+
+        if (is_volume) return FALSE;
+        *status = arctic_read_layout( disk, buffer, outsize, &used );
+        irp->IoStatus.Information = *status ? 0 : used;
+        return TRUE;
+    }
+    case IOCTL_DISK_SET_DRIVE_LAYOUT_EX:
+        if (is_volume) return FALSE;
+        if (!(*status = arctic_write_layout( disk, buffer, insize ))) arctic_rescan( disk );
+        return TRUE;
+
+    case IOCTL_DISK_CREATE_DISK:
+        if (is_volume) return FALSE;
+        if (!(*status = arctic_create_disk( disk, buffer, insize ))) arctic_rescan( disk );
+        return TRUE;
+
+    case IOCTL_DISK_DELETE_DRIVE_LAYOUT:
+    {
+        CREATE_DISK raw;
+
+        if (is_volume) return FALSE;
+        memset( &raw, 0, sizeof(raw) );
+        raw.PartitionStyle = PARTITION_STYLE_RAW;
+        if (!(*status = arctic_create_disk( disk, &raw, sizeof(raw) ))) arctic_rescan( disk );
+        return TRUE;
+    }
+    case IOCTL_DISK_UPDATE_PROPERTIES:
+        /* as partmgr does it: partitions that did not change keep their
+         * volumes (Rufus asks after writing its MBR, then installs Syslinux
+         * through the volume's letter) */
+        if (arctic_table_crc( disk ) != disk->table_crc) arctic_rescan( disk );
+        *status = STATUS_SUCCESS;
+        return TRUE;
+
+    case FSCTL_ALLOW_EXTENDED_DASD_IO:
+    case FSCTL_IS_VOLUME_MOUNTED:
+        *status = STATUS_SUCCESS;
+        return TRUE;
+
+    case FSCTL_LOCK_VOLUME:
+    case FSCTL_DISMOUNT_VOLUME:
+    {
+        ULONG_PTR *flags = (ULONG_PTR *)&irpsp->FileObject->FsContext;
+
+        if (is_volume)
+        {
+            /* As Windows: a lock is refused while files are open on the
+             * volume; a dismount takes the file system away regardless */
+            arctic_set_hold( dev->volume->udi, TRUE );
+            *status = arctic_command( code == FSCTL_LOCK_VOLUME ? "lock" : "dismount", dev->volume->udi );
+            if (*status == STATUS_DEVICE_BUSY) *status = STATUS_ACCESS_DENIED;
+            if (*status) arctic_set_hold( dev->volume->udi, FALSE );
+            else *flags |= ARCTIC_HANDLE_HOLDS;
+        }
+        else *status = STATUS_SUCCESS;
+        return TRUE;
+    }
+    case FSCTL_UNLOCK_VOLUME:
+    {
+        ULONG_PTR *flags = (ULONG_PTR *)&irpsp->FileObject->FsContext;
+
+        if (is_volume && (*flags & ARCTIC_HANDLE_HOLDS))
+        {
+            *flags &= ~ARCTIC_HANDLE_HOLDS;
+            arctic_set_hold( dev->volume->udi, FALSE );
+            arctic_command_later( "mount", dev->volume->udi, 1 );
+        }
+        *status = STATUS_SUCCESS;
+        return TRUE;
+    }
+    }
+    return FALSE;
+}
+
+/* who opens a USB disk to write it may change its table with no request at all */
+static void arctic_open( struct disk_device *dev, IRP *irp )
+{
+    IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation( irp );
+
+    if (dev->arctic && irpsp->Parameters.Create.SecurityContext &&
+        (irpsp->Parameters.Create.SecurityContext->DesiredAccess & (FILE_WRITE_DATA | GENERIC_WRITE)))
+        irpsp->FileObject->FsContext = (void *)(ULONG_PTR)ARCTIC_HANDLE_WRITER;
+}
+
+/* the handle that locked a volume is gone: the file system comes back */
+static void arctic_close( struct disk_device *dev, IRP *irp )
+{
+    IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation( irp );
+
+    if (dev->arctic && ((ULONG_PTR)irpsp->FileObject->FsContext & ARCTIC_HANDLE_WRITER))
+    {
+        DWORD crc = arctic_table_crc( dev->arctic );
+
+        if (crc != dev->arctic->table_crc)
+        {
+            dev->arctic->table_crc = crc;
+            arctic_command_later( "rescan", dev->arctic->rec.name, 30 );
+        }
+        return;
+    }
+    if (!((ULONG_PTR)irpsp->FileObject->FsContext & ARCTIC_HANDLE_HOLDS) || !dev->volume || !dev->volume->udi) return;
+    arctic_set_hold( dev->volume->udi, FALSE );
+    arctic_command_later( "mount", dev->volume->udi, 1 );
+}
+
+/* a volume of a USB disk: reads and writes go to its partition, and it has
+ * the name Windows gives a partition */
+static void arctic_setup_volume( struct volume *volume )
+{
+    struct disk_device *dev = volume->device;
+    struct arctic_volume_info info;
+    WCHAR link[64];
+
+    if (!get_arctic_info( dev, &info ) || !info.managed) return;
+    if (!dev->raw)
+    {
+        dev->raw = TRUE;
+        wine_IoSetDeviceUnixPath( dev->dev_obj, dev->unix_device );
+    }
+    if (dev->dos_part.Buffer || !info.partnum) return;
+    swprintf( link, ARRAY_SIZE(link), L"\\??\\Harddisk%uPartition%u", info.disk_number, info.partnum );
+    if (RtlCreateUnicodeString( &dev->dos_part, link ) && IoCreateSymbolicLink( &dev->dos_part, &dev->name ))
+        RtlFreeUnicodeString( &dev->dos_part );
+}
+
+static void id_part( WCHAR *out, const char *in, int size )
+{
+    int i;
+
+    for (i = 0; in[i] && i < size - 1; i++)
+        out[i] = (in[i] <= ' ' || in[i] == '\\' || in[i] == '/' || in[i] == ',' || in[i] == '#') ? '_' : (BYTE)in[i];
+    out[i] = 0;
+}
+
+static HKEY create_volatile_key( const WCHAR *path )
+{
+    const WCHAR *leaf = wcsrchr( path, '\\' );
+    WCHAR parent[512];
+    HKEY root, key = NULL;
+
+    lstrcpynW( parent, path, leaf - path + 1 );
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, parent, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &root, NULL )) return NULL;
+    RegCreateKeyExW( root, leaf + 1, 0, NULL, REG_OPTION_VOLATILE, KEY_ALL_ACCESS, NULL, &key, NULL );
+    RegCloseKey( root );
+    return key;
+}
+
+static void set_string( HKEY key, const WCHAR *name, const WCHAR *value )
+{
+    RegSetValueExW( key, name, 0, REG_SZ, (const BYTE *)value, (lstrlenW( value ) + 1) * sizeof(WCHAR) );
+}
+
+/* what USBSTOR leaves in the registry for a disk: the setup API lists it from there */
+static void register_arctic_disk( struct arctic_disk *disk )
+{
+    WCHAR vendor[64], model[64], rev[16], serial[128], path[512], hardware[512], name[256], *p;
+    static const WCHAR compatible[] = L"USBSTOR\\Disk\0USBSTOR\\RAW\0GenDisk\0";
+    HKEY key, sub;
+
+    id_part( vendor, disk->rec.vendor, ARRAY_SIZE(vendor) );
+    id_part( model, disk->rec.model, ARRAY_SIZE(model) );
+    id_part( rev, disk->rec.rev, ARRAY_SIZE(rev) );
+    id_part( serial, disk->rec.serial[0] ? disk->rec.serial : disk->rec.name, ARRAY_SIZE(serial) );
+    swprintf( disk->instance, ARRAY_SIZE(disk->instance), L"USBSTOR\\Disk&Ven_%s&Prod_%s&Rev_%s\\%s&0", vendor, model, rev, serial );
+
+    swprintf( path, ARRAY_SIZE(path), ENUM_KEY L"%s", disk->instance );
+    if ((key = create_volatile_key( path )))
+    {
+        DWORD capabilities = disk->rec.removable ? 0x14 : 0x10, config = 0;
+        int len;
+
+        swprintf( name, ARRAY_SIZE(name), L"%S %S USB Device", disk->rec.vendor, disk->rec.model );
+        set_string( key, L"FriendlyName", name );
+        set_string( key, L"DeviceDesc", L"Disk drive" );
+        set_string( key, L"Mfg", L"(Standard disk drives)" );
+        set_string( key, L"Class", L"DiskDrive" );
+        set_string( key, L"ClassGUID", L"{4d36e967-e325-11ce-bfc1-08002be10318}" );
+        set_string( key, L"Service", L"disk" );
+        RegSetValueExW( key, L"Capabilities", 0, REG_DWORD, (const BYTE *)&capabilities, sizeof(capabilities) );
+        RegSetValueExW( key, L"ConfigFlags", 0, REG_DWORD, (const BYTE *)&config, sizeof(config) );
+        len = swprintf( hardware, ARRAY_SIZE(hardware), L"USBSTOR\\Disk%s%s%s", vendor, model, rev ) + 1;
+        len += swprintf( hardware + len, ARRAY_SIZE(hardware) - len, L"USBSTOR\\Disk%s%s", vendor, model ) + 1;
+        len += swprintf( hardware + len, ARRAY_SIZE(hardware) - len, L"USBSTOR\\Disk%s", vendor ) + 1;
+        len += swprintf( hardware + len, ARRAY_SIZE(hardware) - len, L"GenDisk" ) + 1;
+        hardware[len++] = 0;
+        RegSetValueExW( key, L"HardwareID", 0, REG_MULTI_SZ, (const BYTE *)hardware, len * sizeof(WCHAR) );
+        RegSetValueExW( key, L"CompatibleIDs", 0, REG_MULTI_SZ, (const BYTE *)compatible, sizeof(compatible) );
+        RegCloseKey( key );
+    }
+
+    /* the interface: ##?#USBSTOR#Disk&...#{guid}\#\Control */
+    swprintf( name, ARRAY_SIZE(name), L"%s", disk->instance );
+    for (p = name; *p; p++) if (*p == '\\') *p = '#';
+    swprintf( disk->iface_key, ARRAY_SIZE(disk->iface_key), CLASSES_KEY L"##?#%s#" DISK_INTERFACE_GUID, name );
+    if ((key = create_volatile_key( disk->iface_key )))
+    {
+        WCHAR link[320];
+
+        set_string( key, L"DeviceInstance", disk->instance );
+        swprintf( link, ARRAY_SIZE(link), L"\\\\?\\%s#" DISK_INTERFACE_GUID, name );
+        if (!RegCreateKeyExW( key, L"#", 0, NULL, REG_OPTION_VOLATILE, KEY_ALL_ACCESS, NULL, &sub, NULL ))
+        {
+            HKEY control;
+            DWORD linked = 1;
+
+            set_string( sub, L"SymbolicLink", link );
+            if (!RegCreateKeyExW( sub, L"Control", 0, NULL, REG_OPTION_VOLATILE, KEY_ALL_ACCESS, NULL, &control, NULL ))
+            {
+                RegSetValueExW( control, L"Linked", 0, REG_DWORD, (const BYTE *)&linked, sizeof(linked) );
+                RegCloseKey( control );
+            }
+            RegCloseKey( sub );
+        }
+        RegCloseKey( key );
+
+        swprintf( link, ARRAY_SIZE(link), L"\\??\\%s#" DISK_INTERFACE_GUID, name );
+        if (RtlCreateUnicodeString( &disk->iface, link ) && IoCreateSymbolicLink( &disk->iface, &disk->device->name ))
+            RtlFreeUnicodeString( &disk->iface );
+    }
+}
+
+static void unregister_arctic_disk( struct arctic_disk *disk )
+{
+    WCHAR path[512];
+
+    if (disk->iface.Buffer)
+    {
+        IoDeleteSymbolicLink( &disk->iface );
+        RtlFreeUnicodeString( &disk->iface );
+    }
+    RegDeleteTreeW( HKEY_LOCAL_MACHINE, disk->iface_key );
+    swprintf( path, ARRAY_SIZE(path), ENUM_KEY L"%s", disk->instance );
+    RegDeleteTreeW( HKEY_LOCAL_MACHINE, path );
+}
+
+void arctic_add_disk( const char *name )
+{
+    struct arctic_disk_record rec;
+    struct arctic_disk_record_params params = { name, &rec };
+    struct arctic_disk *disk;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING dir_name, dev_name;
+    DEVICE_OBJECT *dev_obj;
+    struct disk_device *dev;
+    WCHAR path[64];
+
+    if (MOUNTMGR_CALL( arctic_disk_record, &params )) return;
+
+    EnterCriticalSection( &device_section );
+    if ((disk = find_arctic_disk( name )))
+    {
+        disk->rec = rec; /* a medium changed its size */
+        goto done;
+    }
+    if (!(disk = calloc( 1, sizeof(*disk) ))) goto done;
+    disk->rec = rec;
+
+    swprintf( path, ARRAY_SIZE(path), L"\\Device\\Harddisk%u", rec.number );
+    RtlInitUnicodeString( &dir_name, path );
+    InitializeObjectAttributes( &attr, &dir_name, OBJ_CASE_INSENSITIVE | OBJ_OPENIF, 0, NULL );
+    if (NtCreateDirectoryObject( &disk->dir, DIRECTORY_ALL_ACCESS, &attr ))
+    {
+        WARN( "no directory %s\n", debugstr_w(path) );
+        free( disk );
+        goto done;
+    }
+
+    swprintf( path, ARRAY_SIZE(path), L"\\Device\\Harddisk%u\\DR0", rec.number );
+    if (!RtlCreateUnicodeString( &dev_name, path ) ||
+        IoCreateDevice( disk_driver, sizeof(*dev), &dev_name, FILE_DEVICE_DISK,
+                        FILE_DEVICE_IS_MOUNTED | (rec.removable ? FILE_REMOVABLE_MEDIA : 0), FALSE, &dev_obj ))
+    {
+        WARN( "no device %s\n", debugstr_w(path) );
+        NtClose( disk->dir );
+        free( disk );
+        goto done;
+    }
+
+    dev = dev_obj->DeviceExtension;
+    memset( dev, 0, sizeof(*dev) );
+    dev->dev_obj = dev_obj;
+    dev->name = dev_name;
+    dev->type = DEVICE_HARDDISK;
+    dev->arctic = disk;
+    dev->raw = TRUE;
+    dev->devnum.DeviceType = FILE_DEVICE_DISK;
+    dev->devnum.DeviceNumber = rec.number;
+    disk->device = dev;
+    {
+        char unix_path[64];
+
+        snprintf( unix_path, sizeof(unix_path), "/dev/%s", name );
+        dev->unix_device = strdup( unix_path );
+        wine_IoSetDeviceUnixPath( dev_obj, unix_path );
+    }
+
+    swprintf( path, ARRAY_SIZE(path), L"\\??\\PhysicalDrive%u", rec.number );
+    if (RtlCreateUnicodeString( &dev->symlink, path ) && IoCreateSymbolicLink( &dev->symlink, &dev->name ))
+        RtlFreeUnicodeString( &dev->symlink );
+    swprintf( path, ARRAY_SIZE(path), L"\\Device\\Harddisk%u\\Partition0", rec.number );
+    if (RtlCreateUnicodeString( &disk->part0, path ) && IoCreateSymbolicLink( &disk->part0, &dev->name ))
+        RtlFreeUnicodeString( &disk->part0 );
+
+    register_arctic_disk( disk );
+    disk->table_crc = arctic_table_crc( disk );
+    list_add_tail( &arctic_disks, &disk->entry );
+    TRACE( "%s is disk %u\n", debugstr_a(name), rec.number );
+
+done:
+    LeaveCriticalSection( &device_section );
+}
+
+void arctic_remove_disk( const char *name )
+{
+    struct arctic_disk *disk;
+
+    EnterCriticalSection( &device_section );
+    if ((disk = find_arctic_disk( name )))
+    {
+        list_remove( &disk->entry );
+        unregister_arctic_disk( disk );
+        if (disk->part0.Buffer)
+        {
+            IoDeleteSymbolicLink( &disk->part0 );
+            RtlFreeUnicodeString( &disk->part0 );
+        }
+        disk->device->arctic = NULL;
+        delete_disk_device( disk->device );
+        NtClose( disk->dir );
+        free( disk );
+    }
+    LeaveCriticalSection( &device_section );
+}
+
+static struct volume *find_volume_by_device_name( const WCHAR *name, USHORT len )
+{
+    WCHAR guid_link[64];
+    struct volume *volume;
+
+    LIST_FOR_EACH_ENTRY( volume, &volumes_list, struct volume, entry )
+    {
+        const GUID *guid = &volume->guid;
+
+        if (volume->device->name.Length == len && !wcsnicmp( name, volume->device->name.Buffer, len / sizeof(WCHAR) ))
+            return volume;
+        swprintf( guid_link, ARRAY_SIZE(guid_link), L"\\??\\Volume{%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x}",
+                  guid->Data1, guid->Data2, guid->Data3, guid->Data4[0], guid->Data4[1], guid->Data4[2], guid->Data4[3],
+                  guid->Data4[4], guid->Data4[5], guid->Data4[6], guid->Data4[7] );
+        if (lstrlenW( guid_link ) * sizeof(WCHAR) == len && !wcsnicmp( name, guid_link, len / sizeof(WCHAR) ))
+            return volume;
+    }
+    return NULL;
+}
+
+static int letter_of_link( const WCHAR *link, USHORT len )
+{
+    static const WCHAR prefix[] = L"\\DosDevices\\";
+    int n = ARRAY_SIZE(prefix) - 1;
+    WCHAR c;
+
+    if (len != (n + 2) * sizeof(WCHAR) || wcsnicmp( link, prefix, n ) || link[n + 1] != ':') return -1;
+    c = towupper( link[n] );
+    return c >= 'A' && c <= 'Z' ? c - 'A' : -1;
+}
+
+/* SetVolumeMountPoint: a drive letter for a volume of a USB disk */
+NTSTATUS create_mount_point( void *buff, SIZE_T size )
+{
+    const MOUNTMGR_CREATE_POINT_INPUT *input = buff;
+    struct arctic_volume_info info;
+    struct volume *volume;
+    char udi[64];
+    int letter;
+
+    if (size < sizeof(*input) || input->SymbolicLinkNameOffset + input->SymbolicLinkNameLength > size ||
+        input->DeviceNameOffset + input->DeviceNameLength > size)
+        return STATUS_INVALID_PARAMETER;
+    if ((letter = letter_of_link( (const WCHAR *)((const char *)buff + input->SymbolicLinkNameOffset ),
+                                  input->SymbolicLinkNameLength )) < 0)
+        return STATUS_NOT_SUPPORTED;
+
+    EnterCriticalSection( &device_section );
+    volume = find_volume_by_device_name( (const WCHAR *)((const char *)buff + input->DeviceNameOffset),
+                                         input->DeviceNameLength );
+    if (!volume || !volume->udi || !get_arctic_info( volume->device, &info ) || !info.managed)
+    {
+        LeaveCriticalSection( &device_section );
+        return volume ? STATUS_ACCESS_DENIED : STATUS_OBJECT_NAME_NOT_FOUND;
+    }
+    lstrcpynA( udi, volume->udi, sizeof(udi) );
+    LeaveCriticalSection( &device_section );
+
+    /* no one has mounted it since it was formatted */
+    if (!info.mount[0])
+    {
+        arctic_command( "mount", udi );
+        get_arctic_info( volume->device, &info );
+    }
+
+    EnterCriticalSection( &device_section );
+    {
+        struct dos_drive *drive;
+
+        LIST_FOR_EACH_ENTRY( drive, &drives_list, struct dos_drive, entry )
+            if (drive->drive == letter)
+            {
+                BOOL same = drive->volume == volume;
+
+                LeaveCriticalSection( &device_section );
+                /* Windows says the folder of the letter is not empty */
+                return same ? STATUS_SUCCESS : STATUS_DIRECTORY_NOT_EMPTY;
+            }
+    }
+    LeaveCriticalSection( &device_section );
+
+    return add_dos_device( letter, udi, volume->device->unix_device, info.mount[0] ? info.mount : NULL,
+                           volume->device->type, &volume->guid, NULL, NULL );
+}
+
+/* DeleteVolumeMountPoint: the letter goes, the volume stays */
+NTSTATUS delete_mount_points( void *buff, SIZE_T insize, SIZE_T outsize, IO_STATUS_BLOCK *iosb )
+{
+    const MOUNTMGR_MOUNT_POINT *input = buff;
+    MOUNTMGR_MOUNT_POINTS *output = buff;
+    struct dos_drive *drive;
+    struct arctic_volume_info info;
+    BOOL managed = FALSE, found = FALSE;
