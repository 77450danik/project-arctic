+    X(GetXMLElement) X(GetXMLElementAttribute) X(GetXMLObject) X(LoadLibraryWithPolicyShim) \
+    X(MetaDataGetDispenser) X(OpenCtrs) X(ReOpenMetaDataWithMemoryEx) X(RunDll32ShimW) \
+    X(RuntimeOSHandle) X(RuntimeOpenImage) X(RuntimeReleaseHandle) X(SetTargetForVTableEntry) \
+    X(StrongNameCompareAssemblies) X(StrongNameErrorInfo) X(StrongNameFreeBuffer) \
+    X(StrongNameGetBlob) X(StrongNameGetBlobFromImage) X(StrongNameGetPublicKey) \
+    X(StrongNameHashSize) X(StrongNameKeyDelete) X(StrongNameKeyGen) X(StrongNameKeyGenEx) \
+    X(StrongNameKeyInstall) X(StrongNameSignatureGeneration) X(StrongNameSignatureGenerationEx) \
+    X(StrongNameSignatureSize) X(StrongNameSignatureVerificationFromImage) \
+    X(StrongNameTokenFromAssemblyEx) X(StrongNameTokenFromPublicKey) X(TranslateSecurityAttributes) \
+    X(CorDllMainWorkerForThunk) X(GetCORSystemDirectory_RetAddr) X(IEE) X(LogHelp_LogAssert) \
+    X(LogHelp_NoGuiOnAssert) X(LogHelp_TerminateOnAssert) X(PostErrorVA)
+
+/* where each export jumps: mscoreei's function, or Wine's */
+#define SHIM_POINTER(name) void *shim_to_##name = NULL;
+SHIM_WINE(SHIM_POINTER)
+SHIM_FRAMEWORK(SHIM_POINTER)
+/* Ordinal 24 has no name: the runtime (clr.dll) asks mscoree for it and
+ * calls it as (REFIID, void **) for its interface to the shim. The
+ * ordinals of mscoree.spec are mscoreei's, as Windows' mscoree has them. */
+void *shim_to_ordinal24 = NULL;
+
+/* The exports themselves (mscoree.spec): a jump through the pointer, which
+ * leaves the arguments, the stack and the return address as the caller made
+ * them, whatever the function's signature. */
+#if defined(__x86_64__)
+#define SHIM_THUNK(name) \
+    __ASM_GLOBAL_FUNC( shim_##name, "jmp *" __ASM_NAME("shim_to_" #name) "(%rip)" )
+#elif defined(__i386__)
+#define SHIM_THUNK(name) \
+    __ASM_GLOBAL_FUNC( shim_##name, "jmp *" __ASM_NAME("shim_to_" #name) )
+#else
+#error "mscoree shim: no jump for this architecture"
+#endif
+SHIM_WINE(SHIM_THUNK)
+SHIM_FRAMEWORK(SHIM_THUNK)
+SHIM_THUNK(ordinal24)
+
+/* An export of the Framework called without the Framework: what Wine's
+ * stub did (a program that calls it ends there either way) */
+static void WINAPI shim_missing(void)
+{
+    ERR( "a .NET Framework function was called, but the .NET Framework is not installed\n" );
+    RaiseException( EXCEPTION_WINE_STUB, EXCEPTION_NONCONTINUABLE, 0, NULL );
+}
+
+static HRESULT WINAPI shim_no_ordinal24( REFIID riid, void **obj )
+{
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+/* Ordinal 142, which has no name either: mscoreei asks the shim, from its
+ * own DllMain, for the version of the system as it is, not as the program's
+ * compatibility settings would tell it (an OSVERSIONINFOW). */
+BOOL WINAPI shim_os_version( OSVERSIONINFOW *info )
+{
+    if (!info || info->dwOSVersionInfoSize < sizeof(*info)) return FALSE;
+    return !RtlGetVersion( (RTL_OSVERSIONINFOEXW *)info );
+}
+
+/* what Windows' mscoree tells mscoreei of its DllMain */
+static BOOL (WINAPI *framework_dll_main)( HINSTANCE, DWORD, void * );
+
+/* InstallRoot\v4.0.30319\mscoreei.dll, as Windows' shim finds it: the
+ * registry's own view gives a 32-bit process Framework, a 64-bit one
+ * Framework64. Without the value, where Windows has it. */
+static HMODULE load_framework_shim(void)
+{
+    WCHAR path[MAX_PATH];
+    DWORD size = sizeof(path) - sizeof(L"v4.0.30319\\mscoreei.dll");
+    HMODULE module;
+    HKEY key;
+    LONG ret = ERROR_FILE_NOT_FOUND;
+
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\.NETFramework", 0, KEY_READ, &key ))
+    {
+        ret = RegQueryValueExW( key, L"InstallRoot", NULL, NULL, (BYTE *)path, &size );
+        RegCloseKey( key );
+    }
+    if (!ret && size >= 2 * sizeof(WCHAR))
+        path[size / sizeof(WCHAR) - 1] = 0;
+    else
+    {
+        UINT len = GetSystemWindowsDirectoryW( path, MAX_PATH - 64 );
+        if (!len || len >= MAX_PATH - 64) return NULL;
+        wcscat( path, sizeof(void *) == 8 ? L"\\Microsoft.NET\\Framework64\\" : L"\\Microsoft.NET\\Framework\\" );
+    }
+    if (path[0] && path[wcslen( path ) - 1] != '\\') wcscat( path, L"\\" );
+    wcscat( path, L"v4.0.30319\\mscoreei.dll" );
+    if (GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES) return NULL;
+    if (!(module = LoadLibraryExW( path, NULL, LOAD_WITH_ALTERED_SEARCH_PATH )))
+    {
+        ERR( "%s: error %lu, .NET programs run on Wine's runtime\n", debugstr_w(path), GetLastError() );
+        return NULL;
+    }
+    TRACE( "the .NET Framework's shim is %s\n", debugstr_w(path) );
+    return module;
+}
+
+void shim_dll_main( HINSTANCE instance, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        HMODULE framework = load_framework_shim();
+        void *proc;
+
+#define SHIM_SET_WINE(name) \
+        shim_to_##name = framework && (proc = GetProcAddress( framework, #name )) ? proc : (void *)name;
+#define SHIM_SET_FRAMEWORK(name) \
+        shim_to_##name = framework && (proc = GetProcAddress( framework, #name )) ? proc : (void *)shim_missing;
+        SHIM_WINE(SHIM_SET_WINE)
+        SHIM_FRAMEWORK(SHIM_SET_FRAMEWORK)
+        shim_to_ordinal24 = framework && (proc = GetProcAddress( framework, (const char *)(ULONG_PTR)24 ))
+                            ? proc : (void *)shim_no_ordinal24;
+        if (framework) framework_dll_main = (void *)GetProcAddress( framework, "OnShimDllMainCalled" );
+    }
+    if (framework_dll_main) framework_dll_main( instance, reason, reserved );
+}
