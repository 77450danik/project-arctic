+    X(GetHashFromAssemblyFileW) X(GetHashFromBlob) X(GetHashFromFile) X(GetHashFromFileW) \
+    X(GetHashFromHandle) X(GetHostConfigurationFile) X(GetMetaDataInternalInterface) \
+    X(GetMetaDataInternalInterfaceFromPublic) X(GetMetaDataPublicInterfaceFromInternal) \
+    X(GetPermissionRequests) X(GetPrivateContextsPerfCounters) X(GetProcessExecutableHeap) \
