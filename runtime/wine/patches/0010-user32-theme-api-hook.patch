From a9041b68a56c3731f720d7d8007a880068a6c1b1 Mon Sep 17 00:00:00 2001
From: 77450danik <dnsystems@email.ua>
Date: Sun, 20 Sep 2026 10:03:14 +0300
Subject: [PATCH] user32: Let the visual style draw windows, as in Windows.

A theme fills the user api hook table in its ThemeInitApiHook, and
user32 sends DefWindowProc and the window procedures through it, so the
style draws the frames, the menus and the scroll bars. ReactOS's uxtheme
uses this, and a theme can also register itself by name as in Windows.
---
 dlls/user32/defwnd.c       | 32 +++++++++++--
 dlls/user32/hook.c         | 85 +++++++++++++++++++++++++++++++++
 dlls/user32/uahook.h       | 96 ++++++++++++++++++++++++++++++++++++++
 dlls/user32/user_private.h |  5 ++
 dlls/user32/winproc.c      | 29 +++++++++++-
 5 files changed, 242 insertions(+), 5 deletions(-)
 create mode 100644 dlls/user32/uahook.h

diff --git a/dlls/user32/defwnd.c b/dlls/user32/defwnd.c
index fd45c784..a90f51d1 100644
--- a/dlls/user32/defwnd.c
+++ b/dlls/user32/defwnd.c
@@ -80,11 +80,11 @@ static void default_ime_compositionA( HWND hwnd, WPARAM wparam, LPARAM lparam )
 }
 
 /***********************************************************************
- *              DefWindowProcA (USER32.@)
+ *              USER_DefWindowProcA
  *
- * See DefWindowProcW.
+ * DefWindowProcA without the theme's hook, which the theme itself calls.
  */
-LRESULT WINAPI DefWindowProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam )
+LRESULT WINAPI USER_DefWindowProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam )
 {
     LRESULT result = 0;
     HWND full_handle;
@@ -146,7 +146,7 @@ LRESULT WINAPI DefWindowProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam
  *  RETURNS
  *     Return value is dependent upon the message.
 */
-LRESULT WINAPI DefWindowProcW(
+LRESULT WINAPI USER_DefWindowProcW(
     HWND hwnd,      /* [in] window procedure receiving message */
     UINT msg,       /* [in] message identifier */
     WPARAM wParam,  /* [in] first message parameter */
@@ -198,3 +198,27 @@ LRESULT WINAPI DefWindowProcW(
     SPY_ExitMessage( SPY_RESULT_DEFWND, hwnd, msg, result, wParam, lParam );
     return result;
 }
+
+/***********************************************************************
+ *              DefWindowProcA (USER32.@)
+ */
+LRESULT WINAPI DefWindowProcA( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam )
+{
+    USERAPIHOOK *hook = get_theme_api_hook();
+
+    if (hook && UAH_IS_MESSAGE_HOOKED( hook->DefWndProcArray, msg ))
+        return hook->DefWindowProcA( hwnd, msg, wParam, lParam );
+    return USER_DefWindowProcA( hwnd, msg, wParam, lParam );
+}
+
+/***********************************************************************
+ *              DefWindowProcW (USER32.@)
+ */
+LRESULT WINAPI DefWindowProcW( HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam )
+{
+    USERAPIHOOK *hook = get_theme_api_hook();
+
+    if (hook && UAH_IS_MESSAGE_HOOKED( hook->DefWndProcArray, msg ))
+        return hook->DefWindowProcW( hwnd, msg, wParam, lParam );
+    return USER_DefWindowProcW( hwnd, msg, wParam, lParam );
+}
diff --git a/dlls/user32/hook.c b/dlls/user32/hook.c
index 6961040b..631a5dd6 100644
--- a/dlls/user32/hook.c
+++ b/dlls/user32/hook.c
@@ -541,9 +541,87 @@ BOOL WINAPI IsWinEventHookInstalled(DWORD dwEvent)
     return TRUE;
 }
 
+/**********************************************************************
+ *           The theme's user api hook
+ *
+ * A visual style draws the frames, the menus and the scroll bars of every
+ * window. It gets them through the table it fills in its ThemeInitApiHook,
+ * as in Windows, where the theme is loaded into each process and hooks
+ * DefWindowProc and the window procedures.
+ */
+
+static USERAPIHOOK theme_api;
+static LONG theme_api_state; /* 0: not tried, 1: loading, 2: in use, 3: none */
+
+static BOOL theme_is_active(void)
+{
+    WCHAR value[8];
+    DWORD size = sizeof(value);
+
+    return !RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\ThemeManager",
+                          L"ThemeActive", RRF_RT_REG_SZ, NULL, value, &size ) && !wcscmp( value, L"1" );
+}
+
+static BOOL init_theme_api_hook( const WCHAR *dll_name, const WCHAR *func_name )
+{
+    char name[64];
+    USERAPIHOOKPROC init;
+    HMODULE module;
+
+    if (!(module = LoadLibraryW( dll_name ))) return FALSE;
+    if (!WideCharToMultiByte( CP_ACP, 0, func_name, -1, name, sizeof(name), NULL, NULL )) return FALSE;
+    if (!(init = (USERAPIHOOKPROC)GetProcAddress( module, name ))) return FALSE;
+
+    memset( &theme_api, 0, sizeof(theme_api) );
+    theme_api.size = sizeof(theme_api);
+    theme_api.DefWindowProcA = USER_DefWindowProcA;
+    theme_api.DefWindowProcW = USER_DefWindowProcW;
+    theme_api.GetScrollInfo = GetScrollInfo;
+    theme_api.SetScrollInfo = SetScrollInfo;
+    theme_api.EnableScrollBar = EnableScrollBar;
+    theme_api.AdjustWindowRectEx = AdjustWindowRectEx;
+    theme_api.SetWindowRgn = SetWindowRgn;
+    theme_api.GetSystemMetrics = GetSystemMetrics;
+    theme_api.SystemParametersInfoA = SystemParametersInfoA;
+    theme_api.SystemParametersInfoW = SystemParametersInfoW;
+    theme_api.DrawFrameControl = DrawFrameControl;
+    theme_api.DrawCaption = DrawCaption;
+
+    if (!init( uahLoadInit, &theme_api )) return FALSE;
+    TRACE( "%s draws windows now\n", debugstr_w(dll_name) );
+    return TRUE;
+}
+
+/* the table the theme filled, or NULL while there is none */
+USERAPIHOOK *get_theme_api_hook(void)
+{
+    if (theme_api_state == 2) return &theme_api;
+    if (theme_api_state) return NULL;
+    /* the theme's own windows must not come back through the hook while it loads */
+    if (InterlockedCompareExchange( &theme_api_state, 1, 0 )) return NULL;
+
+    if (theme_is_active() && init_theme_api_hook( L"uxtheme.dll", L"ThemeInitApiHook" ))
+    {
+        InterlockedExchange( &theme_api_state, 2 );
+        return &theme_api;
+    }
+    InterlockedExchange( &theme_api_state, 3 );
+    return NULL;
+}
+
 /* Undocumented RegisterUserApiHook() */
 BOOL WINAPI RegisterUserApiHook(const struct user_api_hook *new_hook, struct user_api_hook *old_hook)
 {
+    const USERAPIHOOKINFO *info = (const USERAPIHOOKINFO *)new_hook;
+
+    /* a theme registers itself by name, as in Windows */
+    if (info && info->m_size == sizeof(*info) && info->m_dllname1 && info->m_funname1)
+    {
+        if (!init_theme_api_hook( info->m_dllname1, info->m_funname1 )) return FALSE;
+        InterlockedExchange( &theme_api_state, 2 );
+        return TRUE;
+    }
+
     if (!new_hook)
         return FALSE;
 
@@ -559,5 +637,12 @@ BOOL WINAPI RegisterUserApiHook(const struct user_api_hook *new_hook, struct use
 /* Undocumented UnregisterUserApiHook() */
 void WINAPI UnregisterUserApiHook(void)
 {
+    if (InterlockedExchange( &theme_api_state, 3 ) == 2)
+    {
+        USERAPIHOOKPROC init = (USERAPIHOOKPROC)GetProcAddress( GetModuleHandleW( L"uxtheme.dll" ),
+                                                                "ThemeInitApiHook" );
+        if (init) init( uahStop, NULL );
+        memset( &theme_api, 0, sizeof(theme_api) );
+    }
     InterlockedExchangePointer((void **)&user_api, &original_user_api);
 }
