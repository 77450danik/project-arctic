diff --git a/dlls/ole32/datacache.c b/dlls/ole32/datacache.c
index 0a7aaf1a..36734743 100644
--- a/dlls/ole32/datacache.c
+++ b/dlls/ole32/datacache.c
@@ -2134,6 +2134,31 @@ static HRESULT WINAPI DataCache_Draw(
           GlobalUnlock( cache_entry->stgmedium.hGlobal );
           return S_OK;
       }
+      case CF_ENHMETAFILE:
+      {
+          RECT rect = { lprcBounds->left, lprcBounds->top, lprcBounds->right, lprcBounds->bottom };
+
+          if (cache_entry->stgmedium.tymed != TYMED_ENHMF || !cache_entry->stgmedium.hEnhMetaFile)
+              continue;
+          PlayEnhMetaFile( hdcDraw, cache_entry->stgmedium.hEnhMetaFile, &rect );
+          return S_OK;
+      }
+      case CF_BITMAP:
+      {
+          BITMAP bm;
+          HGDIOBJ old;
+          HDC mem;
+
+          if (cache_entry->stgmedium.tymed != TYMED_GDI || !cache_entry->stgmedium.hBitmap ||
+              !GetObjectW( cache_entry->stgmedium.hBitmap, sizeof(bm), &bm ) || !(mem = CreateCompatibleDC( hdcDraw )))
+              continue;
+          old = SelectObject( mem, cache_entry->stgmedium.hBitmap );
+          StretchBlt( hdcDraw, lprcBounds->left, lprcBounds->top, lprcBounds->right - lprcBounds->left,
+                      lprcBounds->bottom - lprcBounds->top, mem, 0, 0, bm.bmWidth, bm.bmHeight, SRCCOPY );
+          SelectObject( mem, old );
+          DeleteDC( mem );
+          return S_OK;
+      }
     }
   }
 
