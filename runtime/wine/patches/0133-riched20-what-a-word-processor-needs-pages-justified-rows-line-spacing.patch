+/* a justified row's run: its spaces wider by what the row lacks */
+static inline void run_justification( HDC hdc, const ME_Run *run, BOOL on )
+{
+    if (!run->justify_breaks) return;
+    if (on) SetTextJustification( hdc, run->justify_extra, run->justify_breaks );
+    else SetTextJustification( hdc, 0, 0 );
+}
