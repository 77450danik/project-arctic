+/**********************************************************************
+ *          wayland_surface_ensure_background
+ *
+ * Arctic: a toplevel shown before it has drawn anything shows its class
+ * background, as in Windows, and not nothing: a surface without a buffer is
+ * not on the screen at all, so Chrome's window, active and in front, stayed
+ * invisible for seconds while its GPU process started, and a click on its
+ * taskbar button meant to bring it minimized it. Layered windows keep their
+ * transparency.
+ */
+void wayland_surface_ensure_background(struct wayland_surface *surface)
+{
+    struct wayland_shm_buffer *buffer;
+    int width, height, i;
+    COLORREF color;
+    UINT32 pixel, *bits;
+    ULONG_PTR brush;
+    HRGN damage;
+
+    if (surface->role != WAYLAND_SURFACE_ROLE_TOPLEVEL || !surface->xdg_surface) return;
+    if (!surface->window.visible || surface->content_width || surface->content_height) return;
+    if (NtUserGetWindowLongW(surface->hwnd, GWL_EXSTYLE) & WS_EX_LAYERED) return;
+    width = surface->window.rect.right - surface->window.rect.left;
+    height = surface->window.rect.bottom - surface->window.rect.top;
+    if (width <= 0 || height <= 0) return;
+
+    /* what WM_ERASEBKGND would paint: the class brush, a system colour or a
+     * solid brush; else the colour of a window's background */
+    color = NtUserGetSysColor(COLOR_WINDOW);
+    brush = NtUserGetClassLongPtrW(surface->hwnd, GCLP_HBRBACKGROUND);
+    if (brush && brush <= COLOR_MENUBAR + 1) color = NtUserGetSysColor(brush - 1);
+    else if (brush)
+    {
+        LOGBRUSH logbrush;
+        if (NtGdiExtGetObjectW((HGDIOBJ)brush, sizeof(logbrush), &logbrush) == sizeof(logbrush) &&
+            logbrush.lbStyle == BS_SOLID)
+            color = logbrush.lbColor;
+    }
+    pixel = 0xff000000 | (GetRValue(color) << 16) | (GetGValue(color) << 8) | GetBValue(color);
+
+    if (!(buffer = wayland_shm_buffer_create(width, height, WL_SHM_FORMAT_XRGB8888)))
+    {
+        ERR("Failed to create the background buffer\n");
+        return;
+    }
+    bits = buffer->map_data;
+    for (i = 0; i < width * height; i++) bits[i] = pixel;
+    wl_buffer_add_listener(buffer->wl_buffer, &dummy_buffer_listener, buffer);
+
+    damage = NtGdiCreateRectRgn(0, 0, width, height);
+    if (wayland_surface_reconfigure(surface))
+    {
+        TRACE("hwnd=%p %dx%d background %08x\n", surface->hwnd, width, height, pixel);
+        wayland_surface_attach_shm(surface, buffer, damage);
+        wl_surface_commit(surface->wl_surface);
+        wl_display_flush(process_wayland.wl_display);
+    }
+    wayland_shm_buffer_unref(buffer);
+    if (damage) NtGdiDeleteObjectApp(damage);
+}
+
