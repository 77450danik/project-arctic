+}
+
+static const struct IMemoryBufferFactoryVtbl memory_buffer_factory_vtbl =
+{
+    memory_buffer_factory_QueryInterface,
+    memory_buffer_factory_AddRef,
+    memory_buffer_factory_Release,
+    /* IInspectable methods */
+    memory_buffer_factory_GetIids,
