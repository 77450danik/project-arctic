+/* Arctic: between IBuffer and Windows.Foundation.MemoryBuffer (memorybuffer.c) */
+DEFINE_IINSPECTABLE( buffer_statics, IBufferStatics, struct buffer_factory_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI buffer_statics_CreateCopyFromMemoryBuffer( IBufferStatics *iface, IMemoryBuffer *input, IBuffer **value )
+{
+    IMemoryBufferReference *reference;
+    UINT32 capacity = 0;
+    BYTE *data = NULL;
+    struct buffer *impl;
+    HRESULT hr;
+
+    TRACE( "iface %p, input %p, value %p\n", iface, input, value );
+
+    if (!input || !value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = memory_buffer_bytes( input, &reference, &data, &capacity ))) return hr;
+    if (SUCCEEDED(hr = buffer_factory_statics_Create( NULL, capacity, value )))
+    {
+        impl = impl_from_IBuffer( *value );
+        memcpy( impl->data, data, capacity );
+        impl->length = capacity;
+    }
+    IMemoryBufferReference_Release( reference );
+    return hr;
+}
+
+static HRESULT WINAPI buffer_statics_CreateMemoryBufferOverIBuffer( IBufferStatics *iface, IBuffer *input, IMemoryBuffer **value )
+{
+    IBufferByteAccess *access;
+    UINT32 length = 0;
+    BYTE *data = NULL;
+    HRESULT hr;
+
+    TRACE( "iface %p, input %p, value %p\n", iface, input, value );
+
+    if (!input || !value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = IBuffer_get_Length( input, &length ))) return hr;
+    if (FAILED(hr = IBuffer_QueryInterface( input, &IID_IBufferByteAccess, (void **)&access ))) return hr;
+    hr = IBufferByteAccess_Buffer( access, &data );
+    IBufferByteAccess_Release( access );
+    if (FAILED(hr)) return hr;
+    return memory_buffer_create( data, length, input, value );
+}
+
+static const struct IBufferStaticsVtbl buffer_statics_vtbl =
+{
+    buffer_statics_QueryInterface,
+    buffer_statics_AddRef,
+    buffer_statics_Release,
+    /* IInspectable methods */
+    buffer_statics_GetIids,
+    buffer_statics_GetRuntimeClassName,
+    buffer_statics_GetTrustLevel,
+    /* IBufferStatics methods */
+    buffer_statics_CreateCopyFromMemoryBuffer,
+    buffer_statics_CreateMemoryBufferOverIBuffer,
+};
+
 static struct buffer_factory_statics buffer_factory_statics =
 {
