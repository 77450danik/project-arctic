index ae82a76..3f155c2 100644
--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -699,6 +699,63 @@ NTSTATUS WINAPI NtGdiDdDDIQueryVideoMemoryInfo( D3DKMT_QUERYVIDEOMEMORYINFO *des
     return STATUS_SUCCESS;
 }
 
+static LONG process_priority_class = D3DKMT_SCHEDULINGPRIORITYCLASS_NORMAL;
+
+/* whether the handle names this process */
+static NTSTATUS is_current_process( HANDLE process, BOOL *current )
+{
+    PROCESS_BASIC_INFORMATION info;
+    NTSTATUS status;
+
+    if (process == GetCurrentProcess())
+    {
+        *current = TRUE;
+        return STATUS_SUCCESS;
+    }
+    if ((status = NtQueryInformationProcess( process, ProcessBasicInformation, &info, sizeof(info), NULL )))
+        return status;
+    *current = info.UniqueProcessId == GetCurrentProcessId();
+    return STATUS_SUCCESS;
+}
+
+/******************************************************************************
+ *           NtGdiDdDDIGetProcessSchedulingPriorityClass    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDIGetProcessSchedulingPriorityClass( HANDLE process, D3DKMT_SCHEDULINGPRIORITYCLASS *priority )
+{
+    NTSTATUS status;
+    BOOL current;
+
+    TRACE( "(%p, %p)\n", process, priority );
+
+    if (!priority) return STATUS_INVALID_PARAMETER;
+    if ((status = is_current_process( process, &current ))) return status;
+    if (!current) FIXME( "another process %p: reporting normal\n", process );
+    *priority = current ? ReadNoFence( &process_priority_class ) : D3DKMT_SCHEDULINGPRIORITYCLASS_NORMAL;
+    return STATUS_SUCCESS;
+}
+
+/******************************************************************************
+ *           NtGdiDdDDISetProcessSchedulingPriorityClass    (win32u.@)
+ */
+NTSTATUS WINAPI NtGdiDdDDISetProcessSchedulingPriorityClass( HANDLE process, D3DKMT_SCHEDULINGPRIORITYCLASS priority )
+{
+    NTSTATUS status;
+    BOOL current;
+
+    TRACE( "(%p, %d)\n", process, priority );
+
+    if ((UINT)priority > D3DKMT_SCHEDULINGPRIORITYCLASS_REALTIME) return STATUS_INVALID_PARAMETER;
+    if ((status = is_current_process( process, &current ))) return status;
+    if (!current)
+    {
+        FIXME( "another process %p, class %d: ignored\n", process, priority );
+        return STATUS_SUCCESS;
+    }
+    WriteNoFence( &process_priority_class, priority );
+    return STATUS_SUCCESS;
+}
+
 /******************************************************************************
  *           NtGdiDdDDISetQueuedLimit    (win32u.@)
  */
