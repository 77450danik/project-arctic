From: 77450danik <ddziuba1@stu.vistula.edu.pl>
Date: Sun, 4 Oct 2026 13:20:00 +0200
Subject: [PATCH] server: Replace a linked registry hive whole, next to its target.

On a stick that keeps what is written, the hives live on C:, in
C:\Windows\System32\config, and arctic-init links system.reg, user.reg
and userdef.reg in the prefix (a tmpfs) to them. A hive reached through a
symbolic link used to be truncated and written over in place, so a stick
pulled out mid-save left half a hive. It is now written to a temp file in
the target's own folder, synced, and renamed over the hive: the old one
or the new one, never a broken one.
---
--- a/server/registry.c
+++ b/server/registry.c
@@ -2016,8 +2016,8 @@
 static int save_branch( struct key *key, const char *filename )
 {
     struct stat st;
-    char tmp[32];
-    int fd, count = 0, ret = 0;
+    char tmp[PATH_MAX + 32], target[PATH_MAX];
+    int fd, count = 0, ret = 0, dir_len = 0;
     FILE *f;

     if (!(key->flags & KEY_DIRTY))
@@ -2031,21 +2031,31 @@

     if ((fd = open( filename, O_WRONLY )) != -1)
     {
+        /* Arctic: the hives live on C:, in C:\Windows\System32\config, and
+         * the prefix links to them. A hive there is replaced whole, through a
+         * temp file next to it, so a stick pulled out mid-save leaves the old
+         * one rather than half of the new one. */
+        if (!lstat( filename, &st ) && S_ISLNK(st.st_mode) && realpath( filename, target ))
+        {
+            close( fd );
+            filename = target;
+            if (strrchr( filename, '/' )) dir_len = strrchr( filename, '/' ) - filename + 1;
+        }
         /* if file is not a regular file or has multiple links or is accessed
          * via symbolic links, write directly into it; otherwise use a temp file */
-        if (!lstat( filename, &st ) && (!S_ISREG(st.st_mode) || st.st_nlink > 1))
+        else if (!lstat( filename, &st ) && (!S_ISREG(st.st_mode) || st.st_nlink > 1))
         {
             ftruncate( fd, 0 );
             goto save;
         }
-        close( fd );
+        else close( fd );
     }

     /* create a temp file */

     for (;;)
     {
-        snprintf( tmp, sizeof(tmp), "reg%lx%04x.tmp", (long) getpid(), count++ );
+        snprintf( tmp, sizeof(tmp), "%.*sreg%lx%04x.tmp", dir_len, filename, (long) getpid(), count++ );
         if ((fd = open( tmp, O_CREAT | O_EXCL | O_WRONLY, 0666 )) != -1) break;
         if (errno != EEXIST) goto done;
         close( fd );
@@ -2068,7 +2078,9 @@
     }

     save_all_subkeys( key, f );
-    ret = !fclose(f);
+    /* on the disk before the rename makes it the hive */
+    ret = !fflush( f ) && (!tmp[0] || !fsync( fileno( f ) ));
+    ret = !fclose(f) && ret;

     if (tmp[0])
     {
