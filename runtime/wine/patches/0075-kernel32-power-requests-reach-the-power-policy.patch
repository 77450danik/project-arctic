Subject: [PATCH] kernel32: power requests reach the power policy.

Arctic (docs/power.md): SetThreadExecutionState and PowerSetRequest /
PowerClearRequest keep a slot a process in shared memory that the power
policy in winlogon reads: a video keeps the display on, a download keeps
the machine awake, as in Windows.
---
--- a/dlls/kernel32/powermgnt.c
+++ b/dlls/kernel32/powermgnt.c
@@ -25,6 +25,7 @@
 #include "winreg.h"
 #include "winternl.h"
 #include "kernel_private.h"
+#include "wine/arctic_power.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(powermgnt);
@@ -132,6 +133,44 @@
     return TRUE;
 }
 
+/* Arctic: what the programs of the session asked of the power policy
+ * (winlogon, docs/power.md): a slot of shared memory a process, with the
+ * display and the machine kept on by ES_CONTINUOUS and by power requests,
+ * and when it last said it was busy */
+static struct arctic_execution_state *execution;
+static LONG execution_slot = -1;
+static LONG display_requests, system_requests;
+static EXECUTION_STATE continuous_state;
+
+static BOOL find_slot(void)
+{
+    LONG pid = GetCurrentProcessId();
+    HANDLE map;
+    UINT i;
+
+    if (execution_slot >= 0) return TRUE;
+    if (!execution)
+    {
+        if (!(map = OpenFileMappingW( FILE_MAP_ALL_ACCESS, FALSE, ARCTIC_EXECUTION_STATE_NAME ))) return FALSE;
+        execution = MapViewOfFile( map, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(*execution) );
+        CloseHandle( map );
+        if (!execution) return FALSE;
+    }
+    for (i = 0; i < ARCTIC_EXECUTION_STATE_SLOTS; i++)
+        if (execution->slots[i].pid == pid) return (execution_slot = i) >= 0;
+    for (i = 0; i < ARCTIC_EXECUTION_STATE_SLOTS; i++)
+        if (!InterlockedCompareExchange( &execution->slots[i].pid, pid, 0 )) return (execution_slot = i) >= 0;
+    return FALSE;
+}
+
+static void publish_execution(void)
+{
+    if (!find_slot()) return;
+    execution->slots[execution_slot].display = display_requests + !!(continuous_state & ES_DISPLAY_REQUIRED);
+    execution->slots[execution_slot].system = system_requests +
+        !!(continuous_state & (ES_SYSTEM_REQUIRED | 0x00000040 /* ES_AWAYMODE_REQUIRED */));
+}
+
 /***********************************************************************
  * SetThreadExecutionState (KERNEL32.@)
  *
@@ -144,6 +183,10 @@
 
     NtSetThreadExecutionState(flags, &old);
 
+    if (flags & ES_CONTINUOUS) continuous_state = flags;
+    else if (flags & (ES_DISPLAY_REQUIRED | ES_SYSTEM_REQUIRED) && find_slot())
+        execution->slots[execution_slot].ping = GetTickCount();
+    publish_execution();
     return old;
 }
 
@@ -152,7 +195,7 @@
  */
 HANDLE WINAPI PowerCreateRequest(REASON_CONTEXT *context)
 {
-    FIXME("(%p): stub\n", context);
+    TRACE("(%p)\n", context);
 
     return CreateEventW(NULL, TRUE, FALSE, NULL);
 }
@@ -162,8 +205,11 @@
  */
 BOOL WINAPI PowerSetRequest(HANDLE request, POWER_REQUEST_TYPE type)
 {
-    FIXME("(%p, %u): stub\n", request, type);
+    TRACE("(%p, %u)\n", request, type);
 
+    if (type == PowerRequestDisplayRequired) InterlockedIncrement( &display_requests );
+    else InterlockedIncrement( &system_requests );
+    publish_execution();
     return TRUE;
 }
 
@@ -172,7 +218,11 @@
  */
 BOOL WINAPI PowerClearRequest(HANDLE request, POWER_REQUEST_TYPE type)
 {
-    FIXME("(%p, %u): stub\n", request, type);
+    LONG *count = type == PowerRequestDisplayRequired ? &display_requests : &system_requests;
+
+    TRACE("(%p, %u)\n", request, type);
 
+    if (InterlockedDecrement( count ) < 0) InterlockedIncrement( count );
+    publish_execution();
     return TRUE;
 }
