From: Arctic <arctic@localhost>
Subject: [PATCH] win32u: Menus of the Windows 11 style.

With the visual style's size "Windows 11" a menu has no frame of its own
(dwm rounds and outlines it, and blurs behind its colour, the key), and
the item under the pointer is a rounded box inside its edges, its text in
the menu's colour; its items are taller and wider.
---
diff --git a/dlls/win32u/menu.c b/dlls/win32u/menu.c
--- a/dlls/win32u/menu.c	2026-11-08 16:35:42.297278222 +0100
+++ b/dlls/win32u/menu.c	2026-11-08 16:35:42.301078660 +0100
@@ -2007,6 +2007,8 @@
 }
 
 /* Calculate the size of the menu item and store it in item->rect */
+static BOOL menu_style_11(void);
+
 static void calc_menu_item_size( HDC hdc, struct menu_item *item, HWND owner, INT org_x, INT org_y,
                                  BOOL menu_bar, struct menu *menu )
 {
@@ -2145,6 +2147,12 @@
             }
             item->rect.right += 2 + txt_width;
             item_height = max( item_height, max( txt_height + 2, menucharsize.cy + 4 ));
+            /* Arctic: Windows 11's menus are roomier */
+            if (menu_style_11())
+            {
+                item_height += 10 * get_system_dpi() / 96;
+                item->rect.right += 16 * get_system_dpi() / 96;
+            }
         }
         if (prev_font) NtGdiSelectFont( hdc, prev_font );
     }
@@ -2390,6 +2398,32 @@
 }
 
 /* Draw a single menu item */
+/* Arctic: the visual style's size "Windows 11" (startui's personalize.c) has
+ * Windows 11's menus: dwm rounds them and blurs behind their colour, which
+ * is its key; the item under the pointer is a rounded box inside the edges */
+static BOOL menu_style_11(void)
+{
+    static const WCHAR win11W[] = {'W','i','n','d','o','w','s',' ','1','1',0};
+    static DWORD checked;
+    static BOOL style_11;
+    char buffer[offsetof( KEY_VALUE_PARTIAL_INFORMATION, Data[64] )];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    DWORD now = NtGetTickCount();
+    HKEY key;
+
+    if (checked && now - checked < 1000) return style_11;
+    checked = now ? now : 1;
+    style_11 = FALSE;
+    if ((key = reg_open_hkcu_key( "Software\\Microsoft\\Windows\\CurrentVersion\\ThemeManager" )))
+    {
+        if (query_reg_ascii_value( key, "SizeName", value, sizeof(buffer) ) && value->Type == REG_SZ &&
+            value->DataLength >= sizeof(win11W) && !memcmp( value->Data, win11W, sizeof(win11W) ))
+            style_11 = TRUE;
+        NtClose( key );
+    }
+    return style_11;
+}
+
 static void draw_menu_item( HWND hwnd, struct menu *menu, HWND owner, HDC hdc,
                             struct menu_item *item, BOOL menu_bar, UINT odaction )
 {
@@ -2437,6 +2471,8 @@
         {
             if (item->fState & MF_GRAYED)
                 NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, get_sys_color( COLOR_GRAYTEXT ), NULL );
+            else if (!menu_bar && menu_style_11())
+                NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, get_sys_color( COLOR_MENUTEXT ), NULL );
             else
                 NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, get_sys_color( COLOR_HIGHLIGHTTEXT ), NULL );
             NtGdiGetAndSetDCDword( hdc, NtGdiSetBkColor, get_sys_color( COLOR_HIGHLIGHT ), NULL );
@@ -2505,7 +2541,20 @@
 
     if (menu_bar && (item->fType & MF_SEPARATOR)) goto done;
 
-    if (item->fState & MF_HILITE)
+    if ((item->fState & MF_HILITE) && !menu_bar && menu_style_11())
+    {
+        UINT dpi = get_system_dpi();
+        int inset = 3 * dpi / 96, round = 8 * dpi / 96;
+        HPEN old_pen = NtGdiSelectPen( hdc, GetStockObject( NULL_PEN ));
+        HBRUSH old_brush;
+
+        fill_rect( hdc, &rect, get_sys_color_brush( bkgnd ));
+        old_brush = NtGdiSelectBrush( hdc, get_sys_color_brush( COLOR_MENUHILIGHT ));
+        NtGdiRoundRect( hdc, rect.left + inset, rect.top + 1, rect.right - inset + 1, rect.bottom, round, round );
+        NtGdiSelectBrush( hdc, old_brush );
+        NtGdiSelectPen( hdc, old_pen );
+    }
+    else if (item->fState & MF_HILITE)
     {
         if (flat_menu)
         {
@@ -2881,7 +2930,9 @@
             BOOL flat_menu = FALSE;
 
             NtUserSystemParametersInfo( SPI_GETFLATMENU, 0, &flat_menu, 0 );
-            if (flat_menu)
+            if (menu_style_11())
+                frame_rect( hdc, &rect, brush );
+            else if (flat_menu)
                 frame_rect( hdc, &rect, get_sys_color_brush( COLOR_BTNSHADOW ));
             else
                 draw_rect_edge( hdc, &rect, EDGE_RAISED, BF_RECT, 1 );
@@ -2979,6 +3030,7 @@
 static void calc_popup_menu_size( struct menu *menu, UINT max_height )
 {
     BOOL textandbmp = FALSE, multi_col = FALSE;
+    int margin;
     int org_x, org_y, max_tab, max_tab_width;
     struct menu_item *item;
     UINT start, i;
@@ -3044,10 +3096,11 @@
 
     menu->nTotalHeight = menu->items_rect.bottom;
 
-    /* space for the border */
-    OffsetRect( &menu->items_rect, MENU_MARGIN, MENU_MARGIN );
-    menu->Height = menu->items_rect.bottom + MENU_MARGIN;
-    menu->Width = menu->items_rect.right + MENU_MARGIN;
+    /* space for the border; Arctic: more of it in Windows 11's menus */
+    margin = menu_style_11() ? 4 * get_system_dpi() / 96 : MENU_MARGIN;
+    OffsetRect( &menu->items_rect, margin, margin );
+    menu->Height = menu->items_rect.bottom + margin;
+    menu->Width = menu->items_rect.right + margin;
 
     /* Adjust popup height if it exceeds maximum */
     if (menu->Height >= max_height)
