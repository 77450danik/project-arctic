From 89301f36666ecabf8ddee562c6af2756d75d1672 Mon Sep 17 00:00:00 2001
From: 77450danik <dnsystems@email.ua>
Date: Tue, 29 Sep 2026 12:39:45 +0300
Subject: [PATCH] user32: GetPointerDevice

Electron programs and Chromium delay-load it; a missing export ends
them the first time pen or touch input is looked at. With no pointer
devices to describe, it fails as for an unknown device.
---
 dlls/user32/misc.c      | 13 +++++++++++++
 dlls/user32/user32.spec |  2 +-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/dlls/user32/misc.c b/dlls/user32/misc.c
index f65ae56..ca252df 100644
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -467,6 +467,19 @@ BOOL WINAPI RegisterPointerDeviceNotifications(HWND hwnd, BOOL notifyrange)
     return TRUE;
 }
 
+/**********************************************************************
+ * GetPointerDevice [USER32.@]
+ *
+ * Chromium links to it for pens and touch screens, which this user32 does not
+ * report as pointer devices: there is no device to describe.
+ */
+BOOL WINAPI GetPointerDevice(HANDLE device, POINTER_DEVICE_INFO *info)
+{
+    FIXME("(%p, %p): stub\n", device, info);
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
 /**********************************************************************
  * GetPointerDevices [USER32.@]
  */
diff --git a/dlls/user32/user32.spec b/dlls/user32/user32.spec
index b934cce..d2d779c 100644
--- a/dlls/user32/user32.spec
+++ b/dlls/user32/user32.spec
@@ -625,7 +625,7 @@
 @ stdcall GetParent(long)
 @ stdcall GetPhysicalCursorPos(ptr)
 # @ stub GetPointerCursorId
-# @ stub GetPointerDevice
+@ stdcall GetPointerDevice(ptr ptr)
 # @ stub GetPointerDeviceCursors
 # @ stub GetPointerDeviceInputSpace
 # @ stub GetPointerDeviceOrientation
-- 
2.55.0

