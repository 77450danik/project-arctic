+/* the process and thread that own a user object, for objects of another process */
+BOOL get_user_handle_owner( HANDLE handle, unsigned short type, DWORD *pid, DWORD *tid )
+{
+    struct user_entry entry;
+    BOOL ret;
+
+    user_lock();
+    ret = get_user_entry( handle, type, &entry, &handle );
+    user_unlock();
+    if (!ret) return FALSE;
+    *pid = entry.pid;
+    *tid = entry.tid;
+    return TRUE;
