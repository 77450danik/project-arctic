+/* The taskbar lives in explorer.exe: what a program puts on its button goes
+ * into the table it reads (wine/arctic_taskbar.h), and the taskbar is told. */
+
+static struct arctic_taskbar_shared *get_shared(void)
+{
+    static struct arctic_taskbar_shared *shared;
+    struct arctic_taskbar_shared *view;
+    HANDLE mapping;
+
+    if (shared) return shared;
+    if (!(mapping = CreateFileMappingW( INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, sizeof(*view),
+                                        ARCTIC_TASKBAR_SECTION )))
+        return NULL;
+    view = MapViewOfFile( mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, sizeof(*view) );
+    CloseHandle( mapping );
+    if (!view) return NULL;
+    /* the first one to map it sets it up */
+    InterlockedCompareExchange( (LONG *)&view->version, ARCTIC_TASKBAR_VERSION, 0 );
+    if (view->version != ARCTIC_TASKBAR_VERSION)
+    {
+        UnmapViewOfFile( view );
+        return NULL;
+    }
+    if (InterlockedCompareExchangePointer( (void **)&shared, view, NULL )) UnmapViewOfFile( view );
+    return shared;
+}
+
+static void lock_shared( struct arctic_taskbar_shared *shared )
+{
+    DWORD start = GetTickCount();
+
+    while (InterlockedCompareExchange( &shared->lock, 1, 0 ))
+    {
+        if (GetTickCount() - start > 200) InterlockedExchange( &shared->lock, 0 );  /* a process died holding it */
+        YieldProcessor();
+    }
+}
+
+static void unlock_shared( struct arctic_taskbar_shared *shared )
+{
+    InterlockedIncrement( &shared->serial );
+    InterlockedExchange( &shared->lock, 0 );
+}
+
+/* the row of a window, a new one if it has none */
+static struct arctic_taskbar_window *window_row( struct arctic_taskbar_shared *shared, HWND hwnd )
+{
+    struct arctic_taskbar_window *row, *spare = NULL;
+
+    for (UINT i = 0; i < ARCTIC_TASKBAR_WINDOWS; i++)
+    {
+        row = &shared->windows[i];
+        if (row->hwnd == HandleToULong( hwnd )) return row;
+        if (!spare && (!row->hwnd || !IsWindow( ULongToHandle( row->hwnd ) ))) spare = row;
+    }
+    if (!spare) return NULL;
+    memset( spare, 0, sizeof(*spare) );
+    spare->hwnd = HandleToULong( hwnd );
+    spare->process = GetCurrentProcessId();
+    return spare;
+}
+
+/* the taskbar's task list repaints the window's button */
+static void notify_taskbar( HWND hwnd, const WCHAR *message, LPARAM lparam )
+{
+    HWND tray = FindWindowW( L"Shell_TrayWnd", NULL ), rebar, tasks;
+
+    if (!tray || !(rebar = FindWindowExW( tray, NULL, L"ReBarWindow32", NULL ))) return;
+    if (!(tasks = FindWindowExW( rebar, NULL, L"MSTaskSwWClass", NULL ))) return;
+    PostMessageW( tasks, RegisterWindowMessageW( message ), (WPARAM)hwnd, lparam );
+}
+
+/* an icon as premultiplied ARGB pixels: drawn over black and over white,
+ * which tells alpha apart from black for icons that carry none */
+static BOOL icon_pixels( HICON icon, UINT32 *pixels )
+{
+    BITMAPINFO info = {{ sizeof(info.bmiHeader), ARCTIC_TASKBAR_ICON, -ARCTIC_TASKBAR_ICON, 1, 32, BI_RGB }};
+    const UINT count = ARCTIC_TASKBAR_ICON * ARCTIC_TASKBAR_ICON;
+    UINT32 *black, *white;
+    HBITMAP black_bitmap, white_bitmap;
+    BOOL has_alpha = FALSE;
+    HDC hdc;
+
+    if (!icon) return FALSE;
+    hdc = CreateCompatibleDC( 0 );
+    black_bitmap = CreateDIBSection( hdc, &info, DIB_RGB_COLORS, (void **)&black, NULL, 0 );
+    white_bitmap = CreateDIBSection( hdc, &info, DIB_RGB_COLORS, (void **)&white, NULL, 0 );
+    if (!black_bitmap || !white_bitmap)
+    {
+        if (black_bitmap) DeleteObject( black_bitmap );
+        if (white_bitmap) DeleteObject( white_bitmap );
+        DeleteDC( hdc );
+        return FALSE;
+    }
+    memset( black, 0, count * 4 );
+    for (UINT i = 0; i < count; i++) white[i] = 0x00ffffff;
+    SelectObject( hdc, black_bitmap );
+    DrawIconEx( hdc, 0, 0, icon, ARCTIC_TASKBAR_ICON, ARCTIC_TASKBAR_ICON, 0, NULL, DI_NORMAL );
+    SelectObject( hdc, white_bitmap );
+    DrawIconEx( hdc, 0, 0, icon, ARCTIC_TASKBAR_ICON, ARCTIC_TASKBAR_ICON, 0, NULL, DI_NORMAL );
+    GdiFlush();
+
+    for (UINT i = 0; i < count && !has_alpha; i++) has_alpha = (black[i] >> 24) != 0;
+    for (UINT i = 0; i < count; i++)
+    {
+        UINT32 a;
+
+        if (has_alpha) a = black[i] >> 24;
+        else a = 255 - min( 255, ((white[i] >> 8) & 0xff) - ((black[i] >> 8) & 0xff) );
+        pixels[i] = (a << 24) | (black[i] & 0xffffff);
+    }
+    DeleteObject( black_bitmap );
+    DeleteObject( white_bitmap );
+    DeleteDC( hdc );
+    return TRUE;
+}
+
+/* a button's new state, made before the table is locked: drawing an icon may take a while */
+static void prepare_button( struct taskbar_list *list, struct arctic_thumb_button *button, const THUMBBUTTON *from )
+{
+    memset( button, 0, sizeof(*button) );
+    button->id = from->iId;
+    if (from->dwMask & THB_FLAGS) button->flags = from->dwFlags;
+    if (from->dwMask & THB_TOOLTIP) lstrcpynW( button->tip, from->szTip, ARRAY_SIZE(button->tip) );
+    if (from->dwMask & THB_ICON) button->has_icon = icon_pixels( from->hIcon, button->icon );
+    else if ((from->dwMask & THB_BITMAP) && list->image_list)
+    {
+        HICON icon = ImageList_GetIcon( list->image_list, from->iBitmap, ILD_NORMAL );
+        button->has_icon = icon_pixels( icon, button->icon );
+        if (icon) DestroyIcon( icon );
+    }
+}
+
+/* what the mask names goes into the table's button */
+static void merge_button( struct arctic_thumb_button *button, const struct arctic_thumb_button *from, DWORD mask )
+{
+    if (mask & THB_FLAGS) button->flags = from->flags;
+    if (mask & THB_TOOLTIP) memcpy( button->tip, from->tip, sizeof(button->tip) );
+    if (mask & (THB_ICON | THB_BITMAP))
+    {
+        button->has_icon = from->has_icon;
+        memcpy( button->icon, from->icon, sizeof(button->icon) );
+    }
+}
