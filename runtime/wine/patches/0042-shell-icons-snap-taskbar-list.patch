diff --git a/dlls/win32u/cursoricon.c b/dlls/win32u/cursoricon.c
index b7bb811..4ce7793 100644
--- a/dlls/win32u/cursoricon.c
+++ b/dlls/win32u/cursoricon.c
@@ -29,6 +29,7 @@
 #endif
 
 #include <assert.h>
+#include <pthread.h>
 #include "ntgdi_private.h"
 #include "ntuser_private.h"
 #include "wine/server.h"
@@ -63,15 +64,209 @@ struct cursoricon_object
 
 static struct list icon_cache = LIST_INIT( icon_cache );
 
+/* An icon of another process. As in Windows, where icons are shared, a
+ * shell draws the icons of other programs' windows (WM_GETICON, the class
+ * icon): the pixels of the icon's first frame come from the thread that owns
+ * it (WM_WINE_GETICONBITS), into an icon of our own that stands in for it. */
+
+struct icon_bits
+{
+    UINT   width, height;
+    UINT   is_icon;
+    INT    hotspot_x, hotspot_y;
+    UINT   reserved;
+    UINT32 pixels[];                  /* straight ARGB, top row first */
+};
+
+C_ASSERT( sizeof(struct icon_bits) == 6 * sizeof(UINT) );
+
+#define FOREIGN_ICON_CACHE 128
+
+static pthread_mutex_t foreign_icon_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct { HICON foreign, local; } foreign_icons[FOREIGN_ICON_CACHE];
+static unsigned int foreign_icon_next;
+
+static HBITMAP bitmap_from_rows( UINT width, UINT height, UINT bpp, const void *rows )
+{
+    return NtGdiCreateBitmap( width, height, 1, bpp, rows );
+}
+
+static HICON icon_from_bits( const struct icon_bits *bits )
+{
+    UINT width = bits->width, height = bits->height, mask_stride = (width + 15) / 16 * 2;
+    struct cursoricon_frame frame = { width, height };
+    struct cursoricon_desc desc = { .num_frames = 1, .frames = &frame };
+    UINT32 *premultiplied;
+    BYTE *mask;
+    HICON icon;
+
+    if (!(premultiplied = malloc( width * height * 4 ))) return 0;
+    if (!(mask = calloc( height, mask_stride )))
+    {
+        free( premultiplied );
+        return 0;
+    }
+    for (UINT i = 0; i < width * height; i++)
+    {
+        UINT32 p = bits->pixels[i], a = p >> 24;
+
+        premultiplied[i] = (a << 24) | ((((p >> 16) & 0xff) * a / 255) << 16) |
+                           ((((p >> 8) & 0xff) * a / 255) << 8) | ((p & 0xff) * a / 255);
+        if (a < 128) mask[(i / width) * mask_stride + (i % width) / 8] |= 0x80 >> (i % 8);
+    }
+    frame.hotspot.x = bits->hotspot_x;
+    frame.hotspot.y = bits->hotspot_y;
+    frame.color = bitmap_from_rows( width, height, 32, bits->pixels );
+    frame.alpha = bitmap_from_rows( width, height, 32, premultiplied );
+    frame.mask = bitmap_from_rows( width, height, 1, mask );
+    free( premultiplied );
+    free( mask );
+
+    if (!frame.color || !frame.alpha || !frame.mask || !(icon = alloc_cursoricon_handle( bits->is_icon )) ||
+        !NtUserSetCursorIconData( icon, NULL, NULL, &desc ))
+    {
+        if (frame.color) NtGdiDeleteObjectApp( frame.color );
+        if (frame.alpha) NtGdiDeleteObjectApp( frame.alpha );
+        if (frame.mask) NtGdiDeleteObjectApp( frame.mask );
+        return 0;
+    }
+    return icon;
+}
+
+/* a copy of an icon of another process, 0 if its owner does not give it */
+static HICON copy_foreign_icon( HICON handle )
+{
+    struct icon_bits *bits;
+    DWORD pid, tid;
+    DWORD_PTR size = 0;
+    HICON local = 0;
+    unsigned int i;
+
+    pthread_mutex_lock( &foreign_icon_lock );
+    for (i = 0; i < FOREIGN_ICON_CACHE; i++)
+    {
+        if (foreign_icons[i].foreign != handle) continue;
+        local = foreign_icons[i].local;
+        pthread_mutex_unlock( &foreign_icon_lock );
+        return local;
+    }
+    pthread_mutex_unlock( &foreign_icon_lock );
+
+    if (!get_user_handle_owner( handle, NTUSER_OBJ_ICON, &pid, &tid )) return 0;
+    if (!(bits = malloc( WINE_ICON_BITS_SIZE ))) return 0;
+    if (send_internal_message_timeout( pid, tid, WM_WINE_GETICONBITS, (WPARAM)handle, (LPARAM)bits,
+                                       SMTO_ABORTIFHUNG, 500, &size ) &&
+        size >= sizeof(*bits) && bits->width && bits->height && bits->width <= WINE_ICON_BITS_MAX &&
+        bits->height <= WINE_ICON_BITS_MAX && size >= sizeof(*bits) + bits->width * bits->height * 4)
+        local = icon_from_bits( bits );
+    else WARN( "icon %p of process %04x: its pixels did not come\n", handle, pid );
+    free( bits );
+
+    /* a failure is kept too: the owner is not asked again and again */
+    pthread_mutex_lock( &foreign_icon_lock );
+    i = foreign_icon_next++ % FOREIGN_ICON_CACHE;
+    if (foreign_icons[i].local) NtUserDestroyCursor( foreign_icons[i].local, 0 );
+    foreign_icons[i].foreign = handle;
+    foreign_icons[i].local = local;
+    pthread_mutex_unlock( &foreign_icon_lock );
+    return local;
+}
+
 static struct cursoricon_object *get_icon_ptr( HICON handle )
 {
     struct cursoricon_object *obj = get_user_handle_ptr( handle, NTUSER_OBJ_ICON );
-    if (obj == OBJ_OTHER_PROCESS)
+    HICON local;
+
+    if (obj != OBJ_OTHER_PROCESS) return obj;
+    if (!(local = copy_foreign_icon( handle ))) return NULL;
+    obj = get_user_handle_ptr( local, NTUSER_OBJ_ICON );
+    return obj == OBJ_OTHER_PROCESS ? NULL : obj;
+}
+
+/* the answer to WM_WINE_GETICONBITS: the first frame of one of our icons */
+LRESULT get_icon_bits( HICON handle, void *buffer, size_t size )
+{
+    struct icon_bits *bits = buffer;
+    struct cursoricon_object *obj;
+    struct cursoricon_frame frame;
+    BITMAPINFO info = {{ sizeof(info.bmiHeader) }};
+    char mask_buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[2] )];
+    BITMAPINFO *mask_info = (BITMAPINFO *)mask_buffer;
+    UINT width, height, mask_stride;
