+/* Aero Snap: the compositor shows where a dragged window would go */
+static void set_snap_preview( HWND hwnd, const RECT *rect )
+{
+    SERVER_START_REQ( set_snap_preview )
+    {
+        req->handle = rect ? wine_server_user_handle( hwnd ) : 0;
+        if (rect)
+        {
+            req->rect.left   = rect->left;
+            req->rect.top    = rect->top;
+            req->rect.right  = rect->right;
+            req->rect.bottom = rect->bottom;
+        }
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+}
+
+enum snap
+{
+    SNAP_NONE,
+    SNAP_MAXIMIZE,     /* the pointer at the top of a monitor */
+    SNAP_LEFT,         /* at the left edge of the screen: the left half of the monitor */
+    SNAP_RIGHT,
+};
+
+/* where a window dragged by its caption goes if it is let go with the
+ * pointer at pt, as Windows does it */
+static enum snap snap_target( POINT pt, UINT style, RECT *target )
+{
+    RECT virtual = get_virtual_screen_rect( get_thread_dpi(), MDT_DEFAULT ), rect;
+    MONITORINFO info;
+
+    SetRect( &rect, pt.x, pt.y, pt.x + 1, pt.y + 1 );
+    info = monitor_info_from_rect( rect, get_thread_dpi() );
+    if (pt.y <= info.rcMonitor.top && (style & WS_MAXIMIZEBOX))
+    {
+        *target = info.rcWork;
+        return SNAP_MAXIMIZE;
+    }
+    if (!(style & WS_THICKFRAME)) return SNAP_NONE;
+    if (pt.x <= virtual.left)
+    {
+        *target = info.rcWork;
+        target->right = (info.rcWork.left + info.rcWork.right) / 2;
+        return SNAP_LEFT;
+    }
+    if (pt.x >= virtual.right - 1)
+    {
+        *target = info.rcWork;
+        target->left = (info.rcWork.left + info.rcWork.right) / 2;
+        return SNAP_RIGHT;
+    }
+    return SNAP_NONE;
+}
+
+/* a rectangle in screen coordinates as WINDOWPLACEMENT has it: relative to the work area */
+static RECT to_workspace( RECT rect )
+{
+    MONITORINFO info = monitor_info_from_rect( rect, get_thread_dpi() );
+
+    OffsetRect( &rect, info.rcMonitor.left - info.rcWork.left, info.rcMonitor.top - info.rcWork.top );
+    return rect;
+}
+
+/* A maximized window dragged by its caption comes out of the maximized
+ * state once the pointer has moved, at its restored size, under the pointer
+ * at the same place along its caption. FALSE if the button was let go first. */
+static BOOL restore_to_drag( HWND hwnd, POINT *pt )
+{
+    WINDOWPLACEMENT placement = { sizeof(placement) };
+    int drag_x = get_system_metrics( SM_CXDRAG ), drag_y = get_system_metrics( SM_CYDRAG );
+    int width, height, left, top;
+    POINT start = *pt;
+    RECT max_rect;
+    MSG msg;
+
+    set_capture_window( hwnd, GUI_INMOVESIZE, NULL );
+    for (;;)
+    {
+        if (!NtUserGetMessage( &msg, 0, 0, 0 )) break;
+        if (NtUserCallMsgFilter( &msg, MSGF_SIZE )) continue;
+        if (msg.message == WM_LBUTTONUP || (msg.message == WM_KEYDOWN && msg.wParam == VK_ESCAPE)) break;
+        if (msg.message != WM_MOUSEMOVE)
+        {
+            NtUserTranslateMessage( &msg, 0 );
+            NtUserDispatchMessage( &msg );
+            if (!(NtUserGetKeyState( VK_LBUTTON ) & 0x8000)) break;
+            continue;
+        }
+        if (abs( msg.pt.x - start.x ) <= drag_x && abs( msg.pt.y - start.y ) <= drag_y) continue;
+
+        set_capture_window( 0, GUI_INMOVESIZE, NULL );
+        *pt = msg.pt;
+        get_window_rect( hwnd, &max_rect, get_thread_dpi() );
+        if (!NtUserGetWindowPlacement( hwnd, &placement )) return FALSE;
+        width = placement.rcNormalPosition.right - placement.rcNormalPosition.left;
+        height = placement.rcNormalPosition.bottom - placement.rcNormalPosition.top;
+        left = pt->x - muldiv( start.x - max_rect.left, width, max( max_rect.right - max_rect.left, 1 ) );
+        top = pt->y - min( start.y - max_rect.top, get_system_metrics( SM_CYCAPTION ) );
+        SetRect( &placement.rcNormalPosition, left, top, left + width, top + height );
+        placement.rcNormalPosition = to_workspace( placement.rcNormalPosition );
+        placement.showCmd = SW_SHOWNORMAL;
+        placement.flags = 0;
+        NtUserSetWindowPlacement( hwnd, &placement );
+        return TRUE;
+    }
+    set_capture_window( 0, GUI_INMOVESIZE, NULL );
+    return FALSE;
+}
