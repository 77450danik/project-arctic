Date: Sun, 20 Sep 2026 10:09:31 +0300
Subject: [PATCH] shlwapi, cfgmgr32: Implement SHLockSharedEx and
 CM_Is_Dock_Station_Present.

ReactOS's Start menu calls both.
---
 dlls/cfgmgr32/cfgmgr32.c    | 21 +++++++++++++++++++++
 dlls/cfgmgr32/cfgmgr32.spec |  4 ++--
 dlls/setupapi/setupapi.spec |  2 +-
 dlls/shlwapi/ordinal.c      | 31 +++++++++++++++++++++++++++++++
 dlls/shlwapi/shlwapi.spec   |  2 +-
 5 files changed, 56 insertions(+), 4 deletions(-)

diff --git a/dlls/cfgmgr32/cfgmgr32.c b/dlls/cfgmgr32/cfgmgr32.c
index 648c1542..d16bd678 100644
--- a/dlls/cfgmgr32/cfgmgr32.c
+++ b/dlls/cfgmgr32/cfgmgr32.c
@@ -2199,3 +2199,24 @@ WORD WINAPI CM_Get_Version( void )
     TRACE( "\n" );
     return 0x0400;
 }
+
+/***********************************************************************
+ *      CM_Is_Dock_Station_Present (cfgmgr32.@)
+ */
+CONFIGRET WINAPI CM_Is_Dock_Station_Present( BOOL *present )
+{
+    TRACE( "%p\n", present );
+
+    if (!present) return CR_INVALID_POINTER;
+    *present = FALSE;
+    return CR_SUCCESS;
+}
+
+/***********************************************************************
+ *      CM_Is_Dock_Station_Present_Ex (cfgmgr32.@)
+ */
+CONFIGRET WINAPI CM_Is_Dock_Station_Present_Ex( BOOL *present, HMACHINE machine )
+{
+    TRACE( "%p %p\n", present, machine );
+    return CM_Is_Dock_Station_Present( present );
+}
