--- a/dlls/shlwapi/ordinal.c
+++ b/dlls/shlwapi/ordinal.c
@@ -221,6 +221,37 @@ PVOID WINAPI SHLockShared(HANDLE hShared, DWORD dwProcId)
   return NULL;
 }
 
+/*************************************************************************
+ * @ [SHLWAPI.510]
+ *
+ * Get a pointer to a block of shared memory, for reading or for writing.
+ *
+ * PARAMS
+ * hShared  [I] Shared memory handle
+ * dwProcId [I] ID of process owning hShared
+ * bWrite   [I] Whether the memory is written through the pointer
+ *
+ * RETURNS
+ * Success: A pointer to the shared memory
+ * Failure: NULL
+ */
+PVOID WINAPI SHLockSharedEx(HANDLE hShared, DWORD dwProcId, BOOL bWrite)
+{
+  DWORD access = bWrite ? FILE_MAP_READ | FILE_MAP_WRITE : FILE_MAP_READ;
+  HANDLE hDup;
+  LPVOID pMapped;
+
+  TRACE("(%p %ld %d)\n", hShared, dwProcId, bWrite);
+
+  hDup = SHMapHandle(hShared, dwProcId, GetCurrentProcessId(), access, 0);
+  pMapped = MapViewOfFile(hDup, access, 0, 0, 0);
+  CloseHandle(hDup);
+
+  if (pMapped)
+    return (char *) pMapped + sizeof(DWORD); /* Hide size */
+  return NULL;
+}
+
 /*************************************************************************
  * @ [SHLWAPI.9]
  *
