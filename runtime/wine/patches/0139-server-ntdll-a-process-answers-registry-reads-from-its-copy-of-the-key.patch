From: Project Arctic
Subject: server, ntdll: a process answers registry reads from its copy of the key.

Each NtQueryValueKey and NtEnumerateValueKey was a request; every GUI
process enumerates the Fonts keys value by value as it starts (about 200
requests) and every program reads the same keys again and again.

A handle that may query values now comes with the locator of its key's
change counter in session memory (a shared object of the key, made when a
client opens a handle and gone with the last handle). On the second read
through the handle, or its first enumeration, the process gets all of the
key's values in one request (get_key_values, up to 64 KB a key, 4 MB a
process) and answers from that copy for as long as the counter has not moved;
every change of the key's values moves it (touch_key, loading a hive, the key
being deleted), from whichever process. The answers are what the server
gives, byte for byte, including the buffer sizes and statuses. NtClose and
DUPLICATE_CLOSE_SOURCE forget the handle's copy. NT_REGCACHE=0 turns it off.
---
diff --git a/dlls/ntdll/unix/registry.c b/dlls/ntdll/unix/registry.c
index 9f45f73..38bc8a6 100644
--- a/dlls/ntdll/unix/registry.c
+++ b/dlls/ntdll/unix/registry.c
@@ -39,6 +39,360 @@ WINE_DEFAULT_DEBUG_CHANNEL(reg);
 #define MAX_VALUE_LENGTH (16383 * sizeof(WCHAR))
 
 
+/***********************************************************************
+ * Arctic: the process's copy of registry values
+ *
+ * Windows reads a key's values from memory of its own; here each one was a
+ * request to the server, and a program reads the same few keys again and
+ * again (and enumerates the Fonts keys value by value in every process).
+ * A handle the server lets query values comes with the locator of the key's
+ * change counter in session memory (open_key, create_key). From the second
+ * read through that handle on, or at its first enumeration, the process gets
+ * all the key's values at once (get_key_values) and answers NtQueryValueKey
+ * and NtEnumerateValueKey from that copy for as long as the counter has not
+ * moved. Every change of the key's values moves it, in whichever process.
+ * NT_REGCACHE=0 in the environment turns it off.
+ */
+
+struct reg_values  /* a copy of a key's values, shared by the readers using it */
+{
+    LONG          refcount;
+    unsigned int  count;
+    size_t        size;
+    const struct key_value_entry *entries[];  /* each followed by its name and data */
+};
+
+struct reg_cache_key
+{
+    struct list         entry;   /* in reg_cache_buckets */
+    struct list         lru;     /* in reg_cache_lru, while it has values */
+    HANDLE              handle;
+    object_id_t         id;      /* the key's shared object */
+    mem_size_t          offset;
+    UINT64              seq;     /* its counter when the values were read */
+    unsigned int        uses;
+    BOOL                too_big;
+    struct reg_values  *values;
+};
+
+struct reg_session_block
+{
+    struct list  entry;
+    char        *data;
+    SIZE_T       offset;
+    SIZE_T       size;
+};
+
+#define REG_CACHE_BUCKETS  256
+#define REG_CACHE_MAX_KEY  (64 * 1024)        /* a key with more than this is not copied */
+#define REG_CACHE_BUDGET   (4 * 1024 * 1024)  /* all the copies of a process */
+
+static struct list reg_cache_buckets[REG_CACHE_BUCKETS];
+static struct list reg_cache_lru = LIST_INIT( reg_cache_lru );
+static struct list reg_session_blocks = LIST_INIT( reg_session_blocks );
+static size_t reg_cache_size;
+static LONG reg_cache_count;
+static int reg_cache_enabled = -1;
+static pthread_mutex_t reg_cache_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t reg_session_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static BOOL reg_cache_on(void)
+{
+    if (reg_cache_enabled == -1)
+    {
+        const char *env = getenv( "NT_REGCACHE" );
+        unsigned int i;
+
+        for (i = 0; i < REG_CACHE_BUCKETS; i++) list_init( &reg_cache_buckets[i] );
+        reg_cache_enabled = !(env && !strcmp( env, "0" ));
+    }
+    return reg_cache_enabled;
+}
+
+static struct list *reg_cache_bucket( HANDLE handle )
+{
+    return &reg_cache_buckets[((ULONG_PTR)handle >> 2) % REG_CACHE_BUCKETS];
+}
+
+static struct reg_cache_key *reg_cache_find( HANDLE handle )
+{
+    struct reg_cache_key *key;
+
+    LIST_FOR_EACH_ENTRY( key, reg_cache_bucket( handle ), struct reg_cache_key, entry )
+        if (key->handle == handle) return key;
+    return NULL;
+}
+
+static void reg_values_release( struct reg_values *values )
+{
+    if (values && !InterlockedDecrement( &values->refcount )) free( values );
+}
+
+static void reg_cache_drop_values( struct reg_cache_key *key )
+{
+    if (!key->values) return;
+    reg_cache_size -= key->values->size;
+    list_remove( &key->lru );
+    reg_values_release( key->values );
+    key->values = NULL;
+    key->seq = 0;
+}
+
+static void reg_cache_free( struct reg_cache_key *key )
+{
+    reg_cache_drop_values( key );
+    list_remove( &key->entry );
+    free( key );
+    InterlockedDecrement( &reg_cache_count );
+}
+
+/* the key's shared object, if its part of the session section is mapped */
+static const shared_object_t *reg_shared_object( mem_size_t offset )
+{
+    const shared_object_t *ret = NULL;
+    struct reg_session_block *block;
+
+    pthread_mutex_lock( &reg_session_mutex );
+    LIST_FOR_EACH_ENTRY( block, &reg_session_blocks, struct reg_session_block, entry )
+    {
+        if (block->offset > offset || offset + sizeof(shared_object_t) > block->offset + block->size) continue;
+        ret = (const shared_object_t *)(block->data + offset - block->offset);
+        break;
+    }
+    pthread_mutex_unlock( &reg_session_mutex );
+    return ret;
+}
+
+/* map the part of the session section with that offset, as win32u does; called
+ * without reg_cache_mutex: mapping a view takes the fd cache's lock, and NtClose
+ * takes ours inside that one */
+static void reg_map_session( mem_size_t offset )
+{
+    static const WCHAR nameW[] =
+        {'\\','K','e','r','n','e','l','O','b','j','e','c','t','s','\\',
+         '_','_','w','i','n','e','_','s','e','s','s','i','o','n',0};
+    UNICODE_STRING name = RTL_CONSTANT_STRING( nameW );
+    struct reg_session_block *block;
+    OBJECT_ATTRIBUTES attr;
+    LARGE_INTEGER off;
+    HANDLE section;
+
+    if (!(block = calloc( 1, sizeof(*block) ))) return;
+    off.QuadPart = offset & ~(mem_size_t)0xffff;  /* the allocation granularity */
+    InitializeObjectAttributes( &attr, &name, 0, NULL, NULL );
+    if (NtOpenSection( &section, SECTION_MAP_READ, &attr ))
+    {
+        free( block );
+        return;
+    }
+    if (NtMapViewOfSection( section, GetCurrentProcess(), (void **)&block->data, 0, 0, &off,
+                            &block->size, ViewUnmap, 0, PAGE_READONLY ))
+    {
+        NtClose( section );
+        free( block );
+        return;
+    }
+    NtClose( section );
+    block->offset = off.QuadPart;
+    {
+        sigset_t sigset;
+        server_enter_uninterrupted_section( &reg_session_mutex, &sigset );
+        list_add_tail( &reg_session_blocks, &block->entry );
+        server_leave_uninterrupted_section( &reg_session_mutex, &sigset );
+    }
+}
+
+/* is the copy still the key's values? */
+static BOOL reg_cache_valid( struct reg_cache_key *key, const shared_object_t *object )
+{
+    UINT64 seq;
+    object_id_t id;
+
+    if (!key->values || !object) return FALSE;
+    seq = __atomic_load_n( (LONG64 *)&object->seq, __ATOMIC_ACQUIRE );
+    id = object->id;
+    __atomic_thread_fence( __ATOMIC_ACQUIRE );
+    if (seq & 1) return FALSE;
+    if (__atomic_load_n( (LONG64 *)&object->seq, __ATOMIC_RELAXED ) != (LONG64)seq) return FALSE;
+    return id == key->id && seq == key->seq;
+}
+
+/* read all the values of the key again */
+static void reg_cache_fetch( struct reg_cache_key *key )
+{
+    struct reg_values *values;
+    unsigned int status, count = 0, i;
+    data_size_t total = 0;
+    UINT64 seq = 0;
+    char *buffer, *ptr, *end;
+
+    if (key->too_big) return;
+    if (!(buffer = malloc( REG_CACHE_MAX_KEY ))) return;
+
+    SERVER_START_REQ( get_key_values )
+    {
+        req->hkey = wine_server_obj_handle( key->handle );
+        wine_server_set_reply( req, buffer, REG_CACHE_MAX_KEY );
+        if (!(status = wine_server_call( req )))
+        {
+            seq   = reply->seq;
+            count = reply->count;
+            total = wine_server_reply_size( reply );
+        }
+    }
+    SERVER_END_REQ;
+
+    if (status == STATUS_BUFFER_OVERFLOW) key->too_big = TRUE;
+    if (status || !seq || (seq & 1))
+    {
+        free( buffer );
+        return;
+    }
+    if (!(values = malloc( offsetof( struct reg_values, entries[count] ) + total )))
+    {
+        free( buffer );
+        return;
+    }
+    ptr = (char *)&values->entries[count];
+    memcpy( ptr, buffer, total );
+    free( buffer );
+    end = ptr + total;
+    for (i = 0; i < count; i++)
+    {
+        const struct key_value_entry *entry = (const struct key_value_entry *)ptr;
+        size_t size;
+
+        if (end - ptr < sizeof(*entry)) break;
+        size = (sizeof(*entry) + entry->namelen + entry->len + 7) & ~7;
+        if (size > end - ptr) break;
+        values->entries[i] = entry;
+        ptr += size;
+    }
+    if (i < count)  /* not what the server sends */
+    {
+        free( values );
+        key->too_big = TRUE;
+        return;
+    }
+    values->refcount = 1;
+    values->count    = count;
+    values->size     = offsetof( struct reg_values, entries[count] ) + total;
+
+    reg_cache_drop_values( key );
+    key->values = values;
+    key->seq    = seq;
+    reg_cache_size += values->size;
+    list_add_head( &reg_cache_lru, &key->lru );
+    while (reg_cache_size > REG_CACHE_BUDGET && !list_empty( &reg_cache_lru ))
+    {
+        struct reg_cache_key *old = LIST_ENTRY( list_tail( &reg_cache_lru ), struct reg_cache_key, lru );
+        if (old == key) break;
+        reg_cache_drop_values( old );
+    }
+}
+
+/* the values to answer from, with a reference, or NULL to ask the server */
+static struct reg_values *reg_cache_get( HANDLE handle, BOOL enumerating )
+{
+    struct reg_values *values = NULL;
+    struct reg_cache_key *key;
+    const shared_object_t *object;
+    mem_size_t unmapped = 0;
+    BOOL mapped = FALSE;
+    sigset_t sigset;
+
+    if (!reg_cache_count || !reg_cache_on()) return NULL;
+
+again:
+    server_enter_uninterrupted_section( &reg_cache_mutex, &sigset );
+    if ((key = reg_cache_find( handle )))
+    {
+        object = reg_shared_object( key->offset );
+        if (!object && !mapped)
+        {
+            /* map that part of the session memory first, outside the lock */
+            unmapped = key->offset;
+            server_leave_uninterrupted_section( &reg_cache_mutex, &sigset );
+            reg_map_session( unmapped );
+            mapped = TRUE;
+            goto again;
+        }
+        if (!object)
+        {
+            server_leave_uninterrupted_section( &reg_cache_mutex, &sigset );
+            return NULL;  /* cannot see the counter: ask the server */
+        }
+        if (key->values && !reg_cache_valid( key, object ))
+        {
+            /* changed: start again, a key written as often as read is not worth copying */
+            reg_cache_drop_values( key );
+            key->uses = 0;
+        }
+        key->uses++;
+        if (!key->values && (enumerating || key->uses >= 2)) reg_cache_fetch( key );
+        if (key->values)
+        {
+            list_remove( &key->lru );
+            list_add_head( &reg_cache_lru, &key->lru );
+            values = key->values;
+            InterlockedIncrement( &values->refcount );
+        }
+    }
+    server_leave_uninterrupted_section( &reg_cache_mutex, &sigset );
+    return values;
+}
+
+/* a handle came from the server, with the locator of its key's counter */
+static void reg_cache_open( HANDLE handle, const struct obj_locator *locator )
+{
+    struct reg_cache_key *key;
+    sigset_t sigset;
+
+    if (!handle || !reg_cache_on()) return;
+    server_enter_uninterrupted_section( &reg_cache_mutex, &sigset );
+    if ((key = reg_cache_find( handle ))) reg_cache_free( key );  /* the handle was closed behind our back */
+    if (locator->id && (key = calloc( 1, sizeof(*key) )))
+    {
+        key->handle = handle;
+        key->id     = locator->id;
+        key->offset = locator->offset;
+        list_add_head( reg_cache_bucket( handle ), &key->entry );
+        InterlockedIncrement( &reg_cache_count );
+    }
+    server_leave_uninterrupted_section( &reg_cache_mutex, &sigset );
+}
+
+/* NtClose, NtDuplicateObject with DUPLICATE_CLOSE_SOURCE */
+void registry_cache_close( HANDLE handle )
+{
+    struct reg_cache_key *key;
+    sigset_t sigset;
+
+    if (!reg_cache_count) return;
+    server_enter_uninterrupted_section( &reg_cache_mutex, &sigset );
+    if ((key = reg_cache_find( handle ))) reg_cache_free( key );
+    server_leave_uninterrupted_section( &reg_cache_mutex, &sigset );
+}
+
+static const struct key_value_entry *reg_values_find( const struct reg_values *values,
+                                                      const WCHAR *name, unsigned int len )
+{
+    unsigned int i, j;
+
+    for (i = 0; i < values->count; i++)
+    {
+        const struct key_value_entry *entry = values->entries[i];
+        const WCHAR *entry_name = (const WCHAR *)(entry + 1);
+
+        if (entry->namelen != len) continue;
+        for (j = 0; j < len / sizeof(WCHAR); j++)
+            if (ntdll_towupper( entry_name[j] ) != ntdll_towupper( name[j] )) break;
+        if (j == len / sizeof(WCHAR)) return entry;
+    }
+    return NULL;
+}
