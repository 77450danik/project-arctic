+
+    TRACE("(%p, %p)\n", thumbnail, props);
+
+    if (!props) return E_INVALIDARG;
+    if (!(shared = get_shared())) return E_INVALIDARG;
+    lock_shared( shared );
+    if ((entry = thumbnail_entry( shared, thumbnail )))
+    {
+        thumb = &entry->u.thumbnail;
+        if (props->dwFlags & DWM_TNP_RECTDESTINATION)
+        {
+            thumb->dest_left = props->rcDestination.left;
+            thumb->dest_top = props->rcDestination.top;
+            thumb->dest_right = props->rcDestination.right;
+            thumb->dest_bottom = props->rcDestination.bottom;
+        }
+        if (props->dwFlags & DWM_TNP_RECTSOURCE)
+        {
+            thumb->source_left = props->rcSource.left;
+            thumb->source_top = props->rcSource.top;
+            thumb->source_right = props->rcSource.right;
+            thumb->source_bottom = props->rcSource.bottom;
+        }
+        if (props->dwFlags & DWM_TNP_OPACITY) thumb->opacity = props->opacity;
+        if (props->dwFlags & DWM_TNP_VISIBLE) thumb->visible = !!props->fVisible;
+        if (props->dwFlags & DWM_TNP_SOURCECLIENTAREAONLY) thumb->client_only = !!props->fSourceClientAreaOnly;
+    }
+    unlock_shared( shared );
+    return entry ? S_OK : E_INVALIDARG;
 }
 
