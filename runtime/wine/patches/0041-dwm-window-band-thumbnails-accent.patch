+/* Windows keeps the taskbar in a z-order band over program windows. A window
+ * in the band lies over every other toplevel window except its own popups; a
+ * window with a caption never goes over it, whatever z-order it asks for,
+ * topmost or not. Other popups (menus, tooltips, full screen games) still do,
+ * as in Windows. */
+static void keep_band_order( struct window *win )
+{
+    struct list *children = &win->parent->children;
+    struct window *other, *next, *last_band = NULL;
+    int seen = 0;
+
+    if (win->band)
+    {
+        struct list owned = LIST_INIT( owned );
+
+        list_remove( &win->entry );
+        list_add_head( children, &win->entry );
+        win->ex_style |= WS_EX_TOPMOST;
+        /* its own popups stay over it, in their order */
+        LIST_FOR_EACH_ENTRY_SAFE( other, next, children, struct window, entry )
+        {
+            if (other == win || other->owner != win->handle) continue;
+            list_remove( &other->entry );
+            list_add_tail( &owned, &other->entry );
+        }
