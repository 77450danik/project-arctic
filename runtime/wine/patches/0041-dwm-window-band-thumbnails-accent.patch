 HRESULT WINAPI DwmSetWindowAttribute(HWND hwnd, DWORD attributenum, LPCVOID attribute, DWORD size)
 {
-    static BOOL once;
+    struct arctic_dwm_shared *shared;
+    struct arctic_dwm_entry *entry;
+    struct arctic_dwm_window *window;
+    HRESULT hr = S_OK;
 
-    if (!once++) FIXME("(%p, %lx, %p, %lx) stub\n", hwnd, attributenum, attribute, size);
+    TRACE("(%p, %#lx, %p, %lu)\n", hwnd, attributenum, attribute, size);
 
-    return S_OK;
+    if (!IsWindow(hwnd)) return E_HANDLE;
+    if (!attribute) return E_INVALIDARG;
+
+    switch (attributenum)
+    {
+    case 3:  /* DWMWA_TRANSITIONS_FORCEDISABLED */
+    case 13: /* DWMWA_CLOAK */
+    case 33: /* DWMWA_WINDOW_CORNER_PREFERENCE */
+    case 38: /* DWMWA_SYSTEMBACKDROP_TYPE */
+    case DWMWA_ARCTIC_TRANSITION:
+        if (size < sizeof(DWORD)) return E_INVALIDARG;
+        break;
+    case DWMWA_ARCTIC_MINIMIZE_RECT:
+        if (size < sizeof(RECT)) return E_INVALIDARG;
+        break;
+    case DWMWA_ARCTIC_ACCENT:
+        if (size < sizeof(struct arctic_accent_policy)) return E_INVALIDARG;
+        break;
+    default:
+        /* colours of the frame and the like: DWM draws no frame here */
+        TRACE("attribute %lu ignored\n", attributenum);
+        return S_OK;
+    }
+
+    if (!(shared = get_shared())) return DWM_E_COMPOSITIONDISABLED;
+    lock_shared( shared );
+    if ((entry = window_entry( shared, hwnd )))
+    {
+        window = &entry->u.window;
+        switch (attributenum)
+        {
+        case 3:  window->transitions_off = !!*(const DWORD *)attribute; break;
+        case 13: window->cloaked = !!*(const DWORD *)attribute; break;
+        case 33: window->corner = *(const DWORD *)attribute; break;
+        case 38: window->backdrop = *(const DWORD *)attribute; break;
+        case DWMWA_ARCTIC_TRANSITION: window->transition = *(const DWORD *)attribute; break;
+        case DWMWA_ARCTIC_MINIMIZE_RECT:
+        {
+            const RECT *rect = attribute;
+            window->minimize_left = rect->left;
+            window->minimize_top = rect->top;
+            window->minimize_right = rect->right;
+            window->minimize_bottom = rect->bottom;
+            break;
+        }
+        case DWMWA_ARCTIC_ACCENT:
+        {
+            const struct arctic_accent_policy *policy = attribute;
+            window->accent = policy->state;
+            window->accent_color = policy->gradient_color;
+            break;
+        }
+        }
+    }
+    else hr = E_OUTOFMEMORY;
+    unlock_shared( shared );
+    return hr;
 }
 
