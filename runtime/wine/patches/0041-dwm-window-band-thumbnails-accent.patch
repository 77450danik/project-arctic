 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dwmapi);
 
+/* the table dwm.exe reads, see wine/arctic_dwm.h; NULL while dwm.exe is not running */
+static struct arctic_dwm_shared *get_shared(void)
+{
+    static struct arctic_dwm_shared *shared;
+    struct arctic_dwm_shared *view;
+    HANDLE mapping;
+
+    if (shared) return shared;
+    if (!(mapping = OpenFileMappingW( FILE_MAP_READ | FILE_MAP_WRITE, FALSE, ARCTIC_DWM_SECTION ))) return NULL;
+    view = MapViewOfFile( mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, sizeof(*view) );
+    CloseHandle( mapping );
+    if (!view) return NULL;
+    if (view->version != ARCTIC_DWM_VERSION)
+    {
+        UnmapViewOfFile( view );
+        return NULL;
+    }
+    if (InterlockedCompareExchangePointer( (void **)&shared, view, NULL )) UnmapViewOfFile( view );
+    return shared;
+}
+
+static void lock_shared( struct arctic_dwm_shared *shared )
+{
+    while (InterlockedCompareExchange( &shared->lock, 1, 0 )) YieldProcessor();
+}
+
+static void unlock_shared( struct arctic_dwm_shared *shared )
+{
+    InterlockedIncrement( &shared->serial );
+    InterlockedExchange( &shared->lock, 0 );
+}
+
+static struct arctic_dwm_entry *new_entry( struct arctic_dwm_shared *shared, UINT32 type, HWND hwnd )
+{
+    for (UINT i = 0; i < ARCTIC_DWM_MAX_ENTRIES; i++)
+    {
+        struct arctic_dwm_entry *entry = &shared->entries[i];
+
+        if (entry->type != ARCTIC_DWM_FREE) continue;
+        memset( entry, 0, sizeof(*entry) );
+        entry->type = type;
+        entry->hwnd = HandleToULong( hwnd );
+        entry->process = GetCurrentProcessId();
+        return entry;
+    }
+    return NULL;
+}
+
+static struct arctic_dwm_entry *window_entry( struct arctic_dwm_shared *shared, HWND hwnd )
+{
+    for (UINT i = 0; i < ARCTIC_DWM_MAX_ENTRIES; i++)
+    {
+        struct arctic_dwm_entry *entry = &shared->entries[i];
+        if (entry->type == ARCTIC_DWM_WINDOW && entry->hwnd == HandleToULong( hwnd )) return entry;
+    }
+    return new_entry( shared, ARCTIC_DWM_WINDOW, hwnd );
+}
+
+static struct arctic_dwm_entry *thumbnail_entry( struct arctic_dwm_shared *shared, HTHUMBNAIL thumbnail )
+{
+    UINT32 id = (UINT32)(ULONG_PTR)thumbnail;
+
+    if (!id) return NULL;
+    for (UINT i = 0; i < ARCTIC_DWM_MAX_ENTRIES; i++)
+    {
+        struct arctic_dwm_entry *entry = &shared->entries[i];
+        if (entry->type == ARCTIC_DWM_THUMBNAIL && entry->id == id) return entry;
+    }
+    return NULL;
+}
+
 
