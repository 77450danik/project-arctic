+/**********************************************************************
+ *              SetWindowBand (USER32.@)
+ *
+ * Windows keeps windows in z-order bands: the taskbar sits in a band over
+ * every program window. Here any band above ZBID_DESKTOP (1) is that band.
+ */
+BOOL WINAPI SetWindowBand(HWND hwnd, HWND after, DWORD band)
+{
+    TRACE("(%p, %p, %lu)\n", hwnd, after, band);
+    return NtUserCallHwndParam( hwnd, band > 1, NtUserCallHwndParam_SetWindowBand );
+}
+
+/**********************************************************************
+ *              GetWindowBand (USER32.@)
+ */
+BOOL WINAPI GetWindowBand(HWND hwnd, DWORD *band)
+{
+    TRACE("(%p, %p)\n", hwnd, band);
+    if (!band) return FALSE;
+    *band = NtUserCallHwndParam( hwnd, 0, NtUserCallHwndParam_GetWindowBand ) ? 4 /* ZBID_SYSTEM_TOOLS */ : 1;
+    return TRUE;
 }
 
