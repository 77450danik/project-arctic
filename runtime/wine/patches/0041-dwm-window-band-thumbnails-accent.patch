+/**********************************************************************
+ *           DwmQueryThumbnailSourceSize         (DWMAPI.@)
+ */
+HRESULT WINAPI DwmQueryThumbnailSourceSize(HTHUMBNAIL thumbnail, SIZE *size)
+{
+    struct arctic_dwm_shared *shared;
+    struct arctic_dwm_entry *entry;
+    HWND source = NULL;
+    BOOL client_only = FALSE;
+    RECT rect;
+
+    TRACE("(%p %p)\n", thumbnail, size);
+
+    if (!size) return E_INVALIDARG;
+    if (!(shared = get_shared())) return E_INVALIDARG;
+    lock_shared( shared );
+    if ((entry = thumbnail_entry( shared, thumbnail )))
+    {
+        source = ULongToHandle( entry->u.thumbnail.source );
+        client_only = entry->u.thumbnail.client_only;
+    }
+    InterlockedExchange( &shared->lock, 0 );
+    if (!source) return E_INVALIDARG;
+
+    if (client_only ? !GetClientRect( source, &rect ) : !GetWindowRect( source, &rect )) return E_INVALIDARG;
+    size->cx = rect.right - rect.left;
+    size->cy = rect.bottom - rect.top;
+    return S_OK;
 }
 
