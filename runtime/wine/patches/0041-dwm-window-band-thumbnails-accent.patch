@@ -231,9 +407,62 @@ HRESULT WINAPI DwmGetWindowAttribute(HWND hwnd, DWORD attribute, PVOID pv_attrib
  */
 HRESULT WINAPI DwmRegisterThumbnail(HWND dest, HWND src, PHTHUMBNAIL thumbnail_id)
 {
-    FIXME("(%p %p %p) stub\n", dest, src, thumbnail_id);
+    struct arctic_dwm_shared *shared;
+    struct arctic_dwm_entry *entry;
+    DWORD process;
+
+    TRACE("(%p %p %p)\n", dest, src, thumbnail_id);
+
+    if (!thumbnail_id) return E_INVALIDARG;
+    *thumbnail_id = NULL;
+    if (!IsWindow(dest) || !IsWindow(src) || dest == src) return E_INVALIDARG;
+    /* the window it is drawn in belongs to the caller, as Windows requires */
+    GetWindowThreadProcessId( dest, &process );
+    if (process != GetCurrentProcessId()) return E_INVALIDARG;
+    if (!(shared = get_shared())) return DWM_E_COMPOSITIONDISABLED;
+
+    lock_shared( shared );
+    if ((entry = new_entry( shared, ARCTIC_DWM_THUMBNAIL, dest )))
+    {
+        if (!++shared->next_id) shared->next_id = 1;
+        entry->id = shared->next_id;
+        entry->u.thumbnail.source = HandleToULong( src );
+        entry->u.thumbnail.opacity = 255;
+        entry->u.thumbnail.visible = TRUE;
+        *thumbnail_id = (HTHUMBNAIL)(ULONG_PTR)entry->id;
+    }
+    unlock_shared( shared );
+    return entry ? S_OK : E_OUTOFMEMORY;
+}
 
