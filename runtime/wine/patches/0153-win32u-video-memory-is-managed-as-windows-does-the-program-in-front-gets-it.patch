+static BOOL vidmm_buffer_wanted( struct vulkan_device *device, VkBufferCreateInfo *info, BOOL chain_ok )
+{
+    VkDeviceBufferMemoryRequirements query = {.sType = VK_STRUCTURE_TYPE_DEVICE_BUFFER_MEMORY_REQUIREMENTS};
+    VkMemoryRequirements2 plain = {.sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2};
+    VkMemoryRequirements2 sparse = {.sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2};
+    VkBufferCreateFlags flags = info->flags;
+
+    if (!device->vidmm || !chain_ok || !device->p_vkGetDeviceBufferMemoryRequirements) return FALSE;
+    if (info->size < 1024 * 1024) return FALSE;
+    if (flags & (VK_BUFFER_CREATE_SPARSE_BINDING_BIT | VK_BUFFER_CREATE_SPARSE_RESIDENCY_BIT | VK_BUFFER_CREATE_SPARSE_ALIASED_BIT |
+                 VK_BUFFER_CREATE_PROTECTED_BIT | VK_BUFFER_CREATE_DEVICE_ADDRESS_CAPTURE_REPLAY_BIT |
+                 VK_BUFFER_CREATE_DESCRIPTOR_BUFFER_CAPTURE_REPLAY_BIT_EXT))
+        return FALSE;
+
+    query.pCreateInfo = info;
+    device->p_vkGetDeviceBufferMemoryRequirements( device->host.device, &query, &plain );
+    info->flags = flags | VK_BUFFER_CREATE_SPARSE_BINDING_BIT;
+    device->p_vkGetDeviceBufferMemoryRequirements( device->host.device, &query, &sparse );
+    info->flags = flags;
+    return sparse.memoryRequirements.memoryTypeBits == plain.memoryRequirements.memoryTypeBits;
+}
+
+static void vidmm_add_resource( struct vulkan_device *device, UINT64 handle, BOOL image )
+{
+    struct vidmm *vm = device->vidmm;
+    VkMemoryRequirements requirements;
+    struct vidmm_resource *res;
+
+    if (image) device->p_vkGetImageMemoryRequirements( device->host.device, (VkImage)handle, &requirements );
+    else device->p_vkGetBufferMemoryRequirements( device->host.device, (VkBuffer)handle, &requirements );
+    if (!(res = calloc( 1, sizeof(*res) ))) return;  /* never bound then: the program fails on it as on a full VRAM */
+    res->handle = handle;
+    res->image = image;
+    res->size = requirements.size;
+    res->type_bits = requirements.memoryTypeBits;
+    list_init( &res->entry );
+    pthread_mutex_lock( &vm->lock );
+    rb_put( &vm->resources, &res->handle, &res->rb );
+    pthread_mutex_unlock( &vm->lock );
+}
+
+static void vidmm_remove_resource( struct vulkan_device *device, UINT64 handle, VkDeviceMemory *backing )
+{
+    struct vidmm *vm = device->vidmm;
+    struct vidmm_resource *res;
+
+    *backing = VK_NULL_HANDLE;
+    if (!vm) return;
+    pthread_mutex_lock( &vm->lock );
+    if ((res = vidmm_find( vm, handle )))
+    {
+        rb_remove( &vm->resources, &res->rb );
+        list_remove( &res->entry );
+        *backing = res->backing;
+        free( res );
+    }
+    pthread_mutex_unlock( &vm->lock );
+}
