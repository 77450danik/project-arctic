+/* Binds a resource to memory: a sparse one on win32u's queue (TRUE, *res set);
+ * an ordinary one pins the memory object it is bound to in VRAM (FALSE). */
+static BOOL vidmm_bind( struct vulkan_device *device, UINT64 handle, VkDeviceMemory client_memory, VkDeviceSize offset,
+                        VkResult *ret )
+{
+    struct vidmm *vm = device->vidmm;
+    struct device_memory *memory;
+    struct vidmm_resource *res;
+    VkDeviceMemory target;
+    VkDeviceSize target_offset = offset;
+
+    if (!vm || !client_memory) return FALSE;
+    memory = device_memory_from_handle( client_memory );
+    pthread_mutex_lock( &vm->lock );
+    if (!(res = vidmm_find( vm, handle )))
+    {
+        /* in a spilled object it gets memory of its own; in VRAM it holds the object there */
+        if (!memory->spill && memory->vm == vm) vidmm_pin_locked( vm, memory );
+        pthread_mutex_unlock( &vm->lock );
+        return FALSE;
+    }
+
+    *ret = VK_SUCCESS;
+    if (memory->spill)
+    {
+        uint32_t type = ~0u;
+
+        res->backing = VK_NULL_HANDLE;
+        /* what draws keeps VRAM unless the program in front needs it */
+        if (res->image && (res->type_bits & (1u << memory->spill_type)) && is_drawing_image( (VkImage)handle ) &&
+            !claim_active_for_other( vm->self ))
