+/* Video memory goes to the program in front when it needs it, as Windows
+ * gives it (docs/games.md). Windows (VidMm) pages out the video memory of
+ * the processes behind the foreground one once that one runs short. Here the
+ * process that owns the foreground window, when a device-local heap of a
+ * discrete GPU is nearly full for it (less than a sixteenth of the heap left
+ * in its budget) or an allocation of its own finds no room, claims video
+ * memory in a page every process shares (/dev/shm/arctic-vram), and renews
+ * the claim on each present and budget query while it stays in front; a
+ * claim not renewed for two seconds is over. Behind a claim, a process sees
+ * a share of the heap as its budget (VK_EXT_memory_budget, and DXGI's budget
+ * built on it), what it allocates beyond that share goes to system memory as
+ * when VRAM is full, and what it holds is paged out (vidmm, below). A program
+ * in front that fits takes nothing from anyone. Integrated GPUs are left
+ * alone: their memory is the system's anyway. */
+#define VRAM_SHARED_FILE "/dev/shm/arctic-vram"
+#define CLAIM_LIFETIME 2000  /* ms */
+
+struct vram_shared
+{
+    LONG claimed_by;  /* process in front that ran short, or 0 */
+    LONG claimed_at;  /* when it last said so, ms of CLOCK_MONOTONIC */
+};
+
+static LONG now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (LONG)((ULONGLONG)ts.tv_sec * 1000 + ts.tv_nsec / 1000000);
+}
+
+static struct vram_shared *vram_shared_page;
+static LONG vram_shared_tried;
+
+static struct vram_shared *get_vram_shared(void)
+{
+    struct vram_shared *ret;
+    int fd;
+
+    if ((ret = ReadPointerAcquire( (void **)&vram_shared_page )) || ReadAcquire( &vram_shared_tried )) return ret;
+    if ((fd = open( VRAM_SHARED_FILE, O_RDWR | O_CREAT | O_CLOEXEC, 0666 )) >= 0)
+    {
+        fchmod( fd, 0666 );  /* whatever the umask: every process of every user */
+        if (!ftruncate( fd, 4096 ) &&
+            (ret = mmap( NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) == MAP_FAILED)
+            ret = NULL;
+        close( fd );
+    }
+    if (!ret) fprintf( stderr, "vulkan: no %s: video memory is not shared out\n", VRAM_SHARED_FILE );
+    if (ret && InterlockedCompareExchangePointer( (void **)&vram_shared_page, ret, NULL )) munmap( ret, 4096 );
+    WriteRelease( &vram_shared_tried, 1 );
+    return ReadPointerAcquire( (void **)&vram_shared_page );
+}
+
+/* this process (first asked on a thread of the program, which has a TEB) */
+static DWORD process_self(void)
+{
+    static LONG self;
+    if (!ReadAcquire( &self )) WriteRelease( &self, GetCurrentProcessId() );
+    return ReadAcquire( &self );
+}
+
+/* the process that owns the foreground window, looked up at most every 100 ms;
+ * only on threads of the program */
+static DWORD foreground_process(void)
+{
+    static LONG pid, checked;
+    LONG now = now_ms();
+    DWORD process = 0;
+    HWND hwnd;
+
+    if (ReadAcquire( &checked ) && now - ReadAcquire( &checked ) < 100) return ReadAcquire( &pid );
+    if ((hwnd = NtUserGetForegroundWindow())) NtUserGetWindowThread( hwnd, &process );
+    WriteRelease( &pid, process );
+    WriteRelease( &checked, now ? now : 1 );
+    return process;
+}
+
+/* whether another process in front has a live claim; any thread */
+static BOOL claim_active_for_other( DWORD self )
+{
+    struct vram_shared *shared = ReadPointerAcquire( (void **)&vram_shared_page );
+    LONG claimed;
+
+    if (!shared || !(claimed = ReadAcquire( &shared->claimed_by )) || claimed == self) return FALSE;
+    return now_ms() - ReadAcquire( &shared->claimed_at ) < CLAIM_LIFETIME;
+}
+
+/* the same on a thread of the program, with a line in the log when it changes */
+static BOOL behind_a_claim(void)
+{
+    static LONG logged;
+    DWORD self = process_self();
+    BOOL behind;
+
+    get_vram_shared();
+    behind = claim_active_for_other( self );
+    if (InterlockedExchange( &logged, behind ) != behind)
+    {
+        if (behind) MESSAGE( "vulkan: the program in front needs video memory: process %04x keeps a share\n", (int)self );
+        else MESSAGE( "vulkan: process %04x has its whole video memory budget again\n", (int)self );
+    }
+    return behind;
+}
+
+/* the process in front renews its claim; one no longer in front gives it up */
+static void renew_claim(void)
+{
+    struct vram_shared *shared = get_vram_shared();
+    DWORD self;
+
+    if (!shared || ReadAcquire( &shared->claimed_by ) != (self = process_self())) return;
+    if (foreground_process() == self) WriteRelease( &shared->claimed_at, now_ms() );
+    else InterlockedCompareExchange( &shared->claimed_by, 0, self );
+}
+
+/* The process in front notes that a device-local heap is short for it: its
+ * budget has less than a sixteenth of the heap left, or (size) does not fit. */
+static void claim_if_short( struct vulkan_physical_device *physical_device, uint32_t heap,
+                            const VkPhysicalDeviceMemoryBudgetPropertiesEXT *budget, VkDeviceSize size )
+{
+    const VkMemoryHeap *props = &physical_device->memory_properties.memoryHeaps[heap];
+    struct vram_shared *shared;
+    DWORD self;
+
+    if (!physical_device->discrete || !(props->flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)) return;
+    if (budget && budget->heapBudget[heap] &&
+        budget->heapUsage[heap] + size + props->size / 16 < budget->heapBudget[heap]) return;
+    if (!(shared = get_vram_shared())) return;
+    if ((self = process_self()) != foreground_process()) return;
+    WriteRelease( &shared->claimed_at, now_ms() );
+    if (InterlockedExchange( &shared->claimed_by, self ) != self)
+        MESSAGE( "vulkan: process %04x in front is short of video memory: the processes behind it give theirs back\n",
+                 (int)self );
+}
+
+/* what a process behind keeps of a heap: enough for its windows */
+static VkDeviceSize background_share( const VkMemoryHeap *heap )
+{
+    return max( heap->size / 16, (VkDeviceSize)64 << 20 );
+}
+
+/* Whether a device-local allocation of a process behind one that ran short
+ * would take it past its share: then it goes to system memory. In the
+ * process in front, a heap found short is claimed. */
+static BOOL front_takes_vram( struct vulkan_device *device, uint32_t type_index, VkDeviceSize size )
+{
+    struct vulkan_physical_device *physical_device = device->physical_device;
+    const VkPhysicalDeviceMemoryProperties *props = &physical_device->memory_properties;
+    VkPhysicalDeviceMemoryBudgetPropertiesEXT budget = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT};
+    VkPhysicalDeviceMemoryProperties2 props2 = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2, .pNext = &budget};
+    uint32_t heap = props->memoryTypes[type_index].heapIndex;
+
+    if (!physical_device->discrete) return FALSE;
+    if (!(props->memoryHeaps[heap].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)) return FALSE;
+    if (!physical_device->instance->p_vkGetPhysicalDeviceMemoryProperties2) return FALSE;
+    physical_device->instance->p_vkGetPhysicalDeviceMemoryProperties2( physical_device->host.physical_device, &props2 );
+    if (!budget.heapBudget[heap]) return FALSE;  /* no VK_EXT_memory_budget: what it holds is not known */
+    if (!behind_a_claim())
+    {
+        claim_if_short( physical_device, heap, &budget, size );
+        return FALSE;
+    }
+    return budget.heapUsage[heap] + size > background_share( &props->memoryHeaps[heap] );
+}
+
+static void *find_vk_struct( void *s, VkStructureType t );
+
+/* Video memory management as Windows has it (VidMm), docs/games.md.
+ *
+ * When the program in front runs short of video memory (claim_if_short),
+ * Windows pages out the video memory of the programs behind it and pages it
+ * back in when it is free again. Linux drivers cannot page the video memory
+ * of a Vulkan program (NVIDIA: none of it; amdgpu, xe: by recent use only),
+ * so win32u does it: on a discrete GPU, the images and large buffers of a
+ * 64-bit process are created with VK_*_CREATE_SPARSE_BINDING_BIT and bound
+ * with vkQueueBindSparse on a queue of win32u's own, so that their GPU
+ * addresses stay when the memory behind them moves. A thread per device moves
+ * the memory objects of a process behind one that ran short to system memory,
+ * one allocation per resource (system memory types differ per kind of
+ * resource), copying their bytes on the GPU and binding them there; they come
+ * back to VRAM when nobody is short any more. Only a memory object whose
+ * every use win32u has seen moves: a resource bound to it the ordinary way,
+ * or its handle given to the driver by the thunks (pinned_host_memory: the
+ * program's own sparse binds, video sessions, priorities...), pins it in
+ * VRAM. A moved memory object is a spilled one (see win32u_vkAllocateMemory):
+ * what is bound to it meanwhile gets memory of its own.
+ * C:\ProgramData\Arctic\no-vidmm (or ARCTIC_VIDMM=0 in the environment) turns
+ * it off for programs started after. */
+
+struct vidmm_resource
+{
+    struct rb_entry rb;            /* in vidmm.resources, by host handle */
+    struct list entry;             /* in the memory object's list */
+    UINT64 handle;                 /* host VkImage or VkBuffer */
+    BOOL image;
+    VkDeviceSize size;             /* what a sparse bind of it covers */
+    uint32_t type_bits;
+    struct device_memory *memory;  /* bound to, or NULL */
+    VkDeviceSize offset;           /* in it */
+    VkDeviceMemory backing;        /* memory of its own while the object is spilled */
+};
+
+struct vidmm
+{
+    struct vulkan_device *device;
+    DWORD self;                    /* process id: the thread has no TEB */
+    pthread_mutex_t lock;          /* everything below and the queue */
+    pthread_rwlock_t submits;      /* the program's submissions: shared; moving memory: exclusive */
+    VkQueue queue;                 /* win32u's own: binds and copies */
+    VkCommandPool pool;
+    VkCommandBuffer cmd;
+    VkFence fence;
+    struct list memories;          /* pageable memory objects */
+    struct rb_tree resources;
+    pthread_t thread;
+    pthread_cond_t wake;
+    BOOL stop;
+    VkDeviceSize moved_out, moved_in;  /* since the last line in the log */
+};
+
+static int vidmm_resource_compare( const void *key, const struct rb_entry *entry )
+{
+    const struct vidmm_resource *res = RB_ENTRY_VALUE( entry, struct vidmm_resource, rb );
+    UINT64 handle = *(const UINT64 *)key;
+    return handle < res->handle ? -1 : handle > res->handle;
+}
+
+static struct vidmm_resource *vidmm_find( struct vidmm *vm, UINT64 handle )
+{
+    struct rb_entry *entry = rb_get( &vm->resources, &handle );
+    return entry ? RB_ENTRY_VALUE( entry, struct vidmm_resource, rb ) : NULL;
+}
+
+static BOOL vidmm_is_sparse( struct vidmm *vm, UINT64 handle )
+{
+    BOOL ret;
+    if (!vm || !handle) return FALSE;
+    pthread_mutex_lock( &vm->lock );
+    ret = vidmm_find( vm, handle ) != NULL;
+    pthread_mutex_unlock( &vm->lock );
+    return ret;
+}
+
+/* the queue win32u adds to a device for itself: a family that binds sparse
+ * memory and copies, with a queue the program did not take */
+static BOOL vidmm_choose_queue( struct vulkan_physical_device *physical_device, const VkDeviceCreateInfo *info,
+                                uint32_t *family, uint32_t *index )
+{
+    struct vulkan_instance *instance = physical_device->instance;
+    VkQueueFamilyProperties *props;
+    VkPhysicalDeviceFeatures features;
+    const char *env = getenv( "ARCTIC_VIDMM" ), *prefix = getenv( "NTPREFIX" );
+    uint32_t count = 0, f, i;
+    BOOL found = FALSE;
+    char off[PATH_MAX];
+
+    if (!physical_device->discrete || zero_bits || (env && *env == '0')) return FALSE;
+    /* C:\ProgramData\Arctic\no-vidmm turns it off for programs started after */
+    if (!prefix) prefix = getenv( "WINEPREFIX" );
+    if (prefix && snprintf( off, sizeof(off), "%s/dosdevices/c:/ProgramData/Arctic/no-vidmm", prefix ) < sizeof(off) &&
+        !access( off, F_OK ))
+        return FALSE;
+    instance->p_vkGetPhysicalDeviceFeatures( physical_device->host.physical_device, &features );
+    if (!features.sparseBinding) return FALSE;
+    instance->p_vkGetPhysicalDeviceQueueFamilyProperties( physical_device->host.physical_device, &count, NULL );
+    if (!count || !(props = calloc( count, sizeof(*props) ))) return FALSE;
+    instance->p_vkGetPhysicalDeviceQueueFamilyProperties( physical_device->host.physical_device, &count, props );
+
+    for (f = 0; f < count && !found; f++)
+    {
+        uint32_t used = 0;
+        BOOL flagged = FALSE;
+
+        if (!(props[f].queueFlags & VK_QUEUE_SPARSE_BINDING_BIT)) continue;
+        if (!(props[f].queueFlags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT | VK_QUEUE_TRANSFER_BIT))) continue;
+        for (i = 0; i < info->queueCreateInfoCount; i++)
+        {
+            if (info->pQueueCreateInfos[i].queueFamilyIndex != f) continue;
+            used += info->pQueueCreateInfos[i].queueCount;
+            if (info->pQueueCreateInfos[i].flags) flagged = TRUE;
+        }
+        if (flagged || used >= props[f].queueCount) continue;
+        *family = f;
+        *index = used;
+        found = TRUE;
+    }
+    free( props );
+    return found;
+}
+
+/* the create info of the device with win32u's queue and sparse binding in it */
+static VkResult vidmm_add_queue( VkDeviceCreateInfo *info, struct mempool *pool, uint32_t family )
+{
+    static const float priority[64];  /* all 0: paging is background work */
+    VkDeviceQueueCreateInfo *queues;
+    VkPhysicalDeviceFeatures2 *features2;
+    VkPhysicalDeviceFeatures *features;
+    uint32_t i, count = info->queueCreateInfoCount;
+
+    if (!(queues = mem_alloc( pool, (count + 1) * sizeof(*queues) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    memcpy( queues, info->pQueueCreateInfos, count * sizeof(*queues) );
+    for (i = 0; i < count; i++) if (queues[i].queueFamilyIndex == family) break;
+    if (i < count)
+    {
+        float *priorities;
+        if (queues[i].queueCount >= ARRAY_SIZE(priority)) return VK_ERROR_INITIALIZATION_FAILED;
+        if (!(priorities = mem_alloc( pool, (queues[i].queueCount + 1) * sizeof(*priorities) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
+        memcpy( priorities, queues[i].pQueuePriorities, queues[i].queueCount * sizeof(*priorities) );
+        priorities[queues[i].queueCount] = 0.0f;
+        queues[i].pQueuePriorities = priorities;
+        queues[i].queueCount++;
+    }
+    else
+    {
+        memset( &queues[count], 0, sizeof(queues[count]) );
+        queues[count].sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
+        queues[count].queueFamilyIndex = family;
+        queues[count].queueCount = 1;
+        queues[count].pQueuePriorities = priority;
+        count++;
+    }
+    info->pQueueCreateInfos = queues;
+    info->queueCreateInfoCount = count;
+
+    if ((features2 = find_vk_struct( info, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 )))
+        features2->features.sparseBinding = VK_TRUE;
+    else
+    {
+        if (!(features = mem_alloc( pool, sizeof(*features) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
+        if (info->pEnabledFeatures) *features = *info->pEnabledFeatures;
+        else memset( features, 0, sizeof(*features) );
+        features->sparseBinding = VK_TRUE;
+        info->pEnabledFeatures = features;
+    }
+    return VK_SUCCESS;
+}
+
+static void *vidmm_thread( void *arg );
+
+static void vidmm_create( struct vulkan_device *device, uint32_t family, uint32_t index )
+{
+    VkCommandPoolCreateInfo pool_info = {.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+    VkCommandBufferAllocateInfo cmd_info = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+    VkFenceCreateInfo fence_info = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    struct vidmm *vm;
+
+    if (!(vm = calloc( 1, sizeof(*vm) ))) return;
+    vm->device = device;
+    vm->self = process_self();
+    get_vram_shared();  /* opened here, on a thread of the program */
+    pthread_mutex_init( &vm->lock, NULL );
+    {
+        /* moving memory must not wait behind a stream of submissions */
+        pthread_rwlockattr_t attr;
+        pthread_rwlockattr_init( &attr );
+        pthread_rwlockattr_setkind_np( &attr, PTHREAD_RWLOCK_PREFER_WRITER_NONRECURSIVE_NP );
+        pthread_rwlock_init( &vm->submits, &attr );
+        pthread_rwlockattr_destroy( &attr );
+    }
+    pthread_cond_init( &vm->wake, NULL );
+    list_init( &vm->memories );
+    rb_init( &vm->resources, vidmm_resource_compare );
+    device->p_vkGetDeviceQueue( device->host.device, family, index, &vm->queue );
+
+    pool_info.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pool_info.queueFamilyIndex = family;
+    cmd_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cmd_info.commandBufferCount = 1;
+    if (device->p_vkCreateCommandPool( device->host.device, &pool_info, NULL, &vm->pool )) goto failed;
+    cmd_info.commandPool = vm->pool;
+    if (device->p_vkAllocateCommandBuffers( device->host.device, &cmd_info, &vm->cmd )) goto failed;
+    if (device->p_vkCreateFence( device->host.device, &fence_info, NULL, &vm->fence )) goto failed;
+    if (pthread_create( &vm->thread, NULL, vidmm_thread, vm )) goto failed;
+
+    TRACE( "device %p: video memory managed, queue %u/%u\n", device, family, index );
+    device->vidmm = vm;
+    return;
+
+failed:
+    WARN( "device %p: no video memory management\n", device );
+    if (vm->fence) device->p_vkDestroyFence( device->host.device, vm->fence, NULL );
+    if (vm->pool) device->p_vkDestroyCommandPool( device->host.device, vm->pool, NULL );
+    free( vm );
+}
+
+static void vidmm_free_resource( struct rb_entry *entry, void *context )
+{
+    struct vulkan_device *device = context;
+    struct vidmm_resource *res = RB_ENTRY_VALUE( entry, struct vidmm_resource, rb );
+    if (res->backing) device->p_vkFreeMemory( device->host.device, res->backing, NULL );
+    free( res );
+}
+
+static void vidmm_destroy( struct vulkan_device *device )
+{
+    struct vidmm *vm = device->vidmm;
+
+    if (!vm) return;
+    pthread_mutex_lock( &vm->lock );
+    vm->stop = TRUE;
+    pthread_cond_signal( &vm->wake );
+    pthread_mutex_unlock( &vm->lock );
+    pthread_join( vm->thread, NULL );
+
+    device->p_vkDestroyFence( device->host.device, vm->fence, NULL );
+    device->p_vkDestroyCommandPool( device->host.device, vm->pool, NULL );
+    rb_destroy( &vm->resources, vidmm_free_resource, device );
+    pthread_cond_destroy( &vm->wake );
+    pthread_rwlock_destroy( &vm->submits );
+    pthread_mutex_destroy( &vm->lock );
+    device->vidmm = NULL;
+    free( vm );
+}
+
+/* what the program submitted has finished; it submits nothing until unlocked */
+static void vidmm_hold_program( struct vidmm *vm )
+{
+    struct vulkan_device *device = vm->device;
+
+    pthread_rwlock_wrlock( &vm->submits );
+    for (uint64_t i = 0; i < device->queue_count; i++) device->p_vkQueueWaitIdle( device->queues[i].host.queue );
+}
+
+static VkResult vidmm_wait( struct vidmm *vm )
+{
+    struct vulkan_device *device = vm->device;
+    VkResult res = device->p_vkWaitForFences( device->host.device, 1, &vm->fence, VK_TRUE, ~(uint64_t)0 );
+    device->p_vkResetFences( device->host.device, 1, &vm->fence );
+    return res;
+}
+
+/* binds resources (whole: opaque binds) to memory, on win32u's queue */
+static VkResult vidmm_bind_sparse( struct vidmm *vm, struct vidmm_resource **resources, const VkDeviceMemory *memories,
+                                   const VkDeviceSize *offsets, UINT count )
+{
+    struct vulkan_device *device = vm->device;
+    VkBindSparseInfo info = {.sType = VK_STRUCTURE_TYPE_BIND_SPARSE_INFO};
+    VkSparseBufferMemoryBindInfo *buffers;
+    VkSparseImageOpaqueMemoryBindInfo *images;
+    VkSparseMemoryBind *binds;
+    VkResult res;
+    UINT i;
+
+    if (!count) return VK_SUCCESS;
+    binds = calloc( count, sizeof(*binds) );
+    buffers = calloc( count, sizeof(*buffers) );
+    images = calloc( count, sizeof(*images) );
+    if (!binds || !buffers || !images)
+    {
+        res = VK_ERROR_OUT_OF_HOST_MEMORY;
+        goto done;
+    }
+    for (i = 0; i < count; i++)
+    {
+        binds[i].size = resources[i]->size;
+        binds[i].memory = memories[i];
+        binds[i].memoryOffset = offsets[i];
+        if (resources[i]->image)
+        {
+            images[info.imageOpaqueBindCount].image = (VkImage)resources[i]->handle;
+            images[info.imageOpaqueBindCount].bindCount = 1;
+            images[info.imageOpaqueBindCount++].pBinds = &binds[i];
+        }
+        else
+        {
+            buffers[info.bufferBindCount].buffer = (VkBuffer)resources[i]->handle;
+            buffers[info.bufferBindCount].bindCount = 1;
+            buffers[info.bufferBindCount++].pBinds = &binds[i];
+        }
+    }
+    info.pBufferBinds = buffers;
+    info.pImageOpaqueBinds = images;
+    if (!(res = device->p_vkQueueBindSparse( vm->queue, 1, &info, vm->fence ))) res = vidmm_wait( vm );
+
+done:
+    free( binds );
+    free( buffers );
+    free( images );
+    return res;
+}
+
+/* a buffer over (part of) a memory object, to copy its bytes */
+static VkBuffer vidmm_buffer_on( struct vidmm *vm, VkDeviceMemory memory, VkDeviceSize offset, VkDeviceSize size )
+{
+    struct vulkan_device *device = vm->device;
+    VkBufferCreateInfo info = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    VkBuffer buffer;
+
+    VkMemoryRequirements requirements;
+
+    info.size = size;
+    info.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    if (device->p_vkCreateBuffer( device->host.device, &info, NULL, &buffer )) return VK_NULL_HANDLE;
+    /* a buffer may need more than its size: then one a little smaller, within the memory */
+    device->p_vkGetBufferMemoryRequirements( device->host.device, buffer, &requirements );
+    if (requirements.size > size && requirements.alignment)
+    {
+        device->p_vkDestroyBuffer( device->host.device, buffer, NULL );
+        info.size = size & ~(requirements.alignment - 1);
+        if (!info.size || device->p_vkCreateBuffer( device->host.device, &info, NULL, &buffer )) return VK_NULL_HANDLE;
+    }
+    if (device->p_vkBindBufferMemory( device->host.device, buffer, memory, offset ))
+    {
+        device->p_vkDestroyBuffer( device->host.device, buffer, NULL );
+        return VK_NULL_HANDLE;
+    }
+    return buffer;
+}
+
+/* copies the bytes of each resource between its place in a memory object
+ * and its own memory, on the GPU (out: to its own memory) */
+static VkResult vidmm_copy( struct vidmm *vm, VkDeviceMemory block, VkDeviceSize block_size,
+                            struct vidmm_resource **resources, const VkDeviceMemory *own, UINT count, BOOL out )
+{
+    struct vulkan_device *device = vm->device;
+    VkCommandBufferBeginInfo begin = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    VkMemoryBarrier barrier = {.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    VkSubmitInfo submit = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    VkBuffer block_buffer, *pieces;
+    VkResult res = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+    UINT i;
+
+    if (!(pieces = calloc( count, sizeof(*pieces) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    if (!(block_buffer = vidmm_buffer_on( vm, block, 0, block_size ))) goto done;
+    for (i = 0; i < count; i++) if (!(pieces[i] = vidmm_buffer_on( vm, own[i], 0, resources[i]->size ))) goto done;
+
+    device->p_vkResetCommandBuffer( vm->cmd, 0 );
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    device->p_vkBeginCommandBuffer( vm->cmd, &begin );
+    barrier.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+    device->p_vkCmdPipelineBarrier( vm->cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                    0, 1, &barrier, 0, NULL, 0, NULL );
+    for (i = 0; i < count; i++)
+    {
+        VkBufferCopy region = {.size = resources[i]->size};
+        if (out) region.srcOffset = resources[i]->offset;
+        else region.dstOffset = resources[i]->offset;
+        device->p_vkCmdCopyBuffer( vm->cmd, out ? block_buffer : pieces[i], out ? pieces[i] : block_buffer, 1, &region );
+    }
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    device->p_vkCmdPipelineBarrier( vm->cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                                    0, 1, &barrier, 0, NULL, 0, NULL );
+    device->p_vkEndCommandBuffer( vm->cmd );
+    submit.commandBufferCount = 1;
+    submit.pCommandBuffers = &vm->cmd;
+    if (!(res = device->p_vkQueueSubmit( vm->queue, 1, &submit, vm->fence ))) res = vidmm_wait( vm );
+
+done:
+    for (i = 0; i < count; i++) if (pieces[i]) device->p_vkDestroyBuffer( device->host.device, pieces[i], NULL );
+    if (block_buffer) device->p_vkDestroyBuffer( device->host.device, block_buffer, NULL );
+    free( pieces );
+    return res;
+}
+
+static void vidmm_rekey( struct vulkan_device *device, struct device_memory *memory, VkDeviceMemory host )
+{
+    struct vulkan_instance *instance = device->physical_device->instance;
+    instance->p_remove_object( instance, &memory->obj.obj );
+    memory->obj.obj.host_handle = (UINT_PTR)host;
+    instance->p_insert_object( instance, &memory->obj.obj );
+}
+
+static VkResult vidmm_allocate( struct vulkan_device *device, struct device_memory *memory, uint32_t type,
+                                VkDeviceSize size, VkDeviceMemory *ret )
+{
+    VkMemoryAllocateFlagsInfo flags = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO};
+    VkMemoryAllocateInfo info = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+
+    flags.flags = memory->alloc_flags;
+    flags.deviceMask = memory->device_mask;
+    info.pNext = memory->alloc_flags ? &flags : NULL;
+    info.allocationSize = size;
+    info.memoryTypeIndex = type;
+    return device->p_vkAllocateMemory( device->host.device, &info, NULL, ret );
+}
+
+static void vidmm_init_spill( struct device_memory *memory )
+{
+    if (memory->spill_lock_ready) return;
+    pthread_mutex_init( &memory->spill_lock, NULL );
+    memory->spill_lock_ready = TRUE;
+}
+
+/* a memory object out of VRAM: each resource in it to system memory of its own */
+static BOOL vidmm_move_out( struct vidmm *vm, struct device_memory *memory )
+{
+    struct vulkan_device *device = vm->device;
+    struct vidmm_resource **resources = NULL, *res;
+    VkDeviceMemory *own = NULL;
+    VkDeviceSize *zero = NULL;
+    UINT count = 0, i;
+    BOOL ok = FALSE;
+
+    LIST_FOR_EACH_ENTRY( res, &memory->resources, struct vidmm_resource, entry ) count++;
+    if (count && (!(resources = calloc( count, sizeof(*resources) )) || !(own = calloc( count, sizeof(*own) )) ||
+                  !(zero = calloc( count, sizeof(*zero) ))))
+        goto done;
+    i = 0;
+    LIST_FOR_EACH_ENTRY( res, &memory->resources, struct vidmm_resource, entry )
+    {
+        uint32_t type = system_memory_type( device, res->type_bits );
+        resources[i] = res;
+        if (type == ~0u || vidmm_allocate( device, memory, type, res->size, &own[i] )) goto done;
+        i++;
+    }
+
+    vidmm_hold_program( vm );
+    if (!count || (!vidmm_copy( vm, memory->obj.host.device_memory, memory->size, resources, own, count, TRUE ) &&
+                   !vidmm_bind_sparse( vm, resources, own, zero, count )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            resources[i]->backing = own[i];
+            own[i] = VK_NULL_HANDLE;
+        }
+        device->p_vkFreeMemory( device->host.device, memory->obj.host.device_memory, NULL );
+        vidmm_init_spill( memory );
+        memory->spill = TRUE;
+        memory->spill_type = memory->type_index;
+        memory->moved = TRUE;
+        vidmm_rekey( device, memory, (VkDeviceMemory)(UINT_PTR)memory );  /* a unique key, never given to the driver */
+        vm->moved_out += memory->size;
+        ok = TRUE;
+    }
+    pthread_rwlock_unlock( &vm->submits );
+
+done:
+    for (i = 0; i < count && own; i++) if (own[i]) device->p_vkFreeMemory( device->host.device, own[i], NULL );
+    free( resources );
+    free( own );
+    free( zero );
+    return ok;
+}
+
+/* a spilled memory object into VRAM: its resources back in their places */
+static BOOL vidmm_move_in( struct vidmm *vm, struct device_memory *memory )
+{
+    struct vulkan_device *device = vm->device;
+    struct vidmm_resource **resources = NULL, *res;
+    VkDeviceMemory host = VK_NULL_HANDLE, *own = NULL, *targets = NULL;
+    VkDeviceSize *offsets = NULL;
+    UINT count = 0, i;
+    BOOL ok = FALSE;
+
+    LIST_FOR_EACH_ENTRY( res, &memory->resources, struct vidmm_resource, entry ) count++;
+    if (count && (!(resources = calloc( count, sizeof(*resources) )) || !(own = calloc( count, sizeof(*own) )) ||
+                  !(targets = calloc( count, sizeof(*targets) )) || !(offsets = calloc( count, sizeof(*offsets) ))))
+        goto done;
+    if (vidmm_allocate( device, memory, memory->type_index, memory->size, &host )) goto done;
+    i = 0;
+    LIST_FOR_EACH_ENTRY( res, &memory->resources, struct vidmm_resource, entry )
+    {
+        resources[i] = res;
+        own[i] = res->backing;
+        targets[i] = host;
+        offsets[i] = res->offset;
+        i++;
+    }
+
+    vidmm_hold_program( vm );
+    if (!count || (!vidmm_copy( vm, host, memory->size, resources, own, count, FALSE ) &&
+                   !vidmm_bind_sparse( vm, resources, targets, offsets, count )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            device->p_vkFreeMemory( device->host.device, resources[i]->backing, NULL );
+            resources[i]->backing = VK_NULL_HANDLE;
+        }
+        memory->spill = FALSE;
+        memory->moved = FALSE;
+        vidmm_rekey( device, memory, host );
+        host = VK_NULL_HANDLE;
+        vm->moved_in += memory->size;
+        ok = TRUE;
+    }
+    pthread_rwlock_unlock( &vm->submits );
+
+done:
+    if (host) device->p_vkFreeMemory( device->host.device, host, NULL );
+    free( resources );
+    free( own );
+    free( targets );
+    free( offsets );
+    return ok;
+}
+
+/* behind one that ran short: out of VRAM down to the share; else back in what fits */
+static void vidmm_balance( struct vidmm *vm, BOOL behind )
+{
+    struct vulkan_device *device = vm->device;
+    struct vulkan_physical_device *physical_device = device->physical_device;
+    const VkPhysicalDeviceMemoryProperties *props = &physical_device->memory_properties;
+    VkPhysicalDeviceMemoryBudgetPropertiesEXT budget = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT};
+    VkPhysicalDeviceMemoryProperties2 props2 = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2, .pNext = &budget};
+    const VkDeviceSize step = (VkDeviceSize)256 << 20;  /* at most per round: the program waits meanwhile */
+    VkDeviceSize done = 0;
+
+    if (!physical_device->instance->p_vkGetPhysicalDeviceMemoryProperties2) return;
+    physical_device->instance->p_vkGetPhysicalDeviceMemoryProperties2( physical_device->host.physical_device, &props2 );
+
+    while (done < step)
+    {
+        struct device_memory *memory, *best = NULL;
+        uint32_t heap;
+
+        LIST_FOR_EACH_ENTRY( memory, &vm->memories, struct device_memory, vidmm_entry )
+        {
+            if (behind && memory->spill) continue;           /* out already */
+            if (!behind && !memory->spill) continue;         /* in already */
+            heap = props->memoryTypes[memory->type_index].heapIndex;
+            if (behind && budget.heapUsage[heap] <= background_share( &props->memoryHeaps[heap] )) continue;
+            if (!behind && budget.heapUsage[heap] + memory->size + props->memoryHeaps[heap].size / 16 > budget.heapBudget[heap]) continue;
+            if (!best || memory->size > best->size) best = memory;
+        }
+        if (!best) break;
+        heap = props->memoryTypes[best->type_index].heapIndex;
+        if (behind ? vidmm_move_out( vm, best ) : vidmm_move_in( vm, best ))
+        {
+            if (behind) budget.heapUsage[heap] -= min( best->size, budget.heapUsage[heap] );
+            else budget.heapUsage[heap] += best->size;
+        }
+        else
+        {
+            /* it will not move: leave it where it is from now on */
+            best->pageable = FALSE;
+            list_remove( &best->vidmm_entry );
+            list_init( &best->vidmm_entry );
+        }
+        done += best->size;
+    }
+
+    if (vm->moved_out || vm->moved_in)
+    {
+        fprintf( stderr, "vulkan: process %04x: %llu MB of video memory to system memory, %llu MB back, for the program in front\n",
+                 (int)vm->self, (unsigned long long)(vm->moved_out >> 20), (unsigned long long)(vm->moved_in >> 20) );
+        vm->moved_out = vm->moved_in = 0;
+    }
+}
+
+static void *vidmm_thread( void *arg )
+{
+    struct vidmm *vm = arg;
+
+    pthread_mutex_lock( &vm->lock );
+    while (!vm->stop)
+    {
+        struct timespec deadline;
+
+        clock_gettime( CLOCK_REALTIME, &deadline );
+        deadline.tv_nsec += 250 * 1000000;
+        if (deadline.tv_nsec >= 1000000000)
+        {
+            deadline.tv_sec++;
+            deadline.tv_nsec -= 1000000000;
+        }
+        pthread_cond_timedwait( &vm->wake, &vm->lock, &deadline );
+        if (vm->stop || list_empty( &vm->memories )) continue;
+        vidmm_balance( vm, claim_active_for_other( vm->self ) );
+    }
+    pthread_mutex_unlock( &vm->lock );
+    return NULL;
+}
+
+/* A memory object whose use win32u does not see stays in VRAM from now on;
+ * one moved out comes back first. */
+static void vidmm_pin_locked( struct vidmm *vm, struct device_memory *memory )
+{
+    WriteRelease( &memory->obj.pinned, 1 );
+    if (!memory->pageable) return;
+    memory->pageable = FALSE;
+    list_remove( &memory->vidmm_entry );
+    list_init( &memory->vidmm_entry );
+    if (memory->moved && !vidmm_move_in( vm, memory ))
+        ERR( "a memory object out of VRAM is used where it cannot be followed\n" );
+}
+
+static void win32u_pin_device_memory( VkDeviceMemory client_memory )
+{
+    struct device_memory *memory = device_memory_from_handle( client_memory );
+    struct vidmm *vm = memory->vm;
+
+    if (!vm)
+    {
+        WriteRelease( &memory->obj.pinned, 1 );
+        return;
+    }
+    pthread_mutex_lock( &vm->lock );
+    vidmm_pin_locked( vm, memory );
+    pthread_mutex_unlock( &vm->lock );
+}
+
+/* whether nothing in a create info's chain keeps the resource from being sparse;
+ * vkCreateImage and vkCreateBuffer decide the same way */
+static BOOL vidmm_chain_ok( const void *chain, BOOL image )
+{
+    for (const VkBaseInStructure *next = chain; next; next = next->pNext)
+    {
+        switch (next->sType)
+        {
+        case VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO:
+        case VK_STRUCTURE_TYPE_IMAGE_STENCIL_USAGE_CREATE_INFO:
+        case VK_STRUCTURE_TYPE_IMAGE_COMPRESSION_CONTROL_EXT:
+        case VK_STRUCTURE_TYPE_IMAGE_ALIGNMENT_CONTROL_CREATE_INFO_MESA:
+            if (!image) return FALSE;
+            break;
+        case VK_STRUCTURE_TYPE_BUFFER_USAGE_FLAGS_2_CREATE_INFO:
+            if (image) return FALSE;
+            break;
+        default:
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+/* whether a resource of these properties is made sparse: one that can be,
+ * large enough, and that accepts the same memory types as it would otherwise
+ * (a program picks memory by them) */
+static BOOL vidmm_image_wanted( struct vulkan_device *device, VkImageCreateInfo *info, BOOL chain_ok )
+{
+    struct vulkan_physical_device *physical_device = device->physical_device;
+    VkDeviceImageMemoryRequirements query = {.sType = VK_STRUCTURE_TYPE_DEVICE_IMAGE_MEMORY_REQUIREMENTS};
+    VkMemoryRequirements2 plain = {.sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2};
+    VkMemoryRequirements2 sparse = {.sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2};
+    VkImageFormatProperties format;
+    VkImageCreateFlags flags = info->flags;
+
+    if (!device->vidmm || !chain_ok || !device->p_vkGetDeviceImageMemoryRequirements) return FALSE;
+    if (info->tiling != VK_IMAGE_TILING_OPTIMAL) return FALSE;
+    if (flags & (VK_IMAGE_CREATE_SPARSE_BINDING_BIT | VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT | VK_IMAGE_CREATE_SPARSE_ALIASED_BIT |
+                 VK_IMAGE_CREATE_PROTECTED_BIT | VK_IMAGE_CREATE_DISJOINT_BIT | VK_IMAGE_CREATE_SUBSAMPLED_BIT_EXT |
+                 VK_IMAGE_CREATE_DESCRIPTOR_BUFFER_CAPTURE_REPLAY_BIT_EXT | VK_IMAGE_CREATE_ALIAS_BIT))
+        return FALSE;
+    if (info->usage & VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT) return FALSE;
+    if (physical_device->instance->p_vkGetPhysicalDeviceImageFormatProperties( physical_device->host.physical_device,
+            info->format, info->imageType, info->tiling, info->usage, flags | VK_IMAGE_CREATE_SPARSE_BINDING_BIT, &format ))
+        return FALSE;
+
+    query.pCreateInfo = info;
+    device->p_vkGetDeviceImageMemoryRequirements( device->host.device, &query, &plain );
+    if (plain.memoryRequirements.size < 64 * 1024) return FALSE;
+    info->flags = flags | VK_IMAGE_CREATE_SPARSE_BINDING_BIT;
+    device->p_vkGetDeviceImageMemoryRequirements( device->host.device, &query, &sparse );
+    info->flags = flags;
+    return sparse.memoryRequirements.memoryTypeBits == plain.memoryRequirements.memoryTypeBits;
+}
