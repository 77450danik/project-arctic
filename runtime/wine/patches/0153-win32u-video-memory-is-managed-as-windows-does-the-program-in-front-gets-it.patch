+/* The budget of a process behind the one in front that ran short is its
+ * share of the VRAM (see behind_a_claim); what it uses stays what it uses,
+ * so DXVK and vkd3d see that they are over it and move resources out. In
+ * the process in front, a heap nearly full is claimed. */
+static void get_physical_device_memory_properties2( struct vulkan_physical_device *physical_device,
+                                                    VkPhysicalDeviceMemoryProperties2 *properties2,
+                                                    PFN_vkGetPhysicalDeviceMemoryProperties2 p_vkGetPhysicalDeviceMemoryProperties2 )
+{
+    const VkPhysicalDeviceMemoryProperties *props = &properties2->memoryProperties;
+    VkPhysicalDeviceMemoryBudgetPropertiesEXT *budget;
+    uint32_t i;
+
+    p_vkGetPhysicalDeviceMemoryProperties2( physical_device->host.physical_device, properties2 );
+
+    if (!physical_device->discrete) return;
+    if (!(budget = find_vk_struct( properties2, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT ))) return;
+    if (!behind_a_claim())
+    {
+        renew_claim();
+        for (i = 0; i < props->memoryHeapCount; i++) claim_if_short( physical_device, i, budget, 0 );
+        return;
+    }
+
+    for (i = 0; i < props->memoryHeapCount; i++)
+    {
+        if (!(props->memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) || !budget->heapBudget[i]) continue;
+        budget->heapBudget[i] = min( budget->heapBudget[i], background_share( &props->memoryHeaps[i] ) );
+    }
+}
