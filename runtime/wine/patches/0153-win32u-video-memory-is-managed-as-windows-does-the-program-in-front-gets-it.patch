+    {
+        list_remove( &res->entry );
+        res->memory = memory;
+        res->offset = offset;
+        list_add_tail( &memory->resources, &res->entry );
+    }
+    else if (res->backing)
+    {
+        device->p_vkFreeMemory( device->host.device, res->backing, NULL );
+        res->backing = VK_NULL_HANDLE;
+    }
+    pthread_mutex_unlock( &vm->lock );
+    return TRUE;
+}
+
+/* a memory object freed: what was bound to it is bound to nothing */
+static void vidmm_forget_memory( struct vulkan_device *device, struct device_memory *memory )
+{
+    struct vidmm *vm = device->vidmm;  /* sparse resources may be bound to memory it does not page */
+    struct vidmm_resource *res, *next;
+
+    if (!vm) return;
+    pthread_mutex_lock( &vm->lock );
+    LIST_FOR_EACH_ENTRY_SAFE( res, next, &memory->resources, struct vidmm_resource, entry )
+    {
+        if (res->backing) device->p_vkFreeMemory( device->host.device, res->backing, NULL );
+        res->backing = VK_NULL_HANDLE;
+        res->memory = NULL;
+        list_remove( &res->entry );
+        list_init( &res->entry );
+    }
+    list_remove( &memory->vidmm_entry );
+    list_init( &memory->vidmm_entry );
+    pthread_mutex_unlock( &vm->lock );
+}
