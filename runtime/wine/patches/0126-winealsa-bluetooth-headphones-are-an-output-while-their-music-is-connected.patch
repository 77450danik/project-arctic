+/* Arctic: Bluetooth headphones. winebth.sys plays to them what programs play
+ * to the loopback card "Bluetooth" (arctic-init loads snd-aloop as it), and
+ * says in /dev/shm/arctic-bt-audio which device has the music now. The card
+ * is an output only then, named after the device, as Windows names it, and
+ * the default output while it is there, as in Windows; its dmix plays at
+ * what the driver reads, 48 kHz in 16 bits. */
+#define BLUETOOTH_CARD_ID "Bluetooth"
+#define BLUETOOTH_STATE "/dev/shm/arctic-bt-audio"
+#define BLUETOOTH_OUTPUT_FORMAT "plug:'dmix:CARD=%u,DEV=0,SUBDEV=0,FORMAT=S16_LE,RATE=48000'"
+/* the headset's microphone (hands-free): the loopback's second substream, which
+ * the driver plays what the headset hears to, in the same format */
+#define BLUETOOTH_INPUT_FORMAT "plug:'dsnoop:CARD=%u,DEV=1,SUBDEV=1,FORMAT=S16_LE,RATE=48000'"
+
+static BOOL is_bluetooth_card(unsigned int card)
+{
+    char path[64], id[32] = "";
+    FILE *f;
+
+    snprintf(path, sizeof(path), "/proc/asound/card%u/id", card);
+    if (!(f = fopen(path, "r")))
+        return FALSE;
+    if (!fgets(id, sizeof(id), f)) id[0] = 0;
+    fclose(f);
+    id[strcspn(id, "\n")] = 0;
+    return !strcmp(id, BLUETOOTH_CARD_ID);
+}
+
+/* the name of the device whose music plays, whether its microphone is there; FALSE: none */
+static BOOL bluetooth_device_name(char *buf, size_t size, BOOL *hfp)
+{
+    char line[300];
+    BOOL found = FALSE;
+    FILE *f = fopen(BLUETOOTH_STATE, "r");
+
+    if (hfp)
+        *hfp = FALSE;
+    if (!f)
+        return FALSE;
+    while (fgets(line, sizeof(line), f))
+    {
+        line[strcspn(line, "\n")] = 0;
+        if (!strcmp(line, "hfp=1") && hfp)
+            *hfp = TRUE;
+        if (strncmp(line, "name=", 5)) continue;
+        snprintf(buf, size, "%s", line + 5);
+        found = buf[0] != 0;
+    }
+    fclose(f);
+    return found;
+}
