From: 77450danik <ddziuba1@stu.vistula.edu.pl>
Date: Wed, 4 Nov 2026 12:00:00 +0100
Subject: [PATCH] win32u: System colours changed by another process reach every program.

The dark mode of desk.cpl's Personalization sets the system colours
(SetSysColors) from its own process. Each process had read them once and
kept them, with their brushes and pens, so a program already open stayed
light: Notepad's page white under white text. In Windows the colours, and
the brushes GetSysColorBrush gives, are the kernel's, one set for all. Here
every process reads the colours anew when it hears WM_SYSCOLORCHANGE, which
SetSysColors sends to every window, and the brushes and pens it has of
them take the new colours in place, since programs keep those handles;
the window draws itself again, its frame and menu bar too.
---
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -7845,6 +7845,25 @@
     return system_colors[index].pen;
 }
 
+/* Arctic: the system colours are read anew after another process changed
+ * them (SetSysColors, WM_SYSCOLORCHANGE), as they are one set for all
+ * programs in Windows; this process's brushes and pens of them, which
+ * programs keep (GetSysColorBrush), take the new colours in place */
+void refresh_sys_colors(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE( system_colors ); i++)
+    {
+        COLORREF color;
+
+        system_colors[i].hdr.loaded = FALSE;
+        color = get_sys_color( i );
+        if (system_colors[i].brush) set_brush_color( system_colors[i].brush, color );
+        if (system_colors[i].pen) set_pen_color( system_colors[i].pen, color );
+    }
+}
+
 /**********************************************************************
  *	     NtUserGetDoubleClickTime    (win32u.@)
  */
--- a/dlls/win32u/brush.c
+++ b/dlls/win32u/brush.c
@@ -368,3 +368,14 @@
     GDI_ReleaseObj( handle );
     return count;
 }
+
+/* Arctic: the brush of a system colour takes its new value in place when
+ * another process changes it (sysparams.c, refresh_sys_colors) */
+void set_brush_color( HBRUSH handle, COLORREF color )
+{
+    BRUSHOBJ *brush;
+
+    if (!(brush = GDI_GetObjPtr( handle, NTGDI_OBJ_BRUSH ))) return;
+    if (brush->logbrush.lbStyle == BS_SOLID) brush->logbrush.lbColor = color;
+    GDI_ReleaseObj( handle );
+}
--- a/dlls/win32u/pen.c
+++ b/dlls/win32u/pen.c
@@ -315,3 +315,14 @@
     GDI_ReleaseObj( handle );
     return ret;
 }
+
+/* Arctic: the pen of a system colour takes its new value in place when
+ * another process changes it (sysparams.c, refresh_sys_colors) */
+void set_pen_color( HPEN handle, COLORREF color )
+{
+    PENOBJ *pen;
+
+    if (!(pen = GDI_GetObjPtr( handle, NTGDI_OBJ_PEN ))) return;
+    pen->logpen.elpColor = color;
+    GDI_ReleaseObj( handle );
+}
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2365,6 +2365,15 @@
     SIZE_T extra_buffer_size = 0;
     LRESULT result = 0;
     CWPSTRUCT cwp;
+
+    /* Arctic: the system colours changed, maybe in another process: this
+     * one reads them anew, and the window draws itself again with them, its
+     * frame and menu bar too, as Windows redraws every window */
+    if (msg == WM_SYSCOLORCHANGE)
+    {
+        refresh_sys_colors();
+        NtUserRedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+    }
     CWPRETSTRUCT cwpret;
     size_t ret_len = 0;
 
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -184,6 +184,9 @@
 extern COLORREF get_sys_color( int index );
 extern HBRUSH get_sys_color_brush( unsigned int index );
 extern HPEN get_sys_color_pen( unsigned int index );
+extern void refresh_sys_colors(void);
+extern void set_brush_color( HBRUSH handle, COLORREF color );
+extern void set_pen_color( HPEN handle, COLORREF color );
 extern UINT get_system_dpi(void);
 extern int get_system_metrics( int index );
 extern struct ratio get_thread_dpi(void);
