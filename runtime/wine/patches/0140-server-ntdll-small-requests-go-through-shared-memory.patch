+
+/* Arctic: fast calls (fastcall_area_t in protocol.def, the client side in
+ * ntdll/unix/server.c). A process gives the server a sealed memfd with a
+ * slot for each of its threads and an eventfd. The server takes posted
+ * requests from the slots between its other events, keeps looking for more
+ * for a short while when they come close together, and before it sleeps in
+ * epoll it tells every process to ring the doorbell. Nothing in the slots is
+ * trusted: the request is copied out and checked like one read from a pipe. */
+
+#ifdef __linux__
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <linux/futex.h>
+
+struct fastcall_process
+{
+    struct list       entry;          /* in fastcall_list */
+    struct process   *process;        /* not referenced: the process takes this away when it goes */
+    fastcall_area_t  *area;
+    struct fd        *doorbell;
+    struct thread    *threads[FASTCALL_SLOTS];
+};
+
+static struct list fastcall_list = LIST_INIT( fastcall_list );
+static timeout_t fastcall_last;               /* monotonic time of the last fast call */
+static timeout_t fastcall_gap = TICKS_PER_SEC; /* average time between fast calls */
+static int fastcall_sleeping;
+
+/* the longest the server looks for more fast calls before it sleeps: past
+ * that, being woken by the doorbell costs less than spinning */
+#define FASTCALL_SPIN_MAX (500)  /* 50 us in ticks */
+
+static void fastcall_doorbell_event( struct fd *fd, int event );
+
+static const struct fd_ops fastcall_fd_ops =
+{
+    .poll_event = fastcall_doorbell_event,
+};
+
+static void fastcall_set_sleeping( int sleeping )
+{
+    struct fastcall_process *fp;
+
+    if (fastcall_sleeping == sleeping) return;
+    fastcall_sleeping = sleeping;
+    LIST_FOR_EACH_ENTRY( fp, &fastcall_list, struct fastcall_process, entry )
+        __atomic_store_n( &fp->area->server_sleeping, sleeping, __ATOMIC_SEQ_CST );
+}
+
+static void fastcall_send_reply( struct thread *thread, union generic_reply *reply )
+{
+    struct fastcall_process *fp = thread->process->fastcall;
+    fastcall_slot_t *slot;
+
+    thread->fastcall_reply = 0;
+    if (!fp || thread->fastcall_slot < 0) return;
+    slot = &fp->area->slots[thread->fastcall_slot];
+
+    memcpy( (void *)slot->reply, reply, sizeof(*reply) );
+    if (thread->reply_size)
+        memcpy( (void *)slot->data, thread->reply_data, min( thread->reply_size, FASTCALL_DATA_SIZE ));
+    free( thread->reply_data );
+    thread->reply_data = NULL;
+    __atomic_store_n( &slot->state, FASTCALL_REPLIED, __ATOMIC_SEQ_CST );
+    if (__atomic_load_n( &slot->waiting, __ATOMIC_SEQ_CST ))
+        syscall( SYS_futex, (int *)&slot->state, FUTEX_WAKE, 1, NULL, NULL, 0 );
+}
+
+/* handle the request posted in a slot */
+static void fastcall_handle( struct fastcall_process *fp, unsigned int index )
+{
+    struct thread *thread = fp->threads[index];
+    fastcall_slot_t *slot = &fp->area->slots[index];
+    data_size_t size;
+
+    if (!thread || thread->state == TERMINATED) return;
+    if (__atomic_load_n( &slot->state, __ATOMIC_ACQUIRE ) != FASTCALL_POSTED) return;
+    if (thread->req_toread || thread->reply_towrite || thread->req_data)
+    {
+        /* a thread makes one request at a time: this one did not */
+        fatal_protocol_error( thread, "fast call during a pipe request\n" );
+        return;
+    }
+
+    memcpy( &thread->req, (void *)slot->req, sizeof(thread->req) );
+    size = thread->req.request_header.request_size;
+    if (size > FASTCALL_DATA_SIZE || thread->req.request_header.reply_size > FASTCALL_DATA_SIZE)
+    {
+        fatal_protocol_error( thread, "fast call of %u bytes\n", size );
+        return;
+    }
+    if (size)
+    {
+        if (!(thread->req_data = malloc( size )))
+        {
+            fatal_protocol_error( thread, "no memory for %u bytes request %d\n", size,
+                                  thread->req.request_header.req );
+            return;
+        }
+        memcpy( thread->req_data, (void *)slot->data, size );
+    }
+
+    grab_object( thread );
+    set_current_time();
+    thread->fastcall_reply = 1;
+    call_req_handler( thread );
+    thread->fastcall_reply = 0;
+    free( thread->req_data );
+    thread->req_data = NULL;
+    release_object( thread );
+}
+
+/* handle the posted requests of every process; the number handled */
+static int fastcall_scan(void)
+{
+    struct fastcall_process *fp;
+    int handled = 0, found;
+
+    do
+    {
+        found = 0;
+        LIST_FOR_EACH_ENTRY( fp, &fastcall_list, struct fastcall_process, entry )
+        {
+            unsigned int i;
+
+            for (i = 0; i < FASTCALL_SLOTS / 64; i++)
+            {
+                unsigned __int64 bits;
+
+                struct process *process = fp->process;
+
+                if (!__atomic_load_n( &fp->area->pending[i], __ATOMIC_RELAXED )) continue;
+                bits = __atomic_exchange_n( &fp->area->pending[i], 0, __ATOMIC_SEQ_CST );
+                grab_object( process );  /* fp stays while we use it */
+                while (bits)
+                {
+                    unsigned int bit = __builtin_ctzll( bits );
+                    timeout_t now = monotonic_counter();
+
+                    bits &= bits - 1;
+                    fastcall_gap = (fastcall_gap * 7 + (now - fastcall_last)) / 8;
+                    fastcall_last = now;
+                    fastcall_handle( fp, i * 64 + bit );
+                    handled++;
+                }
+                release_object( process );  /* may free fp: not used after this */
+                found = 1;
+                break;
+            }
+            /* a request may have taken processes away: start the list again */
+            if (found) break;
+        }
+    } while (found);
+    return handled;
+}
+
+/* called by the main loop before it waits: handle fast calls, spin for more
+ * while they come close together; non-zero when it handled some (and the
+ * loop has to look at its timeouts again) */
+int fastcall_poll( int timeout )
+{
+    timeout_t end;
+    int handled;
+
+    if (list_empty( &fastcall_list )) return 0;
+    if ((handled = fastcall_scan())) return handled;
+
+    if (timeout && fastcall_gap < FASTCALL_SPIN_MAX)
+    {
+        unsigned int loops = 0;
+
+        end = monotonic_counter() + min( 2 * fastcall_gap + 20, FASTCALL_SPIN_MAX );
+        while (monotonic_counter() < end)
+        {
+            int i;
+            for (i = 0; i < 16; i++) YieldProcessor();
+            if ((handled = fastcall_scan())) return handled;
+            /* a request on a pipe, a timer, a wait: the main loop's, within
+             * a few microseconds (a look at epoll is a system call) */
+            if (!(++loops % 4) && has_poll_events()) break;
+        }
+    }
+
+    /* going to sleep: from now on the clients ring the doorbell */
+    fastcall_set_sleeping( 1 );
+    if ((handled = fastcall_scan()))
+    {
+        fastcall_set_sleeping( 0 );
+        return handled;
+    }
+    return 0;
+}
+
+/* called by the main loop when it wakes up */
+void fastcall_awake(void)
+{
+    fastcall_set_sleeping( 0 );
+}
+
+static void fastcall_doorbell_event( struct fd *fd, int event )
+{
+    UINT64 count;
+
+    if (read( get_unix_fd( fd ), &count, sizeof(count) ) < 0 && errno != EAGAIN)
+        set_fd_events( fd, -1 );
+    /* the main loop scans the slots next */
+}
+
+void fastcall_thread_gone( struct thread *thread )
+{
+    struct fastcall_process *fp = thread->process ? thread->process->fastcall : NULL;
+
+    if (fp && thread->fastcall_slot >= 0 && fp->threads[thread->fastcall_slot] == thread)
+        fp->threads[thread->fastcall_slot] = NULL;
+    thread->fastcall_slot = -1;
+}
+
+void fastcall_process_gone( struct process *process )
+{
+    struct fastcall_process *fp = process->fastcall;
+
+    if (!fp) return;
+    process->fastcall = NULL;
+    list_remove( &fp->entry );
+    if (fp->doorbell) release_object( fp->doorbell );
+    munmap( (void *)fp->area, sizeof(*fp->area) );
+    free( fp );
+}
+
+DECL_HANDLER(register_fastcall)
+{
+    struct fastcall_process *fp = current->process->fastcall;
+
+    if (req->slot >= FASTCALL_SLOTS)
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    if (!fp)
+    {
+        int area_fd, doorbell_fd, seals;
+        struct stat st;
+        void *area;
+
+        if (req->area_fd == -1 || req->doorbell_fd == -1)
+        {
+            set_error( STATUS_INVALID_PARAMETER );
+            return;
+        }
+        area_fd = thread_get_inflight_fd( current, req->area_fd );
+        doorbell_fd = thread_get_inflight_fd( current, req->doorbell_fd );
+        if (area_fd == -1 || doorbell_fd == -1)
+        {
+            if (area_fd != -1) close( area_fd );
+            if (doorbell_fd != -1) close( doorbell_fd );
+            set_error( STATUS_INVALID_HANDLE );
+            return;
+        }
+        /* the client must not be able to shrink the memory under us */
+        seals = fcntl( area_fd, F_GET_SEALS );
+        if (seals == -1 || (seals & (F_SEAL_SHRINK | F_SEAL_SEAL)) != (F_SEAL_SHRINK | F_SEAL_SEAL) ||
+            fstat( area_fd, &st ) == -1 || st.st_size < sizeof(fastcall_area_t) ||
+            (area = mmap( NULL, sizeof(fastcall_area_t), PROT_READ | PROT_WRITE, MAP_SHARED,
+                          area_fd, 0 )) == MAP_FAILED)
+        {
+            close( area_fd );
+            close( doorbell_fd );
+            set_error( STATUS_INVALID_PARAMETER );
+            return;
+        }
+        close( area_fd );
+        if (!(fp = mem_alloc( sizeof(*fp) )))
+        {
+            munmap( area, sizeof(fastcall_area_t) );
+            close( doorbell_fd );
+            return;
+        }
+        memset( fp, 0, sizeof(*fp) );
+        fp->process = current->process;
+        fp->area = area;
+        if (!(fp->doorbell = create_anonymous_fd( &fastcall_fd_ops, doorbell_fd, &current->process->obj, 0 )))
+        {
+            munmap( area, sizeof(fastcall_area_t) );
+            free( fp );
+            return;
+        }
+        set_fd_events( fp->doorbell, POLLIN );
+        __atomic_store_n( &fp->area->server_sleeping, fastcall_sleeping, __ATOMIC_SEQ_CST );
+        current->process->fastcall = fp;
+        list_add_tail( &fastcall_list, &fp->entry );
+    }
+    if (fp->threads[req->slot] && fp->threads[req->slot] != current)
+        fp->threads[req->slot]->fastcall_slot = -1;  /* a slot the process gave again */
+    if (current->fastcall_slot >= 0 && fp->threads[current->fastcall_slot] == current)
+        fp->threads[current->fastcall_slot] = NULL;
+    fp->threads[req->slot] = current;
+    current->fastcall_slot = req->slot;
+}
+
+#else  /* __linux__ */
+
+static void fastcall_send_reply( struct thread *thread, union generic_reply *reply ) { }
+void fastcall_thread_gone( struct thread *thread ) { }
+void fastcall_process_gone( struct process *process ) { }
+int fastcall_poll( int timeout ) { return 0; }
+void fastcall_awake(void) { }
+DECL_HANDLER(register_fastcall) { set_error( STATUS_NOT_SUPPORTED ); }
+
+#endif  /* __linux__ */
