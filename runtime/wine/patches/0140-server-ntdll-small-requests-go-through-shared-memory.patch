From: Project Arctic
Subject: server, ntdll: small requests go through shared memory.

A request took 6.6 us although the server spends about 1 us on it: the
rest is the request and reply pipes, and waking the server and the thread up.
On this kernel a bare system call is 0.5 us, a pipe round trip 5.3 us and a
futex round trip with both sides spinning 0.6 us (tests/tools/ipcfloor.c).

A process now gives the server a sealed memfd with a slot for each thread and
an eventfd (register_fastcall). A request that fits (4 KB of data and of
reply) goes into the thread's slot and a bit in the area's pending words; the
server takes posted slots between its other events, looks for more for up to
50 us while they come close together, and before it sleeps in epoll sets
server_sleeping in every area, after which the clients ring the doorbell. The
thread spins for its reply for up to 15 us and then sleeps on the slot's
state (a futex), checking once a second that the server is still there.
The server copies the request out of the slot and checks it like one read
from a pipe; the area must be sealed against shrinking.

Requests that do not fit, data behind a bad pointer (the pipe gives the
program its STATUS_ACCESS_VIOLATION as before), a call made while the thread
is in another and a thread beyond the 256th of a process use the pipes. So
does everything with fewer than 4 processors or NT_FASTCALL=0.
---
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index fa9138d..8ebfc5d 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -279,6 +279,252 @@ static inline unsigned int wait_reply( int reply_fd, struct __server_request_inf
 }
 
 
+/***********************************************************************
+ * Arctic: fast calls
+ *
+ * A small request goes to the server through the thread's slot of the
+ * process's fast call area (fastcall_area_t), not through the pipes: no
+ * system call while the server is busy anyway, and a short spin instead of
+ * sleeping for a reply that is a few microseconds away. The server looks
+ * for posted slots while it has work and sleeps in epoll otherwise; the
+ * doorbell eventfd wakes it then. Anything that does not fit in a slot,
+ * a request whose data the program gave us a bad pointer for (so that it
+ * gets STATUS_ACCESS_VIOLATION as before) and a call made while a fast call
+ * is in progress on the thread go through the pipes. NT_FASTCALL=0 in the
+ * environment, or fewer than 4 processors (spinning needs a processor for
+ * each side), keeps all requests on the pipes.
+ */
+#ifdef __linux__
+#include <poll.h>
+#include <time.h>
+#include <sys/eventfd.h>
+#include <linux/futex.h>
+
+static fastcall_area_t *fastcall_area;
+static int fastcall_doorbell = -1;
+static LONG64 fastcall_used[FASTCALL_SLOTS / 64];
+static unsigned int fastcall_spin_ns;  /* how long a thread spins for its reply */
+
+C_ASSERT( sizeof(union generic_request) == sizeof(((fastcall_slot_t *)0)->req) );
+C_ASSERT( sizeof(union generic_reply) == sizeof(((fastcall_slot_t *)0)->reply) );
+
+static int fastcall_futex( volatile int *addr, int op, int val, const struct timespec *timeout )
+{
+    /* not FUTEX_PRIVATE: the server shares the memory */
+    return syscall( SYS_futex, (int *)addr, op, val, timeout, NULL, 0 );
+}
+
+/* the process's area, made by the first thread */
+static int fastcall_init_process(void)
+{
+    const char *env = getenv( "NT_FASTCALL" );
+    fastcall_area_t *area;
+    int fd;
+
+    if (env && !strcmp( env, "0" )) return -1;
+    /* the server and the thread each keep a processor while they spin: below
+     * 4 that is taken from everything else. With 4 (a VM of 4 vCPUs,
+     * 2026-11-16, three runs each) CreateThread and SetWindowPos were as fast
+     * or faster than without */
+    if (sysconf( _SC_NPROCESSORS_ONLN ) < 4) return -1;
+    if ((fd = memfd_create( "nt-fastcall", MFD_CLOEXEC | MFD_ALLOW_SEALING )) == -1) return -1;
+    if (ftruncate( fd, sizeof(*area) ) == -1 ||
+        fcntl( fd, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL ) == -1 ||
+        (area = mmap( NULL, sizeof(*area), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0 )) == MAP_FAILED)
+    {
+        close( fd );
+        return -1;
+    }
+    if ((fastcall_doorbell = eventfd( 0, EFD_CLOEXEC | EFD_NONBLOCK )) == -1)
+    {
+        munmap( (void *)area, sizeof(*area) );
+        close( fd );
+        return -1;
+    }
+    fastcall_area = area;
+    /* a reply from a server that is awake takes 1-3 us, one it has to be woken
+     * for 5-10 us: longer than that, sleeping costs less than spinning */
+    fastcall_spin_ns = 15000;
+    return fd;
+}
+
+static int fastcall_alloc_slot(void)
+{
+    unsigned int i, bit;
+
+    for (i = 0; i < ARRAY_SIZE(fastcall_used); i++)
+    {
+        LONG64 used;
+        while (~(used = fastcall_used[i]))
+        {
+            bit = __builtin_ctzll( ~used );
+            if (InterlockedCompareExchange64( &fastcall_used[i], used | (1ull << bit), used ) == used)
+                return i * 64 + bit;
+        }
+    }
+    return -1;
+}
+
+static void fastcall_free_slot( unsigned int index )
+{
+    LONG64 used;
+    do used = fastcall_used[index / 64];
+    while (InterlockedCompareExchange64( &fastcall_used[index / 64], used & ~(1ull << (index % 64)), used ) != used);
+}
+
+/* register the thread's slot with the server; the first thread also gives it the area */
+static void fastcall_init_thread( struct thread_data *data, BOOL first )
+{
+    int area_fd = -1, index;
+    fastcall_slot_t *slot;
+    unsigned int status;
+
+    if (first && (area_fd = fastcall_init_process()) == -1) return;
+    if (!fastcall_area) return;
+    if ((index = fastcall_alloc_slot()) == -1) return;
+
+    slot = &fastcall_area->slots[index];
+    slot->state = FASTCALL_IDLE;
+    slot->waiting = 0;
+    if (first)
+    {
+        wine_server_send_fd( area_fd );
+        wine_server_send_fd( fastcall_doorbell );
+    }
+    SERVER_START_REQ( register_fastcall )
+    {
+        req->area_fd     = area_fd;
+        req->doorbell_fd = first ? fastcall_doorbell : -1;
+        req->slot        = index;
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    if (area_fd != -1) close( area_fd );
+
+    if (status)
+    {
+        WARN( "no fast calls: %#x\n", status );
+        fastcall_free_slot( index );
+        if (first)  /* the server does not take them: pipes only */
+        {
+            munmap( (void *)fastcall_area, sizeof(*fastcall_area) );
+            fastcall_area = NULL;
+            close( fastcall_doorbell );
+            fastcall_doorbell = -1;
+        }
+        return;
+    }
+    data->fastcall = slot;
+    data->fastcall_index = index;
+}
+
+void fastcall_exit_thread( struct thread_data *data )
+{
+    if (!data->fastcall) return;
+    data->fastcall = NULL;
+    fastcall_free_slot( data->fastcall_index );
+}
+
+/* the request through the thread's slot; FALSE if it has to go through the pipes */
+static BOOL fastcall( struct thread_data *data, struct __server_request_info *req, unsigned int *ret )
+{
+    fastcall_slot_t *slot = data->fastcall;
+    unsigned int size = req->u.req.request_header.request_size, reply_size, i, spin;
+    /* the reply goes over the request in req->u: keep what was asked for */
+    unsigned int reply_max = req->u.req.request_header.reply_size;
+    BOOL copied = FALSE, replied;
+    char *ptr;
+
+    if (size > FASTCALL_DATA_SIZE || reply_max > FASTCALL_DATA_SIZE) return FALSE;
+    if (data->jmp_buf) return FALSE;  /* inside a __TRY already */
+    if (__atomic_load_n( &slot->state, __ATOMIC_ACQUIRE ) != FASTCALL_IDLE) return FALSE;  /* a call in a call */
+    slot->state = FASTCALL_FILLING;
+
+    memcpy( (void *)slot->req, &req->u.req, sizeof(req->u.req) );
+    __TRY
+    {
+        for (i = 0, ptr = (char *)slot->data; i < req->data_count; i++)
+        {
+            memcpy( ptr, req->data[i].ptr, req->data[i].size );
+            ptr += req->data[i].size;
+        }
+        copied = TRUE;
+    }
+    __EXCEPT
+    {
+    }
+    __ENDTRY
+    if (!copied)  /* a bad pointer: the pipe gives the program its error */
+    {
+        __atomic_store_n( &slot->state, FASTCALL_IDLE, __ATOMIC_RELEASE );
+        return FALSE;
+    }
+
+    __atomic_store_n( &slot->state, FASTCALL_POSTED, __ATOMIC_SEQ_CST );
+    __atomic_fetch_or( &fastcall_area->pending[data->fastcall_index / 64],
+                       1ull << (data->fastcall_index % 64), __ATOMIC_SEQ_CST );
+    if (__atomic_load_n( &fastcall_area->server_sleeping, __ATOMIC_SEQ_CST ))
+    {
+        static const UINT64 one = 1;
+        write( fastcall_doorbell, &one, sizeof(one) );
+    }
+
+    /* the reply: spin for a while (time, not loops: a pause takes 10 to 140 cycles) */
+    replied = FALSE;
+    if (fastcall_spin_ns)
+    {
+        struct timespec now;
+        ULONGLONG end;
+
+        clock_gettime( CLOCK_MONOTONIC, &now );
+        end = now.tv_sec * 1000000000ull + now.tv_nsec + fastcall_spin_ns;
+        for (spin = 0; ; spin++)
+        {
+            if (__atomic_load_n( &slot->state, __ATOMIC_ACQUIRE ) == FASTCALL_REPLIED)
+            {
+                replied = TRUE;
+                break;
+            }
+            YieldProcessor();
+            if (spin % 16 == 15)
+            {
+                clock_gettime( CLOCK_MONOTONIC, &now );
+                if (now.tv_sec * 1000000000ull + now.tv_nsec >= end) break;
+            }
+        }
+    }
+    if (!replied)
+    {
+        static const struct timespec second = { 1, 0 };
+
+        for (;;)
+        {
+            __atomic_store_n( &slot->waiting, 1, __ATOMIC_SEQ_CST );
+            if (__atomic_load_n( &slot->state, __ATOMIC_SEQ_CST ) == FASTCALL_REPLIED) break;
+            if (fastcall_futex( &slot->state, FUTEX_WAIT, FASTCALL_POSTED, &second ) == -1 &&
+                errno == ETIMEDOUT)
+            {
+                /* is the server still there? the reply pipe hangs up when it goes */
+                struct pollfd pfd = { data->reply_fd, POLLIN, 0 };
+                if (poll( &pfd, 1, 0 ) == 1 && (pfd.revents & (POLLHUP | POLLERR))) abort_thread( 0 );
+            }
+        }
+        slot->waiting = 0;
+    }
+
+    memcpy( &req->u.reply, (void *)slot->reply, sizeof(req->u.reply) );
+    reply_size = req->u.reply.reply_header.reply_size;
+    if (reply_size) memcpy( req->reply_data, (void *)slot->data, min( reply_size, reply_max ));
+    __atomic_store_n( &slot->state, FASTCALL_IDLE, __ATOMIC_RELEASE );
+    *ret = req->u.reply.reply_header.error;
+    return TRUE;
+}
+#else
+static void fastcall_init_thread( struct thread_data *data, BOOL first ) { }
+void fastcall_exit_thread( struct thread_data *data ) { }
+#endif
+
+
 /***********************************************************************
  *           server_call_unlocked
  */
@@ -288,6 +534,9 @@ unsigned int server_call_unlocked( void *req_ptr )
     struct __server_request_info * const req = req_ptr;
     unsigned int ret;
 
+#ifdef __linux__
+    if (data->fastcall && fastcall( data, req, &ret )) return ret;
+#endif
     if ((ret = send_request( data->request_fd, req ))) return ret;
     return wait_reply( data->reply_fd, req );
 }
