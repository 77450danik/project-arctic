+/* Arctic: fast calls. A process's threads pass small requests to the server
+ * through a memfd the process shares with it (register_fastcall): the
+ * request goes into the thread's slot, a bit in "pending" tells the server,
+ * which looks for those bits while it is busy and is woken by the doorbell
+ * eventfd when it sleeps; the reply comes back in the slot and the thread
+ * waits for it on the slot's state (a futex). Everything that does not fit
+ * goes through the request pipe as before. */
+#define FASTCALL_SLOTS     256
+#define FASTCALL_DATA_SIZE 4096
+#define FASTCALL_IDLE      0
+#define FASTCALL_FILLING   1   /* the client is writing the request */
+#define FASTCALL_POSTED    2   /* the server may take it */
+#define FASTCALL_REPLIED   3   /* the reply is in the slot */
+
+typedef volatile struct
+{
+    int                  state;            /* FASTCALL_*, the futex the client sleeps on */
+    int                  waiting;          /* the client sleeps: wake it */
+    int                  __pad[14];
+    unsigned char        req[64];          /* union generic_request */
+    unsigned char        reply[64];        /* union generic_reply */
+    unsigned char        data[FASTCALL_DATA_SIZE]; /* request data, then reply data */
+} fastcall_slot_t;
+
+typedef volatile struct
+{
+    unsigned __int64     pending[FASTCALL_SLOTS / 64]; /* a bit for each slot with a posted request */
+    int                  server_sleeping;  /* the server waits for events: ring the doorbell */
+    int                  __pad[7];
+    fastcall_slot_t      slots[FASTCALL_SLOTS];
+} fastcall_area_t;
+
 /****************************************************************/
 /* Request declarations */
 
