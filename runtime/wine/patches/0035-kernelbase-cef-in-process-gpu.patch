From 33af0394b1b80dac9f0702ae9143b3c3668d0948 Mon Sep 17 00:00:00 2001
From: 77450danik <dnsystems@email.ua>
Date: Tue, 29 Sep 2026 14:04:59 +0300
Subject: [PATCH] kernelbase: CEF browsers draw their own windows; Chromium's
 crash handler finds its folder

Chromium's GPU process draws into the browser's windows from another
process, which the Wayland driver cannot show: Steam's window stayed
black. steamwebhelper.exe and EpicWebHelper.exe get --in-process-gpu,
as Proton gives CEF launchers.

A Chromium browser starts its crash handler before it makes its profile
folder; the handler makes <profile>\Crashpad at once and gives up when
the profile folder is not there, and the browser then ends itself. On a
fresh profile, which the live C: always is, Chrome never started. The
folders of --database= are made before the handler starts.
---
 dlls/kernelbase/process.c | 71 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 71 insertions(+)

diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index 25b3f4f..d0f729e 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -505,6 +505,70 @@ done:
 /**********************************************************************
  *           CreateProcessInternalW   (kernelbase.@)
  */
+/* Arctic: the GPU process of Chromium draws into the browser's windows from
+ * another process, and the Wayland driver shows only what a window's own
+ * process draws. The browsers of CEF programs do that work themselves then,
+ * as Proton makes them. */
+static WCHAR *cef_command_line( const WCHAR *app_name, const WCHAR *cmd_line )
+{
+    static const WCHAR *browsers[] = { L"steamwebhelper.exe", L"EpicWebHelper.exe" };
+    static const WCHAR flag[] = L" --in-process-gpu";
+    const WCHAR *base = wcsrchr( app_name, '\\' );
+    WCHAR *ret;
+    unsigned int i;
+    size_t len;
+
+    base = base ? base + 1 : app_name;
+    for (i = 0; i < ARRAY_SIZE(browsers); i++) if (!wcsicmp( base, browsers[i] )) break;
+    if (i == ARRAY_SIZE(browsers)) return NULL;
+    /* only the browser process itself: its children are started with a --type */
+    if (wcsstr( cmd_line, L"--type=" ) || wcsstr( cmd_line, L"--in-process-gpu" )) return NULL;
+
+    len = lstrlenW( cmd_line ) + ARRAY_SIZE(flag);
+    if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, len * sizeof(WCHAR) ))) return NULL;
+    lstrcpyW( ret, cmd_line );
+    lstrcatW( ret, flag );
+    TRACE( "%s\n", debugstr_w(ret) );
+    return ret;
+}
+
+/* Arctic: a Chromium browser starts its crash handler and only then makes its
+ * profile folder, while the handler makes <profile>\Crashpad at once and
+ * gives up when the profile folder is not there yet; the browser then ends
+ * itself ("crash server failed to launch"). Windows starts the handler
+ * slowly enough that the browser wins; here the folders are made first. */
+static void make_crashpad_database( const WCHAR *cmd_line )
+{
+    const WCHAR *arg = wcsstr( cmd_line, L"--database=" ), *start, *end;
+    WCHAR path[MAX_PATH], *p;
+    BOOL quoted;
+
+    if (!arg || !wcsstr( cmd_line, L"--type=crashpad-handler" )) return;
+    /* "--database=C:\x y" or --database="C:\x y" or --database=C:\x */
+    quoted = arg > cmd_line && arg[-1] == '"';
+    start = arg + wcslen( L"--database=" );
+    if (*start == '"')
+    {
+        quoted = TRUE;
+        start++;
+    }
+    end = wcschr( start, quoted ? '"' : ' ' );
+    if (!end) end = start + wcslen( start );
+    if (end - start >= MAX_PATH || end - start < 3) return;
+    memcpy( path, start, (end - start) * sizeof(WCHAR) );
+    path[end - start] = 0;
+
+    for (p = path + 3; *p; p++)
+    {
+        if (*p != '\\') continue;
+        *p = 0;
+        CreateDirectoryW( path, NULL );
+        *p = '\\';
+    }
+    CreateDirectoryW( path, NULL );
+    TRACE( "%s\n", debugstr_w(path) );
+}
+
 BOOL WINAPI DECLSPEC_HOTPATCH CreateProcessInternalW( HANDLE token, const WCHAR *app_name, WCHAR *cmd_line,
                                                       SECURITY_ATTRIBUTES *process_attr,
                                                       SECURITY_ATTRIBUTES *thread_attr,
@@ -543,6 +607,13 @@ BOOL WINAPI DECLSPEC_HOTPATCH CreateProcessInternalW( HANDLE token, const WCHAR
         app_name = name;
     }
 
+    if ((p = cef_command_line( app_name, tidy_cmdline )))
+    {
+        if (tidy_cmdline != cmd_line) HeapFree( GetProcessHeap(), 0, tidy_cmdline );
+        tidy_cmdline = p;
+    }
+    make_crashpad_database( tidy_cmdline );
+
     /* Warn if unsupported features are used */
 
     if (flags & (IDLE_PRIORITY_CLASS | HIGH_PRIORITY_CLASS | REALTIME_PRIORITY_CLASS |
-- 
2.55.0

