+/* Arctic: the monitors changed (their DPI too): every toplevel window takes
+ * its monitor's DPI at once, before the programs hear of it */
+void update_windows_monitor_dpi( struct winstation *winstation )
+{
+    struct desktop *desktop;
+    struct window *win;
+
+    LIST_FOR_EACH_ENTRY( desktop, &winstation->desktops, struct desktop, entry )
+    {
+        if (!desktop->top_window) continue;
+        LIST_FOR_EACH_ENTRY( win, &desktop->top_window->children, struct window, entry )
+            set_window_monitor_dpi( win );
+    }
+}
