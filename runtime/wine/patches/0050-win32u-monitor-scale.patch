+/* Arctic: the scale of each monitor, as in Windows 10. It is "recommended"
+ * from the monitor's size (EDID) and resolution, and the user moves it some
+ * steps from there, which Windows keeps in PerMonitorSettings\<monitor>\DpiValue
+ * and so do we. The source of the monitor gets its DPI; the primary one's also
+ * goes to LogPixels, the DPI of the system for the processes to come. */
+static const UINT arctic_scales[] = { 100, 125, 150, 175, 200, 225, 250, 300, 350, 400, 450, 500 };
+static const char arctic_per_monitor_keyA[] = "Control Panel\\Desktop\\PerMonitorSettings";
+static const WCHAR arctic_dpi_valueW[] = {'D','p','i','V','a','l','u','e',0};
+static const WCHAR arctic_log_pixelsW[] = {'L','o','g','P','i','x','e','l','s',0};
+static const WCHAR arctic_recommendedW[] = {'A','r','c','t','i','c','S','c','a','l','e',
+                                            'R','e','c','o','m','m','e','n','d','e','d',0};
+static const WCHAR arctic_maxW[] = {'A','r','c','t','i','c','S','c','a','l','e','M','a','x',0};
+
+static BOOL lock_display_devices( BOOL force );
+static void unlock_display_devices(void);
+static void set_winstation_monitors( BOOL increment );
+
+/* the biggest scale that leaves at least 1024x600 of room, as Windows offers */
+static UINT arctic_max_scale_index( UINT width, UINT height )
+{
+    UINT i = 0;
+
+    while (i + 1 < ARRAY_SIZE(arctic_scales) && width * 100 / arctic_scales[i + 1] >= 1024 &&
+           height * 100 / arctic_scales[i + 1] >= 600) i++;
+    return i;
+}
+
+/* the screen's width in millimetres: the first detailed timing, else the size in centimetres */
+static UINT arctic_edid_width_mm( const unsigned char *edid, UINT len )
+{
+    UINT mm = 0;
+
+    if (!edid || len < 128) return 0;
+    if (edid[54] | edid[55]) mm = edid[66] | ((edid[68] & 0xf0) << 4);
+    if (!mm) mm = edid[21] * 10;
+    return mm;
+}
+
+/* about 110 pixels an inch looks as 96 do on the screens Windows had in mind;
+ * the nearest step of 25 %: a 15.6" 1080p laptop 125 %, a 13.3" one 150 %,
+ * a 24" 1080p monitor 100 %, a 27" 4K one 150 % */
+static UINT arctic_recommended_scale_index( const unsigned char *edid, UINT len, UINT width, UINT height )
+{
+    UINT mm = arctic_edid_width_mm( edid, len ), best = 0, i, percent;
+
+    if (!mm || !width) return 0;
+    percent = width * 254 / (mm * 11);  /* pixels an inch (width * 25.4 / mm) / 110, in percent */
+    for (i = 1; i < ARRAY_SIZE(arctic_scales); i++)
+    {
+        int d = (int)arctic_scales[i] - (int)percent, d_best = (int)arctic_scales[best] - (int)percent;
+        if ((d < 0 ? -d : d) < (d_best < 0 ? -d_best : d_best)) best = i;
+    }
+    return min( best, arctic_max_scale_index( width, height ) );
+}
+
+static void arctic_monitor_scale_key( const struct gdi_monitor *gdi_monitor, const char *id, char *key, size_t size )
+{
+    const unsigned char *edid = gdi_monitor->edid;
+
+    if (edid && gdi_monitor->edid_len >= 16)
+        snprintf( key, size, "%s_%02X%02X%02X%02X", id, edid[15], edid[14], edid[13], edid[12] );
+    else
+        snprintf( key, size, "%s", id );
+}
+
+static INT arctic_read_scale_steps( const char *key )
+{
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[sizeof(DWORD)])];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    char path[MAX_PATH];
+    INT steps = 0;
+    HKEY hkey;
+
+    snprintf( path, sizeof(path), "%s\\%s", arctic_per_monitor_keyA, key );
+    if (!(hkey = reg_open_hkcu_key( path ))) return 0;
+    if (query_reg_ascii_value( hkey, "DpiValue", value, sizeof(buffer) ) == sizeof(DWORD))
+        steps = *(INT *)value->Data;
+    NtClose( hkey );
+    return steps;
+}
+
+static void arctic_write_scale_steps( const char *key, INT steps )
+{
+    char path[MAX_PATH];
+    HKEY hkey;
+
+    snprintf( path, sizeof(path), "%s\\%s", arctic_per_monitor_keyA, key );
+    if (!(hkey = reg_create_ascii_key( hkcu_key, path, 0, NULL ))) return;
+    set_reg_value( hkey, arctic_dpi_valueW, REG_DWORD, &steps, sizeof(steps) );
+    NtClose( hkey );
+}
+
+static void arctic_set_system_dpi( UINT dpi )
+{
+    HKEY hkey;
+
+    if (!(hkey = reg_create_ascii_key( hkcu_key, "Control Panel\\Desktop", 0, NULL ))) return;
+    set_reg_value( hkey, arctic_log_pixelsW, REG_DWORD, &dpi, sizeof(dpi) );
+    NtClose( hkey );
+}
+
+/* the DPI of a source from the monitor shown on it, when it is made */
+static void arctic_choose_source_dpi( struct source *source, const struct gdi_monitor *gdi_monitor, const char *id )
+{
+    UINT width = gdi_monitor->rc_monitor.right - gdi_monitor->rc_monitor.left;
+    UINT height = gdi_monitor->rc_monitor.bottom - gdi_monitor->rc_monitor.top;
+    UINT recommended, max_index, index;
+    DWORD value;
+    char key[64];
+    INT steps;
+
+    arctic_monitor_scale_key( gdi_monitor, id, key, sizeof(key) );
+    recommended = arctic_recommended_scale_index( gdi_monitor->edid, gdi_monitor->edid_len, width, height );
+    max_index = arctic_max_scale_index( width, height );
+    steps = arctic_read_scale_steps( key );
+    index = max( 0, min( (INT)max_index, (INT)recommended + steps ) );
+
+    source->dpi = USER_DEFAULT_SCREEN_DPI * arctic_scales[index] / 100;
+    TRACE( "%s: %ux%u, recommended %u%%, %d steps: %u dpi\n", key, width, height, arctic_scales[recommended],
+           steps, source->dpi );
+    set_reg_value( source->key, dpiW, REG_DWORD, &source->dpi, sizeof(source->dpi) );
+    set_reg_ascii_value( source->key, "ArcticScaleKey", key );
+    value = recommended;
+    set_reg_value( source->key, arctic_recommendedW, REG_DWORD, &value, sizeof(value) );
+    value = max_index;
+    set_reg_value( source->key, arctic_maxW, REG_DWORD, &value, sizeof(value) );
+    if (source->state_flags & DISPLAY_DEVICE_PRIMARY_DEVICE) arctic_set_system_dpi( source->dpi );
+}
+
+/* the source's key: its path is absolute where the source was made, relative
+ * to the configuration key where it was read back from the registry */
+static HKEY arctic_open_source_key( struct source *source )
+{
+    HKEY hkey;
+
+    if (config_key && (hkey = reg_open_ascii_key( config_key, source->path ))) return hkey;
+    return reg_open_ascii_key( NULL, source->path );
+}
+
+static BOOL arctic_source_scale_info( struct source *source, char *key, size_t size, UINT *recommended, UINT *max_index )
+{
+    char buffer[offsetof(KEY_VALUE_PARTIAL_INFORMATION, Data[128])];
+    KEY_VALUE_PARTIAL_INFORMATION *value = (void *)buffer;
+    HKEY hkey;
+    BOOL ret = FALSE;
+
+    if (!(hkey = arctic_open_source_key( source ))) return FALSE;
+    if (query_reg_ascii_value( hkey, "ArcticScaleKey", value, sizeof(buffer) ) && value->Type == REG_SZ)
+    {
+        WCHAR *str = (WCHAR *)value->Data;
+        UINT i;
+
+        for (i = 0; i + 1 < size && i < value->DataLength / sizeof(WCHAR) && str[i]; i++) key[i] = str[i];
+        key[i] = 0;
+        ret = TRUE;
+    }
+    *recommended = query_reg_ascii_value( hkey, "ArcticScaleRecommended", value, sizeof(buffer) ) == sizeof(DWORD)
+                   ? *(DWORD *)value->Data : 0;
+    *max_index = query_reg_ascii_value( hkey, "ArcticScaleMax", value, sizeof(buffer) ) == sizeof(DWORD)
+                 ? *(DWORD *)value->Data : 0;
+    NtClose( hkey );
+    return ret;
+}
+
+static UINT arctic_scale_index( UINT dpi )
+{
+    UINT i, percent = dpi * 100 / USER_DEFAULT_SCREEN_DPI;
+
+    for (i = 0; i + 1 < ARRAY_SIZE(arctic_scales); i++) if (arctic_scales[i] >= percent) break;
+    return i;
+}
+
+/* the layouts of DISPLAYCONFIG_DEVICE_INFO_GET/SET_SOURCE_DPI_SCALE, which Windows does not document */
+struct arctic_source_dpi_scale_get
+{
+    DISPLAYCONFIG_DEVICE_INFO_HEADER header;
+    INT32 min_scale_rel;
+    INT32 cur_scale_rel;
+    INT32 max_scale_rel;
+};
+
+struct arctic_source_dpi_scale_set
+{
+    DISPLAYCONFIG_DEVICE_INFO_HEADER header;
+    INT32 scale_rel;
+};
+
+static BOOL get_primary_source_mode( DEVMODEW *mode );
+
+/* every toplevel window hears in its own thread that its monitor's DPI
+ * changed; then, as the screen of a window that knows nothing of DPI grew
+ * or shrank in its terms, that the display changed (the taskbar of a shell
+ * that does not know DPI takes its place again from it), and that the
+ * metrics did */
+static void arctic_tell_windows_dpi_changed( UINT old_dpi, UINT new_dpi )
+{
+    HWND *list = list_window_children( get_desktop_window() );
+    DEVMODEW mode = {.dmSize = sizeof(mode)};
+    LPARAM size;
+
+    if (!list) return;
+    if (!get_primary_source_mode( &mode )) mode.dmBitsPerPel = 32;
+    size = MAKELPARAM( mode.dmPelsWidth, mode.dmPelsHeight );
+    for (int i = 0; list[i]; i++) NtUserPostMessage( list[i], WM_WINE_DPICHANGED, old_dpi, new_dpi );
+    for (int i = 0; list[i]; i++) NtUserPostMessage( list[i], WM_DISPLAYCHANGE, mode.dmBitsPerPel, size );
+    for (int i = 0; list[i]; i++) NtUserPostMessage( list[i], WM_SETTINGCHANGE, SPI_SETNONCLIENTMETRICS, 0 );
+    free( list );
+}
+
+static NTSTATUS arctic_set_source_scale( const struct arctic_source_dpi_scale_set *set )
+{
+    UINT recommended, max_index, index, old_dpi = 0, new_dpi = 0;
+    struct source *source;
+    char key[64];
+    NTSTATUS ret = STATUS_UNSUCCESSFUL;
+
+    if (!lock_display_devices( FALSE )) return STATUS_UNSUCCESSFUL;
+    LIST_FOR_EACH_ENTRY( source, &sources, struct source, entry )
+    {
+        if (set->header.id != source->id) continue;
+        if (memcmp( &set->header.adapterId, &source->gpu->luid, sizeof(source->gpu->luid) )) continue;
+        if (!arctic_source_scale_info( source, key, sizeof(key), &recommended, &max_index )) break;
+
+        index = max( 0, min( (INT)max_index, (INT)recommended + set->scale_rel ) );
+        arctic_write_scale_steps( key, (INT)index - (INT)recommended );
+        old_dpi = source->dpi ? source->dpi : system_dpi;
+        new_dpi = USER_DEFAULT_SCREEN_DPI * arctic_scales[index] / 100;
+        TRACE( "%s: %u -> %u dpi\n", key, old_dpi, new_dpi );
+        if (new_dpi != old_dpi)
+        {
+            HKEY hkey;
+
+            source->dpi = new_dpi;
+            if ((hkey = arctic_open_source_key( source )))
+            {
+                set_reg_value( hkey, dpiW, REG_DWORD, &new_dpi, sizeof(new_dpi) );
+                NtClose( hkey );
+            }
+            if (source->state_flags & DISPLAY_DEVICE_PRIMARY_DEVICE) arctic_set_system_dpi( new_dpi );
+            /* every process reads the monitors again */
+            if (video_key) set_reg_ascii_value( video_key, "ArcticDpi", "" );
+            set_winstation_monitors( TRUE );
+        }
+        ret = STATUS_SUCCESS;
+        break;
+    }
+    unlock_display_devices();
+    if (!ret && old_dpi != new_dpi) arctic_tell_windows_dpi_changed( old_dpi, new_dpi );
+    return ret;
+}
+
+static NTSTATUS arctic_get_source_scale( struct arctic_source_dpi_scale_get *get )
+{
+    UINT recommended, max_index;
+    struct source *source;
+    char key[64];
+    NTSTATUS ret = STATUS_UNSUCCESSFUL;
+
+    if (!lock_display_devices( FALSE )) return STATUS_UNSUCCESSFUL;
+    LIST_FOR_EACH_ENTRY( source, &sources, struct source, entry )
+    {
+        if (get->header.id != source->id) continue;
+        if (memcmp( &get->header.adapterId, &source->gpu->luid, sizeof(source->gpu->luid) )) continue;
+        if (!arctic_source_scale_info( source, key, sizeof(key), &recommended, &max_index )) break;
+        get->min_scale_rel = -(INT32)recommended;
+        get->max_scale_rel = (INT32)max_index - (INT32)recommended;
+        get->cur_scale_rel = (INT32)arctic_scale_index( source->dpi ? source->dpi : system_dpi ) - (INT32)recommended;
+        ret = STATUS_SUCCESS;
+        break;
+    }
+    unlock_display_devices();
+    return ret;
+}
+
