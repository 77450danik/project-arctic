+/* Arctic: a maximized window takes the maximized place again, which the
+ * new DPI made larger or smaller */
+static void remaximize_window( HWND hwnd )
+{
+    MINMAXINFO info = get_min_max_info( hwnd );
+
+    NtUserSetWindowPos( hwnd, 0, info.ptMaxPosition.x, info.ptMaxPosition.y, info.ptMaxSize.x,
+                        info.ptMaxSize.y, SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED );
+}
+
+static void send_dpi_changed_to_children( HWND parent, UINT msg )
+{
+    HWND *list = list_window_children( parent );
+
+    if (!list) return;
+    for (int i = 0; list[i]; i++)
+    {
+        if (msg == WM_DPICHANGED_BEFOREPARENT) send_message( list[i], msg, 0, 0 );
+        send_dpi_changed_to_children( list[i], msg );
+        if (msg == WM_DPICHANGED_AFTERPARENT) send_message( list[i], msg, 0, 0 );
+    }
+    free( list );
+}
+
+/***********************************************************************
+ *              window_monitor_dpi_changed
+ *
+ * Arctic: the scale of the window's monitor changed on the fly
+ * (DisplayConfigSetDeviceInfo, as the Display panel does), in the thread of
+ * the window. As in Windows, a window that knows the DPI of its monitor is
+ * told with WM_DPICHANGED and a rectangle that keeps its size in its own
+ * terms, which it is expected to take; any other window keeps its
+ * coordinates, and its surface is drawn at the monitor's new scale.
+ */
+void window_monitor_dpi_changed( HWND hwnd, UINT old_dpi, UINT new_dpi )
+{
+    UINT context = get_window_dpi_awareness_context( hwnd ), prev;
+    DWORD style = get_window_long( hwnd, GWL_STYLE );
+
+    if (!old_dpi || !new_dpi || old_dpi == new_dpi) return;
+    TRACE( "%p dpi %u -> %u, context %#x\n", hwnd, old_dpi, new_dpi, context );
+
+    prev = set_thread_dpi_awareness_context( context );
+    if (NTUSER_DPI_CONTEXT_IS_MONITOR_AWARE( context ))
+    {
+        BOOL v2 = NTUSER_DPI_CONTEXT_GET_VERSION( context ) >= 2;
+        RECT rect;
+
+        get_window_rect( hwnd, &rect, get_thread_dpi() );
+        if (!(style & (WS_MAXIMIZE | WS_MINIMIZE)))
+        {
+            rect.right = rect.left + muldiv( rect.right - rect.left, new_dpi, old_dpi );
+            rect.bottom = rect.top + muldiv( rect.bottom - rect.top, new_dpi, old_dpi );
+        }
+        if (v2) send_dpi_changed_to_children( hwnd, WM_DPICHANGED_BEFOREPARENT );
+        send_message( hwnd, WM_DPICHANGED, MAKEWPARAM( new_dpi, new_dpi ), (LPARAM)&rect );
+        if (v2) send_dpi_changed_to_children( hwnd, WM_DPICHANGED_AFTERPARENT );
+        if (style & WS_MAXIMIZE) remaximize_window( hwnd );
+        else NtUserSetWindowPos( hwnd, 0, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER |
+                                 SWP_NOACTIVATE | SWP_FRAMECHANGED );
+    }
+    else
+    {
+        update_window_state( hwnd );
+        if (style & WS_MAXIMIZE) remaximize_window( hwnd );
+    }
+    NtUserRedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+    set_thread_dpi_awareness_context( prev );
+}
