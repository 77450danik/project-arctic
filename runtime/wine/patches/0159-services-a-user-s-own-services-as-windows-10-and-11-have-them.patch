+/* Arctic: the logon's own part of a user service instance's name, as Windows
+ * gives it: the logon session's id, in hexadecimal */
+static const WCHAR *user_service_suffix(void)
+{
+    static WCHAR suffix[16];
+
+    if (!suffix[0])
+    {
+        TOKEN_STATISTICS stats;
+        LUID luid = { 0x5a3b1, 0 };
+        HANDLE token;
+        DWORD len;
+
+        if (OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token))
+        {
+            if (GetTokenInformation(token, TokenStatistics, &stats, sizeof(stats), &len) &&
+                stats.AuthenticationId.LowPart)
+                luid = stats.AuthenticationId;
+            CloseHandle(token);
+        }
+        swprintf(suffix, ARRAY_SIZE(suffix), L"_%x", luid.LowPart);
+    }
+    return suffix;
+}
+
+/* the instance of a user service's template for this logon, made when it is
+ * not there yet; returned with a reference */
+DWORD user_service_instance(struct scmdatabase *db, struct service_entry *template, struct service_entry **instance)
+{
+    const WCHAR *suffix = user_service_suffix();
+    WCHAR name[MAX_SERVICE_NAME], *display = NULL;
+    struct service_entry *entry;
+    DWORD err;
+
+    if (wcslen(template->name) + wcslen(suffix) >= MAX_SERVICE_NAME)
+        return ERROR_INVALID_NAME;
+    swprintf(name, ARRAY_SIZE(name), L"%s%s", template->name, suffix);
+
+    scmdatabase_lock(db);
+    if ((entry = scmdatabase_find_service(db, name)))
+    {
+        *instance = grab_service(entry);
+        scmdatabase_unlock(db);
+        return ERROR_SUCCESS;
+    }
+    if ((err = service_create(name, &entry)))
+    {
+        scmdatabase_unlock(db);
+        return err;
+    }
+    if (template->config.lpDisplayName &&
+        (display = malloc((wcslen(template->config.lpDisplayName) + wcslen(suffix) + 1) * sizeof(WCHAR))))
+    {
+        wcscpy(display, template->config.lpDisplayName);
+        wcscat(display, suffix);
+    }
+    entry->is_wow64 = template->is_wow64;
+    entry->delayed_autostart = template->delayed_autostart;
+    entry->preshutdown_timeout = template->preshutdown_timeout;
+    entry->config.dwServiceType = entry->status.dwServiceType =
+        template->config.dwServiceType | SERVICE_USERSERVICE_INSTANCE;
+    entry->config.dwStartType = template->config.dwStartType;
+    entry->config.dwErrorControl = template->config.dwErrorControl;
+    entry->config.lpBinaryPathName = wcsdup(template->config.lpBinaryPathName);
+    entry->config.lpLoadOrderGroup = template->config.lpLoadOrderGroup ? wcsdup(template->config.lpLoadOrderGroup) : NULL;
+    entry->config.lpServiceStartName = template->config.lpServiceStartName ? wcsdup(template->config.lpServiceStartName) : NULL;
+    entry->config.lpDisplayName = display;
+    entry->description = template->description ? wcsdup(template->description) : NULL;
+
+    if (!validate_service_config(entry) || (err = scmdatabase_add_service(db, entry)))
+    {
+        scmdatabase_unlock(db);
+        free_service_entry(entry);
+        return err ? err : ERROR_INVALID_PARAMETER;
+    }
+    WINE_TRACE("user service %s: instance %s\n", wine_dbgstr_w(template->name), wine_dbgstr_w(name));
+    *instance = entry;  /* service_create's reference */
+    scmdatabase_unlock(db);
+    return ERROR_SUCCESS;
+}
+
+static DWORD WINAPI user_service_start_proc(void *arg)
+{
+    struct service_entry *instance = arg;
+    DWORD err;
+
+    scmdatabase_lock_startup(instance->db, INFINITE);
+    err = service_start(instance, 0, NULL);
+    scmdatabase_unlock_startup(instance->db);
+    if (err != ERROR_SUCCESS && err != ERROR_SERVICE_ALREADY_RUNNING)
+        WINE_FIXME("user service %s failed to start: %ld\n", wine_dbgstr_w(instance->name), err);
+    release_service(instance);
+    return 0;
+}
+
+/* starts an instance that was just made, as its logon would have; takes the reference */
+void user_service_start_async(struct service_entry *instance)
+{
+    HANDLE thread;
+
+    if ((thread = CreateThread(NULL, 0, user_service_start_proc, instance, 0, NULL)))
+        CloseHandle(thread);
+    else
+        release_service(instance);
+}
+
+/* this logon's instance of each user service; the automatic ones start with the others */
+static void scmdatabase_create_user_services(struct scmdatabase *db)
+{
+    struct service_entry *service, **templates;
+    unsigned int count = 0, i;
+
+    scmdatabase_lock(db);
+    LIST_FOR_EACH_ENTRY(service, &db->services, struct service_entry, entry)
+        if (is_user_service_template(service)) count++;
+    if (!count || !(templates = malloc(count * sizeof(*templates))))
+    {
+        scmdatabase_unlock(db);
+        return;
+    }
+    count = 0;
+    LIST_FOR_EACH_ENTRY(service, &db->services, struct service_entry, entry)
+        if (is_user_service_template(service)) templates[count++] = grab_service(service);
+    scmdatabase_unlock(db);
+
+    for (i = 0; i < count; i++)
+    {
+        struct service_entry *instance;
+        DWORD err;
+
+        if (!(err = user_service_instance(db, templates[i], &instance)))
+            release_service(instance);
+        else
+            WINE_ERR("no instance of the user service %s: %lu\n", wine_dbgstr_w(templates[i]->name), err);
+        release_service(templates[i]);
+    }
+    free(templates);
+}
+
