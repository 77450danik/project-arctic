+    /* Arctic: a program's service of LocalSystem runs as SYSTEM */
+    if ((token = service_system_token(service_entry)))
+        r = CreateProcessAsUserW(token, NULL, path, NULL, NULL, FALSE, CREATE_UNICODE_ENVIRONMENT | DETACHED_PROCESS,
