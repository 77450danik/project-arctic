         return err;
+    scmdatabase_create_user_services(active_database);
     if ((err = RPC_Init()) == ERROR_SUCCESS)
     {
         scmdatabase_autostart_services(active_database);
diff --git a/programs/services/services.h b/programs/services/services.h
index 1d9dbfd..a7f2df1 100644
--- a/programs/services/services.h
+++ b/programs/services/services.h
@@ -69,6 +69,23 @@ struct service_entry
 
 extern struct scmdatabase *active_database;
 
+/* Arctic: a user's own services (Windows 10 1703 and later). A service of
+ * type SERVICE_USER_OWN_PROCESS or SERVICE_USER_SHARE_PROCESS is a template:
+ * it never runs itself; each logon has an instance of it, <name>_<logon id>,
+ * which runs in the user's session, on the user's desktop. */
+#ifndef SERVICE_USER_SERVICE
+#define SERVICE_USER_SERVICE         0x00000040
+#define SERVICE_USERSERVICE_INSTANCE 0x00000080
+#endif
+
+static inline BOOL is_user_service_template(const struct service_entry *service)
+{
+    return (service->config.dwServiceType & (SERVICE_USER_SERVICE | SERVICE_USERSERVICE_INSTANCE)) == SERVICE_USER_SERVICE;
+}
+
+DWORD user_service_instance(struct scmdatabase *db, struct service_entry *template, struct service_entry **instance);
+void user_service_start_async(struct service_entry *instance);
+
 /* SCM database functions */
 
 struct service_entry *scmdatabase_find_service(struct scmdatabase *db, LPCWSTR name);
