+/* Arctic: every process of Arctic runs as its one user; in Windows a service
+ * of LocalSystem runs as SYSTEM, elevated, and programs rely on it: G HUB's
+ * updater starts its agent in the user's session (WTSQueryUserToken,
+ * CreateProcessAsUser) only when it runs as SYSTEM, and the installer waited
+ * for the agent for ever. A program's service (outside Windows' directory) of
+ * LocalSystem gets SYSTEM's token; the system's own keep running as before. */
+static HANDLE make_system_token(void)
+{
+    static const WCHAR *names[] =
+    {
+        L"SeTcbPrivilege", L"SeAssignPrimaryTokenPrivilege", L"SeImpersonatePrivilege", L"SeDebugPrivilege",
+        L"SeCreateGlobalPrivilege", L"SeIncreaseQuotaPrivilege", L"SeBackupPrivilege", L"SeRestorePrivilege",
+        L"SeShutdownPrivilege", L"SeLoadDriverPrivilege", L"SeSecurityPrivilege", L"SeTakeOwnershipPrivilege",
+        L"SeChangeNotifyPrivilege", L"SeManageVolumePrivilege", L"SeSystemEnvironmentPrivilege",
+        L"SeIncreaseBasePriorityPrivilege", L"SeCreatePagefilePrivilege", L"SeSystemtimePrivilege",
+        L"SeAuditPrivilege", L"SeCreatePermanentPrivilege", L"SeLockMemoryPrivilege", L"SeProfileSingleProcessPrivilege",
+    };
+    SID_IDENTIFIER_AUTHORITY nt_auth = {SECURITY_NT_AUTHORITY}, world_auth = {SECURITY_WORLD_SID_AUTHORITY};
+    struct { TOKEN_GROUPS g; SID_AND_ATTRIBUTES more[3]; } groups;
+    struct { TOKEN_PRIVILEGES p; LUID_AND_ATTRIBUTES more[ARRAY_SIZE(names)]; } privs;
+    PSID system_sid = NULL, admins_sid = NULL, world_sid = NULL, auth_sid = NULL;
+    const DWORD attrs = SE_GROUP_ENABLED | SE_GROUP_ENABLED_BY_DEFAULT | SE_GROUP_MANDATORY;
+    TOKEN_SOURCE source = { "*SYSTEM*", {0, 0} };
+    OBJECT_ATTRIBUTES attr;
+    TOKEN_PRIMARY_GROUP group;
+    LARGE_INTEGER expire;
+    TOKEN_OWNER owner;
+    TOKEN_USER user;
+    HANDLE token = NULL;
+    NTSTATUS status;
+    unsigned int i;
+    LUID id;
+
+    if (!AllocateAndInitializeSid(&nt_auth, 1, SECURITY_LOCAL_SYSTEM_RID, 0, 0, 0, 0, 0, 0, 0, &system_sid) ||
+        !AllocateAndInitializeSid(&nt_auth, 2, SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0, &admins_sid) ||
+        !AllocateAndInitializeSid(&world_auth, 1, SECURITY_WORLD_RID, 0, 0, 0, 0, 0, 0, 0, &world_sid) ||
+        !AllocateAndInitializeSid(&nt_auth, 1, SECURITY_AUTHENTICATED_USER_RID, 0, 0, 0, 0, 0, 0, 0, &auth_sid))
+        goto done;
+
+    groups.g.GroupCount = 4;
+    groups.g.Groups[0].Sid = admins_sid;
+    groups.g.Groups[0].Attributes = attrs | SE_GROUP_OWNER;
+    groups.more[0].Sid = world_sid;
+    groups.more[0].Attributes = attrs;
+    groups.more[1].Sid = auth_sid;
+    groups.more[1].Attributes = attrs;
+    groups.more[2].Sid = system_sid;
+    groups.more[2].Attributes = attrs;
+
+    privs.p.PrivilegeCount = 0;
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        LUID_AND_ATTRIBUTES *priv = &privs.p.Privileges[privs.p.PrivilegeCount];
+        if (!LookupPrivilegeValueW(NULL, names[i], &priv->Luid)) continue;
+        priv->Attributes = SE_PRIVILEGE_ENABLED | SE_PRIVILEGE_ENABLED_BY_DEFAULT;
+        privs.p.PrivilegeCount++;
+    }
+
+    user.User.Sid = system_sid;
+    user.User.Attributes = 0;
+    owner.Owner = admins_sid;
+    group.PrimaryGroup = system_sid;
+    InitializeObjectAttributes(&attr, NULL, 0, NULL, NULL);
+    NtAllocateLocallyUniqueId(&id);
+    expire.QuadPart = 0x7fffffffffffffff;
+    status = NtCreateToken(&token, TOKEN_ALL_ACCESS, &attr, TokenPrimary, &id, &expire, &user, &groups.g,
+                           &privs.p, &owner, &group, NULL, &source);
+    if (status)
+    {
+        WINE_ERR("no token of SYSTEM: %#lx\n", status);
+        token = NULL;
+    }
+done:
+    if (system_sid) FreeSid(system_sid);
+    if (admins_sid) FreeSid(admins_sid);
+    if (world_sid) FreeSid(world_sid);
+    if (auth_sid) FreeSid(auth_sid);
+    return token;
+}
+
+static BOOL is_third_party_service(const struct service_entry *service);
+
+/* SYSTEM's token for a program's service of LocalSystem, NULL for the others */
+static HANDLE service_system_token(const struct service_entry *service)
+{
+    static HANDLE token;
+    const WCHAR *account = service->config.lpServiceStartName;
+
+    if (service->config.dwServiceType & SERVICE_USER_SERVICE) return NULL;  /* runs as its user */
+    if (account && wcsicmp(account, L"LocalSystem") && wcsicmp(account, L".\\LocalSystem")) return NULL;
+    if (!is_third_party_service(service)) return NULL;
+    if (!token) token = make_system_token();
+    return token;
+}
