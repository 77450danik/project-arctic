+/* AllowSetForegroundWindow: the foreground process lets another one (or any,
+ * ASFW_ANY) take the foreground, as Steam does for the game it starts */
+static BOOL allow_set_foreground_window( DWORD pid )
+{
+    BOOL ret;
+
+    SERVER_START_REQ( allow_set_foreground )
+    {
+        req->pid = pid;
+        ret = !wine_server_call_err( req );
+    }
+    SERVER_END_REQ;
+    return ret;
+}
