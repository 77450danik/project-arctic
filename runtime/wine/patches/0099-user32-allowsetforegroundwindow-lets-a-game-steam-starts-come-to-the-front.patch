+/* Whether the current process may set the foreground window: it has the
+ * foreground, the foreground process let it (AllowSetForegroundWindow), or
+ * the user's last input went to it. A game Steam starts is let by Steam: the
+ * foreground belongs to steamwebhelper, which did not start it. */
+static int can_set_foreground( struct desktop *desktop, struct msg_queue *queue )
+{
+    if (is_current_process_foreground( desktop )) return 1;
+    if (desktop->foreground_allowed == (process_id_t)-1 || desktop->foreground_allowed == current->process->id)
+        return 1;
+    return !queue || !queue->input || !desktop->foreground_input ||
+           queue->input->user_time >= desktop->foreground_input->user_time;
+}
+
+/* let a process take the foreground (AllowSetForegroundWindow), if this one may */
+DECL_HANDLER(allow_set_foreground)
+{
+    struct desktop *desktop;
+
+    if (!(desktop = get_thread_desktop( current, 0 ))) return;
+    if (!can_set_foreground( desktop, current->queue )) set_error( STATUS_ACCESS_DENIED );
+    else desktop->foreground_allowed = req->pid;
+    release_object( desktop );
+}
+
