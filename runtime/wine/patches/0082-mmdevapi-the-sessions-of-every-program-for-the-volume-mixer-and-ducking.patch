diff --git a/dlls/mmdevapi/sharedsession.c b/dlls/mmdevapi/sharedsession.c
new file mode 100644
--- /dev/null
+++ b/dlls/mmdevapi/sharedsession.c
@@ -0,0 +1,306 @@
+/*
+ * Arctic: the sessions of every process, for the Volume Mixer, and ducking
+ * (include/wine/arctic_audio.h)
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <math.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "winreg.h"
+#include "wine/debug.h"
+#include "wine/list.h"
+
+#include "ole2.h"
+#include "mmdeviceapi.h"
+#include "mmsystem.h"
+#include "audioclient.h"
+#include "audiopolicy.h"
+#include "ks.h"
+#include "ksmedia.h"
+
+#include "mmdevapi_private.h"
+#include "wine/arctic_audio.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mmdevapi);
+
+/* the process asked for the communications endpoint: its microphone is a call */
+BOOL communications_role;
+static LONG process_calls;
+
+static struct arctic_audio_sessions *get_sessions(void)
+{
+    static struct arctic_audio_sessions *shared;
+    struct arctic_audio_sessions *view;
+    HANDLE mapping;
+
+    if (shared) return shared;
+    if (!(mapping = CreateFileMappingW( INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, sizeof(*view),
+                                        ARCTIC_AUDIO_SESSIONS_SECTION )))
+        return NULL;
+    if (!(view = MapViewOfFile( mapping, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, sizeof(*view) )))
+    {
+        CloseHandle( mapping );
+        return NULL;
+    }
+    /* the handle stays open, as for the endpoints' section */
+    InterlockedCompareExchange( (LONG *)&view->version, ARCTIC_AUDIO_SESSIONS_VERSION, 0 );
+    if (view->version != ARCTIC_AUDIO_SESSIONS_VERSION)
+    {
+        UnmapViewOfFile( view );
+        CloseHandle( mapping );
+        return NULL;
+    }
+    if (InterlockedCompareExchangePointer( (void **)&shared, view, NULL ))
+    {
+        UnmapViewOfFile( view );
+        CloseHandle( mapping );
+    }
+    return shared;
+}
+
+static HANDLE lock_sessions(void)
+{
+    HANDLE mutex = CreateMutexW( NULL, FALSE, ARCTIC_AUDIO_SESSIONS_MUTEX );
+
+    if (mutex) WaitForSingleObject( mutex, INFINITE );
+    return mutex;
+}
+
+static void unlock_sessions( HANDLE mutex )
+{
+    if (!mutex) return;
+    ReleaseMutex( mutex );
+    CloseHandle( mutex );
+}
+
+static BOOL process_alive( DWORD pid )
+{
+    HANDLE process;
+    DWORD code = 0;
+
+    if (pid == GetCurrentProcessId()) return TRUE;
+    if (!(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid ))) return FALSE;
+    GetExitCodeProcess( process, &code );
+    CloseHandle( process );
+    return code == STILL_ACTIVE;
+}
+
+LONG shared_sessions_serial(void)
+{
+    struct arctic_audio_sessions *shared = get_sessions();
+    return shared ? ReadAcquire( &shared->serial ) : 0;
+}
+
+static struct arctic_audio_session *session_row( struct audio_session *session )
+{
+    struct arctic_audio_sessions *shared = get_sessions();
+
+    if (!shared || !session->shared_row) return NULL;
+    return &shared->rows[session->shared_row - 1];
+}
+
+/* the row's name and icon: what the program gave the session, or its own */
+static void describe( struct audio_session *session, struct arctic_audio_session *row )
+{
+    WCHAR *name;
+
+    if (session->display_name && session->display_name[0] && session->display_name[0] != '@')
+        lstrcpynW( row->name, session->display_name, ARRAY_SIZE(row->name) );
+    else if ((name = get_application_name()))
+    {
+        lstrcpynW( row->name, name, ARRAY_SIZE(row->name) );
+        free( name );
+    }
+    if (session->icon_path && session->icon_path[0])
+        lstrcpynW( row->icon, session->icon_path, ARRAY_SIZE(row->icon) );
+    else
+        GetModuleFileNameW( NULL, row->icon, ARRAY_SIZE(row->icon) );
+}
+
+void shared_session_attach( struct audio_session *session, const GUID *device )
+{
+    struct arctic_audio_sessions *shared = get_sessions();
+    struct arctic_audio_session *row = NULL;
+    DWORD pid = GetCurrentProcessId();
+    HANDLE mutex;
+    int i, free_row = -1;
+
+    if (!shared) return;
+    mutex = lock_sessions();
+    if ((row = session_row( session ))) row->clients++;
+    else
+    {
+        for (i = 0; i < ARCTIC_AUDIO_SESSIONS; i++)
+        {
+            struct arctic_audio_session *r = &shared->rows[i];
+
+            if (r->pid && !process_alive( r->pid )) r->pid = 0;
+            if (!r->pid)
+            {
+                if (free_row < 0) free_row = i;
+                continue;
+            }
+            if (r->pid == pid && IsEqualGUID( &r->session, &session->guid ) && IsEqualGUID( &r->device, device ))
+            {
+                row = r;
+                break;
+            }
+        }
+        if (!row && free_row >= 0)
+        {
+            row = &shared->rows[free_row];
+            memset( row, 0, sizeof(*row) );
+            row->session = session->guid;
+            row->device = *device;
+            row->volume = session->master_vol;
+            row->mute = session->mute;
+            describe( session, row );
+            row->pid = pid;
+        }
+        if (row)
+        {
+            row->clients++;
+            session->shared_row = row - shared->rows + 1;
+            session->shared_changed = row->changed;
+        }
+    }
+    InterlockedIncrement( &shared->serial );
+    unlock_sessions( mutex );
+}
+
+void shared_session_detach( struct audio_session *session )
+{
+    struct arctic_audio_sessions *shared = get_sessions();
+    struct arctic_audio_session *row = session_row( session );
+    HANDLE mutex;
+
+    if (!row) return;
+    /* the mixer shows the session while its program runs, as Windows does */
+    mutex = lock_sessions();
+    if (row->clients > 0) row->clients--;
+    InterlockedIncrement( &shared->serial );
+    unlock_sessions( mutex );
+}
+
+void shared_session_describe( struct audio_session *session )
+{
+    struct arctic_audio_session *row = session_row( session );
+    HANDLE mutex;
+
+    if (!row) return;
+    mutex = lock_sessions();
+    describe( session, row );
+    unlock_sessions( mutex );
+}
+
+/* the program set its own volume */
+void shared_session_set( struct audio_session *session )
+{
+    struct arctic_audio_sessions *shared = get_sessions();
+    struct arctic_audio_session *row = session_row( session );
+    HANDLE mutex;
+
+    if (!row) return;
+    mutex = lock_sessions();
+    row->volume = session->master_vol;
+    row->mute = session->mute;
+    session->shared_changed = ++row->changed;
+    InterlockedIncrement( &shared->serial );
+    unlock_sessions( mutex );
+}
+
+/* the mixer set it: the session takes it */
+void shared_session_take( struct audio_session *session )
+{
+    struct arctic_audio_session *row = session_row( session );
+
+    if (!row || row->changed == session->shared_changed) return;
+    session->master_vol = max( 0.f, min( 1.f, row->volume ) );
+    session->mute = !!row->mute;
+    session->shared_changed = row->changed;
+}
+
+void shared_session_peak( struct audio_client *client, const BYTE *data, UINT32 frames )
+{
+    struct arctic_audio_session *row = session_row( client->session );
+    UINT32 i, count = frames * client->channel_count;
+    float peak = 0.f, scale;
+
+    if (!row || !data || !count || !client->sample_bytes) return;
+    /* every fourth sample is enough for a meter */
+    for (i = 0; i < count; i += 4)
+    {
+        const BYTE *p = data + i * client->sample_bytes;
+        float v;
+
+        if (client->sample_float) v = fabsf( *(const float *)p );
+        else if (client->sample_bytes == 2) v = abs( *(const INT16 *)p ) / 32768.f;
+        else if (client->sample_bytes == 3) v = abs( (INT32)((p[0] << 8) | (p[1] << 16) | (p[2] << 24)) >> 8 ) / 8388608.f;
+        else if (client->sample_bytes == 4) v = fabsf( (float)*(const INT32 *)p ) / 2147483648.f;
+        else v = (abs( (int)p[0] - 128 )) / 128.f;
+        if (v > peak) peak = v;
+    }
+    scale = client->session->mute ? 0.f : client->session->master_vol;
+    peak = min( 1.f, peak * scale );
+    if (peak > row->peak) row->peak = peak;
+}
+
+/* a call begins and ends: the other programs duck */
+void shared_call( BOOL begin )
+{
+    struct arctic_audio_sessions *shared = get_sessions();
+    DWORD pid = GetCurrentProcessId();
+    HANDLE mutex;
+    int i;
+
+    if (!shared) return;
+    if (begin ? InterlockedIncrement( &process_calls ) != 1 : InterlockedDecrement( &process_calls ) != 0) return;
+    mutex = lock_sessions();
+    for (i = 0; i < ARCTIC_AUDIO_CALLS; i++)
+    {
+        if (begin && !shared->calls[i]) { shared->calls[i] = pid; break; }
+        if (!begin && shared->calls[i] == pid) shared->calls[i] = 0;
+    }
+    InterlockedIncrement( &shared->serial );
+    unlock_sessions( mutex );
+    TRACE( "call %s\n", begin ? "begins" : "ends" );
+}
+
+/* what the Communications tab asks of the other sounds while a call is on */
+float shared_duck_factor(void)
+{
+    struct arctic_audio_sessions *shared = get_sessions();
+    DWORD pid = GetCurrentProcessId(), preference = 1, size = sizeof(preference);
+    BOOL call = FALSE;
+    int i;
+
+    if (!shared || process_calls) return 1.f;
+    for (i = 0; i < ARCTIC_AUDIO_CALLS; i++)
+    {
+        DWORD other = shared->calls[i];
+
+        if (!other || other == pid) continue;
+        if (process_alive( other )) call = TRUE;
+        else InterlockedCompareExchange( (LONG *)&shared->calls[i], 0, other );
+    }
+    if (!call) return 1.f;
+    RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Multimedia\\Audio", L"UserDuckingPreference",
+                  RRF_RT_REG_DWORD, NULL, &preference, &size );
+    switch (preference)
+    {
+    case 0: return 0.f;     /* mute all other sounds */
+    case 1: return 0.2f;    /* reduce by 80 % */
+    case 2: return 0.5f;    /* reduce by 50 % */
+    default: return 1.f;    /* do nothing */
+    }
+}
diff --git a/include/wine/arctic_audio.h b/include/wine/arctic_audio.h
new file mode 100644
--- /dev/null
+++ b/include/wine/arctic_audio.h
@@ -0,0 +1,50 @@
+/*
+ * The audio sessions of every process, for the Volume Mixer
+ *
+ * In Windows the audio service knows every program's session: the Volume
+ * Mixer (SndVol.exe) shows each with its own level and mute, and turns the
+ * other programs down while a call is on (the Communications tab). In Arctic
+ * mmdevapi keeps a row here for each session that plays, and takes back the
+ * volume and mute that SndVol.exe sets in it (a row stays while its process
+ * lives, as Windows lists a session); a process with a call running
+ * is in calls[]. serial moves after every change, and the audio clients of
+ * every process look at it before each buffer.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef __WINE_ARCTIC_AUDIO_H
+#define __WINE_ARCTIC_AUDIO_H
+
+#define ARCTIC_AUDIO_SESSIONS_SECTION  L"Global\\__arctic_audio_sessions"
+#define ARCTIC_AUDIO_SESSIONS_MUTEX    L"Global\\__arctic_audio_sessions_lock"
+#define ARCTIC_AUDIO_SESSIONS_VERSION  1
+#define ARCTIC_AUDIO_SESSIONS          64
+#define ARCTIC_AUDIO_CALLS             16
+
+struct arctic_audio_session
+{
+    DWORD pid;                  /* 0: a free row */
+    GUID  session;              /* the session's GUID, GUID_NULL for the process's own */
+    GUID  device;               /* the endpoint it plays on */
+    LONG  clients;              /* its audio clients */
+    float volume;               /* the session's master volume, 0-1 */
+    LONG  mute;
+    LONG  changed;              /* moves when the volume or mute is set */
+    float peak;                 /* the loudest sample since the mixer last looked, 0-1 */
+    WCHAR name[64];             /* the session's display name, or the program's */
+    WCHAR icon[260];            /* the session's icon, or the program's file */
+};
+
+struct arctic_audio_sessions
+{
+    UINT32 version;
+    volatile LONG serial;
+    struct arctic_audio_session rows[ARCTIC_AUDIO_SESSIONS];
+    DWORD calls[ARCTIC_AUDIO_CALLS];  /* processes with a communications stream running */
+};
+
+#endif
