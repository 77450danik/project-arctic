 {
     HWND *list = list_window_children( parent );
@@ -5237,6 +5274,12 @@ static BOOL show_window( HWND hwnd, INT cmd )
 
     context = set_thread_dpi_awareness_context( get_window_dpi_awareness_context( hwnd ));
 
+    if (cmd == ARCTIC_SW_REMAXIMIZE)
+    {
+        if ((style & (WS_MAXIMIZE | WS_MINIMIZE)) == WS_MAXIMIZE) remaximize_if_moved( hwnd );
+        goto done;
+    }
+
     if ((!(style & (WS_POPUP | WS_CHILD))
          || ((style & (WS_POPUP | WS_CHILD | WS_CAPTION)) == (WS_POPUP | WS_CAPTION)))
         && !get_window_relative( hwnd, GW_OWNER )
