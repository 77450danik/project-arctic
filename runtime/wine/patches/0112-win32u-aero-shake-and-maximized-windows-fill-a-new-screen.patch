+/* Aero Shake: a window shaken by its caption minimizes the others, which
+ * stay so until the user brings them back. A shake is three turns within
+ * a second, each stroke quick and longer than a slip of the hand. */
+#define SHAKE_TURNS   3
+#define SHAKE_TIME    1000   /* ms, the turns */
+#define SHAKE_STROKE  600    /* ms, a slower stroke is a drag */
+
+struct shake_axis
+{
+    int origin;              /* where the stroke began */
+    int extreme;             /* how far it has gone */
+    int dir;                 /* -1, 1, 0: none yet */
+    DWORD start;             /* when it began */
+    DWORD turns[SHAKE_TURNS];
+    UINT count;
+};
+
+static BOOL shake_track( struct shake_axis *axis, int pos, DWORD now, int stroke, int jitter )
+{
+    if (!axis->dir)
+    {
+        if (abs( pos - axis->origin ) < jitter) return FALSE;
+        axis->dir = pos > axis->origin ? 1 : -1;
+        axis->extreme = pos;
+        axis->start = now;
+        return FALSE;
+    }
+    if ((pos - axis->extreme) * axis->dir > 0)
+    {
+        axis->extreme = pos;
+        return FALSE;
+    }
+    if ((axis->extreme - pos) * axis->dir < jitter) return FALSE;
+
+    /* it turned back */
+    if (abs( axis->extreme - axis->origin ) < stroke || now - axis->start > SHAKE_STROKE) axis->count = 0;
+    else
+    {
+        if (axis->count == SHAKE_TURNS)
+        {
+            memmove( axis->turns, axis->turns + 1, (SHAKE_TURNS - 1) * sizeof(axis->turns[0]) );
+            axis->count--;
+        }
+        axis->turns[axis->count++] = now;
+    }
+    axis->origin = axis->extreme;
+    axis->extreme = pos;
+    axis->dir = -axis->dir;
+    axis->start = now;
+    if (axis->count < SHAKE_TURNS || now - axis->turns[0] > SHAKE_TIME) return FALSE;
+    axis->count = 0;
+    return TRUE;
+}
+
+/* a program's window with a frame that can go, not what belongs to the
+ * dragged one or what it belongs to */
+static BOOL shake_takes( HWND hwnd, HWND dragged )
+{
+    DWORD style = get_window_long( hwnd, GWL_STYLE ), exstyle = get_window_long( hwnd, GWL_EXSTYLE );
+    HWND owner;
+
+    if ((style & (WS_VISIBLE | WS_MINIMIZE | WS_CHILD)) != WS_VISIBLE) return FALSE;
+    if (!(style & WS_MINIMIZEBOX) || (style & WS_CAPTION) != WS_CAPTION) return FALSE;
+    if (exstyle & (WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE)) return FALSE;
+    for (owner = hwnd; owner; owner = get_window_relative( owner, GW_OWNER )) if (owner == dragged) return FALSE;
+    for (owner = dragged; owner; owner = get_window_relative( owner, GW_OWNER )) if (owner == hwnd) return FALSE;
+    if (get_window_relative( hwnd, GW_OWNER ) && !(exstyle & WS_EX_APPWINDOW)) return FALSE;
+    return TRUE;
+}
+
+static void shake_others( HWND dragged )
+{
+    HWND *list = list_window_children( get_desktop_window() );
+
+    if (!list) return;
+    for (int i = 0; list[i]; i++)
+        if (list[i] != dragged && shake_takes( list[i], dragged ))
+            NtUserShowWindowAsync( list[i], SW_SHOWMINNOACTIVE );
+    free( list );
+}
