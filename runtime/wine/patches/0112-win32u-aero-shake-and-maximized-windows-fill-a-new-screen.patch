 extern MINMAXINFO get_min_max_info( HWND hwnd );
 extern void window_monitor_dpi_changed( HWND hwnd, UINT old_dpi, UINT new_dpi );
+/* Arctic: commands of ShowWindowAsync only win32u gives */
+#define ARCTIC_SW_REMAXIMIZE        0x4001  /* maximized: take the monitor's work area again */
+extern void remaximize_windows(void);
 extern HWND get_window_relative( HWND hwnd, UINT rel );
 extern DWORD get_window_thread( HWND hwnd, DWORD *process );
 extern void arctic_log_minimize( HWND hwnd, const char *how, INT asked, INT done );
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 2d9ce2b..147c206 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -5032,6 +5032,43 @@ static void remaximize_window( HWND hwnd )
                         info.ptMaxSize.y, SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED );
 }
 
+/* Arctic: ... and only if it is somewhere else now */
+static void remaximize_if_moved( HWND hwnd )
+{
+    MINMAXINFO info = get_min_max_info( hwnd );
+    RECT rect;
+
+    get_window_rect( hwnd, &rect, get_thread_dpi() );
+    if (rect.left == info.ptMaxPosition.x && rect.top == info.ptMaxPosition.y &&
+        rect.right - rect.left == info.ptMaxSize.x && rect.bottom - rect.top == info.ptMaxSize.y)
+        return;
+    remaximize_window( hwnd );
+}
+
+/***********************************************************************
+ *              remaximize_windows
+ *
+ * Arctic: the screen or its work area changed, and as in Windows every
+ * window with a frame that is maximized fills what there is now; each in
+ * its own thread, without waiting. A game of another resolution left a
+ * maximized program the size of the old screen, still marked maximized.
+ */
+void remaximize_windows(void)
+{
+    HWND *list = list_window_children( get_desktop_window() );
+
+    if (!list) return;
+    for (int i = 0; list[i]; i++)
+    {
+        DWORD style = get_window_long( list[i], GWL_STYLE );
+
+        if ((style & (WS_VISIBLE | WS_MAXIMIZE | WS_MINIMIZE)) != (WS_VISIBLE | WS_MAXIMIZE)) continue;
+        if ((style & WS_POPUP) && (style & WS_CAPTION) != WS_CAPTION) continue;
+        NtUserShowWindowAsync( list[i], ARCTIC_SW_REMAXIMIZE );
+    }
+    free( list );
+}
