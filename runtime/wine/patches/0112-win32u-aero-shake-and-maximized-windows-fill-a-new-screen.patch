     BOOL can_snap;
+    struct shake_axis shake_x = { 0 }, shake_y = { 0 };
+    BOOL shaken = FALSE;
+    int shake_stroke = get_system_metrics( SM_CXDRAG ) * 8, shake_jitter = get_system_metrics( SM_CXDRAG ) * 2;
     HWND parent;
     HDC hdc;
     MSG msg;
@@ -819,6 +903,8 @@ static void sys_command_size_move( HWND hwnd, WPARAM wparam )
                (style & WS_CAPTION) == WS_CAPTION;
 
     capture_point = pt;
+    shake_x.origin = pt.x;
+    shake_y.origin = pt.y;
     NtUserClipCursor( NULL );
 
     TRACE( "hwnd %p command %04x, hittest %d, pos %d,%d\n",
@@ -936,6 +1022,15 @@ static void sys_command_size_move( HWND hwnd, WPARAM wparam )
 
         pt = msg.pt;
 
+        /* shaken by its caption: the other windows go, once a drag */
+        if (!shaken && syscommand == SC_MOVE && hittest == HTCAPTION && !parent && msg.message == WM_MOUSEMOVE &&
+            (shake_track( &shake_x, msg.pt.x, msg.time, shake_stroke, shake_jitter ) ||
+             shake_track( &shake_y, msg.pt.y, msg.time, shake_stroke, shake_jitter )))
+        {
+            shaken = TRUE;
+            shake_others( hwnd );
+        }
+
         /* dragged to an edge of the screen: where it would snap shows */
         if (can_snap && hittest == HTCAPTION && msg.message == WM_MOUSEMOVE)
         {
