From bb248208454873d1b481001eebde51e767d41a22 Mon Sep 17 00:00:00 2001
From: 77450danik <dnsystems@email.ua>
Date: Sat, 19 Sep 2026 22:49:20 +0300
Subject: [PATCH] win32u: Keyboard layouts from their layout files, and the
 user's layouts in Preload order.

As win32k does, win32u maps the kbd*.dll that the registry names for a
layout and takes its tables, for every process. The layouts, and the
first one for new threads, come from HKCU\Keyboard Layout\Preload, any
input language can be activated, and HKL_NEXT/HKL_PREV go through them.
---
 dlls/win32u/input.c     | 372 +++++++++++++++++++++++++++++++++++++---
 dlls/win32u/sysparams.c |   4 +-
 2 files changed, 354 insertions(+), 22 deletions(-)

diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index 84d398f7..089fee81 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -30,6 +30,7 @@
 #pragma makedep unix
 #endif
 
+#include <sys/mman.h>
 #include "ntstatus.h"
 #include "win32u_private.h"
 #include "ntuser_private.h"
@@ -407,6 +408,278 @@ static const KBDTABLES kbdus_tables =
     .fLocaleFlags = MAKELONG(0, KBD_VERSION),
