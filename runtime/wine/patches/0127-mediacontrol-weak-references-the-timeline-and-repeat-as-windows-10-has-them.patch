+
+static HRESULT add_event_handler( struct media_control *impl, enum timeline_event event, IUnknown *handler,
+                                  EventRegistrationToken *token )
+{
+    struct event_handler *entry;
+
+    if (!handler) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    IUnknown_AddRef( handler );
+    entry->handler = handler;
+    entry->event = event;
+    entry->token.value = InterlockedIncrement( &impl->next_token );
+    EnterCriticalSection( &controls_cs );
+    list_add_tail( &impl->event_handlers, &entry->entry );
+    LeaveCriticalSection( &controls_cs );
+    *token = entry->token;
+    return S_OK;
+}
+
+static HRESULT remove_event_handler( struct media_control *impl, EventRegistrationToken token )
+{
+    struct event_handler *entry, *found = NULL;
+
+    EnterCriticalSection( &controls_cs );
+    LIST_FOR_EACH_ENTRY( entry, &impl->event_handlers, struct event_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    LeaveCriticalSection( &controls_cs );
+    if (!found) return S_OK;
+    IUnknown_Release( found->handler );
+    free( found );
+    return S_OK;
+}
+
