From ac7cd33c2f2165fda64df2894d01f41d63007f6b Mon Sep 17 00:00:00 2001
From: 77450danik <ddziuba1@stu.vistula.edu.pl>
Date: Mon, 21 Sep 2026 13:05:52 +0300
Subject: [PATCH] win32u: Session 0 has a virtual monitor, as services do.

wineboot ran with the null driver and wrote its 1024x768 display into the
registry, which csrss.exe then took for the display: the desktop and the
taskbar came out 1024x768 on a 1280x800 screen.
---
 dlls/win32u/sysparams.c | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index a70f5d13..7737ce07 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -2873,8 +2873,6 @@ void reset_monitor_update_serial(void)
 
 static BOOL lock_display_devices( BOOL force )
 {
-    static const WCHAR wine_service_station_name[] =
-        {'_','_','w','i','n','e','s','e','r','v','i','c','e','_','w','i','n','s','t','a','t','i','o','n',0};
     struct device_manager_ctx ctx =
     {
         .opengl_gpus = LIST_INIT(ctx.opengl_gpus),
@@ -2882,7 +2880,6 @@ static BOOL lock_display_devices( BOOL force )
     };
     UINT64 serial;
     UINT status;
-    WCHAR name[MAX_PATH];
     BOOL ret = TRUE;
 
     init_display_driver(); /* make sure to load the driver before anything else */
@@ -2892,9 +2889,9 @@ static BOOL lock_display_devices( BOOL force )
     serial = get_monitor_update_serial();
     if (!force && monitor_update_serial >= serial) return TRUE;
 
-    /* services do not have any adapters, only a virtual monitor */
-    if (NtUserGetObjectInformation( NtUserGetProcessWindowStation(), UOI_NAME, name, sizeof(name), NULL )
-        && !wcscmp( name, wine_service_station_name ))
+    /* services do not have any adapters, only a virtual monitor; nor do the
+     * boot tasks of session 0, whose null driver must not become the display */
+    if (is_service_process())
     {
         clear_display_devices();
         list_add_tail( &monitors, &virtual_monitor.entry );
-- 
2.53.0.windows.2

