From: Arctic <arctic@localhost>
Subject: [PATCH] user32: Icon themes.

HKCU\Software\Arctic\Icons\Theme names a folder of %WINDIR%\Resources\Icons
(We10X when not set, empty for the system's own); its <module>\<id>.ico
stands for that icon group of the module however the icon is taken:
LoadIcon, LoadImage, ExtractIcon, PrivateExtractIcons.
---
diff --git a/dlls/user32/exticon.c b/dlls/user32/exticon.c
--- a/dlls/user32/exticon.c	2026-11-08 17:12:29.305041801 +0100
+++ b/dlls/user32/exticon.c	2026-11-08 17:12:29.305161971 +0100
@@ -246,6 +246,172 @@
  *  failure:0;
  *  success: number of icons in file (nIcons = 0) or nr of icons retrieved
  */
+/**********************************************************************
+ *          Arctic: icon themes
+ *
+ * HKCU\Software\Arctic\Icons\Theme names a folder of %WINDIR%\Resources\Icons
+ * ("We10X" when it is not set, "" for the system's own icons): its
+ * <module>\<id>.ico stands for the icon group <id> of <module>.dll or .exe,
+ * however the icon is taken: LoadIcon and LoadImage, ExtractIcon and the
+ * shell's "shell32.dll,4". The shell refreshes what it keeps (shell32's
+ * iconcache.cpp) when the theme changes.
+ */
+
+static SRWLOCK icon_theme_lock = SRWLOCK_INIT;
+
+/* the theme's folder; read again after a third of a second at most, or at once */
+static BOOL icon_theme_dir( WCHAR *dir, DWORD count, BOOL fresh )
+{
+    static WCHAR cached[MAX_PATH];
+    static DWORD checked;
+    static BOOL have;
+    WCHAR name[64] = L"We10X";
+    DWORD size = sizeof(name), type, now = GetTickCount();
+    BOOL ret;
+    HKEY key;
+    UINT len;
+
+    AcquireSRWLockExclusive( &icon_theme_lock );
+    if (fresh || !checked || now - checked > 300)
+    {
+        checked = now ? now : 1;
+        have = FALSE;
+        if (!RegOpenKeyExW( HKEY_CURRENT_USER, L"Software\\Arctic\\Icons", 0, KEY_QUERY_VALUE, &key ))
+        {
+            if (RegQueryValueExW( key, L"Theme", NULL, &type, (BYTE *)name, &size ) || type != REG_SZ)
+                lstrcpyW( name, L"We10X" );
+            name[ARRAY_SIZE(name) - 1] = 0;
+            RegCloseKey( key );
+        }
+        if (name[0] && !wcschr( name, '\\' ) && !wcschr( name, '/' ) && !wcsstr( name, L".." ) &&
+            (len = GetWindowsDirectoryW( cached, ARRAY_SIZE(cached) )) && len + 20 + lstrlenW( name ) < ARRAY_SIZE(cached))
+        {
+            DWORD attr;
+
+            swprintf( cached + len, ARRAY_SIZE(cached) - len, L"\\Resources\\Icons\\%s", name );
+            attr = GetFileAttributesW( cached );
+            have = attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY);
+        }
+    }
+    if ((ret = have)) lstrcpynW( dir, cached, count );
+    ReleaseSRWLockExclusive( &icon_theme_lock );
+    return ret;
+}
+
+/* the theme's folder of a module, when it has one */
+static BOOL icon_theme_module( const WCHAR *module_path, WCHAR *dir, DWORD count, BOOL fresh )
+{
+    const WCHAR *base = wcsrchr( module_path, '\\' ), *dot;
+    WCHAR theme[MAX_PATH];
+    DWORD attr;
+
+    if (!icon_theme_dir( theme, ARRAY_SIZE(theme), fresh )) return FALSE;
+    base = base ? base + 1 : module_path;
+    if (wcsrchr( base, '/' )) base = wcsrchr( base, '/' ) + 1;
+    if (!(dot = wcsrchr( base, '.' ))) dot = base + lstrlenW( base );
+    if (dot == base || dot - base > 64) return FALSE;
+    if (swprintf( dir, count, L"%s\\%.*s", theme, (int)(dot - base), base ) < 0) return FALSE;
+    attr = GetFileAttributesW( dir );
+    return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static BOOL icon_theme_file( const WCHAR *dir, UINT id, WCHAR *path, DWORD count )
+{
+    if (!id || swprintf( path, count, L"%s\\%u.ico", dir, id ) < 0) return FALSE;
+    return GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES;
+}
+
+/* LoadIcon and LoadImage of a module's icon group */
+HICON icon_theme_load( HINSTANCE module, UINT id, INT width, INT height, UINT flags )
+{
+    static struct { WCHAR path[MAX_PATH]; INT width, height; HICON icon; } shared[64];
+    static unsigned int next_shared;
+    WCHAR module_path[MAX_PATH], dir[MAX_PATH], path[MAX_PATH];
+    HICON icon;
+
+    if (!module || ((ULONG_PTR)module & 3) || !GetModuleFileNameW( module, module_path, ARRAY_SIZE(module_path) )) return 0;
+    if (!icon_theme_module( module_path, dir, ARRAY_SIZE(dir), FALSE ) || !icon_theme_file( dir, id, path, ARRAY_SIZE(path) ))
+        return 0;
+    if (!(flags & LR_SHARED))
+        return LoadImageW( 0, path, IMAGE_ICON, width, height, LR_LOADFROMFILE | (flags & (LR_DEFAULTSIZE | LR_MONOCHROME)) );
+
+    /* a shared one is made once: its users never destroy it */
+    AcquireSRWLockExclusive( &icon_theme_lock );
+    for (unsigned int i = 0; i < ARRAY_SIZE(shared); i++)
+    {
+        if (shared[i].icon && shared[i].width == width && shared[i].height == height && !wcsicmp( shared[i].path, path ))
+        {
+            icon = shared[i].icon;
+            ReleaseSRWLockExclusive( &icon_theme_lock );
+            return icon;
+        }
+    }
+    ReleaseSRWLockExclusive( &icon_theme_lock );
+    if (!(icon = LoadImageW( 0, path, IMAGE_ICON, width, height,
+                             LR_LOADFROMFILE | LR_SHARED | (flags & (LR_DEFAULTSIZE | LR_MONOCHROME)) )))
+        return 0;
+    AcquireSRWLockExclusive( &icon_theme_lock );
+    {
+        unsigned int i = next_shared++ % ARRAY_SIZE(shared);
+
+        lstrcpynW( shared[i].path, path, MAX_PATH );
+        shared[i].width = width;
+        shared[i].height = height;
+        shared[i].icon = icon;
+    }
+    ReleaseSRWLockExclusive( &icon_theme_lock );
+    return icon;
+}
+
+struct icon_theme_group { INT index; UINT id; };
+
+static BOOL CALLBACK icon_theme_find_group( HMODULE module, LPCWSTR type, LPWSTR name, LONG_PTR param )
+{
+    struct icon_theme_group *group = (struct icon_theme_group *)param;
+
+    if (group->index--) return TRUE;
+    if (IS_INTRESOURCE( name )) group->id = LOWORD( name );
+    return FALSE;
+}
+
+/* ExtractIcon and the like: one icon, at one size or two; 0 when the theme
+ * has none of it */
+static UINT icon_theme_extract( const WCHAR *file, HICON *icons, INT index, UINT count, UINT cx, UINT cy,
+                                UINT *ids, UINT flags )
+{
+    UINT sizes = HIWORD( cx ) && HIWORD( cy ) ? 2 : 1, id = 0;
+    WCHAR dir[MAX_PATH], path[MAX_PATH];
+
+    if (!icons || !count || count > sizes) return 0;
+    if (!icon_theme_module( file, dir, ARRAY_SIZE(dir), TRUE )) return 0;
+    if (index < 0) id = -index;
+    else
+    {
+        struct icon_theme_group group = { index, 0 };
+        HMODULE module = LoadLibraryExW( file, NULL, LOAD_LIBRARY_AS_DATAFILE );
+
+        if (!module) return 0;
+        EnumResourceNamesW( module, (LPCWSTR)RT_GROUP_ICON, icon_theme_find_group, (LONG_PTR)&group );
+        FreeLibrary( module );
+        id = group.id;
+    }
+    if (!icon_theme_file( dir, id, path, ARRAY_SIZE(path) )) return 0;
+    for (UINT i = 0; i < count; i++)
+    {
+        UINT width = i ? HIWORD( cx ) : LOWORD( cx ), height = i ? HIWORD( cy ) : LOWORD( cy );
+
+        icons[i] = LoadImageW( 0, path, IMAGE_ICON, width, height,
+                               LR_LOADFROMFILE | (width ? 0 : LR_DEFAULTSIZE) | (flags & LR_MONOCHROME) );
+        if (!icons[i])
+        {
+            while (i--) DestroyIcon( icons[i] );
+            return 0;
+        }
+        if (ids) ids[i] = id;
+    }
+    return count;
+}
+
 static UINT ICO_ExtractIconExW(
 	LPCWSTR lpszExeFileName,
 	HICON * RetPtr,
@@ -277,6 +443,9 @@
             return -1;
         }
 
+        /* Arctic: the icon theme's first */
+        if ((ret = icon_theme_extract( szExePath, RetPtr, nIconIndex, nIcons, cxDesired, cyDesired, pIconId, flags ))) return ret;
+
 	hFile = CreateFileW(szExePath, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, 0);
 	if (hFile == INVALID_HANDLE_VALUE) return ret;
 	fsizel = GetFileSize(hFile,&fsizeh);
diff --git a/dlls/user32/cursoricon.c b/dlls/user32/cursoricon.c
--- a/dlls/user32/cursoricon.c	2026-11-08 17:12:29.308078119 +0100
+++ b/dlls/user32/cursoricon.c	2026-11-08 17:12:29.308323322 +0100
@@ -1597,6 +1597,11 @@
 
     if (!hInstance) hInstance = user32_module;  /* Load OEM cursor/icon */
 
+    /* Arctic: the icon theme's first */
+    if (!fCursor && IS_INTRESOURCE( name ) &&
+        (hIcon = icon_theme_load( hInstance, LOWORD( name ), width, height, loadflags )))
+        return hIcon;
+
     /* don't cache 16-bit instances (FIXME: should never get 16-bit instances in the first place) */
     if ((ULONG_PTR)hInstance >> 16 == 0) loadflags &= ~LR_SHARED;
 
diff --git a/dlls/user32/user_private.h b/dlls/user32/user_private.h
--- a/dlls/user32/user_private.h	2026-11-08 17:12:29.309761342 +0100
+++ b/dlls/user32/user_private.h	2026-11-08 17:12:29.309896131 +0100
@@ -44,6 +44,8 @@
 };
 
 extern HMODULE user32_module;
+/* exticon.c: the icon theme's (Arctic) */
+extern HICON icon_theme_load( HINSTANCE module, UINT id, INT width, INT height, UINT flags );
 
 extern NTSTATUS post_dde_message( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, DWORD dest_tid );
 extern BOOL unpack_dde_message( HWND hwnd, UINT message, WPARAM *wparam, LPARAM *lparam,
