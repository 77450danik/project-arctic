From b9e499b6e506e9767942d1588ba7f32a07d3c400 Mon Sep 17 00:00:00 2001
From: 77450danik <ddziuba1@stu.vistula.edu.pl>
Date: Mon, 21 Sep 2026 11:50:27 +0300
Subject: [PATCH] win32u: Processes started before the session run in a session
 0 of their own.

wineboot and the other boot tasks start before csrss.exe has made the
desktop. Their first call for the desktop window brought up csrss.exe
with no display, and the session's own csrss.exe then quit as a second
instance. Like Windows' session 0, they now get a window station nobody
sees and are treated as services are: the server makes their desktop
window and they use no display driver.
---
 dlls/win32u/winstation.c | 39 ++++++++++++++++++++++++++++++++++++---
 1 file changed, 36 insertions(+), 3 deletions(-)

diff --git a/dlls/win32u/winstation.c b/dlls/win32u/winstation.c
index f56ccbf1..7c9683cf 100644
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -348,13 +348,40 @@ BOOL is_virtual_desktop(void)
     return ret;
 }
 
+/* The session's desktop exists once csrss.exe has started to create it:
+ * winsrv.dll makes this event before anything else. */
+static BOOL session_desktop_exists(void)
+{
+    static const WCHAR nameW[] = {'_','_','a','r','c','t','i','c','_','d','e','s','k','t','o','p','_','r','e','a','d','y',0};
+    char path[64];
+    WCHAR buffer[MAX_PATH];
+    UNICODE_STRING str;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE handle;
+    DWORD len, i;
+
+    len = snprintf( path, sizeof(path), "\\Sessions\\%u\\BaseNamedObjects\\", (int)NtCurrentTeb()->Peb->SessionId );
+    for (i = 0; i < len; i++) buffer[i] = path[i];
+    for (i = 0; nameW[i]; i++) buffer[len + i] = nameW[i];
+    buffer[len + i] = 0;
+    str.Buffer = buffer;
+    str.Length = str.MaximumLength = (len + i) * sizeof(WCHAR);
+    InitializeObjectAttributes( &attr, &str, OBJ_CASE_INSENSITIVE, NULL, NULL );
+    if (NtOpenEvent( &handle, SYNCHRONIZE, &attr )) return FALSE;
+    NtClose( handle );
+    return TRUE;
+}
+
+static const WCHAR session0_station_name[] = {'_','_','a','r','c','t','i','c','_','s','e','s','s','i','o','n','0',0};
+
+/* services, and the boot tasks that run before the session, as in Windows' session 0 */
 BOOL is_service_process(void)
 {
     static const WCHAR wine_service_station_name[] = {'_','_','w','i','n','e','s','e','r','v','i','c','e','_','w','i','n','s','t','a','t','i','o','n',0};
     WCHAR name[MAX_PATH];
 
     return NtUserGetObjectInformation( NtUserGetProcessWindowStation(), UOI_NAME, name, sizeof(name), NULL ) &&
-           !wcscmp( name, wine_service_station_name );
+           (!wcscmp( name, wine_service_station_name ) || !wcscmp( name, session0_station_name ));
 }
 
 /***********************************************************************
@@ -996,6 +1023,7 @@ void winstation_init(void)
     UNICODE_STRING str;
 
     static const WCHAR winsta0[] = {'W','i','n','S','t','a','0',0};
+    const WCHAR *default_winstation;
 
     if (params->Desktop.Length)
     {
@@ -1013,7 +1041,12 @@ void winstation_init(void)
     /* set winstation if explicitly specified, or if we don't have one yet */
     if (buffer || !(handle = NtUserGetProcessWindowStation()))
     {
-        str.Buffer = (WCHAR *)(winstation ? winstation : winsta0);
+        /* A process that starts before the session's desktop, like the boot
+         * tasks, gets a window station of its own that nobody sees, as in
+         * Windows' session 0: its first window must not bring up csrss.exe
+         * without the display. The session's processes name WinSta0. */
+        default_winstation = session_desktop_exists() ? winsta0 : session0_station_name;
+        str.Buffer = (WCHAR *)(winstation ? winstation : default_winstation);
         str.Length = str.MaximumLength = lstrlenW( str.Buffer ) * sizeof(WCHAR);
         dir = get_winstations_dir_handle();
         InitializeObjectAttributes( &attr, &str, OBJ_CASE_INSENSITIVE | OBJ_OPENIF,
@@ -1024,7 +1057,7 @@ void winstation_init(void)
         {
             NtUserSetProcessWindowStation( handle );
             /* only WinSta0 is visible */
-            if (!winstation || !wcsicmp( winstation, winsta0 ))
+            if (!wcsicmp( str.Buffer, winsta0 ))
             {
                 USEROBJECTFLAGS flags;
                 flags.fInherit  = FALSE;
-- 
