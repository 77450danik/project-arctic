From c9839cdc6f5586c840a7704c837063cc966667f0 Mon Sep 17 00:00:00 2001
From: 77450danik <ddziuba1@stu.vistula.edu.pl>
Date: Mon, 21 Sep 2026 13:40:11 +0300
Subject: [PATCH] gdi32: Implement GdiDrawStream.

uxtheme draws every image of a visual style through it, as in Windows;
the stub drew nothing, so ReactOS's uxtheme left frames, captions,
buttons and the taskbar unpainted or classic.
---
 dlls/gdi32/Makefile.in  |   1 +
 dlls/gdi32/drawstream.c | 254 ++++++++++++++++++++++++++++++++++++++++
 dlls/gdi32/gdi32.spec   |   2 +-
 3 files changed, 256 insertions(+), 1 deletion(-)
 create mode 100644 dlls/gdi32/drawstream.c

diff --git a/dlls/gdi32/Makefile.in b/dlls/gdi32/Makefile.in
index 61a23f13..96f06432 100644
--- a/dlls/gdi32/Makefile.in
+++ b/dlls/gdi32/Makefile.in
@@ -8,6 +8,7 @@ VER_FILEDESCRIPTION_STR = "Wine graphics library"
 
 SOURCES = \
 	dc.c \
+	drawstream.c \
 	emfdc.c \
 	enhmetafile.c \
 	gdi32.rc \
diff --git a/dlls/gdi32/drawstream.c b/dlls/gdi32/drawstream.c
new file mode 100644
index 00000000..6d801cc3
--- /dev/null
+++ b/dlls/gdi32/drawstream.c
@@ -0,0 +1,254 @@
+/*
+ * GdiDrawStream: draws the images of a visual style
+ *
+ * uxtheme hands every image of a theme part to GdiDrawStream, as in Windows:
+ * the image, its source and destination rectangles, the sizing margins and
+ * how it is to be stretched or tiled and blended. The drawing is the one
+ * uxtheme used to do itself (Wine's uxtheme draw.c, by way of ReactOS's
+ * gdi32, which implements GdiDrawStream with it).
+ *
+ * Copyright (C) 2003 Kevin Koltzau
+ * Copyright (C) ReactOS Team
+ *
