From e66195b11fda46e1841f8c578e731b1313417fee Mon Sep 17 00:00:00 2001
From: 77450danik <ddziuba1@stu.vistula.edu.pl>
Date: Mon, 21 Sep 2026 13:09:58 +0300
Subject: [PATCH] user32: Theme regions are not set on composed windows.

ReactOS's uxtheme shapes every captioned window with a region built from
the caption image, as Windows XP did; the caption part came out empty
and the whole title bar and frame were cut away. dwm.exe composes the
windows, and as in Windows since the DWM their frames stay rectangular.
---
 dlls/user32/hook.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/dlls/user32/hook.c b/dlls/user32/hook.c
index c69c4e62..22251f73 100644
--- a/dlls/user32/hook.c
+++ b/dlls/user32/hook.c
@@ -562,6 +562,16 @@ static BOOL theme_is_active(void)
                           L"ThemeActive", RRF_RT_REG_SZ, NULL, value, &size ) && !wcscmp( value, L"1" );
 }
 
+/* The theme shapes a window's frame with a region, as uxtheme did before
+ * windows were composed. dwm.exe composes every window, and frames stay
+ * rectangular, as in Windows since the DWM: the theme's regions are not set. */
+static int WINAPI theme_set_window_rgn( HWND hwnd, HRGN hrgn, BOOL redraw )
+{
+    if (!hrgn) return NtUserSetWindowRgn( hwnd, 0, redraw );
+    DeleteObject( hrgn );
+    return TRUE;
+}
+
 static BOOL init_theme_api_hook( const WCHAR *dll_name, const WCHAR *func_name )
 {
     char name[64];
@@ -580,7 +590,7 @@ static BOOL init_theme_api_hook( const WCHAR *dll_name, const WCHAR *func_name )
     theme_api.SetScrollInfo = NtUserSetScrollInfo;
     theme_api.EnableScrollBar = NtUserEnableScrollBar;
     theme_api.AdjustWindowRectEx = AdjustWindowRectEx;
-    theme_api.SetWindowRgn = NtUserSetWindowRgn;
+    theme_api.SetWindowRgn = theme_set_window_rgn;
     theme_api.GetSystemMetrics = GetSystemMetrics;
     theme_api.SystemParametersInfoA = SystemParametersInfoA;
     theme_api.SystemParametersInfoW = SystemParametersInfoW;
-- 
2.53.0.windows.2

