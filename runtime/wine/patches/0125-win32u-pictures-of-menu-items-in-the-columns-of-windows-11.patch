 /* Calculate the size of a popup menu */
+/* Arctic: a popup of the Windows 11 style whose items have pictures lays
+ * them out as Windows 11 does: [check mark] [picture] text, with a column
+ * for check marks only while an item is checked, every picture centred in a
+ * column 16 pixels wide at 100 % (or as wide as the widest picture) */
+static void set_columns_11( struct menu *menu )
+{
+    UINT dpi = get_system_dpi(), i;
+    BOOL check = FALSE, picture = FALSE;
+    int width = 16 * dpi / 96;
+
+    menu->col_check = menu->col_icon = menu->col_icon_width = menu->col_text = 0;
+    if ((menu->dwStyle & (MNS_CHECKORBMP | MNS_NOCHECK)) || !menu_style_11()) return;
+    for (i = 0; i < menu->nItems; i++)
+    {
+        struct menu_item *item = &menu->items[i];
+
+        if (item->fType & (MF_SEPARATOR | MF_OWNERDRAW | MF_SYSMENU)) continue;
+        if ((item->fState & MF_CHECKED) || item->hCheckBit || item->hUnCheckBit) check = TRUE;
+        if (item->hbmpItem == HBMMENU_CALLBACK || (item->hbmpItem && !IS_MAGIC_BITMAP( item->hbmpItem )))
+        {
+            RECT rect = item->rect;
+            SIZE size;
+
+            /* measured as calc_menu_item_size does, from an empty rectangle */
+            SetRectEmpty( &item->rect );
+            get_bitmap_item_size( item, &size, menu->hwndOwner );
+            item->rect = rect;
+            if (size.cx <= 0) continue;
+            picture = TRUE;
+            width = max( width, size.cx );
+        }
+    }
+    if (!picture) return;
+    menu->col_check = check ? 16 * dpi / 96 : 0;
+    menu->col_icon = (check ? 38 : 11) * dpi / 96;
+    menu->col_icon_width = width;
+    menu->col_text = menu->col_icon + width + 11 * dpi / 96;
+}
+
 static void calc_popup_menu_size( struct menu *menu, UINT max_height )
 {
     BOOL textandbmp = FALSE, multi_col = FALSE;
@@ -3046,6 +3147,7 @@
 
     start = 0;
     menu->textOffset = 0;
+    set_columns_11( menu );
 
     while (start < menu->nItems)
     {
