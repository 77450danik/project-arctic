+/* Arctic: a picture of 32 bits that has alpha is blended over the item, as
+ * Windows has done since Vista (the shell's pictures of Windows 11's menus);
+ * one whose alpha is all 0 is an old opaque picture and is copied */
+static BOOL bitmap_has_alpha( HBITMAP bmp )
+{
+    DIBSECTION dib;
+    const DWORD *bits;
+    size_t i, n;
+
+    if (NtGdiExtGetObjectW( bmp, sizeof(dib), &dib ) != sizeof(dib)) return FALSE;
+    if (dib.dsBm.bmBitsPixel != 32 || !dib.dsBm.bmBits) return FALSE;
+    bits = dib.dsBm.bmBits;
+    n = (size_t)dib.dsBm.bmWidthBytes / 4 * abs( dib.dsBm.bmHeight );
+    for (i = 0; i < n; i++) if (bits[i] >> 24) return TRUE;
+    return FALSE;
+}
