 dlls/winewayland.drv/arctic-display-v1.xml |  87 ++++++++++
 dlls/winewayland.drv/display.c             | 188 ++++++++++++++++++++-
 dlls/winewayland.drv/wayland.c             |  37 ++++
 dlls/winewayland.drv/wayland_output.c      |  47 ++++++
 dlls/winewayland.drv/waylanddrv.h          |  16 ++
 dlls/winewayland.drv/waylanddrv_main.c     |   1 +
 7 files changed, 374 insertions(+), 3 deletions(-)
 create mode 100755 dlls/winewayland.drv/arctic-display-v1.xml

