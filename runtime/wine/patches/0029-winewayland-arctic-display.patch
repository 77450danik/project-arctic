 }
 
+/* dwm.exe describes the graphics adapter once, when the global is bound */
+static void arctic_display_v1_handle_adapter(void *data, struct arctic_display_v1 *arctic_display_v1,
+                                             uint32_t vendor, uint32_t device, uint32_t subsystem,
+                                             uint32_t revision, const char *description)
+{
+    TRACE("adapter %04x:%04x subsystem %08x revision %02x %s\n", vendor, device, subsystem,
+          revision, debugstr_a(description));
+
+    process_wayland.adapter.vendor = vendor;
+    process_wayland.adapter.device = device;
+    process_wayland.adapter.subsystem = subsystem;
+    process_wayland.adapter.revision = revision;
+    free(process_wayland.adapter.description);
+    process_wayland.adapter.description = strdup(description);
+}
+
+static const struct arctic_display_v1_listener arctic_display_v1_listener =
+{
+    arctic_display_v1_handle_adapter,
+};
+
+
 static void registry_handle_global_remove(void *data, struct wl_registry *registry,
                                           uint32_t id)
 {
diff --git a/dlls/winewayland.drv/wayland_output.c b/dlls/winewayland.drv/wayland_output.c
index f76881a..4078a90 100644
--- a/dlls/winewayland.drv/wayland_output.c
+++ b/dlls/winewayland.drv/wayland_output.c
@@ -299,6 +299,47 @@ static const struct zxdg_output_v1_listener zxdg_output_v1_listener = {
     zxdg_output_v1_handle_description,
 };
 
+/**********************************************************************
+ *          arctic_output_v1
+ *
+ * The EDID of the monitor, which wl_output has no place for: Windows
+ * programs read it as the monitor's own data, and win32u takes the model
+ * and the serial number from it.
+ */
+
+static void arctic_output_v1_handle_edid(void *data, struct arctic_output_v1 *arctic_output_v1,
+                                         struct wl_array *edid)
+{
+    struct wayland_output *output = data;
+    unsigned char *copy = NULL;
+
+    TRACE("edid %zu bytes\n", edid->size);
+
+    if (edid->size && (copy = malloc(edid->size)))
+        memcpy(copy, edid->data, edid->size);
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    free(output->current.edid);
+    output->current.edid = copy;
+    output->current.edid_len = copy ? edid->size : 0;
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+
+    maybe_init_display_devices();
+}
+
+static const struct arctic_output_v1_listener arctic_output_v1_listener =
+{
+    arctic_output_v1_handle_edid,
+};
+
+void wayland_output_use_arctic_extension(struct wayland_output *output)
+{
+    if (output->arctic_output_v1) return;
+    output->arctic_output_v1 =
+        arctic_display_v1_get_output(process_wayland.arctic_display_v1, output->wl_output);
+    arctic_output_v1_add_listener(output->arctic_output_v1, &arctic_output_v1_listener, output);
+}
+
