-    device_manager->add_gpu(NULL, &pci_id, NULL, param);
+    device_manager->add_gpu(adapter->description, &pci_id, NULL, param);
 }
 
 static void wayland_add_device_source(const struct gdi_device_manager *device_manager,
@@ -218,6 +227,11 @@ static void wayland_add_device_monitor(const struct gdi_device_manager *device_m
     /* We don't have a direct way to get the work area in Wayland. */
     monitor.rc_work = monitor.rc_monitor;
 
+    /* what the monitor says about itself: win32u takes its model, its serial
+     * number and its native mode from here */
+    monitor.edid = output_info->output->edid;
+    monitor.edid_len = output_info->output->edid_len;
+
     TRACE("name=%s rc_monitor=rc_work=%s\n",
           output_info->output->name, wine_dbgstr_rect(&monitor.rc_monitor));
 
@@ -265,6 +279,174 @@ static void wayland_add_device_modes(const struct gdi_device_manager *device_man
     free(modes);
 }
 
+/* The outputs in the order win32u numbers them: \\.\\DISPLAY1 is the
+ * primary one, the rest follow from left to right. */
+static UINT sorted_outputs(struct wayland_output **sorted, UINT capacity)
+{
+    struct wl_array output_info_array;
+    struct output_info *output_info;
+    struct wayland_output *output;
+    UINT count = 0;
+
+    wl_array_init(&output_info_array);
+
+    wl_list_for_each(output, &process_wayland.output_list, link)
+    {
+        if (!output->current.current_mode) continue;
+        output_info = wl_array_add(&output_info_array, sizeof(*output_info));
+        if (output_info) output_info->output = &output->current;
+    }
+    output_info_array_arrange_physical_coords(&output_info_array);
+
+    wl_array_for_each(output_info, &output_info_array)
+    {
+        if (count >= capacity) break;
+        /* the state is a member of its output */
+        sorted[count++] = CONTAINING_RECORD(output_info->output, struct wayland_output, current);
+    }
+
+    wl_array_release(&output_info_array);
+    return count;
+}
+
+/* the exact rate of the mode, from the whole Hz a DEVMODE carries */
+static struct wayland_output_mode *output_find_mode(struct wayland_output *output, const DEVMODEW *devmode)
+{
+    struct wayland_output_mode *mode, *found = NULL;
+
+    RB_FOR_EACH_ENTRY(mode, &output->current.modes, struct wayland_output_mode, entry)
+    {
+        if (mode->width != (int)devmode->dmPelsWidth || mode->height != (int)devmode->dmPelsHeight)
+            continue;
+        if (!(devmode->dmFields & DM_DISPLAYFREQUENCY) || !devmode->dmDisplayFrequency)
+        {
+            if (!found || mode->refresh > found->refresh) found = mode;
+        }
+        else if ((mode->refresh + 500) / 1000 == devmode->dmDisplayFrequency) found = mode;
+    }
+    return found;
+}
+
+enum configuration_result { CONFIGURATION_PENDING, CONFIGURATION_DONE, CONFIGURATION_FAILED };
+
+static void configuration_handle_succeeded(void *data, struct arctic_configuration_v1 *configuration)
+{
+    *(enum configuration_result *)data = CONFIGURATION_DONE;
+}
+
+static void configuration_handle_failed(void *data, struct arctic_configuration_v1 *configuration)
+{
+    *(enum configuration_result *)data = CONFIGURATION_FAILED;
+}
+
+static const struct arctic_configuration_v1_listener configuration_listener =
+{
+    configuration_handle_succeeded,
+    configuration_handle_failed,
+};
+
+/***********************************************************************
+ *      ChangeDisplaySettings (WAYLAND.@)
+ *
+ * The modes and positions of every monitor at once, the way win32u hands
+ * them over: dwm.exe sets them on the hardware and answers when the screen
+ * shows them.
+ */
+LONG WAYLAND_ChangeDisplaySettings(LPDEVMODEW displays, LPCWSTR primary_name, HWND hwnd,
+                                   DWORD flags, LPVOID lparam)
+{
+    struct wayland_output *sorted[32], *output;
+    struct arctic_configuration_v1 *configuration;
+    struct arctic_display_v1 *display_wrapper;
+    enum configuration_result result = CONFIGURATION_PENDING;
+    struct wayland_output_mode *modes[32];
+    struct wl_event_queue *queue;
+    LONG ret = DISP_CHANGE_FAILED;
+    DEVMODEW *devmode;
+    UINT count, i = 0;
+
+    if (!process_wayland.arctic_display_v1)
+    {
+        WARN("the compositor does not set modes\n");
+        return DISP_CHANGE_FAILED;
+    }
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+
+    count = sorted_outputs(sorted, ARRAY_SIZE(sorted));
+    for (devmode = displays; devmode->dmSize; devmode = NEXT_DEVMODEW(devmode), i++)
+    {
+        if (i >= count)
+        {
+            WARN("%s is gone\n", debugstr_w(devmode->dmDeviceName));
+            goto done;
+        }
+        if (!devmode->dmPelsWidth || !devmode->dmPelsHeight)
+        {
+            WARN("a monitor cannot be detached yet\n");
+            ret = DISP_CHANGE_BADMODE;
+            goto done;
+        }
+        if (!(modes[i] = output_find_mode(sorted[i], devmode)))
+        {
+            WARN("%s has no mode %ux%u@%u\n", sorted[i]->current.name, (UINT)devmode->dmPelsWidth,
+                 (UINT)devmode->dmPelsHeight, (UINT)devmode->dmDisplayFrequency);
+            ret = DISP_CHANGE_BADMODE;
+            goto done;
+        }
+    }
+    if (!(count = i)) goto done;
+
+    if (!(queue = wl_display_create_queue(process_wayland.wl_display))) goto done;
+    display_wrapper = wl_proxy_create_wrapper(process_wayland.arctic_display_v1);
+    wl_proxy_set_queue((struct wl_proxy *)display_wrapper, queue);
+    configuration = arctic_display_v1_create_configuration(display_wrapper);
+    wl_proxy_wrapper_destroy(display_wrapper);
+    arctic_configuration_v1_add_listener(configuration, &configuration_listener, &result);
+
+    for (devmode = displays, i = 0; i < count; devmode = NEXT_DEVMODEW(devmode), i++)
+    {
+        TRACE("%s %ux%u@%u at %d,%d\n", sorted[i]->current.name, modes[i]->width, modes[i]->height,
+              modes[i]->refresh, (int)devmode->dmPosition.x, (int)devmode->dmPosition.y);
+        arctic_configuration_v1_set_mode(configuration, sorted[i]->wl_output, devmode->dmPosition.x,
+                                         devmode->dmPosition.y, modes[i]->width, modes[i]->height,
+                                         modes[i]->refresh);
+    }
+    /* what the user sets in the Control Panel is kept for this set of monitors */
+    arctic_configuration_v1_apply(configuration,
+                                  (flags & CDS_UPDATEREGISTRY) ? ARCTIC_CONFIGURATION_V1_APPLY_FLAGS_PERSIST : 0);
+    wl_display_flush(process_wayland.wl_display);
+
+    while (result == CONFIGURATION_PENDING)
+        if (wl_display_dispatch_queue(process_wayland.wl_display, queue) < 0) break;
+
+    arctic_configuration_v1_destroy(configuration);
+    wl_event_queue_destroy(queue);
+    if (result != CONFIGURATION_DONE)
+    {
+        WARN("dwm.exe did not take the configuration\n");
+        ret = DISP_CHANGE_FAILED;
+        goto done;
+    }
+
+    /* The monitors show it now; the same state arrives as wl_output events,
+     * but the caller reads the display devices as soon as we return. */
+    for (devmode = displays, i = 0; i < count; devmode = NEXT_DEVMODEW(devmode), i++)
+    {
+        output = sorted[i];
+        output->current.current_mode = modes[i];
+        output->current.logical_x = devmode->dmPosition.x;
+        output->current.logical_y = devmode->dmPosition.y;
+        output->current.logical_w = modes[i]->width;
+        output->current.logical_h = modes[i]->height;
+    }
+    ret = DISP_CHANGE_SUCCESSFUL;
+
+done:
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+    return ret;
+}
+
