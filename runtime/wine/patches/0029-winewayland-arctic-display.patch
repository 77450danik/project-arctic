index 1d46d64..39aa4d8 100644
--- a/dlls/winewayland.drv/display.c
+++ b/dlls/winewayland.drv/display.c
@@ -35,6 +35,8 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(waylanddrv);
 
+#define NEXT_DEVMODEW(mode) ((DEVMODEW *)((char *)((mode) + 1) + (mode)->dmDriverExtra))
+
 struct output_info
 {
     int x, y;
@@ -188,11 +190,18 @@ static void output_info_array_arrange_physical_coords(struct wl_array *output_in
 static void wayland_add_device_gpu(const struct gdi_device_manager *device_manager,
                                    void *param)
 {
-    struct pci_id pci_id = {0};
