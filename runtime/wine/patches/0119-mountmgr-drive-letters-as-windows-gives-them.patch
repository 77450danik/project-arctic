+/* What Windows knows a volume by in MountedDevices (MOUNTDEV_QUERY_UNIQUE_ID):
+ * a USB stick by its device, whatever is written on it, so that a new partition
+ * table leaves it the same stick; a partition of another disk by its partition
+ * table's GUID, or signature and offset. 0 for a volume with neither: Wine's
+ * own id, the mount point, stands for it. */
+static unsigned int arctic_unique_id( const char *udi, const GUID *guid, enum device_type type,
+                                      BYTE *id, unsigned int size )
+{
+    struct arctic_volume_info info;
+    struct arctic_volume_info_params params = { udi, &info };
+    struct arctic_disk *disk;
+
+    if (!udi || type == DEVICE_CDROM || type == DEVICE_DVD || MOUNTMGR_CALL( arctic_volume_info, &params ))
+        return 0;
+    if (info.removable && (disk = find_arctic_disk( info.disk )))
+    {
+        WCHAR *out = (WCHAR *)id, *p;
+        int len = swprintf( out, size / sizeof(WCHAR), L"_??_%s#" DISK_INTERFACE_GUID, disk->instance );
+
+        for (p = out; *p; p++) if (*p == '\\') *p = '#';
+        /* the first partition is the stick's own, the others are known by where they lie */
+        if (info.partnum > 1)
+            len += swprintf( out + len, size / sizeof(WCHAR) - len, L"#%08X%08X",
+                             (unsigned int)(info.offset >> 32), (unsigned int)info.offset );
+        return len * sizeof(WCHAR);
+    }
+    if (!guid || guid_empty( guid ) || size < 24) return 0;
+    if (!guid->Data2 && !guid->Data3 && !memcmp( guid->Data4, "MBR", 3 ))
+    {
+        memcpy( id, &guid->Data1, sizeof(guid->Data1) );
+        memcpy( id + 4, &info.offset, 8 );
+        return 12;
+    }
+    memcpy( id, "DMIO:ID:", 8 );
+    memcpy( id + 8, guid, sizeof(*guid) );
+    return 24;
+}
