+/* A letter that stays goes on the disk at once: the registry is otherwise saved
+ * every half minute, and a power cut in between would lose it. A stick's
+ * automatic letter is not worth writing the hive for. */
+void flush_mount_points(void)
+{
+    if (!mount_key_changed) return;
+    mount_key_changed = FALSE;
+    RegFlushKey( mount_key );
+}
+
+/* the letter of a value of MountedDevices, -1 for any other value */
+static int letter_of_value( const WCHAR *name )
+{
+    static const WCHAR prefix[] = L"\\DosDevices\\";
+    int n = ARRAY_SIZE(prefix) - 1;
+
+    if (wcsnicmp( name, prefix, n ) || name[n + 1] != ':' || name[n + 2]) return -1;
+    if (name[n] >= 'a' && name[n] <= 'z') return name[n] - 'a';
+    if (name[n] >= 'A' && name[n] <= 'Z') return name[n] - 'A';
+    return -1;
+}
+
+/* a partition of a disk that stays in the PC: "DMIO:ID:" and its GPT GUID, or
+ * its MBR signature and offset. A USB stick's is the name of its device. */
+static BOOL is_fixed_disk_id( const BYTE *id, unsigned int len )
+{
+    return (len == 24 && !memcmp( id, "DMIO:ID:", 8 )) || len == 12;
+}
+
+/* What MountedDevices says of the letters: the one this volume owns, or -1,
+ * and in *reserved those of the fixed disks other than this one, there now or
+ * not. As in Windows a letter has one owner, the value of that letter. */
+int kept_drive_letter( const void *id, unsigned int id_len, unsigned int *reserved )
+{
+    WCHAR name[64];
+    BYTE data[MAX_UNIQUE_ID];
+    DWORD index, name_len, size, type;
+    int letter, found = -1;
+    LONG ret;
+
+    *reserved = 0;
+    for (index = 0;; index++)
+    {
+        name_len = ARRAY_SIZE(name);
+        size = sizeof(data);
+        ret = RegEnumValueW( mount_key, index, name, &name_len, NULL, &type, data, &size );
+        if (ret == ERROR_NO_MORE_ITEMS) break;
+        if (ret || type != REG_BINARY || (letter = letter_of_value( name )) < 0) continue;
+        if (id_len && size == id_len && !memcmp( data, id, id_len ))
+        {
+            if (found == -1) found = letter;
+        }
+        else if (is_fixed_disk_id( data, size )) *reserved |= 1u << letter;
+    }
+    return found;
+}
+
+/* a volume has one letter: the others it had in the registry go */
+void forget_other_letters( const void *id, unsigned int id_len, int keep )
+{
+    WCHAR name[64], link[] = L"\\DosDevices\\A:";
+    BYTE data[MAX_UNIQUE_ID];
+    DWORD index, name_len, size, type;
+    unsigned int others = 0;
+    int letter;
+    LONG ret;
+
+    if (!id_len) return;
+    for (index = 0;; index++)
+    {
+        name_len = ARRAY_SIZE(name);
+        size = sizeof(data);
+        ret = RegEnumValueW( mount_key, index, name, &name_len, NULL, &type, data, &size );
+        if (ret == ERROR_NO_MORE_ITEMS) break;
+        if (ret || type != REG_BINARY || (letter = letter_of_value( name )) < 0 || letter == keep) continue;
+        if (size == id_len && !memcmp( data, id, id_len )) others |= 1u << letter;
+    }
+    if (!others) return;
+    for (letter = 0; letter < 26; letter++)
+    {
+        if (!(others & (1u << letter))) continue;
+        link[12] = 'A' + letter;
+        RegDeleteValueW( mount_key, link );
+    }
+    RegFlushKey( mount_key );
+}
+
+/* The letters kept before MountedDevices kept them. That key is left as it is:
+ * going back to the previous update reads it. Only the GPT partitions come
+ * over: the others there are sticks, which keep no letter any more. */
+static void import_old_drive_letters(void)
+{
+    WCHAR name[64], value[4], link[] = L"\\DosDevices\\A:";
+    UNICODE_STRING string;
+    BYTE id[24], old[MAX_UNIQUE_ID];
+    DWORD index, name_len, size, type;
+    unsigned int reserved;
+    BOOL changed = FALSE;
+    GUID guid;
+    HKEY key;
+    LONG ret;
+    int letter;
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"System\\Arctic\\DriveLetters", 0, KEY_QUERY_VALUE, &key )) return;
+    for (index = 0;; index++)
+    {
+        name_len = ARRAY_SIZE(name);
+        size = sizeof(value) - sizeof(WCHAR);
+        ret = RegEnumValueW( key, index, name, &name_len, NULL, &type, (BYTE *)value, &size );
+        if (ret == ERROR_NO_MORE_ITEMS) break;
+        if (ret || type != REG_SZ || size < sizeof(WCHAR)) continue;
+        RtlInitUnicodeString( &string, name );
+        if (RtlGUIDFromString( &string, &guid )) continue;
+        /* what arctic.c made up for an MBR partition or a disk with no table:
+         * a generated GUID always has a version in Data3 */
+        if (!guid.Data3) continue;
+        letter = towupper( value[0] ) - 'A';
+        if (letter < 3 || letter > 25) continue;
+
+        memcpy( id, "DMIO:ID:", 8 );
+        memcpy( id + 8, &guid, sizeof(guid) );
+        /* already here, with this letter or one chosen since */
+        if (kept_drive_letter( id, sizeof(id), &reserved ) != -1) continue;
+        link[12] = 'A' + letter;
+        size = sizeof(old);
+        if (!RegQueryValueExW( mount_key, link, NULL, &type, old, &size )) continue;
+        RegSetValueExW( mount_key, link, 0, REG_BINARY, id, sizeof(id) );
+        changed = TRUE;
+    }
+    RegCloseKey( key );
+    if (changed) RegFlushKey( mount_key );
+}
