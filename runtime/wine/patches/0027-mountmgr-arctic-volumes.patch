+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#ifdef __linux__
+#include <sys/inotify.h>
+#endif
+
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mountmgr);
+
+#define VOLUMES_DIR "/run/arctic/volumes"
+
+#ifdef __linux__
+
+static BOOL parse_guid( const char *str, GUID *guid )
+{
+    unsigned int d[11];
+
+    if (strlen( str ) != 36 ||
+        sscanf( str, "%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x", &d[0], &d[1], &d[2], &d[3], &d[4],
+                &d[5], &d[6], &d[7], &d[8], &d[9], &d[10] ) != 11)
+        return FALSE;
+    guid->Data1 = d[0];
+    guid->Data2 = d[1];
+    guid->Data3 = d[2];
+    for (int i = 0; i < 8; i++) guid->Data4[i] = d[3 + i];
+    return TRUE;
+}
+
+/* a record is key=value lines: device, mount, type (fixed, removable or
+ * cdrom), fs, label, uuid, partuuid, read_only */
+static void add_volume_record( const char *name )
+{
+    char path[PATH_MAX], line[1024];
+    char device[256] = "", mount[256] = "", type[32] = "", label[256] = "", uuid[64] = "", partuuid[64] = "";
+    enum device_type device_type;
+    GUID guid, *guid_ptr = NULL;
+    FILE *f;
+
+    snprintf( path, sizeof(path), VOLUMES_DIR "/%s", name );
+    if (!(f = fopen( path, "r" )))
+    {
+        WARN( "%s: %s\n", debugstr_a(path), strerror(errno) );
+        return;
+    }
+    while (fgets( line, sizeof(line), f ))
+    {
+        char *value = strchr( line, '=' ), *end;
+
+        if (!value) continue;
+        *value++ = 0;
+        if ((end = strchr( value, '\n' ))) *end = 0;
+        if (!strcmp( line, "device" )) snprintf( device, sizeof(device), "%s", value );
+        else if (!strcmp( line, "mount" )) snprintf( mount, sizeof(mount), "%s", value );
+        else if (!strcmp( line, "type" )) snprintf( type, sizeof(type), "%s", value );
+        else if (!strcmp( line, "label" )) snprintf( label, sizeof(label), "%s", value );
+        else if (!strcmp( line, "uuid" )) snprintf( uuid, sizeof(uuid), "%s", value );
+        else if (!strcmp( line, "partuuid" )) snprintf( partuuid, sizeof(partuuid), "%s", value );
+    }
+    fclose( f );
+    if (!device[0] || !mount[0]) return;
+
+    if (!strcmp( type, "cdrom" )) device_type = DEVICE_CDROM;
+    else if (!strcmp( type, "removable" )) device_type = DEVICE_HARDDISK; /* DRIVE_REMOVABLE */
+    else device_type = DEVICE_HARDDISK_VOL;                            /* DRIVE_FIXED */
+    if (parse_guid( partuuid, &guid ) || parse_guid( uuid, &guid )) guid_ptr = &guid;
+
+    TRACE( "%s: %s on %s, %s, label %s\n", debugstr_a(name), debugstr_a(device), debugstr_a(mount),
+           type, debugstr_a(label) );
+    queue_device_op( ADD_DOS_DEVICE, name, device, mount, device_type, guid_ptr, NULL,
+                     label[0] ? label : NULL, NULL );
+}
+
+static void remove_volume_record( const char *name )
+{
+    TRACE( "%s\n", debugstr_a(name) );
+    queue_device_op( REMOVE_DEVICE, name, NULL, NULL, DEVICE_UNKNOWN, NULL, NULL, NULL, NULL );
+}
+
+void run_arctic_loop(void)
+{
+    char buffer[4096] __attribute__((aligned(__alignof__(struct inotify_event))));
+    struct dirent *de;
+    DIR *dir;
+    int fd;
+
+    if ((fd = inotify_init1( IN_CLOEXEC )) == -1) return;
+    /* records are written under a dot name and renamed when whole */
+    if (inotify_add_watch( fd, VOLUMES_DIR, IN_MOVED_TO | IN_MOVED_FROM | IN_DELETE ) == -1)
+    {
+        TRACE( "no %s: %s\n", VOLUMES_DIR, strerror(errno) );
+        close( fd );
+        return;
+    }
+
+    /* the volumes there before mountmgr started */
+    if ((dir = opendir( VOLUMES_DIR )))
+    {
+        while ((de = readdir( dir )))
+            if (de->d_name[0] != '.') add_volume_record( de->d_name );
+        closedir( dir );
+    }
+
+    for (;;)
+    {
+        ssize_t len = read( fd, buffer, sizeof(buffer) );
+        char *p;
+
+        if (len <= 0)
+        {
+            if (len == -1 && errno == EINTR) continue;
+            break;
+        }
+        for (p = buffer; p < buffer + len; p += sizeof(struct inotify_event) + ((struct inotify_event *)p)->len)
+        {
+            struct inotify_event *event = (struct inotify_event *)p;
+
+            if (!event->len || event->name[0] == '.') continue;
+            if (event->mask & IN_MOVED_TO) add_volume_record( event->name );
+            else if (event->mask & (IN_MOVED_FROM | IN_DELETE)) remove_volume_record( event->name );
+        }
+    }
+    close( fd );
+}
+
+#else
+
+void run_arctic_loop(void)
+{
+}
+
+#endif
diff --git a/dlls/mountmgr.sys/device.c b/dlls/mountmgr.sys/device.c
index 51e3cb19..6d19736c 100644
--- a/dlls/mountmgr.sys/device.c
+++ b/dlls/mountmgr.sys/device.c
@@ -1020,8 +1020,9 @@ static NTSTATUS set_volume_info( struct volume *volume, struct dos_drive *drive,
         get_filesystem_label( volume );
         get_filesystem_serial( volume );
     }
+    /* labels come from the host in UTF-8 */
     if (label && label[0] && !volume->label[0])
-        RtlMultiByteToUnicodeN(volume->label, ARRAY_SIZE(volume->label), NULL, label, strlen(label)+1);
+        MultiByteToWideChar( CP_UTF8, 0, label, -1, volume->label, ARRAY_SIZE(volume->label) );
 
     TRACE("fs_type %#x, label %s, serial %08lx\n", volume->fs_type, debugstr_w(volume->label), volume->serial);
 
diff --git a/dlls/mountmgr.sys/mountmgr.c b/dlls/mountmgr.sys/mountmgr.c
index 762fa395..2135bc94 100644
--- a/dlls/mountmgr.sys/mountmgr.c
+++ b/dlls/mountmgr.sys/mountmgr.c
@@ -564,6 +564,13 @@ static DWORD WINAPI run_loop_thread( void *arg )
     return MOUNTMGR_CALL( run_loop, &params );
 }
 
+/* the volumes the Arctic host mounts */
+static DWORD WINAPI arctic_loop_thread( void *arg )
+{
+    struct run_loop_params params = {.op_thread = arg, .op_apc = device_op};
+    return MOUNTMGR_CALL( arctic_loop, &params );
+}
+
 static NTSTATUS WINAPI mountmgr_create( DEVICE_OBJECT *device, IRP *irp )
 {
     irp->IoStatus.Status = STATUS_SUCCESS;
@@ -614,6 +621,7 @@ NTSTATUS WINAPI DriverEntry( DRIVER_OBJECT *driver, UNICODE_STRING *path )
 
     thread = CreateThread( NULL, 0, device_op_thread, NULL, 0, NULL );
     CloseHandle( CreateThread( NULL, 0, run_loop_thread, thread, 0, NULL ));
+    CloseHandle( CreateThread( NULL, 0, arctic_loop_thread, thread, 0, NULL ));
 
 #ifdef _WIN64
     /* create a symlink so that the Wine port overrides key can be edited with 32-bit reg or regedit */
diff --git a/dlls/mountmgr.sys/unixlib.c b/dlls/mountmgr.sys/unixlib.c
index 235e3ae1..5127dfc9 100644
--- a/dlls/mountmgr.sys/unixlib.c
+++ b/dlls/mountmgr.sys/unixlib.c
@@ -181,6 +181,16 @@ static NTSTATUS run_loop( void *args )
     return STATUS_SUCCESS;
 }
 
+/* on a thread of its own, next to D-Bus, which, when it runs, does not return */
+static NTSTATUS arctic_loop( void *args )
+{
+    const struct run_loop_params *params = args;
+
+    run_loop_params = *params;
+    run_arctic_loop();
+    return STATUS_SUCCESS;
+}
+
 static NTSTATUS dequeue_device_op( void *args )
 {
     const struct dequeue_device_op_params *params = args;
@@ -635,6 +645,7 @@ const unixlib_entry_t __wine_unix_call_funcs[] =
     write_credential,
     delete_credential,
     enumerate_credentials,
+    arctic_loop,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
diff --git a/dlls/mountmgr.sys/unixlib.h b/dlls/mountmgr.sys/unixlib.h
index bb4cfc46..75629919 100644
--- a/dlls/mountmgr.sys/unixlib.h
+++ b/dlls/mountmgr.sys/unixlib.h
@@ -193,12 +193,14 @@ enum mountmgr_funcs
     unix_write_credential,
     unix_delete_credential,
     unix_enumerate_credentials,
+    unix_arctic_loop,
     unix_funcs_count
 };
 
 #define MOUNTMGR_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
 
 extern NTSTATUS errno_to_status( int err );
+extern void run_arctic_loop(void);
 extern void queue_device_op( enum device_op op, const char *udi, const char *device,
                              const char *mount_point, enum device_type type, const GUID *guid,
                              const char *disk_serial, const char *label,
-- 
