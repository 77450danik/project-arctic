From 00478a806d13f1e13d38f7ca263ad6897883e999 Mon Sep 17 00:00:00 2001
From: 77450danik <ddziuba1@stu.vistula.edu.pl>
Date: Mon, 21 Sep 2026 17:08:58 +0300
Subject: [PATCH] mountmgr.sys: Volumes the Arctic host mounts get drive
 letters as they come and go.

The host mounts every volume Windows would give a letter to and describes
each in a file of /run/arctic/volumes; the folder is watched with inotify.
Fixed disks, removable disks and CDs get their letters and Windows' drive
types, and the shell hears of each through WM_DEVICECHANGE.
---
 dlls/mountmgr.sys/Makefile.in |   1 +
 dlls/mountmgr.sys/arctic.c    | 168 ++++++++++++++++++++++++++++++++++
 dlls/mountmgr.sys/unixlib.c   |  10 ++
 dlls/mountmgr.sys/unixlib.h   |   1 +
 4 files changed, 180 insertions(+)
 create mode 100644 dlls/mountmgr.sys/arctic.c

diff --git a/dlls/mountmgr.sys/Makefile.in b/dlls/mountmgr.sys/Makefile.in
index 5d732eb9..086d6544 100644
--- a/dlls/mountmgr.sys/Makefile.in
+++ b/dlls/mountmgr.sys/Makefile.in
@@ -8,6 +8,7 @@ UNIX_LIBS    = $(DISKARBITRATION_LIBS) $(SYSTEMCONFIGURATION_LIBS) $(CORESERVICE
 EXTRADLLFLAGS = -Wl,--subsystem,native
 
 SOURCES = \
+	arctic.c \
 	cdrom.c \
 	cred.c \
 	dbus.c \
diff --git a/dlls/mountmgr.sys/arctic.c b/dlls/mountmgr.sys/arctic.c
new file mode 100644
index 00000000..41e52aca
--- /dev/null
+++ b/dlls/mountmgr.sys/arctic.c
@@ -0,0 +1,168 @@
+/*
+ * Volumes of the Arctic host
+ *
+ * Arctic's host mounts every volume Windows would give a drive letter to
+ * (arctic-volume, which udev runs as disks come and go) and describes each in
+ * a file of /run/arctic/volumes named after the device. The folder is watched
+ * here, and each volume gets its letter the moment it is plugged in.
+ *
