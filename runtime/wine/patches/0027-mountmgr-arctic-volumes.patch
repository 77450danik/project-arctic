diff --git a/dlls/mountmgr.sys/arctic.c b/dlls/mountmgr.sys/arctic.c
new file mode 100644
index 00000000..e8a5cf03
--- /dev/null
+++ b/dlls/mountmgr.sys/arctic.c
@@ -0,0 +1,269 @@
+/*
+ * Volumes of the Arctic host
+ *
+ * Arctic's host mounts every volume Windows would give a drive letter to
+ * (arctic-volume, which udev runs as disks come and go) and describes each in
+ * a file of /run/arctic/volumes named after the device. The folder is watched
+ * here, and each volume gets its letter the moment it is plugged in.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#ifdef __linux__
+#include <sys/inotify.h>
+#endif
+
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mountmgr);
+
+#define VOLUMES_DIR "/run/arctic/volumes"
+#define EJECT_DIR "/run/arctic/eject" /* served by arctic-init, which is root */
+
+#ifdef __linux__
+
+static BOOL parse_guid( const char *str, GUID *guid )
+{
+    unsigned int d[11];
+
+    if (strlen( str ) != 36 ||
+        sscanf( str, "%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x", &d[0], &d[1], &d[2], &d[3], &d[4],
+                &d[5], &d[6], &d[7], &d[8], &d[9], &d[10] ) != 11)
+        return FALSE;
+    guid->Data1 = d[0];
+    guid->Data2 = d[1];
+    guid->Data3 = d[2];
+    for (int i = 0; i < 8; i++) guid->Data4[i] = d[3 + i];
+    return TRUE;
+}
+
+/* a record is key=value lines: device, mount, type (fixed, removable or
+ * cdrom), fs, label, uuid, partuuid, read_only */
+static void add_volume_record( const char *name )
+{
+    char path[PATH_MAX], line[1024];
+    char device[256] = "", mount[256] = "", type[32] = "", label[256] = "", uuid[64] = "", partuuid[64] = "";
+    enum device_type device_type;
+    GUID guid, *guid_ptr = NULL;
+    FILE *f;
+
+    snprintf( path, sizeof(path), VOLUMES_DIR "/%s", name );
+    if (!(f = fopen( path, "r" )))
+    {
+        WARN( "%s: %s\n", debugstr_a(path), strerror(errno) );
+        return;
+    }
+    while (fgets( line, sizeof(line), f ))
+    {
+        char *value = strchr( line, '=' ), *end;
+
+        if (!value) continue;
+        *value++ = 0;
+        if ((end = strchr( value, '\n' ))) *end = 0;
+        if (!strcmp( line, "device" )) snprintf( device, sizeof(device), "%s", value );
+        else if (!strcmp( line, "mount" )) snprintf( mount, sizeof(mount), "%s", value );
+        else if (!strcmp( line, "type" )) snprintf( type, sizeof(type), "%s", value );
+        else if (!strcmp( line, "label" )) snprintf( label, sizeof(label), "%s", value );
+        else if (!strcmp( line, "uuid" )) snprintf( uuid, sizeof(uuid), "%s", value );
+        else if (!strcmp( line, "partuuid" )) snprintf( partuuid, sizeof(partuuid), "%s", value );
+    }
+    fclose( f );
+    if (!device[0] || !mount[0]) return;
+
+    if (!strcmp( type, "cdrom" )) device_type = DEVICE_CDROM;
+    else if (!strcmp( type, "removable" )) device_type = DEVICE_HARDDISK; /* DRIVE_REMOVABLE */
+    else device_type = DEVICE_HARDDISK_VOL;                            /* DRIVE_FIXED */
+    if (parse_guid( partuuid, &guid ) || parse_guid( uuid, &guid )) guid_ptr = &guid;
+
+    TRACE( "%s: %s on %s, %s, label %s\n", debugstr_a(name), debugstr_a(device), debugstr_a(mount),
+           type, debugstr_a(label) );
+    queue_device_op( ADD_DOS_DEVICE, name, device, mount, device_type, guid_ptr, NULL,
+                     label[0] ? label : NULL, NULL );
+}
+
+static void remove_volume_record( const char *name )
+{
+    TRACE( "%s\n", debugstr_a(name) );
+    queue_device_op( REMOVE_DEVICE, name, NULL, NULL, DEVICE_UNKNOWN, NULL, NULL, NULL, NULL );
+}
+
+void run_arctic_loop(void)
+{
+    char buffer[4096] __attribute__((aligned(__alignof__(struct inotify_event))));
+    struct dirent *de;
+    DIR *dir;
+    int fd;
+
+    if ((fd = inotify_init1( IN_CLOEXEC )) == -1) return;
+    /* records are written under a dot name and renamed when whole */
+    if (inotify_add_watch( fd, VOLUMES_DIR, IN_MOVED_TO | IN_MOVED_FROM | IN_DELETE ) == -1)
+    {
+        TRACE( "no %s: %s\n", VOLUMES_DIR, strerror(errno) );
+        close( fd );
+        return;
+    }
+
+    /* the volumes there before mountmgr started */
+    if ((dir = opendir( VOLUMES_DIR )))
+    {
+        while ((de = readdir( dir )))
+            if (de->d_name[0] != '.') add_volume_record( de->d_name );
+        closedir( dir );
+    }
+
+    for (;;)
+    {
+        ssize_t len = read( fd, buffer, sizeof(buffer) );
+        char *p;
+
+        if (len <= 0)
+        {
+            if (len == -1 && errno == EINTR) continue;
+            break;
+        }
+        for (p = buffer; p < buffer + len; p += sizeof(struct inotify_event) + ((struct inotify_event *)p)->len)
+        {
+            struct inotify_event *event = (struct inotify_event *)p;
+
+            if (!event->len || event->name[0] == '.') continue;
+            if (event->mask & IN_MOVED_TO) add_volume_record( event->name );
+            else if (event->mask & (IN_MOVED_FROM | IN_DELETE)) remove_volume_record( event->name );
+        }
+    }
+    close( fd );
+}
+
+/* reads one key of a volume's record */
+static BOOL read_record( const char *udi, const char *key, char *value, size_t size )
+{
+    char path[PATH_MAX], line[1024];
+    size_t len = strlen( key );
+    BOOL found = FALSE;
+    FILE *f;
+
+    if (!udi || strchr( udi, '/' )) return FALSE;
+    snprintf( path, sizeof(path), VOLUMES_DIR "/%s", udi );
+    if (!(f = fopen( path, "r" ))) return FALSE;
+    while (!found && fgets( line, sizeof(line), f ))
+    {
+        if (strncmp( line, key, len ) || line[len] != '=') continue;
+        line[strcspn( line, "\n" )] = 0;
+        snprintf( value, size, "%s", line + len + 1 );
+        found = TRUE;
+    }
+    fclose( f );
+    return found;
+}
+
+/* every disk keeps the number it got first, as a PhysicalDrive number does */
+static ULONG disk_number( const char *disk )
+{
+    static char disks[64][32];
+    static unsigned int count;
+    unsigned int i;
+
+    for (i = 0; i < count; i++) if (!strcmp( disks[i], disk )) return i + 1;
+    if (count == ARRAY_SIZE(disks)) return 0;
+    snprintf( disks[count], sizeof(disks[count]), "%s", disk );
+    return ++count;
+}
+
+NTSTATUS arctic_volume_info( void *args )
+{
+    const struct arctic_volume_info_params *params = args;
+    struct arctic_volume_info *info = params->info;
+    char value[32];
+
+    memset( info, 0, sizeof(*info) );
+    if (!read_record( params->udi, "disk", info->disk, sizeof(info->disk) )) return STATUS_NOT_FOUND;
+    read_record( params->udi, "product", info->product, sizeof(info->product) );
+    info->usb = read_record( params->udi, "usb", value, sizeof(value) ) && !strcmp( value, "1" );
+    info->removable = read_record( params->udi, "type", value, sizeof(value) ) && !strcmp( value, "removable" );
+    info->disk_number = disk_number( info->disk );
+    return STATUS_SUCCESS;
+}
+
+/* asks the host to take the disk away safely and waits for its answer */
+NTSTATUS arctic_eject( void *args )
+{
+    const struct arctic_eject_params *params = args;
+    char disk[32], request[PATH_MAX], answer[PATH_MAX], result[16] = "";
+    int fd, i;
+
+    if (!read_record( params->udi, "disk", disk, sizeof(disk) )) return STATUS_NO_SUCH_DEVICE;
+    snprintf( request, sizeof(request), EJECT_DIR "/%s", disk );
+    snprintf( answer, sizeof(answer), EJECT_DIR "/%s.done", disk );
+    unlink( answer );
+    if ((fd = open( request, O_WRONLY | O_CREAT | O_CLOEXEC, 0644 )) == -1)
+    {
+        ERR( "%s: %s\n", request, strerror(errno) );
+        return STATUS_ACCESS_DENIED;
+    }
+    close( fd );
+
+    /* flushing a slow stick can take a while */
+    for (i = 0; i < 600; i++)
+    {
+        if ((fd = open( answer, O_RDONLY | O_CLOEXEC )) != -1)
+        {
+            ssize_t len = read( fd, result, sizeof(result) - 1 );
+
+            close( fd );
+            unlink( answer );
+            result[len > 0 ? len : 0] = 0;
+            TRACE( "%s: %s\n", disk, result );
+            if (!strcmp( result, "ok" )) return STATUS_SUCCESS;
+            if (!strcmp( result, "busy" )) return STATUS_DEVICE_BUSY;
+            return STATUS_UNSUCCESSFUL;
+        }
+        usleep( 100000 );
+    }
+    unlink( request );
+    return STATUS_IO_TIMEOUT;
+}
+
+#else
+
+void run_arctic_loop(void)
+{
+}
+
+NTSTATUS arctic_volume_info( void *args )
+{
+    return STATUS_NOT_FOUND;
+}
+
+NTSTATUS arctic_eject( void *args )
+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+#endif
diff --git a/dlls/mountmgr.sys/device.c b/dlls/mountmgr.sys/device.c
index 51e3cb19..99aca1d1 100644
--- a/dlls/mountmgr.sys/device.c
+++ b/dlls/mountmgr.sys/device.c
@@ -1020,8 +1020,9 @@ static NTSTATUS set_volume_info( struct volume *volume, struct dos_drive *drive,
         get_filesystem_label( volume );
         get_filesystem_serial( volume );
     }
+    /* labels come from the host in UTF-8 */
     if (label && label[0] && !volume->label[0])
-        RtlMultiByteToUnicodeN(volume->label, ARRAY_SIZE(volume->label), NULL, label, strlen(label)+1);
+        MultiByteToWideChar( CP_UTF8, 0, label, -1, volume->label, ARRAY_SIZE(volume->label) );
 
     TRACE("fs_type %#x, label %s, serial %08lx\n", volume->fs_type, debugstr_w(volume->label), volume->serial);
 
@@ -1553,6 +1554,64 @@ NTSTATUS query_unix_drive( void *buff, SIZE_T insize, SIZE_T outsize, IO_STATUS_
     return status;
 }
 
+/* the disk under a volume the Arctic host mounted, from the host's record */
+static BOOL get_arctic_info( struct disk_device *device, struct arctic_volume_info *info )
+{
+    struct arctic_volume_info_params params;
+
+    if (!device->volume || !device->volume->udi) return FALSE;
+    params.udi = device->volume->udi;
+    params.info = info;
+    return !MOUNTMGR_CALL( arctic_volume_info, &params );
+}
+
+struct arctic_eject_request
+{
+    IRP  *irp;
+    char *udi;
+};
+
+/* the host flushes, unmounts and powers the disk off, which takes a moment:
+ * the request completes on a thread of its own */
+static DWORD WINAPI arctic_eject_thread( void *arg )
+{
+    struct arctic_eject_request *request = arg;
+    struct arctic_eject_params params = { request->udi };
+    NTSTATUS status = MOUNTMGR_CALL( arctic_eject, &params );
+
+    TRACE( "%s: %#lx\n", debugstr_a(request->udi), status );
+    request->irp->IoStatus.Status = status;
+    request->irp->IoStatus.Information = 0;
+    IoCompleteRequest( request->irp, IO_NO_INCREMENT );
+    RtlFreeHeap( GetProcessHeap(), 0, request->udi );
+    RtlFreeHeap( GetProcessHeap(), 0, request );
+    return 0;
+}
+
+static NTSTATUS arctic_eject_volume( struct disk_device *device, IRP *irp )
+{
+    struct arctic_eject_request *request;
+    HANDLE thread;
+
+    if (!(request = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*request) ))) return STATUS_NO_MEMORY;
+    if (!(request->udi = RtlAllocateHeap( GetProcessHeap(), 0, strlen( device->volume->udi ) + 1 )))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, request );
+        return STATUS_NO_MEMORY;
+    }
+    strcpy( request->udi, device->volume->udi );
+    request->irp = irp;
+    IoMarkIrpPending( irp );
+    if (!(thread = CreateThread( NULL, 0, arctic_eject_thread, request, 0, NULL )))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, request->udi );
+        RtlFreeHeap( GetProcessHeap(), 0, request );
+        return STATUS_NO_MEMORY;
+    }
+    CloseHandle( thread );
+    return STATUS_PENDING;
+}
+
 static NTSTATUS query_property( struct disk_device *device, IRP *irp )
 {
     IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation( irp );
@@ -1577,8 +1636,11 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
     {
         STORAGE_DEVICE_DESCRIPTOR *descriptor;
         DWORD len = sizeof(*descriptor);
+        struct arctic_volume_info arctic;
+        BOOL is_arctic = get_arctic_info( device, &arctic );
 
         if (device->disk_serial) len += strlen( device->disk_serial ) + 1;
+        if (is_arctic) len += strlen( arctic.product ) + 1;
 
         if (irpsp->Parameters.DeviceIoControl.OutputBufferLength < sizeof(STORAGE_DESCRIPTOR_HEADER))
             status = STATUS_INVALID_PARAMETER;
@@ -1613,6 +1675,15 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
                 descriptor->SerialNumberOffset = sizeof(*descriptor);
                 strcpy( (char *)descriptor + descriptor->SerialNumberOffset, device->disk_serial );
             }
+            /* a volume of the Arctic host: its disk as the host sees it */
+            if (is_arctic)
+            {
+                descriptor->RemovableMedia = arctic.removable;
+                descriptor->BusType = arctic.usb ? BusTypeUsb : BusTypeAta;
+                descriptor->ProductIdOffset = sizeof(*descriptor);
+                if (device->disk_serial) descriptor->ProductIdOffset += strlen( device->disk_serial ) + 1;
+                strcpy( (char *)descriptor + descriptor->ProductIdOffset, arctic.product );
+            }
             irp->IoStatus.Information = len;
             status = STATUS_SUCCESS;
         }
@@ -1920,8 +1991,12 @@ static NTSTATUS WINAPI disk_ioctl( DEVICE_OBJECT *device, IRP *irp )
     case IOCTL_STORAGE_GET_DEVICE_NUMBER:
     {
         DWORD len = min( sizeof(dev->devnum), irpsp->Parameters.DeviceIoControl.OutputBufferLength );
+        STORAGE_DEVICE_NUMBER devnum = dev->devnum;
+        struct arctic_volume_info arctic;
 
-        memcpy( irp->AssociatedIrp.SystemBuffer, &dev->devnum, len );
+        /* the volumes of one disk of the Arctic host share its number */
+        if (get_arctic_info( dev, &arctic )) devnum.DeviceNumber = arctic.disk_number;
+        memcpy( irp->AssociatedIrp.SystemBuffer, &devnum, len );
         irp->IoStatus.Information = len;
         status = STATUS_SUCCESS;
         break;
@@ -1967,7 +2042,27 @@ static NTSTATUS WINAPI disk_ioctl( DEVICE_OBJECT *device, IRP *irp )
     case IOCTL_STORAGE_QUERY_PROPERTY:
         status = query_property( dev, irp );
         break;
+    case IOCTL_STORAGE_EJECT_MEDIA:
+    case IOCTL_DISK_EJECT_MEDIA:
+    case IOCTL_STORAGE_MEDIA_REMOVAL:
+    {
+        struct arctic_volume_info arctic;
+
+        if (dev->type == DEVICE_CDROM || dev->type == DEVICE_DVD || !get_arctic_info( dev, &arctic ))
+            goto other;
+        if (irpsp->Parameters.DeviceIoControl.IoControlCode == IOCTL_STORAGE_MEDIA_REMOVAL)
+        {
+            status = STATUS_SUCCESS;
+            break;
+        }
+        /* Safely Remove Hardware */
+        status = arctic_eject_volume( dev, irp );
+        if (status != STATUS_PENDING) break;
+        LeaveCriticalSection( &device_section );
+        return status;
+    }
     default:
+    other:
     {
         ULONG code = irpsp->Parameters.DeviceIoControl.IoControlCode;
 
diff --git a/dlls/mountmgr.sys/mountmgr.c b/dlls/mountmgr.sys/mountmgr.c
index 762fa395..2135bc94 100644
--- a/dlls/mountmgr.sys/mountmgr.c
+++ b/dlls/mountmgr.sys/mountmgr.c
@@ -564,6 +564,13 @@ static DWORD WINAPI run_loop_thread( void *arg )
     return MOUNTMGR_CALL( run_loop, &params );
 }
 
+/* the volumes the Arctic host mounts */
+static DWORD WINAPI arctic_loop_thread( void *arg )
+{
+    struct run_loop_params params = {.op_thread = arg, .op_apc = device_op};
+    return MOUNTMGR_CALL( arctic_loop, &params );
+}
+
 static NTSTATUS WINAPI mountmgr_create( DEVICE_OBJECT *device, IRP *irp )
 {
     irp->IoStatus.Status = STATUS_SUCCESS;
@@ -614,6 +621,7 @@ NTSTATUS WINAPI DriverEntry( DRIVER_OBJECT *driver, UNICODE_STRING *path )
 
     thread = CreateThread( NULL, 0, device_op_thread, NULL, 0, NULL );
     CloseHandle( CreateThread( NULL, 0, run_loop_thread, thread, 0, NULL ));
+    CloseHandle( CreateThread( NULL, 0, arctic_loop_thread, thread, 0, NULL ));
 
 #ifdef _WIN64
     /* create a symlink so that the Wine port overrides key can be edited with 32-bit reg or regedit */
diff --git a/dlls/mountmgr.sys/unixlib.c b/dlls/mountmgr.sys/unixlib.c
index 235e3ae1..fc8e88b8 100644
--- a/dlls/mountmgr.sys/unixlib.c
+++ b/dlls/mountmgr.sys/unixlib.c
@@ -181,6 +181,16 @@ static NTSTATUS run_loop( void *args )
     return STATUS_SUCCESS;
 }
 
+/* on a thread of its own, next to D-Bus, which, when it runs, does not return */
+static NTSTATUS arctic_loop( void *args )
+{
+    const struct run_loop_params *params = args;
+
+    run_loop_params = *params;
+    run_arctic_loop();
+    return STATUS_SUCCESS;
+}
+
 static NTSTATUS dequeue_device_op( void *args )
 {
     const struct dequeue_device_op_params *params = args;
@@ -635,6 +645,9 @@ const unixlib_entry_t __wine_unix_call_funcs[] =
     write_credential,
     delete_credential,
     enumerate_credentials,
+    arctic_loop,
+    arctic_volume_info,
+    arctic_eject,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
diff --git a/dlls/mountmgr.sys/unixlib.h b/dlls/mountmgr.sys/unixlib.h
index bb4cfc46..29194cfa 100644
--- a/dlls/mountmgr.sys/unixlib.h
+++ b/dlls/mountmgr.sys/unixlib.h
@@ -58,6 +58,27 @@ struct dequeue_device_op_params
     struct device_info *info;
 };
 
+/* a volume the Arctic host mounted: the disk it is on, for Safely Remove Hardware */
+struct arctic_volume_info
+{
+    char  disk[32];      /* the host's name for the disk */
+    char  product[128];  /* the USB product string, or the disk model */
+    ULONG disk_number;   /* the same for every volume of the disk; C: is on 0 */
+    BOOL  usb;           /* on a USB device */
+    BOOL  removable;     /* the medium is removable (a USB stick, a card) */
+};
+
+struct arctic_volume_info_params
+{
+    const char *udi;
+    struct arctic_volume_info *info;
+};
+
+struct arctic_eject_params
+{
+    const char *udi;
+};
+
 struct add_drive_params
 {
     const char *device;
@@ -193,12 +214,18 @@ enum mountmgr_funcs
     unix_write_credential,
     unix_delete_credential,
     unix_enumerate_credentials,
+    unix_arctic_loop,
+    unix_arctic_volume_info,
+    unix_arctic_eject,
     unix_funcs_count
 };
 
 #define MOUNTMGR_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
 
 extern NTSTATUS errno_to_status( int err );
+extern void run_arctic_loop(void);
+extern NTSTATUS arctic_volume_info( void *args );
+extern NTSTATUS arctic_eject( void *args );
 extern void queue_device_op( enum device_op op, const char *udi, const char *device,
                              const char *mount_point, enum device_type type, const GUID *guid,
                              const char *disk_serial, const char *label,
