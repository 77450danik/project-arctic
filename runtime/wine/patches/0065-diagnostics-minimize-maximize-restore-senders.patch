+/* Arctic: the wall clock of the log lines, local time with milliseconds, to
+ * match them with what the user did */
+const char *arctic_now(void)
+{
+    static __thread char buf[16];
+    struct timeval tv;
+    struct tm tm;
+
+    gettimeofday( &tv, NULL );
+    localtime_r( &tv.tv_sec, &tm );
+    snprintf( buf, sizeof(buf), "%02d:%02d:%02d.%03d", tm.tm_hour, tm.tm_min, tm.tm_sec, (int)(tv.tv_usec / 1000) );
+    return buf;
+}
+
+/* Arctic: who asks a window to minimize, maximize or restore with
+ * WM_SYSCOMMAND, the way that does not go through ShowWindow: the sender's
+ * process and thread, and how (sent, posted). A window minimized by nobody's
+ * hand gets one of these. "grep arctic-syscommand" in the logs. */
+void arctic_log_syscommand( HWND hwnd, WPARAM wparam, const char *how )
+{
+    const WCHAR *app = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+    WCHAR title[64] = {0}, class[64] = {0};
+    UNICODE_STRING name = { 0, sizeof(class) - sizeof(WCHAR), class };
+    const char *command;
+    DWORD pid = 0;
+
+    switch (wparam & 0xfff0)
+    {
+    case SC_MINIMIZE: command = "SC_MINIMIZE"; break;
+    case SC_MAXIMIZE: command = "SC_MAXIMIZE"; break;
+    case SC_RESTORE:  command = "SC_RESTORE"; break;
+    default: return;
+    }
+    if (hwnd && (ULONG_PTR)hwnd > 1)
+    {
+        NtUserInternalGetWindowText( hwnd, title, ARRAY_SIZE(title) );
+        NtUserGetClassName( hwnd, FALSE, &name );
+        get_window_thread( hwnd, &pid );
+    }
+    MESSAGE( "arctic-syscommand: %s %s %s to %p (%s %s, process %04x, style %08x) by %s (%04x, thread %04x), "
+             "foreground %p\n", arctic_now(), how, command, hwnd, debugstr_w(class), debugstr_w(title), (int)pid,
+             hwnd ? (int)get_window_long( hwnd, GWL_STYLE ) : 0, debugstr_w(app), (int)GetCurrentProcessId(),
+             (int)GetCurrentThreadId(), NtUserGetForegroundWindow() );
+}
