diff --git a/src/dxvk/dxvk_memory.cpp b/src/dxvk/dxvk_memory.cpp
index fc18044..8c5578d 100644
--- a/src/dxvk/dxvk_memory.cpp
+++ b/src/dxvk/dxvk_memory.cpp
@@ -753,6 +753,9 @@ namespace dxvk {
       heap.properties = memInfo.memoryHeaps[i];
       heap.enforceBudget = !m_device->isUnifiedMemoryArchitecture()
         && m_device->properties().core.properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU;
+
+      if (heap.enforceBudget && (heap.properties.flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT))
+        m_hasDedicatedVram = true;
     }
 
     for (uint32_t i = 0; i < m_memTypeCount; i++) {
@@ -2463,6 +2466,29 @@ namespace dxvk {
         }
       }
     }
+
+    // Arctic: a budget can fall below what is already held, as it does for
+    // a process behind the game in front. Move resources out then, as when
+    // an allocation finds the heap full, and look again sooner.
+    bool overBudget = false;
+
+    for (uint32_t i = 0; i < m_memHeapCount; i++) {
+      auto& heap = m_memHeaps[i];
+
+      if (!heap.enforceBudget || !(heap.properties.flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT))
+        continue;
+
+      if (getMemoryStats(i).memoryAllocated > heap.memoryBudget) {
+        heap.enableEviction = true;
+        overBudget = true;
+      }
+    }
+
+    if (m_overBudget.exchange(overBudget) != overBudget) {
+      Logger::info(str::format("DxvkMemoryAllocator: ", overBudget
+        ? "over the video memory budget, moving resources to system memory"
+        : "within the video memory budget again"));
+    }
   }
 
 
@@ -2729,24 +2755,36 @@ namespace dxvk {
 
 
   void DxvkMemoryAllocator::performTimedTasks() {
-    static constexpr auto Interval = std::chrono::milliseconds(500u);
+    // Over budget, resources move out a chunk per run: run more often then
+    auto interval = std::chrono::milliseconds(m_overBudget.load() ? 100u : 500u);
 
-    // This function shouldn't be called concurrently, so checking and
-    // updating the deadline is fine without taking the global lock
-    auto currentTime = high_resolution_clock::now();
-
-    if (m_taskDeadline != high_resolution_clock::time_point()
-     && m_taskDeadline > currentTime)
+    // The submission thread and an idle CS thread both call this: one at a
+    // time, so that eviction keeps an interval between demoting a resource
+    // and moving it out, and the deadline is not updated concurrently
+    if (m_tasksRunning.exchange(true, std::memory_order_acquire))
       return;
 
+    auto currentTime = high_resolution_clock::now();
+
     if (m_taskDeadline == high_resolution_clock::time_point()
-     || m_taskDeadline + Interval <= currentTime)
-      m_taskDeadline = currentTime + Interval;
-    else
-      m_taskDeadline = m_taskDeadline + Interval;
+     || m_taskDeadline <= currentTime) {
+      if (m_taskDeadline == high_resolution_clock::time_point()
+       || m_taskDeadline + interval <= currentTime)
+        m_taskDeadline = currentTime + interval;
+      else
+        m_taskDeadline = m_taskDeadline + interval;
 
-    std::unique_lock lock(m_mutex);
-    performTimedTasksLocked(currentTime);
+      std::unique_lock lock(m_mutex);
+      performTimedTasksLocked(currentTime);
+    }
+
+    m_tasksRunning.store(false, std::memory_order_release);
+  }
+
+
+  bool DxvkMemoryAllocator::performIdleTasks() {
+    performTimedTasks();
+    return !m_relocations.empty();
   }
 
 
