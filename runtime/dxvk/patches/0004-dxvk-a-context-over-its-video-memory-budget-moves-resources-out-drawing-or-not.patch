From: Project Arctic
Subject: dxvk: a context over its video memory budget moves resources out, drawing or not.

Arctic gives a game in front the video memory of a discrete GPU as Windows
does (Wine patch 0153): every other process sees a budget of a share of
the heap, below what it may hold already. DXVK evicted only when an
allocation of its own found the heap full, and ran its memory tasks only
after a submission, so a program that draws nothing behind the game kept
all it had. Now a device-local heap whose budget is below what is
allocated turns eviction on and the tasks run every 100 ms instead of
500; and on a GPU with video memory of its own an idle CS thread wakes up
every 500 ms (20 ms while resources are queued) to run them and submits
what moves the queued resources. Integrated GPUs are untouched.
---
diff --git a/src/dxvk/dxvk_cs.cpp b/src/dxvk/dxvk_cs.cpp
index 06f6aa4..5f89b4c 100644
--- a/src/dxvk/dxvk_cs.cpp
+++ b/src/dxvk/dxvk_cs.cpp
@@ -198,8 +198,16 @@ namespace dxvk {
     std::vector<DxvkCsQueuedChunk> ordered;
     std::vector<DxvkCsQueuedChunk> highPrio;
 
+    // Arctic: on a GPU with video memory of its own, an idle thread still
+    // wakes up to keep the context's memory within its budget, which falls
+    // when a game comes in front; queued relocations need a submission.
+    bool idleMemoryTasks = m_device->needsIdleMemoryTasks();
+    bool relocationsQueued = false;
+
     try {
       while (!m_stopped.load()) {
+        bool idle = false;
+
         { std::unique_lock<dxvk::mutex> lock(m_mutex);
 
           auto pred = [this] { return
@@ -211,20 +219,40 @@ namespace dxvk {
           if (unlikely(!pred())) {
             auto t0 = dxvk::high_resolution_clock::now();
 
-            m_condOnAdd.wait(lock, [&] {
-              return pred();
-            });
+            if (idleMemoryTasks) {
+              auto timeout = std::chrono::milliseconds(relocationsQueued ? 20u : 500u);
+              idle = !m_condOnAdd.wait_for(lock, timeout, pred);
+            } else {
+              m_condOnAdd.wait(lock, [&] {
+                return pred();
+              });
+            }
 
             auto t1 = dxvk::high_resolution_clock::now();
             m_device->addStatCtr(DxvkStatCounter::CsIdleTicks, std::chrono::duration_cast<std::chrono::microseconds>(t1 - t0).count());
           }
 
-          std::swap(ordered, m_queueOrdered.queue);
-          std::swap(highPrio, m_queueHighPrio.queue);
+          if (!idle) {
+            std::swap(ordered, m_queueOrdered.queue);
+            std::swap(highPrio, m_queueHighPrio.queue);
+
+            m_hasHighPrio.store(false);
+          }
+        }
+
+        if (unlikely(idle)) {
+          // Nothing queued in between: the context is ours here, as it is
+          // for any chunk. A submission carries the relocations out.
+          relocationsQueued = m_device->performIdleMemoryTasks();
 
-          m_hasHighPrio.store(false);
+          if (relocationsQueued)
+            m_context->flushCommandList(nullptr, nullptr);
+
+          continue;
         }
 
+        relocationsQueued = false;
+
         size_t orderedIndex = 0u;
         size_t highPrioIndex = 0u;
 
