REGEDIT4

; Display: Windows' item {C555438B-...}, a shell folder of displaycpl.dll:
; the display drawn as Windows 11's, Personalization, the background and the
; screen saver as pages of the Control Panel inside File Explorer
[HKEY_CLASSES_ROOT\CLSID\{C555438B-3C23-4769-A71F-B6D3D9B6053A}]
@="Display"
"LocalizedString"="@C:\\Windows\\System32\\displaycpl.dll,-1"
"InfoTip"="@C:\\Windows\\System32\\displaycpl.dll,-2"
"System.ApplicationName"="Microsoft.Display"
"System.ControlPanel.Category"="1"

[HKEY_CLASSES_ROOT\CLSID\{C555438B-3C23-4769-A71F-B6D3D9B6053A}\DefaultIcon]
@="C:\\Windows\\System32\\desk.cpl,-40"

[HKEY_CLASSES_ROOT\CLSID\{C555438B-3C23-4769-A71F-B6D3D9B6053A}\InProcServer32]
@="C:\\Windows\\System32\\displaycpl.dll"
"ThreadingModel"="Apartment"

[HKEY_CLASSES_ROOT\CLSID\{C555438B-3C23-4769-A71F-B6D3D9B6053A}\ShellFolder]
"Attributes"=dword:28000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ControlPanel\NameSpace\{C555438B-3C23-4769-A71F-B6D3D9B6053A}]
@="Display"

; "control desk.cpl" and its pages open the item; the Control Panel lists the
; item, not the applet as well
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Control Panel\don't load]
"desk.cpl"="no"
