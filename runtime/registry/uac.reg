REGEDIT4

; User Account Control (docs/linux-gate.md): the Application Information
; service, which is the one thing that puts the consent window on the screen.
; It is a service DLL in svchost, as in Windows, so that the rest of
; elevation can grow in it later; appinfo.dll and consent.exe are Arctic's
; own (runtime/wine/modules/dlls/appinfo, .../programs/consent).
;
; Windows has this service on demand, started by the elevation API. Here the
; host's arctic-lxss (root) is what asks for a window, over 127.0.0.1, and
; root cannot ask the service manager to start anything: so it starts with
; the system. Its name, group and ServiceDll are Windows'.
[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Appinfo]
"DisplayName"="Application Information"
"ImagePath"="C:\\Windows\\System32\\svchost.exe -k netsvcs"
"ObjectName"="LocalSystem"
"Type"=dword:00000020
"Start"=dword:00000002
"ErrorControl"=dword:00000001

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Appinfo\Parameters]
"ServiceDll"="C:\\Windows\\System32\\appinfo.dll"
"ServiceDllUnloadOnStop"=dword:00000001

; the group svchost.exe -k netsvcs loads: "Appinfo" as a REG_MULTI_SZ
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Svchost]
"netsvcs"=hex(7):41,70,70,69,6e,66,6f,00,00

; What Windows programs read to know that UAC is on and that it asks on the
; secure desktop (installers look at EnableLUA). Arctic's own gate keeps its
; switches in the protected gate.conf, not here; these are the Windows
; policy defaults, which the elevation of Windows programs will use.
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System]
"EnableLUA"=dword:00000001
"ConsentPromptBehaviorAdmin"=dword:00000002
"ConsentPromptBehaviorUser"=dword:00000003
"PromptOnSecureDesktop"=dword:00000001

; "Облікові записи користувачів" of the Control Panel (usercpl.dll): a shell
; folder Explorer browses into, as {60632754-...} is in Windows, with the
; link to the settings of User Account Control. Category 9 is Windows' own
; for User Accounts, and the icon is the one DefaultIcon points at there.
[HKEY_CLASSES_ROOT\CLSID\{60632754-C523-4B62-B45C-4172DA012619}]
@="User Accounts"
"LocalizedString"="@C:\\Windows\\System32\\usercpl.dll,-1"
"InfoTip"="@C:\\Windows\\System32\\usercpl.dll,-2"
"System.ApplicationName"="Microsoft.UserAccounts"
"System.ControlPanel.Category"="9"

[HKEY_CLASSES_ROOT\CLSID\{60632754-C523-4B62-B45C-4172DA012619}\DefaultIcon]
@="C:\\Windows\\System32\\usercpl.dll,-1"

[HKEY_CLASSES_ROOT\CLSID\{60632754-C523-4B62-B45C-4172DA012619}\InProcServer32]
@="C:\\Windows\\System32\\usercpl.dll"
"ThreadingModel"="Apartment"

[HKEY_CLASSES_ROOT\CLSID\{60632754-C523-4B62-B45C-4172DA012619}\ShellFolder]
"Attributes"=dword:28000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\ControlPanel\NameSpace\{60632754-C523-4B62-B45C-4172DA012619}]
@="User Accounts"
