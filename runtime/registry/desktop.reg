REGEDIT4

; The Control Panel among the desktop's system icons, as in Windows 10: shown
; when Desktop Icon Settings (desk.cpl) has it checked, hidden by default
; (ReactOS 0092)
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Explorer\Desktop\NameSpace\{21EC2020-3AEA-1069-A2DD-08002B30309D}]
@="Control Panel"

; Videos are in the profile, as since Vista: ReactOS's shell32 had written them
; into Documents under the name Windows reads ("My Video")
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders]
"My Video"=hex(2):25,55,53,45,52,50,52,4f,46,49,4c,45,25,5c,56,69,64,65,6f,73,00

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders]
"My Video"=-
