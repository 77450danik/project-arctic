; The system colours and sizes of the Mizu visual style ([SysMetrics] in
; mizu.msstyles), set as Windows sets them when it applies the style; inactive
; captions are white with grey text, as in Windows 10
[HKEY_CURRENT_USER\Control Panel\Colors]
"ActiveTitle"="255 255 255"
"GradientActiveTitle"="255 255 255"
"TitleText"="0 0 0"
"InactiveTitle"="255 255 255"
"GradientInactiveTitle"="255 255 255"
"InactiveTitleText"="153 153 153"
"Background"="33 87 141"
"ButtonFace"="240 240 240"
"ButtonHilight"="255 255 255"
"ButtonLight"="241 239 226"
"ButtonShadow"="162 162 162"
"ButtonDkShadow"="162 162 162"
"GrayText"="172 168 153"
"Hilight"="230 230 230"
"HilightText"="0 0 0"
"HotTrackingColor"="0 0 128"
"Menu"="255 255 255"
"MenuBar"="239 238 243"
"MenuHilight"="220 220 220"
"MenuText"="0 0 0"
"Window"="255 255 255"

[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]
"CaptionHeight"="-360"
"CaptionWidth"="-360"
"SmCaptionHeight"="-285"
"SmCaptionWidth"="-315"
"ScrollHeight"="-225"
"ScrollWidth"="-225"

; as Windows 10: a window being moved or sized redraws its contents all the
; way, not an outline that dwm would not even show
[HKEY_CURRENT_USER\Control Panel\Desktop]
"DragFullWindows"="1"

; Source Sans Pro, the font of the Mizu visual style (SIL Open Font License, runtime/fonts)
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Fonts]
"Source Sans Pro (TrueType)"="SourceSansPro-Regular.ttf"
"Source Sans Pro Italic (TrueType)"="SourceSansPro-It.ttf"
"Source Sans Pro Semibold (TrueType)"="SourceSansPro-Semibold.ttf"
"Source Sans Pro Semibold Italic (TrueType)"="SourceSansPro-SemiboldIt.ttf"
"Source Sans Pro Bold (TrueType)"="SourceSansPro-Bold.ttf"
"Source Sans Pro Bold Italic (TrueType)"="SourceSansPro-BoldIt.ttf"
; Arial, Times New Roman and Courier New, made from Liberation (ci/windows-fonts.py)
"Arial (TrueType)"="arial.ttf"
"Arial Bold (TrueType)"="arialbd.ttf"
"Arial Italic (TrueType)"="ariali.ttf"
"Arial Bold Italic (TrueType)"="arialbi.ttf"
"Times New Roman (TrueType)"="times.ttf"
"Times New Roman Bold (TrueType)"="timesbd.ttf"
"Times New Roman Italic (TrueType)"="timesi.ttf"
"Times New Roman Bold Italic (TrueType)"="timesbi.ttf"
"Courier New (TrueType)"="cour.ttf"
"Courier New Bold (TrueType)"="courbd.ttf"
"Courier New Italic (TrueType)"="couri.ttf"
"Courier New Bold Italic (TrueType)"="courbi.ttf"

