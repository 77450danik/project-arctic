REGEDIT4

[HKEY_CURRENT_USER\Software\Arctic\Runtime\Drivers]
"Graphics"="wayland"

[HKEY_CURRENT_USER\Keyboard Layout\Preload]
"1"="00000409"
"2"="00000422"
"3"="00000419"

[HKEY_CURRENT_USER\Keyboard Layout\Toggle]
"Hotkey"="1"
"Language Hotkey"="1"
"Layout Hotkey"="2"

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Keyboard Layouts\00000409]
"Layout File"="KBDUS.DLL"
"Layout Text"="US"

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Keyboard Layouts\00000422]
"Layout File"="KBDUR.DLL"
"Layout Text"="Ukrainian"

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Keyboard Layouts\00000419]
"Layout File"="KBDRU.DLL"
"Layout Text"="Russian"

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]
"ThemeActive"="1"
"DllName"="C:\\Windows\\Resources\\Themes\\Mizu\\mizu.msstyles"

; the light and the dark mode of desk.cpl's Personalization (startui.dll,
; personalize.c), set when the taskbar first comes; Chromium follows the key
; only if it is there when it starts
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize]

[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon]
"Shell"="C:\\Windows\\explorer.exe"

; The notification area's own icons (stobject): Safely Remove Hardware and the
; volume (sndvolsso.dll, sound.reg) and the battery (batmeter.dll, docs/power.md),
; which shows only when there is a battery.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Applets\SysTray]
"Services"=dword:00000007

[HKEY_CURRENT_USER\Software\Arctic\Runtime\DllOverrides]
"shell32"="native,builtin"
"browseui"="native,builtin"
"shdocvw"="native,builtin"
"uxtheme"="native,builtin"
"shlwapi"="native,builtin"
"comctl32"="native,builtin"
; the picture viewer of ReactOS: Wine's shimgvw is a stub without a window
"shimgvw"="native,builtin"
"winemenubuilder.exe"=""
; Wine's mshtml is a shell over wine-gecko, which this image does not carry:
; a program that asked for it got the "download Gecko" box, which has hung
; the start before (host/init/arctic-init.c). Off until our own mshtml
; stands on our engine (docs/browser.md, stage 10).
"mshtml"=""

[HKEY_CURRENT_USER\Software\Arctic\Runtime\Debugger]
"ShowCrashDialog"=dword:00000000

[HKEY_CLASSES_ROOT\Folder]
@="Folder"

[HKEY_CLASSES_ROOT\Folder\shell\open]
"BrowserFlags"=dword:00000010
"ExplorerFlags"=dword:00000012

[HKEY_CLASSES_ROOT\Folder\shell\open\command]
@="explorer.exe \"%1\""

[HKEY_CLASSES_ROOT\Folder\shell\explore]
"BrowserFlags"=dword:00000022
"ExplorerFlags"=dword:00000021

[HKEY_CLASSES_ROOT\Folder\shell\explore\command]
@="explorer.exe /e,\"%1\""

[HKEY_CLASSES_ROOT\Directory]
@="File Folder"
"AlwaysShowExt"=""
"NoRecentDocs"=""

[HKEY_CLASSES_ROOT\Drive]
@="Drive"

