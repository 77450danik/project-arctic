REGEDIT4

; Internet Explorer: the system's own browser on the system's own engine
; (docs/browser.md). Nothing here claims http, https or a file type: Chrome
; keeps them until the engine is hardened (docs/browser.md, stage 11), and
; this only makes the program findable the way Windows makes it findable.
;
; There is no "Version" value on purpose: the engine is ours and not
; Trident, and a program that asks which Internet Explorer this is should
; not be told a number that is not true.

; where Windows keeps it: the browser is a Windows program of its own
; (runtime/browser/build.py), not a module of Wine
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\App Paths\iexplore.exe]
@="C:\\Program Files\\Internet Explorer\\iexplore.exe"
"Path"="C:\\Program Files\\Internet Explorer"

[HKEY_CURRENT_USER\Software\Microsoft\Internet Explorer\Main]
"Start Page"="about:arctic"
