+/* Arctic: one page of the properties by itself, for the page of the Control
+ * Panel in File Explorer that shows it (taskbarcpl.dll): 0 the taskbar,
+ * 1 its look, 2 its buttons, 3 the Start menu, 4 the notification area. A
+ * page of explorer's own is made for it and goes with it. */
+HPROPSHEETPAGE
+CreateTrayPropertyPage(IN UINT uPage, IN HWND hwndTaskbar)
+{
+    HMODULE hStartUi = LoadLibraryW(L"startui.dll");
+    HPROPSHEETPAGE hPage = NULL;
+
+    switch (uPage)
+    {
+        case 0:
+        {
+            CTaskBarSettingsPage *pPage = new CTaskBarSettingsPage(hwndTaskbar, TRUE);
+            if (!(hPage = pPage->Create()))
+                delete pPage;
+            break;
+        }
+        case 1:
+        {
+            typedef HPROPSHEETPAGE (WINAPI *PFN_LOOKPAGE)(HWND);
+            PFN_LOOKPAGE pLookPage = hStartUi ? (PFN_LOOKPAGE)GetProcAddress(hStartUi, "ArcticTaskbarLookPage") : NULL;
+            if (pLookPage)
+                hPage = pLookPage(hwndTaskbar);
+            break;
+        }
+        case 2:
+        {
+            typedef HPROPSHEETPAGE (WINAPI *PFN_BUTTONSPAGE)(HWND);
+            PFN_BUTTONSPAGE pButtonsPage = hStartUi ? (PFN_BUTTONSPAGE)GetProcAddress(hStartUi, "ArcticTaskbarButtonsPage") : NULL;
+            if (pButtonsPage)
+                hPage = pButtonsPage(hwndTaskbar);
+            break;
+        }
+        case 3:
+        {
+            typedef HPROPSHEETPAGE (WINAPI *PFN_STARTPAGE)(HWND, VOID (WINAPI *)(HWND));
+            PFN_STARTPAGE pStartPage = hStartUi ? (PFN_STARTPAGE)GetProcAddress(hStartUi, "ArcticStartMenuPage") : NULL;
+            if (pStartPage)
+                hPage = pStartPage(hwndTaskbar, ArcticCustomizeClassic);
+            if (!hPage)
+            {
+                CStartMenuSettingsPage *pPage = new CStartMenuSettingsPage(TRUE);
+                if (!(hPage = pPage->Create()))
+                    delete pPage;
+            }
+            break;
+        }
+        case 4:
+        {
+            CNotifySettingsPage *pPage = new CNotifySettingsPage(hwndTaskbar, TRUE);
+            if (!(hPage = pPage->Create()))
+                delete pPage;
+            break;
+        }
+    }
+    return hPage;
+}
+
