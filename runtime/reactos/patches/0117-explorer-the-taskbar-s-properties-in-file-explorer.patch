     }
 
+    /* Arctic: wParam the page (CreateTrayPropertyPage), the page made returned */
+    LRESULT OnArcticTrayPropertyPage(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        return (LRESULT)CreateTrayPropertyPage((UINT)wParam, m_hWnd);
+    }
+
+    /* Arctic: what the pages of the taskbar and the notification area set,
+     * as bits, for the Control Panel's pages (taskbarcpl.dll): wParam 0
+     * returns them, 1 sets those of lParam as the pages' Apply did, 2 opens
+     * Customize of the classic Start menu (lParam its owner). The bits: 0x1
+     * locked, 0x2 hidden by itself, 0x4 on top, 0x8 small buttons, 0x30 how
+     * buttons combine (0 always, 1 when full, 2 never), 0x40 no clock, 0x80
+     * the seconds, 0x200 the Show desktop button; 0x400 (got only) the clock
+     * may not be shown (policy). */
+    LRESULT OnArcticTraySettings(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        switch (wParam)
+        {
+        case 0:
+        {
+            LRESULT bits = 0;
+
+            if (g_TaskbarSettings.bLock) bits |= 0x1;
+            if (g_TaskbarSettings.sr.AutoHide) bits |= 0x2;
+            if (g_TaskbarSettings.sr.AlwaysOnTop) bits |= 0x4;
+            if (g_TaskbarSettings.bSmallIcons) bits |= 0x8;
+            bits |= (g_TaskbarSettings.dwGlomLevel <= 2 ? g_TaskbarSettings.dwGlomLevel : 0) << 4;
+            if (GetHideClock()) bits |= 0x40;
+            if (g_TaskbarSettings.bShowSeconds) bits |= 0x80;
+            if (g_TaskbarSettings.bShowDesktopButton) bits |= 0x200;
+            if (SHRestricted(REST_HIDECLOCK)) bits |= 0x400;
+            return bits;
+        }
+        case 1:
+        {
+            TaskbarSettings newSettings = g_TaskbarSettings;
+            DWORD bits = (DWORD)lParam;
+
+            newSettings.bLock = (bits & 0x1) != 0;
+            newSettings.sr.AutoHide = (bits & 0x2) != 0;
+            newSettings.sr.AlwaysOnTop = (bits & 0x4) != 0;
+            newSettings.bSmallIcons = (bits & 0x8) != 0;
+            newSettings.dwGlomLevel = ((bits >> 4) & 3) <= 2 ? ((bits >> 4) & 3) : 2;
+            newSettings.bGroupButtons = newSettings.dwGlomLevel != 2;
+            newSettings.bHideLabels = newSettings.dwGlomLevel == 0;
+            newSettings.sr.HideClock = (bits & 0x40) != 0;
+            newSettings.bShowSeconds = (bits & 0x80) != 0;
+            newSettings.bShowDesktopButton = (bits & 0x200) != 0;
+            SendMessageW(TWM_SETTINGSCHANGED, 0, (LPARAM)&newSettings);
+            return TRUE;
+        }
+        case 2:
+            ShowCustomizeClassic(hExplorerInstance, (HWND)lParam);
+            return TRUE;
+        }
+        return 0;
+    }
+
     /* Arctic: the task buttons fill the height of the rebar: the band of a
        running taskbar kept the old height, and the buttons stayed at its top */
     VOID ArcticFitTaskBand()
