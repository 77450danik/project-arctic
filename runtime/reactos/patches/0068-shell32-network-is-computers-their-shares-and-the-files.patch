+/* Arctic: a network drive is "share (\\server)", as Windows names it */
+static HRESULT GetNetworkDriveLabel(PCWSTR DrivePath, LPWSTR szLabel, UINT cchMax)
+{
+    WCHAR szLocal[3] = { DrivePath[0], L':', 0 }, szRemote[MAX_PATH];
+    DWORD cchRemote = _countof(szRemote);
+
+    if (GetDriveTypeW(DrivePath) != DRIVE_REMOTE ||
+        WNetGetConnectionW(szLocal, szRemote, &cchRemote) != NO_ERROR ||
+        szRemote[0] != L'\\' || szRemote[1] != L'\\')
+        return E_FAIL;
+    LPWSTR pszShare = wcschr(szRemote + 2, L'\\');
+    if (!pszShare || !pszShare[1])
+        return E_FAIL;
+    *pszShare++ = UNICODE_NULL;
+    return StringCchPrintfW(szLabel, cchMax, L"%s (%s)", pszShare, szRemote);
+}
+
 static HRESULT GetDriveLabel(PCWSTR DrivePath, LPWSTR szLabel, UINT cchMax)
 {
     HRESULT hr = getLabelForDriveFromAutoRun(DrivePath, szLabel, cchMax);
+    if (hr != S_OK)
+        hr = GetNetworkDriveLabel(DrivePath, szLabel, cchMax);
     return hr == S_OK ? S_OK : GetRawDriveLabel(DrivePath, szLabel, cchMax);
 }
 
