+
+static LPCWSTR NetItem_Path(LPCITEMIDLIST pidl)
+{
+    if (!pidl || pidl->mkid.cb < sizeof(WORD) + 3 * sizeof(WCHAR))
+        return NULL;
+    LPCWSTR psz = (LPCWSTR)&pidl->mkid.abID[0];
+    if (psz[0] != L'\\' || psz[1] != L'\\')
+        return NULL;
+    return psz;
+}
+
+static LPCWSTR NetItem_Comment(LPCITEMIDLIST pidl)
+{
+    LPCWSTR psz = NetItem_Path(pidl);
+    if (!psz)
+        return L"";
+    UINT cch = wcslen(psz) + 1;
+    if (sizeof(WORD) + (cch + 1) * sizeof(WCHAR) > pidl->mkid.cb)
+        return L"";
+    return psz + cch;
+}
+
+/* the share of "\\server\share", or NULL for a computer */
+static LPCWSTR NetItem_Share(LPCWSTR pszPath)
+{
+    LPCWSTR psz = pszPath ? wcschr(pszPath + 2, L'\\') : NULL;
+    return (psz && psz[1]) ? psz + 1 : NULL;
+}
+
+/* A shared folder the computer does not let a guest into: the user is asked
+ * for a name and password, in the window he is working in and not from the
+ * threads that only look (icons, the tree) */
+static DWORD NetItem_Connect(HWND hwndOwner, LPCWSTR pszPath)
+{
+    static WCHAR s_szRefused[MAX_PATH];
+    static DWORD s_dwRefused;
+
+    if (!hwndOwner)
+        hwndOwner = GetActiveWindow();
+    if (!lstrcmpiW(s_szRefused, pszPath) && GetTickCount() - s_dwRefused < 3000)
+        return ERROR_CANCELLED;
+
+    NETRESOURCEW res = { 0 };
+    res.dwType = NetItem_Share(pszPath) ? RESOURCETYPE_DISK : RESOURCETYPE_ANY;
+    res.lpRemoteName = const_cast<LPWSTR>(pszPath);
+    DWORD dwError = WNetAddConnection3W(hwndOwner, &res, NULL, NULL, hwndOwner ? CONNECT_INTERACTIVE : 0);
+    if (dwError != NO_ERROR)
+    {
+        StringCchCopyW(s_szRefused, _countof(s_szRefused), pszPath);
+        s_dwRefused = GetTickCount();
+    }
+    else
+    {
+        s_szRefused[0] = UNICODE_NULL;
+    }
+    return dwError;
+}
 
