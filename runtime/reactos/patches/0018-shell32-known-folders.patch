diff --git a/dll/win32/shell32/wine/shellpath.c b/dll/win32/shell32/wine/shellpath.c
index 6dc7227..2700d5d 100644
--- a/dll/win32/shell32/wine/shellpath.c
+++ b/dll/win32/shell32/wine/shellpath.c
@@ -3397,3 +3397,72 @@ HRESULT WINAPI SHGetSpecialFolderLocation(
     hr = SHGetFolderLocation(hwndOwner, nFolder, NULL, 0, ppidl);
     return hr;
 }
+
+/* Arctic: the known folders of Windows Vista, over the CSIDL table, whose
+ * entries carry their KNOWNFOLDERID. Programs such as Steam call these. */
+static int csidl_from_known_folder(const KNOWNFOLDERID *rfid)
+{
+    int i;
+
+    if (!rfid || IsEqualGUID(rfid, &GUID_NULL))
+        return -1;
+    for (i = 0; i < ARRAY_SIZE(CSIDL_Data); i++)
+    {
+        if (CSIDL_Data[i].id && IsEqualGUID(CSIDL_Data[i].id, rfid))
+            return i;
+    }
+    return -1;
+}
+
+/*************************************************************************
+ * SHGetKnownFolderPath           [SHELL32.@]
+ */
+HRESULT WINAPI SHGetKnownFolderPath(const KNOWNFOLDERID *rfid, DWORD flags, HANDLE token, PWSTR *ret_path)
+{
+    WCHAR path[MAX_PATH];
+    int folder = csidl_from_known_folder(rfid);
+    HRESULT hr;
+
+    TRACE("%s, 0x%08x, %p, %p\n", debugstr_guid(rfid), flags, token, ret_path);
+
+    if (!ret_path)
+        return E_INVALIDARG;
+    *ret_path = NULL;
+    if (folder < 0)
+        return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+
+    if (flags & KF_FLAG_CREATE)
+        folder |= CSIDL_FLAG_CREATE;
+    if (flags & KF_FLAG_DONT_VERIFY)
+        folder |= CSIDL_FLAG_DONT_VERIFY;
+
+    hr = SHGetFolderPathW(NULL, folder, token,
+                          (flags & KF_FLAG_DEFAULT_PATH) ? SHGFP_TYPE_DEFAULT : SHGFP_TYPE_CURRENT, path);
+    if (hr != S_OK)
+        return FAILED(hr) ? hr : E_FAIL;
+
+    *ret_path = CoTaskMemAlloc((lstrlenW(path) + 1) * sizeof(WCHAR));
+    if (!*ret_path)
+        return E_OUTOFMEMORY;
+    lstrcpyW(*ret_path, path);
+    return S_OK;
+}
+
+/*************************************************************************
+ * SHGetKnownFolderIDList         [SHELL32.@]
+ */
+HRESULT WINAPI SHGetKnownFolderIDList(const KNOWNFOLDERID *rfid, DWORD flags, HANDLE token, PIDLIST_ABSOLUTE *pidl)
+{
+    int folder = csidl_from_known_folder(rfid);
+
+    TRACE("%s, 0x%08x, %p, %p\n", debugstr_guid(rfid), flags, token, pidl);
+
+    if (!pidl)
+        return E_INVALIDARG;
+    *pidl = NULL;
+    if (folder < 0)
+        return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    if (flags & KF_FLAG_CREATE)
+        folder |= CSIDL_FLAG_CREATE;
+    return SHGetFolderLocation(NULL, folder, token, 0, pidl);
+}
