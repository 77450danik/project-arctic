+/* Arctic: Windows 10's tiles, This PC's default: the large icon beside the
+ * name, and for a drive a capacity bar and "X free of Y" under it. The list
+ * view lays the tiles out (LV_VIEW_TILE, comctl32); they are drawn here. */
+void CDefView::UpdateTileView()
+{
+    HIMAGELIST big_icons, small_icons;
+
+    if (!m_ListView)
+        return;
+    Shell_GetImageLists(&big_icons, &small_icons);
+    if (m_FolderSettings.ViewMode == FVM_TILE)
+    {
+        HDC hdc = ::GetDC(m_ListView);
+        int dpi = GetDeviceCaps(hdc, LOGPIXELSY);
+        ::ReleaseDC(m_ListView, hdc);
+        LVTILEVIEWINFO tvi = { sizeof(tvi) };
+        tvi.dwMask = LVTVIM_TILESIZE;
+        tvi.dwFlags = LVTVIF_FIXEDSIZE;
+        tvi.sizeTile.cx = MulDiv(256, dpi, 96);
+        tvi.sizeTile.cy = MulDiv(60, dpi, 96);
+        m_ListView.SetImageList(big_icons, LVSIL_SMALL);
+        m_ListView.SendMessage(LVM_SETTILEVIEWINFO, 0, (LPARAM)&tvi);
+        m_ListView.SendMessage(LVM_SETVIEW, LV_VIEW_TILE, 0);
+    }
+    else if (m_ListView.SendMessage(LVM_GETVIEW, 0, 0) == LV_VIEW_TILE)
+    {
+        DWORD view = LV_VIEW_LIST;
+        switch (m_FolderSettings.ViewMode)
+        {
+            case FVM_ICON:      view = LV_VIEW_ICON;      break;
+            case FVM_SMALLICON: view = LV_VIEW_SMALLICON; break;
+            case FVM_DETAILS:   view = LV_VIEW_DETAILS;   break;
+            default: break;
+        }
+        m_ListView.SetImageList(small_icons, LVSIL_SMALL);
+        m_ListView.SendMessage(LVM_SETVIEW, view, 0);
+    }
+}
+
+/* an item's icon at a tile's size, kept by its index in the system image list */
+HICON CDefView::TileIcon(int iImage, PCUITEMID_CHILD pidl, int size)
+{
+    UINT slot = (UINT)iImage % _countof(m_TileIcons);
+    if (m_TileIcons[slot].icon && m_TileIcons[slot].iImage == iImage && m_TileIcons[slot].size == size)
+        return m_TileIcons[slot].icon;
+
+    HICON icon = NULL;
+    CComPtr<IExtractIconW> pei;
+    if (m_pSFParent && SUCCEEDED(m_pSFParent->GetUIObjectOf(m_hWnd, 1, &pidl, IID_NULL_PPV_ARG(IExtractIconW, &pei))))
+    {
+        WCHAR file[MAX_PATH];
+        int index = 0;
+        UINT flags = 0;
+        if (SUCCEEDED(pei->GetIconLocation(GIL_FORSHELL, file, _countof(file), &index, &flags)))
+        {
+            HICON hBig = NULL, hLittle = NULL;
+            if (pei->Extract(file, index, &hBig, &hLittle, MAKELONG(size, 16)) == S_OK)
+            {
+                icon = hBig;
+                if (hLittle)
+                    DestroyIcon(hLittle);
+            }
+            else if (!(flags & GIL_NOTFILENAME))
+                PrivateExtractIconsW(file, index, size, size, &icon, NULL, 1, 0);
+        }
+    }
+    if (!icon)
+        return NULL;
+    if (m_TileIcons[slot].icon)
+        DestroyIcon(m_TileIcons[slot].icon);
+    m_TileIcons[slot].iImage = iImage;
+    m_TileIcons[slot].size = size;
+    m_TileIcons[slot].icon = icon;
+    return icon;
+}
+
+LRESULT CDefView::OnCustomDraw(LPNMLVCUSTOMDRAW cd)
+{
+    if (m_FolderSettings.ViewMode != FVM_TILE)
+        return CDRF_DODEFAULT;
+    switch (cd->nmcd.dwDrawStage)
+    {
+        case CDDS_PREPAINT:
+            return CDRF_NOTIFYITEMDRAW;
+        case CDDS_ITEMPREPAINT:
+            DrawTile(cd);
+            return CDRF_SKIPDEFAULT;
+    }
+    return CDRF_DODEFAULT;
+}
+
+void CDefView::DrawTile(LPNMLVCUSTOMDRAW cd)
+{
+    HDC hdc = cd->nmcd.hdc;
+    int item = (int)cd->nmcd.dwItemSpec, dpi = GetDeviceCaps(hdc, LOGPIXELSY);
+    RECT rc;
+    WCHAR name[MAX_PATH] = L"", path[MAX_PATH] = L"";
+    LVITEMW lvi = { LVIF_IMAGE | LVIF_STATE | LVIF_PARAM | LVIF_TEXT, item };
+    HIMAGELIST big_icons, small_icons;
+
+    if (!ListView_GetItemRect(m_ListView, item, &rc, LVIR_BOUNDS))
+        return;
+    lvi.stateMask = LVIS_SELECTED | LVIS_FOCUSED | LVIS_OVERLAYMASK | LVIS_CUT;
+    lvi.pszText = name;
+    lvi.cchTextMax = _countof(name);
+    if (!ListView_GetItem(m_ListView, &lvi))
+        return;
+
+    /* Windows 10's light blue: hot, selected, selected without the focus */
+    BOOL selected = (lvi.state & LVIS_SELECTED) != 0, hot = (cd->nmcd.uItemState & CDIS_HOT) != 0;
+    BOOL active = ::GetFocus() == m_ListView.m_hWnd;
+    if (selected || hot)
+    {
+        COLORREF fill = selected ? (active ? RGB(0xcc, 0xe8, 0xff) : RGB(0xd9, 0xd9, 0xd9)) : RGB(0xe5, 0xf3, 0xff);
+        COLORREF edge = selected ? (active ? RGB(0x99, 0xd1, 0xff) : RGB(0xd9, 0xd9, 0xd9)) : RGB(0xe5, 0xf3, 0xff);
+        HBRUSH brush = CreateSolidBrush(fill);
+        HPEN pen = CreatePen(PS_SOLID, 1, edge);
+        HGDIOBJ oldBrush = SelectObject(hdc, brush), oldPen = SelectObject(hdc, pen);
+        Rectangle(hdc, rc.left, rc.top, rc.right, rc.bottom);
+        SelectObject(hdc, oldBrush);
+        SelectObject(hdc, oldPen);
+        DeleteObject(brush);
+        DeleteObject(pen);
+    }
+
+    Shell_GetImageLists(&big_icons, &small_icons);
+    /* Windows 10's tiles have 48 pixel icons; the shell's image lists stop at 32 */
+    int cx = MulDiv(48, dpi, 96), cy = cx;
+    int pad = MulDiv(6, dpi, 96);
+    HICON icon = TileIcon(lvi.iImage, (PCUITEMID_CHILD)lvi.lParam, cx);
+    if (icon)
+        DrawIconEx(hdc, rc.left + pad, rc.top + (rc.bottom - rc.top - cy) / 2, icon, cx, cy, 0, NULL, DI_NORMAL);
+    else
+    {
+        ImageList_GetIconSize(big_icons, &cx, &cy);
+        ImageList_Draw(big_icons, lvi.iImage, hdc, rc.left + pad, rc.top + (rc.bottom - rc.top - cy) / 2,
+                       ILD_TRANSPARENT | (lvi.state & LVIS_OVERLAYMASK) | ((lvi.state & LVIS_CUT) ? ILD_BLEND50 : 0));
+    }
+
+    /* a drive: its capacity */
+    ULARGE_INTEGER avail = {}, total = {}, freeAll = {};
+    BOOL drive = FALSE;
+    STRRET str;
+    if (m_pSFParent && SUCCEEDED(m_pSFParent->GetDisplayNameOf((PCUITEMID_CHILD)lvi.lParam, SHGDN_FORPARSING, &str)) &&
+        SUCCEEDED(StrRetToBufW(&str, (PCUITEMID_CHILD)lvi.lParam, path, _countof(path))) &&
+        path[0] && path[1] == L':' && path[2] == L'\\' && !path[3])
+    {
+        UINT type = GetDriveTypeW(path);
+        drive = type != DRIVE_NO_ROOT_DIR && type != DRIVE_CDROM && GetDiskFreeSpaceExW(path, &avail, &total, &freeAll) &&
+                total.QuadPart;
+    }
+
+    HFONT font = (HFONT)m_ListView.SendMessage(WM_GETFONT, 0, 0);
+    HGDIOBJ oldFont = SelectObject(hdc, font);
+    TEXTMETRICW tm;
+    GetTextMetricsW(hdc, &tm);
+    int lineH = tm.tmHeight, barH = MulDiv(14, dpi, 96), gap = MulDiv(3, dpi, 96);
+    int left = rc.left + pad + cx + MulDiv(8, dpi, 96), right = rc.right - pad;
+    int block = drive ? lineH * 2 + barH + gap * 2 : lineH;
+    int top = rc.top + (rc.bottom - rc.top - block) / 2;
+    SetBkMode(hdc, TRANSPARENT);
+    SetTextColor(hdc, GetSysColor(COLOR_WINDOWTEXT));
+    RECT line = { left, top, right, top + lineH };
+    DrawTextW(hdc, name, -1, &line, DT_LEFT | DT_SINGLELINE | DT_END_ELLIPSIS | DT_NOPREFIX);
+    if (drive)
+    {
+        RECT bar = { left, line.bottom + gap, min(right, left + MulDiv(180, dpi, 96)), line.bottom + gap + barH };
+        HBRUSH back = CreateSolidBrush(RGB(0xe6, 0xe6, 0xe6)), border = CreateSolidBrush(RGB(0xbc, 0xbc, 0xbc));
+        FillRect(hdc, &bar, back);
+        FrameRect(hdc, &bar, border);
+        ULONGLONG used = total.QuadPart - freeAll.QuadPart;
+        RECT fill = bar;
+        InflateRect(&fill, -1, -1);
+        fill.right = fill.left + (LONG)((fill.right - fill.left) * (double)used / (double)total.QuadPart);
+        /* more than nine tenths used: red, as Windows warns of a full drive */
+        HBRUSH meter = CreateSolidBrush(used * 10 > total.QuadPart * 9 ? RGB(0xda, 0x26, 0x26) : RGB(0x26, 0xa0, 0xda));
+        if (fill.right > fill.left)
+            FillRect(hdc, &fill, meter);
+        DeleteObject(back);
+        DeleteObject(border);
+        DeleteObject(meter);
+
+        WCHAR freeText[64], totalText[64], format[64], text[192];
+        StrFormatByteSizeW(avail.QuadPart, freeText, _countof(freeText));
+        StrFormatByteSizeW(total.QuadPart, totalText, _countof(totalText));
+        if (!LoadStringW(shell32_hInstance, IDS_DRIVE_FREE_OF, format, _countof(format)))
+            StringCchCopyW(format, _countof(format), L"%s free of %s");
+        StringCchPrintfW(text, _countof(text), format, freeText, totalText);
+        SetTextColor(hdc, RGB(0x6d, 0x6d, 0x6d));
+        RECT line2 = { left, bar.bottom + gap, right, bar.bottom + gap + lineH };
+        DrawTextW(hdc, text, -1, &line2, DT_LEFT | DT_SINGLELINE | DT_END_ELLIPSIS | DT_NOPREFIX);
+    }
+    SelectObject(hdc, oldFont);
+
+    if ((lvi.state & LVIS_FOCUSED) && active && !(m_ListView.SendMessage(WM_QUERYUISTATE, 0, 0) & UISF_HIDEFOCUS))
+        DrawFocusRect(hdc, &rc);
+}
