 class CNotifyToolbar;
 
+#include <winver.h>
+
+#ifndef PROCESS_QUERY_LIMITED_INFORMATION
+#define PROCESS_QUERY_LIMITED_INFORMATION 0x1000
+#endif
+
+/* the name a toast gives its program, as Windows 10 does: its file's
+ * description; none for the shell's own balloons, which carry the shell's */
+static void ToastProgramName(HWND hwnd, LPWSTR pszName, UINT cchName)
+{
+    typedef BOOL (WINAPI *QUERY_FN)(HANDLE, DWORD, LPWSTR, PDWORD);
+    QUERY_FN pQuery = (QUERY_FN)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "QueryFullProcessImageNameW");
+    WCHAR szPath[MAX_PATH], szKey[64];
+    DWORD pid = 0, cch = _countof(szPath), dwHandle, cb;
+    HANDLE hProcess;
+    BOOL ok = FALSE;
+
+    pszName[0] = UNICODE_NULL;
+    if (!pQuery || !GetWindowThreadProcessId(hwnd, &pid) || pid == GetCurrentProcessId())
+        return;
+    if ((hProcess = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid)))
+    {
+        ok = pQuery(hProcess, 0, szPath, &cch);
+        CloseHandle(hProcess);
+    }
+    if (!ok)
+        return;
+    if ((cb = GetFileVersionInfoSizeW(szPath, &dwHandle)))
+    {
+        LPVOID pInfo = HeapAlloc(GetProcessHeap(), 0, cb);
+        WORD *pTranslation;
+        LPWSTR pszDescription;
+        UINT cbValue;
+
+        if (pInfo && GetFileVersionInfoW(szPath, 0, cb, pInfo) &&
+            VerQueryValueW(pInfo, L"\\VarFileInfo\\Translation", (LPVOID *)&pTranslation, &cbValue) && cbValue >= 4)
+        {
+            StringCchPrintfW(szKey, _countof(szKey), L"\\StringFileInfo\\%04x%04x\\FileDescription",
+                             pTranslation[0], pTranslation[1]);
+            if (VerQueryValueW(pInfo, szKey, (LPVOID *)&pszDescription, &cbValue) && cbValue)
+                StringCchCopyW(pszName, cchName, pszDescription);
+        }
+        if (pInfo)
+            HeapFree(GetProcessHeap(), 0, pInfo);
+    }
+    if (!pszName[0])
+    {
+        StringCchCopyW(pszName, cchName, PathFindFileNameW(szPath));
+        PathRemoveExtensionW(pszName);
+    }
+}
