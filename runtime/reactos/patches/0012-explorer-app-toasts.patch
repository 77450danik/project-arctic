 /* a click on the toast is the program's to act on; its X only closes it */
 void CBalloonQueue::OnToastClicked(BOOL bClose)
 {
+    if (m_bAppToast)
+    {
+        CloseAppToast(bClose ? ARCTIC_TOAST_USER_CANCELED : ARCTIC_TOAST_ACTIVATED);
+        return;
+    }
     if (m_current != NULL)
     {
         Close(m_current, bClose ? NIN_BALLOONTIMEOUT : NIN_BALLOONUSERCLICK);
     }
+}
+
+/* a program's toast, in turn with the balloons */
+void CBalloonQueue::ShowAppToast(const arctic_toast *toast)
+{
+    Info info(toast);
+
+    if (m_current != NULL || m_bAppToast || !m_queue.IsEmpty())
+        m_queue.AddTail(info);
+    else
+        Show(info);
+}
+
+/* the program took it back (ToastNotifier.Hide) */
+void CBalloonQueue::HideAppToast(HWND hwndReply, DWORD dwId)
+{
+    if (m_bAppToast && m_hwndAppReply == hwndReply && m_dwAppToastId == dwId)
+    {
+        CloseAppToast(ARCTIC_TOAST_APPLICATION_HIDDEN);
+        return;
+    }
+    for (POSITION next = m_queue.GetHeadPosition(); next;)
+    {
+        POSITION current = next;
+        Info& info = m_queue.GetNext(next);
+        if (info.hwndReply == hwndReply && info.dwToastId == dwId)
+        {
+            m_queue.RemoveAt(current);
+            ::PostMessageW(hwndReply, RegisterWindowMessageW(ARCTIC_TOAST_EVENT), dwId, ARCTIC_TOAST_APPLICATION_HIDDEN);
+            break;
+        }
+    }
+}
+
+void CBalloonQueue::CloseAppToast(UINT uReason)
+{
+    DWORD pid = 0;
+
+    if (!m_bAppToast)
+        return;
+    /* the program a click activates may come to the front */
+    if (uReason == ARCTIC_TOAST_ACTIVATED && GetWindowThreadProcessId(m_hwndAppReply, &pid))
+        AllowSetForegroundWindow(pid);
+    ::PostMessageW(m_hwndAppReply, RegisterWindowMessageW(ARCTIC_TOAST_EVENT), m_dwAppToastId, uReason);
+    m_bAppToast = FALSE;
+    m_toast.Hide(uReason == ARCTIC_TOAST_ACTIVATED);
+    if (m_hAppIcon)
+        DestroyIcon(m_hAppIcon);
+    m_hAppIcon = NULL;
+    SetTimer(CooldownBetweenBalloons);
 }
 
