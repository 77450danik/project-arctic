 BOOL CExplorerBand::_WantsRootItem()
 {
+    // Quick access, This PC and Network stand at the top, as in Windows 10
+    return FALSE;
+}
+
+/* Windows 10's navigation pane: Quick access, This PC and Network at the top
+ * level. Quick access is the user's Links folder, as Favorites was in
+ * Windows 7: each shortcut in it pins the folder it points to. */
+
+static const INT QUICK_ACCESS_ICON = 16800; /* shell32's IDI_SHELL_QUICKACCESS, a star */
+
+static HRESULT GetLinksFolder(PWSTR pszPath)
+{
+    HRESULT hr = SHGetFolderPathW(NULL, CSIDL_PROFILE, NULL, SHGFP_TYPE_CURRENT, pszPath);
+    if (FAILED(hr))
+        return hr;
+    return PathAppendW(pszPath, L"Links") ? S_OK : E_FAIL;
+}
+
+static void PinFolder(PCWSTR pszLinks, LPCITEMIDLIST pidl)
+{
+    WCHAR szLink[MAX_PATH * 2];
+    SHFILEINFOW info;
+    CComPtr<IShellLinkW> psl;
+    CComPtr<IPersistFile> ppf;
+
+    if (!SHGetFileInfoW((LPCWSTR)pidl, 0, &info, sizeof(info), SHGFI_PIDL | SHGFI_DISPLAYNAME))
+        return;
+    if (FAILED(CoCreateInstance(CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, IID_PPV_ARG(IShellLinkW, &psl))) ||
+        FAILED(psl->SetIDList(pidl)) ||
+        FAILED(psl->QueryInterface(IID_PPV_ARG(IPersistFile, &ppf))))
+        return;
+    wsprintfW(szLink, L"%s\\%s.lnk", pszLinks, info.szDisplayName);
+    ppf->Save(szLink, TRUE);
+}
+
+/* the folders Windows 10 pins for a new user */
+static void PinDefaults(PCWSTR pszLinks)
+{
+    static const INT csidls[] = { CSIDL_DESKTOPDIRECTORY, -1 /* Downloads */, CSIDL_PERSONAL, CSIDL_MYPICTURES };
+    WCHAR szPath[MAX_PATH];
+
+    for (UINT i = 0; i < _countof(csidls); i++)
+    {
+        CComHeapPtr<ITEMIDLIST> pidl;
+
+        if (csidls[i] < 0)
+        {
+            if (FAILED(SHGetFolderPathW(NULL, CSIDL_PROFILE, NULL, SHGFP_TYPE_CURRENT, szPath)) ||
+                !PathAppendW(szPath, L"Downloads") || !PathIsDirectoryW(szPath) ||
+                FAILED(SHParseDisplayName(szPath, NULL, &pidl, 0, NULL)))
+                continue;
+        }
+        else if (FAILED(SHGetFolderLocation(NULL, csidls[i], NULL, 0, &pidl)))
+            continue;
+        PinFolder(pszLinks, pidl);
+    }
+}
+
+/* the defaults are pinned once for a user, as Windows 10 does for a new profile */
+static BOOL FirstQuickAccess()
+{
+    static const WCHAR szKey[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced";
+    DWORD dwValue = 0, cbValue = sizeof(dwValue);
+
+    if (SHGetValueW(HKEY_CURRENT_USER, szKey, L"QuickAccessPinned", NULL, &dwValue, &cbValue) == ERROR_SUCCESS &&
+        dwValue)
+        return FALSE;
+    dwValue = 1;
+    SHSetValueW(HKEY_CURRENT_USER, szKey, L"QuickAccessPinned", REG_DWORD, &dwValue, sizeof(dwValue));
     return TRUE;
+}
+
+void CExplorerBand::_InsertTopFolder(INT csidl)
+{
+    CComHeapPtr<ITEMIDLIST> pidl;
+
+    if (SUCCEEDED(SHGetFolderLocation(NULL, csidl, NULL, 0, &pidl)))
+        _InsertItem(NULL, m_pDesktop, pidl, pidl, FALSE);
+}
+
+void CExplorerBand::_InsertQuickAccess()
+{
+    WCHAR szLinks[MAX_PATH], szName[64];
+    CComHeapPtr<ITEMIDLIST> pidlLinks;
+    CComPtr<IShellFolder> psfParent;
+    LPCITEMIDLIST pidlChild;
+    INT iIcon;
+
+    if (FAILED(GetLinksFolder(szLinks)))
+        return;
+    if (!PathIsDirectoryW(szLinks))
+        SHCreateDirectoryExW(NULL, szLinks, NULL);
+    if (FirstQuickAccess())
+        PinDefaults(szLinks);
+    if (FAILED(SHParseDisplayName(szLinks, NULL, &pidlLinks, 0, NULL)) ||
+        FAILED(SHBindToParent(pidlLinks, IID_PPV_ARG(IShellFolder, &psfParent), &pidlChild)))
+        return;
+
+    m_hQuickAccess = _InsertItem(NULL, psfParent, pidlLinks, pidlChild, FALSE);
+    if (!m_hQuickAccess)
+        return;
+
+    TVITEMW item = { TVIF_HANDLE | TVIF_CHILDREN };
+    item.hItem = m_hQuickAccess;
+    item.cChildren = 1;
+    if (LoadStringW(instance, IDS_QUICKACCESS, szName, _countof(szName)))
+    {
+        item.mask |= TVIF_TEXT;
+        item.pszText = szName;
+    }
+    iIcon = Shell_GetCachedImageIndex(L"shell32.dll", -QUICK_ACCESS_ICON, 0);
+    if (iIcon >= 0)
+    {
+        item.mask |= TVIF_IMAGE | TVIF_SELECTEDIMAGE;
+        item.iImage = item.iSelectedImage = iIcon;
+    }
+    TreeView_SetItem(m_hwndTreeView, &item);
+
+    _InsertPins();
+    TreeView_Expand(m_hwndTreeView, m_hQuickAccess, TVE_EXPAND);
+}
+
+/* the children of Quick access are the folders its shortcuts point to */
+void CExplorerBand::_InsertPins()
+{
+    CItemData *pQuick = _GetItemData(m_hQuickAccess);
+    CComPtr<IShellFolder> psfLinks;
+    CComPtr<IEnumIDList> pEnum;
+    LPITEMIDLIST pidl;
+    ULONG fetched;
+
+    if (!pQuick)
+        return;
+    pQuick->expanded = TRUE;
+    if (FAILED(m_pDesktop->BindToObject(pQuick->absolutePidl, NULL, IID_PPV_ARG(IShellFolder, &psfLinks))) ||
+        psfLinks->EnumObjects(NULL, SHCONTF_NONFOLDERS, &pEnum) != S_OK)
+        return;
+
+    while (pEnum->Next(1, &pidl, &fetched) == S_OK && fetched)
+    {
+        STRRET str;
+        WCHAR szPath[MAX_PATH];
+        CComPtr<IShellLinkW> psl;
+        CComPtr<IPersistFile> ppf;
+        CComHeapPtr<ITEMIDLIST> target;
+
+        if (SUCCEEDED(psfLinks->GetDisplayNameOf(pidl, SHGDN_FORPARSING, &str)) &&
+            SUCCEEDED(StrRetToBufW(&str, pidl, szPath, _countof(szPath))) &&
+            SUCCEEDED(CoCreateInstance(CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, IID_PPV_ARG(IShellLinkW, &psl))) &&
+            SUCCEEDED(psl->QueryInterface(IID_PPV_ARG(IPersistFile, &ppf))) &&
+            SUCCEEDED(ppf->Load(szPath, STGM_READ)) &&
+            psl->GetIDList(&target) == S_OK && target)
+        {
+            _InsertItem(m_hQuickAccess, target, ILFindLastID(target), FALSE);
+        }
+        ILFree(pidl);
+    }
+}
+
+void CExplorerBand::_Refresh()
+{
+    ++m_mtxBlockNavigate;
+    m_hwndTreeView.SendMessage(WM_SETREDRAW, FALSE, 0);
+    for (HTREEITEM hItem = TreeView_GetRoot(m_hwndTreeView); hItem;
+         hItem = TreeView_GetNextSibling(m_hwndTreeView, hItem))
+    {
+        if (hItem == m_hQuickAccess)
+        {
+            HTREEITEM hPin;
+            while ((hPin = TreeView_GetChild(m_hwndTreeView, hItem)))
+                TreeView_DeleteItem(m_hwndTreeView, hPin);
+            _InsertPins();
+        }
+        else if (TreeView_GetItemState(m_hwndTreeView, hItem, TVIS_EXPANDEDONCE) & TVIS_EXPANDEDONCE)
+        {
+            _RefreshRecurse(hItem);
+        }
+    }
+    m_hwndTreeView.SendMessage(WM_SETREDRAW, TRUE, 0);
+    --m_mtxBlockNavigate;
 }
 
