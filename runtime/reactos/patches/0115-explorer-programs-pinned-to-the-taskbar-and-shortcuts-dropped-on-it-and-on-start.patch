+    /* Arctic: the button of a pinned program none of whose windows is open */
+    static BOOL IsPinOnly(IN const TASK_ITEM *TaskItem)
+    {
+        return TaskItem->hWnd == NULL && TaskItem->Group != NULL && TaskItem->Group->bPinned;
+    }
+
+    HICON PinIcon(IN PTASK_GROUP TaskGroup)
+    {
+        if (!TaskGroup->hPinIcon && TaskGroup->szPinLink[0])
+        {
+            SHFILEINFOW info = { 0 };
+
+            if (SHGetFileInfoW(TaskGroup->szPinLink, 0, &info, sizeof(info),
+                               SHGFI_ICON | (g_TaskbarSettings.bSmallIcons ? SHGFI_SMALLICON : SHGFI_LARGEICON)))
+                TaskGroup->hPinIcon = info.hIcon;
+        }
+        return TaskGroup->hPinIcon;
+    }
+
+    /* how wide a button without a label is, as in Windows 10 and 11 */
+    static INT IconButtonWidth()
+    {
+        return ArcticDpiScale(g_TaskbarSettings.bSmallIcons ? 40 : ArcticTaskbarStyle11() ? 44 : 48);
+    }
+
+    INT LastButtonOfGroup(IN PTASK_GROUP TaskGroup)
+    {
+        INT iLast = -1;
+
+        for (PTASK_ITEM TaskItem = m_TaskItems; TaskItem != m_TaskItems + m_TaskItemCount; TaskItem++)
+        {
+            if (TaskItem->Group == TaskGroup && TaskItem->Index > iLast)
+                iLast = TaskItem->Index;
+        }
+        return iLast;
+    }
+
+    INT AddPinButton(IN OUT PTASK_ITEM TaskItem, IN INT iIndex)
+    {
+        TBBUTTON tbBtn = { 0 };
+
+        TaskItem->IconIndex = -1;
+        SetTaskIcon(TaskItem, PinIcon(TaskItem->Group));
+        tbBtn.iBitmap = I_IMAGENONE;
+        tbBtn.fsState = TBSTATE_ENABLED | TBSTATE_ELLIPSES;
+        tbBtn.fsStyle = BTNS_CHECK | BTNS_NOPREFIX | BTNS_SHOWTEXT;
+        tbBtn.idCommand = iIndex;
+
+        m_TaskBar.BeginUpdate();
+        if (m_TaskBar.InsertButton(iIndex, &tbBtn))
+        {
+            UpdateIndexesAfter(iIndex, TRUE);
+            TaskItem->Index = iIndex;
+            m_ButtonCount++;
+            UpdateButtonsSize(TRUE);
+            return iIndex;
+        }
+        m_TaskBar.EndUpdate();
+        return -1;
+    }
+
+    /* the first window of a pinned program takes the pin's button, where it is */
+    PTASK_ITEM TakePinButton(IN HWND hWnd)
+    {
+        WCHAR szExePath[MAX_PATH];
+        DWORD dwProcessId = 0;
+
+        if (!SHELL_GetWindowExePath(hWnd, szExePath, _countof(szExePath)) || !*szExePath)
+            return NULL;
+        ::GetWindowThreadProcessId(hWnd, &dwProcessId);
+        for (PTASK_ITEM TaskItem = m_TaskItems; TaskItem != m_TaskItems + m_TaskItemCount; TaskItem++)
+        {
+            if (!IsPinOnly(TaskItem) || _wcsicmp(TaskItem->Group->szExePath, szExePath))
+                continue;
+            TaskItem->hWnd = hWnd;
+            TaskItem->dwFlags = 0;
+            TaskItem->Group->dwProcessId = dwProcessId;
+            if (TaskItem->Index >= 0)
+                UpdateTaskItemButton(TaskItem);
+            UpdateButtonsSize(FALSE);
+            ::PostMessageW(hWnd, m_uButtonCreatedMsg, 0, 0);
+            CheckFull();
+            return TaskItem;
+        }
+        return NULL;
+    }
+
+    /* the last window of a pinned program leaves its button to the pin */
+    BOOL LeaveToPin(IN OUT PTASK_ITEM TaskItem)
+    {
+        PTASK_GROUP TaskGroup = TaskItem->Group;
+
+        if (m_IsDestroying || m_bRebuilding || TaskGroup == NULL || !TaskGroup->bPinned ||
+            TaskGroup->dwTaskCount != 1 || TaskItem->Index < 0)
+            return FALSE;
+        if (m_ActiveTaskItem == TaskItem)
+            m_ActiveTaskItem = NULL;
+        TaskItem->hWnd = NULL;
+        TaskItem->dwFlags = 0;
+        TaskGroup->dwProcessId = 0;
+        UpdateTaskItemButton(TaskItem);
+        UpdateButtonsSize(FALSE);
+        return TRUE;
+    }
+
+    /* the pins startui.dll keeps: a button of its own for each program with
+       no window open, the button of its windows for the others; one unpinned
+       loses its button only when no window of it is open */
+    VOID SyncPins()
+    {
+        LPWSTR pszList = ArcticTaskbarPinList();
+        INT iInsert = 0;
+
+        if (!pszList)
+            return;
+        for (PTASK_GROUP Group = m_TaskGroups; Group != NULL; Group = Group->Next)
+            Group->bPinSeen = FALSE;
+        for (LPCWSTR p = pszList; *p; p += wcslen(p) + 1)
+        {
+            WCHAR szLink[MAX_PATH];
+            LPCWSTR pszBar = wcschr(p, L'|');
+            PTASK_GROUP TaskGroup = NULL;
+
+            if (!pszBar || pszBar - p >= MAX_PATH)
+                continue;
+            StringCchCopyNW(szLink, _countof(szLink), p, pszBar - p);
+            for (PTASK_GROUP Group = m_TaskGroups; Group != NULL && TaskGroup == NULL; Group = Group->Next)
+            {
+                if ((Group->bPinned && !_wcsicmp(Group->szPinLink, szLink)) ||
+                    (pszBar[1] && !_wcsicmp(Group->szExePath, pszBar + 1)))
+                    TaskGroup = Group;
+            }
+            if (TaskGroup != NULL)
+            {
+                if (_wcsicmp(TaskGroup->szPinLink, szLink))
+                {
+                    if (TaskGroup->hPinIcon)
+                        DestroyIcon(TaskGroup->hPinIcon);
+                    TaskGroup->hPinIcon = NULL;
+                    StringCchCopyW(TaskGroup->szPinLink, _countof(TaskGroup->szPinLink), szLink);
+                }
+                TaskGroup->bPinned = TaskGroup->bPinSeen = TRUE;
+                iInsert = max(iInsert, LastButtonOfGroup(TaskGroup) + 1);
+                continue;
+            }
+            if (!pszBar[1])
+                continue;
+
+            TaskGroup = (PTASK_GROUP)HeapAlloc(hProcessHeap, HEAP_ZERO_MEMORY, sizeof(*TaskGroup));
+            if (TaskGroup == NULL)
+                break;
+            TaskGroup->dwTaskCount = 1;
+            TaskGroup->Index = -1;
+            TaskGroup->bPinned = TaskGroup->bPinSeen = TRUE;
+            StringCchCopyW(TaskGroup->szExePath, _countof(TaskGroup->szExePath), pszBar + 1);
+            StringCchCopyW(TaskGroup->szPinLink, _countof(TaskGroup->szPinLink), szLink);
+            PTASK_GROUP *ppLink = &m_TaskGroups;
+            while (*ppLink != NULL)
+                ppLink = &(*ppLink)->Next;
+            *ppLink = TaskGroup;
+
+            PTASK_ITEM TaskItem = AllocTaskItem();
+            if (TaskItem == NULL)
+            {
+                *ppLink = NULL;
+                HeapFree(hProcessHeap, 0, TaskGroup);
+                break;
+            }
+            ZeroMemory(TaskItem, sizeof(*TaskItem));
+            TaskItem->Index = -1;
+            TaskItem->IconIndex = -1;
+            TaskItem->Group = TaskGroup;
+            INT iIndex = AddPinButton(TaskItem, min(iInsert, (INT)m_ButtonCount));
+            if (iIndex >= 0)
+                iInsert = iIndex + 1;
+        }
+        LocalFree(pszList);
+
+        for (BOOL bAgain = TRUE; bAgain; )
+        {
+            bAgain = FALSE;
+            for (PTASK_GROUP Group = m_TaskGroups; Group != NULL; Group = Group->Next)
+            {
+                if (!Group->bPinned || Group->bPinSeen)
+                    continue;
+                Group->bPinned = FALSE;
+                Group->szPinLink[0] = UNICODE_NULL;
+                for (PTASK_ITEM TaskItem = m_TaskItems; TaskItem != m_TaskItems + m_TaskItemCount; TaskItem++)
+                {
+                    if (TaskItem->Group != Group || TaskItem->hWnd != NULL)
+                        continue;
+                    /* the group goes with it: the list is gone through again */
+                    DeleteTaskItem(TaskItem);
+                    bAgain = TRUE;
+                    break;
+                }
+                if (bAgain)
+                    break;
+            }
+        }
+        UpdateButtonsSize(FALSE);
+    }
+
+    LRESULT OnPinsChanged(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        SyncPins();
+        return 0;
+    }
+
+    /* something is dragged over the taskbar (startui.dll's drop target): the
+       window of a button held under it a moment comes up, as in Windows */
+    LRESULT OnDragHover(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        POINT pt = { GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
+        INT iButton = -1;
+
+        if (wParam)
+        {
+            m_TaskBar.ScreenToClient(&pt);
+            iButton = m_TaskBar.HitTest(&pt);
+        }
+        if (iButton != m_iDragHoverButton)
+        {
+            m_iDragHoverButton = iButton;
+            KillTimer(TIMER_ID_DRAG_HOVER);
+            if (iButton >= 0)
+                SetTimer(TIMER_ID_DRAG_HOVER, DRAG_HOVER_DELAY, NULL);
+        }
+        return 0;
+    }
+
+    VOID DragHoverElapsed()
+    {
+        KillTimer(TIMER_ID_DRAG_HOVER);
+        if (m_iDragHoverButton < 0)
+            return;
+
+        TBBUTTON tbb = { 0 };
+        if (!m_TaskBar.SendMessageW(TB_GETBUTTON, m_iDragHoverButton, (LPARAM)&tbb))
+            return;
+        PTASK_ITEM TaskItem = FindTaskItemByIndex(tbb.idCommand);
+        if (TaskItem != NULL && ::IsWindow(TaskItem->hWnd))
+            ::SwitchToThisWindow(TaskItem->hWnd, TRUE);
+    }
