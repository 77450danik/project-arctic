+/* Arctic: the programs pinned to the taskbar, "shortcut|program" each (startui.dll); LocalFree it */
+LPWSTR ArcticTaskbarPinList(VOID)
+{
+    typedef LPWSTR (WINAPI *PFN_LIST)(VOID);
+    PFN_LIST pList = (PFN_LIST)ArcticProc(L"startui.dll", "ArcticTaskbarPinList");
+
+    return pList ? pList() : NULL;
+}
+
+/* the menu of a pin with no window: start it, unpin it */
+BOOL ArcticTaskbarPinMenu(IN HWND hwndOwner, IN LPCWSTR pszLink, IN const RECT *prcButton)
+{
+    typedef BOOL (WINAPI *PFN_MENU)(HWND, LPCWSTR, const RECT *);
+    PFN_MENU pMenu = (PFN_MENU)ArcticProc(L"startui.dll", "ArcticTaskbarPinMenu");
+
+    return pMenu && pMenu(hwndOwner, pszLink, prcButton);
+}
+
+/* what is dragged onto the window is pinned: to the taskbar or to Start */
+BOOL ArcticPinDropRegister(IN HWND hWnd, IN DWORD dwWhere)
+{
+    typedef BOOL (WINAPI *PFN_REGISTER)(HWND, DWORD);
+    PFN_REGISTER pRegister = (PFN_REGISTER)ArcticProc(L"startui.dll", "ArcticPinDropRegister");
+
+    return pRegister && pRegister(hWnd, dwWhere);
+}
