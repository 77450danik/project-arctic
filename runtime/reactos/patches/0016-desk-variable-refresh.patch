  * next to the adapter: "Dell U2415 on AMD Radeon RX 580". Reading it needs
  * the display configuration API, which lives in monitorname.c. */
 BOOL GetMonitorName(IN LPCWSTR pszDevice, OUT LPWSTR pszName, IN DWORD cchName);
+BOOL GetMonitorPnpId(IN LPCWSTR pszDevice, OUT LPWSTR pszId, IN DWORD cchId);
+
+/* Variable refresh (FreeSync, G-SYNC) of each monitor. dwm.exe keeps in the
+ * monitor's key of the monitor data store whether the monitor and the card
+ * take it, and follows the user's choice kept next to it. */
+#define MONITOR_STORE_KEY L"System\\CurrentControlSet\\Control\\GraphicsDrivers\\MonitorDataStore"
+
+static VOID
+ReadVariableRefresh(IN PDISPLAY_DEVICE_ENTRY Entry, IN LPCWSTR DeviceName)
+{
+    WCHAR szKey[128];
+    DWORD Value, Size, Type;
+    HKEY hKey;
+
+    Entry->VrrCapable = FALSE;
+    Entry->VrrEnabled = Entry->InitialVrrEnabled = TRUE;
+    if (!GetMonitorPnpId(DeviceName, Entry->PnpId, _countof(Entry->PnpId)))
+        return;
+    _snwprintf(szKey, _countof(szKey), L"%s\\%s", MONITOR_STORE_KEY, Entry->PnpId);
+    szKey[_countof(szKey) - 1] = 0;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, szKey, 0, KEY_QUERY_VALUE, &hKey) != ERROR_SUCCESS)
+        return;
+    Size = sizeof(Value);
+    if (RegQueryValueExW(hKey, L"VariableRefreshCapable", NULL, &Type, (LPBYTE)&Value, &Size) == ERROR_SUCCESS &&
+        Type == REG_DWORD)
+    {
+        Entry->VrrCapable = Value != 0;
+    }
+    Size = sizeof(Value);
+    if (RegQueryValueExW(hKey, L"VariableRefresh", NULL, &Type, (LPBYTE)&Value, &Size) == ERROR_SUCCESS &&
+        Type == REG_DWORD)
+    {
+        Entry->VrrEnabled = Entry->InitialVrrEnabled = Value != 0;
+    }
+    RegCloseKey(hKey);
+}
+
+static VOID
+WriteVariableRefresh(IN PDISPLAY_DEVICE_ENTRY Entry)
+{
+    WCHAR szKey[128];
+    DWORD Value = Entry->VrrEnabled ? 1 : 0;
+    HKEY hKey;
+
+    _snwprintf(szKey, _countof(szKey), L"%s\\%s", MONITOR_STORE_KEY, Entry->PnpId);
+    szKey[_countof(szKey) - 1] = 0;
+    if (RegCreateKeyExW(HKEY_LOCAL_MACHINE, szKey, 0, NULL, 0, KEY_SET_VALUE, NULL, &hKey, NULL) != ERROR_SUCCESS)
+        return;
+    if (RegSetValueExW(hKey, L"VariableRefresh", 0, REG_DWORD, (const BYTE *)&Value, sizeof(Value)) == ERROR_SUCCESS)
+        Entry->InitialVrrEnabled = Entry->VrrEnabled;
+    RegCloseKey(hKey);
+}
 
