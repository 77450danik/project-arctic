+/* The friendly name of the monitor on the given adapter */
+BOOL
+GetMonitorName(IN LPCWSTR pszDevice, OUT LPWSTR pszName, IN DWORD cchName)
+{
+    TARGET_DEVICE_NAME Target;
+
+    if (!GetMonitorTarget(pszDevice, &Target) || Target.monitorFriendlyDeviceName[0] == 0)
+        return FALSE;
+    StringCchCopyW(pszName, cchName, Target.monitorFriendlyDeviceName);
+    return TRUE;
+}
+
+/* "ACR0A2B", the Plug and Play id of the monitor on the given adapter, taken
+ * from its device path \\?\DISPLAY\ACR0A2B\... A monitor without an EDID has
+ * none. */
+BOOL
+GetMonitorPnpId(IN LPCWSTR pszDevice, OUT LPWSTR pszId, IN DWORD cchId)
+{
+    TARGET_DEVICE_NAME Target;
+    LPCWSTR pszStart, pszEnd;
+
+    if (!GetMonitorTarget(pszDevice, &Target))
+        return FALSE;
+    if (_wcsnicmp(Target.monitorDevicePath, L"\\\\?\\DISPLAY\\", 12) != 0)
+        return FALSE;
+    pszStart = Target.monitorDevicePath + 12;
+    if (!(pszEnd = wcschr(pszStart, L'\\')) || pszEnd == pszStart ||
+        (DWORD)(pszEnd - pszStart) >= cchId || _wcsnicmp(pszStart, L"Default_Monitor", 15) == 0)
+    {
+        return FALSE;
+    }
+    StringCchCopyNW(pszId, cchId, pszStart, pszEnd - pszStart);
+    return TRUE;
+}
