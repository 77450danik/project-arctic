+/* Arctic: the notification settings of the program that sent it */
+BOOL CBalloonQueue::Allow(Info& info)
+{
+    WCHAR szName[64];
+
+    StringCchCopyW(szName, _countof(szName), info.szApp);
+    if (!szName[0] && !info.hwndReply)
+        LoadStringW(GetModuleHandleW(NULL), IDS_TOAST_APP, szName, _countof(szName));
+    if (!ToastPolicy(info.szSender, szName, info.szIcon, &info.bSound, &info.dwRank))
+        return FALSE;
+    if (info.bNoSound)
+        info.bSound = FALSE;
+    return TRUE;
+}
+
+/* in turn, those of a higher rank before the others */
+void CBalloonQueue::Queue(Info& info)
+{
+    for (POSITION pos = m_queue.GetHeadPosition(); pos;)
+    {
+        POSITION current = pos;
+        if (m_queue.GetNext(pos).dwRank < info.dwRank)
+        {
+            m_queue.InsertBefore(current, info);
+            return;
+        }
+    }
+    m_queue.AddTail(info);
+}
+
+/* its settings button: the program's notification settings, and it goes */
+void CBalloonQueue::OnToastSettings()
+{
+    WCHAR szParams[MAX_PATH + 32];
+
+    if (m_szSender[0])
+    {
+        StringCchPrintfW(szParams, _countof(szParams), L"notifications.cpl,,\"%s\"", m_szSender);
+        ShellExecuteW(NULL, NULL, L"control.exe", szParams, NULL, SW_SHOWNORMAL);
+    }
+    OnToastClicked(TRUE);
+}
