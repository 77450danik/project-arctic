+/*
+ * Arctic: the notification settings (notifications.cpl), kept where Windows
+ * keeps them. Each program that sends a notification gets a key under
+ * Notifications\Settings, named by its path with '/' for '\': its name and
+ * icon for the applet, when it last sent one, and what the user allows it.
+ * A notification shows only when notifications are on, the program's are,
+ * with their banners, and focus assist lets it through: off, priority only
+ * (the program on its list) or alarms only (none), by hand or while a
+ * program covers the screen. Then its sound, and its rank in the queue.
+ */
+#define NOTIFY_PUSH_KEY     L"Software\\Microsoft\\Windows\\CurrentVersion\\PushNotifications"
+#define NOTIFY_SETTINGS_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings"
+#define NOTIFY_FOCUS_KEY    L"Software\\Arctic\\FocusAssist"
+
+static DWORD NotifyDword(LPCWSTR pszPath, LPCWSTR pszName, DWORD dwDefault)
+{
+    DWORD dwValue, cb = sizeof(dwValue);
+
+    if (RegGetValueW(HKEY_CURRENT_USER, pszPath, pszName, RRF_RT_REG_DWORD, NULL, &dwValue, &cb) != ERROR_SUCCESS)
+        return dwDefault;
+    return dwValue;
+}
+
+/* the program of a window; explorer's own windows are explorer's */
+static void ToastSenderPath(HWND hwnd, LPWSTR pszPath, DWORD cch)
+{
+    typedef BOOL (WINAPI *QUERY_FN)(HANDLE, DWORD, LPWSTR, PDWORD);
+    QUERY_FN pQuery = (QUERY_FN)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "QueryFullProcessImageNameW");
+    DWORD pid = 0, cchPath = cch;
+    HANDLE hProcess;
+    BOOL ok = FALSE;
+
+    if (pQuery && hwnd && GetWindowThreadProcessId(hwnd, &pid) && pid != GetCurrentProcessId() &&
+        (hProcess = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid)))
+    {
+        ok = pQuery(hProcess, 0, pszPath, &cchPath);
+        CloseHandle(hProcess);
+    }
+    if (!ok && !GetModuleFileNameW(NULL, pszPath, cch))
+        pszPath[0] = UNICODE_NULL;
+}
+
+/* a program in front covers its monitor: a video, a game, a presentation */
+static BOOL ToastFullScreenInFront()
+{
+    HWND hwnd = GetForegroundWindow();
+    MONITORINFO mi = { sizeof(mi) };
+    DWORD pid = 0;
+    RECT rc;
+
+    if (!hwnd || GetAncestor(hwnd, GA_ROOT) == GetShellWindow() ||
+        !GetWindowThreadProcessId(hwnd, &pid) || pid == GetCurrentProcessId() ||
+        (GetWindowLongPtrW(hwnd, GWL_STYLE) & WS_MAXIMIZE) || !GetWindowRect(hwnd, &rc) ||
+        !GetMonitorInfoW(MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST), &mi))
+        return FALSE;
+    return rc.left <= mi.rcMonitor.left && rc.top <= mi.rcMonitor.top &&
+           rc.right >= mi.rcMonitor.right && rc.bottom >= mi.rcMonitor.bottom;
+}
+
+/* the program's key, made or brought up to date; whether its notification shows */
+static BOOL ToastPolicy(LPCWSTR pszSender, LPCWSTR pszName, LPCWSTR pszIcon, BOOL *pbSound, DWORD *pdwRank)
+{
+    WCHAR szKey[MAX_PATH + 96];
+    size_t cchPrefix = wcslen(NOTIFY_SETTINGS_KEY) + 1;
+    DWORD dwMode;
+    FILETIME ft;
+    HKEY hKey;
+
+    *pbSound = FALSE;
+    *pdwRank = 0;
+    if (!pszSender[0])
+        return TRUE;
+    StringCchPrintfW(szKey, _countof(szKey), L"%s\\%s", NOTIFY_SETTINGS_KEY, pszSender);
+    for (WCHAR *p = szKey + cchPrefix; *p; p++)
+        if (*p == L'\\')
+            *p = L'/';
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, szKey, 0, NULL, 0, KEY_SET_VALUE, NULL, &hKey, NULL) == ERROR_SUCCESS)
+    {
+        LPCWSTR pszFile = PathFindFileNameW(pszSender);
+        WCHAR szName[MAX_PATH];
+
+        if (pszName && pszName[0])
+            StringCchCopyW(szName, _countof(szName), pszName);
+        else
+        {
+            StringCchCopyW(szName, _countof(szName), pszFile);
+            PathRemoveExtensionW(szName);
+        }
+        RegSetValueExW(hKey, L"DisplayName", 0, REG_SZ, (const BYTE *)szName, (wcslen(szName) + 1) * sizeof(WCHAR));
+        if (!pszIcon || !pszIcon[0])
+            pszIcon = pszSender;
+        RegSetValueExW(hKey, L"IconPath", 0, REG_SZ, (const BYTE *)pszIcon, (wcslen(pszIcon) + 1) * sizeof(WCHAR));
+        GetSystemTimeAsFileTime(&ft);
+        RegSetValueExW(hKey, L"LastNotification", 0, REG_QWORD, (const BYTE *)&ft, sizeof(ft));
+        RegCloseKey(hKey);
+    }
+
+    if (!NotifyDword(NOTIFY_PUSH_KEY, L"ToastEnabled", 1) ||
+        !NotifyDword(szKey, L"Enabled", 1) || !NotifyDword(szKey, L"ShowBanner", 1))
+        return FALSE;
+    dwMode = NotifyDword(NOTIFY_FOCUS_KEY, L"Mode", 0);
+    if (!dwMode && ToastFullScreenInFront())
+        dwMode = NotifyDword(NOTIFY_FOCUS_KEY, L"FullScreen", 2);
+    if (dwMode >= 2 || (dwMode == 1 && !NotifyDword(szKey, L"Priority", 0)))
+        return FALSE;
+    *pbSound = NotifyDword(NOTIFY_SETTINGS_KEY, L"NOC_GLOBAL_SETTING_ALLOW_NOTIFICATION_SOUND", 1) &&
+               NotifyDword(szKey, L"PlaySound", 1);
+    *pdwRank = NotifyDword(szKey, L"Rank", 0);
+    return TRUE;
+}
+
+/* Windows 10's sound of a notification (runtime/registry/notifications.reg) */
+static void ToastPlaySound()
+{
+    typedef BOOL (WINAPI *PLAYSOUND_FN)(LPCWSTR, HMODULE, DWORD);
+    static PLAYSOUND_FN pPlaySound;
+
+    if (!pPlaySound)
+    {
+        HMODULE hWinmm = LoadLibraryW(L"winmm.dll");
+        pPlaySound = hWinmm ? (PLAYSOUND_FN)GetProcAddress(hWinmm, "PlaySoundW") : NULL;
+    }
+    /* SND_ALIAS | SND_ASYNC | SND_NODEFAULT */
+    if (pPlaySound)
+        pPlaySound(L"Notification.Default", NULL, 0x00010000 | 0x0001 | 0x0002);
+}
