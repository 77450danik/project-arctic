index 5f07f38a..e1616587 100644
--- a/base/shell/explorer/precomp.h
+++ b/base/shell/explorer/precomp.h
@@ -424,4 +424,19 @@ Tray_OnStartMenuDismissed(ITrayWindow* Tray);
 HRESULT
 IsSameObject(IN IUnknown *punk1, IN IUnknown *punk2);
 
+/* Arctic: a size in pixels at 96 DPI, in the DPI the shell draws at: the
+   system's, which is the primary monitor's scale when the session starts */
+static inline int ArcticDpiScale(int px)
+{
+    static int s_dpi;
+    if (!s_dpi)
+    {
+        HDC hdc = ::GetDC(NULL);
+        s_dpi = hdc ? ::GetDeviceCaps(hdc, LOGPIXELSY) : 96;
+        if (hdc) ::ReleaseDC(NULL, hdc);
+        if (s_dpi <= 0) s_dpi = 96;
+    }
+    return ::MulDiv(px, s_dpi, 96);
+}
+
 #endif /* _EXPLORER_PRECOMP__H_ */
