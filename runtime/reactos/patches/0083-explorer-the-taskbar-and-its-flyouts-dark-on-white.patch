+    /* Arctic: over a light look, as Windows 10's light taskbar: on white
+     * (the backdrop seen through), darker under the pointer and pressed,
+     * the four panes of the logo in black */
+    LRESULT OnPaint(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        PAINTSTRUCT ps;
+        RECT rc, rcPane;
+        LRESULT state;
+        int logo = ArcticDpiScale(16), pane = (logo - ArcticDpiScale(1)) / 2, x, y;
+
+        if (!ArcticTaskbarLight())
+        {
+            bHandled = FALSE;
+            return 0;
+        }
+        HDC hdc = BeginPaint(&ps);
+        GetClientRect(&rc);
+        FillRect(hdc, &rc, (HBRUSH)GetStockObject(WHITE_BRUSH));
+        state = SendMessageW(BM_GETSTATE, 0, 0);
+        if (state & BST_PUSHED)
+            ArcticFillAlpha(hdc, &rc, RGB(0, 0, 0), 0x26);
+        else if (state & BST_HOT)
+            ArcticFillAlpha(hdc, &rc, RGB(0, 0, 0), 0x1a);
+        x = (rc.right - logo) / 2;
+        y = (rc.bottom - logo) / 2;
+        for (int i = 0; i < 4; i++)
+        {
+            SetRect(&rcPane, x + (i % 2) * (logo - pane), y + (i / 2) * (logo - pane),
+                    x + (i % 2) * (logo - pane) + pane, y + (i / 2) * (logo - pane) + pane);
+            ArcticFillAlpha(hdc, &rcPane, RGB(0, 0, 0), 255);
+        }
+        EndPaint(&ps);
+        return 0;
+    }
+
