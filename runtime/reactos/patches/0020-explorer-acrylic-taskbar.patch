+/*
+ * Arctic: the taskbar of Windows 10. dwm.exe draws acrylic behind it and keeps
+ * it in its band over program windows (user32's SetWindowBand and
+ * SetWindowCompositionAttribute); twinui.dll does Alt+Tab and the thumbnails
+ * over its buttons, as in Windows. They are looked up at run time: this
+ * explorer also runs where they are missing.
+ */
+
+static FARPROC ArcticProc(IN LPCWSTR pszModule, IN LPCSTR pszName)
+{
+    HMODULE hModule = GetModuleHandleW(pszModule);
+
+    if (!hModule)
+        hModule = LoadLibraryW(pszModule);
+    return hModule ? GetProcAddress(hModule, pszName) : NULL;
+}
+
+/* a colour at some opacity, which dwm.exe keeps over the acrylic */
+VOID ArcticFillAlpha(IN HDC hdc, IN const RECT *prc, IN COLORREF color, IN BYTE alpha)
+{
+    BITMAPINFO bi;
+    DWORD *pBits;
+    HBITMAP hbm;
+
+    ZeroMemory(&bi, sizeof(bi));
+    bi.bmiHeader.biSize = sizeof(bi.bmiHeader);
+    bi.bmiHeader.biWidth = 1;
+    bi.bmiHeader.biHeight = 1;
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    hbm = CreateDIBSection(hdc, &bi, DIB_RGB_COLORS, (void **)&pBits, NULL, 0);
+    if (!hbm)
+        return;
+    *pBits = ((DWORD)alpha << 24) | ((GetRValue(color) * alpha / 255) << 16) |
+             ((GetGValue(color) * alpha / 255) << 8) | (GetBValue(color) * alpha / 255);
+    HDC hdcMem = CreateCompatibleDC(hdc);
+    HGDIOBJ hOld = SelectObject(hdcMem, hbm);
+    BLENDFUNCTION bf = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    GdiAlphaBlend(hdc, prc->left, prc->top, prc->right - prc->left, prc->bottom - prc->top, hdcMem, 0, 0, 1, 1, bf);
+    SelectObject(hdcMem, hOld);
+    DeleteDC(hdcMem);
+    DeleteObject(hbm);
+}
+
+VOID ArcticSetTrayBand(IN HWND hWnd, IN BOOL bBand)
+{
+    typedef BOOL (WINAPI *PFN_SETWINDOWBAND)(HWND, HWND, DWORD);
+    PFN_SETWINDOWBAND pSetWindowBand = (PFN_SETWINDOWBAND)ArcticProc(L"user32.dll", "SetWindowBand");
+
+    /* ZBID_SYSTEM_TOOLS is over program windows, ZBID_DESKTOP among them */
+    if (pSetWindowBand)
+        pSetWindowBand(hWnd, NULL, bBand ? 4 : 1);
+}
+
+VOID ArcticSetAcrylic(IN HWND hWnd, IN DWORD dwTint)
+{
+    typedef BOOL (WINAPI *PFN_SETWCA)(HWND, PVOID);
+    PFN_SETWCA pSetWindowCompositionAttribute =
+        (PFN_SETWCA)ArcticProc(L"user32.dll", "SetWindowCompositionAttribute");
+    struct { DWORD AccentState, AccentFlags, GradientColor, AnimationId; } policy =
+        { 4 /* ACCENT_ENABLE_ACRYLICBLURBEHIND */, 0, dwTint, 0 };
+    struct { DWORD Attrib; PVOID pvData; SIZE_T cbData; } data =
+        { 19 /* WCA_ACCENT_POLICY */, &policy, sizeof(policy) };
+
+    if (pSetWindowCompositionAttribute)
+        pSetWindowCompositionAttribute(hWnd, &data);
+}
+
+HRESULT ArcticSetWindowAttribute(IN HWND hWnd, IN DWORD dwAttribute, IN LPCVOID pvValue, IN DWORD cbValue)
+{
+    typedef HRESULT (WINAPI *PFN_DWMSETWINDOWATTRIBUTE)(HWND, DWORD, LPCVOID, DWORD);
+    PFN_DWMSETWINDOWATTRIBUTE pDwmSetWindowAttribute =
+        (PFN_DWMSETWINDOWATTRIBUTE)ArcticProc(L"dwmapi.dll", "DwmSetWindowAttribute");
+
+    return pDwmSetWindowAttribute ? pDwmSetWindowAttribute(hWnd, dwAttribute, pvValue, cbValue) : E_NOTIMPL;
+}
+
+VOID ArcticStartTaskSwitcher(VOID)
+{
+    typedef BOOL (WINAPI *PFN_START)(void);
+    PFN_START pStart = (PFN_START)ArcticProc(L"twinui.dll", "ArcticStartTaskSwitcher");
+
+    if (pStart)
+        pStart();
+}
+
+VOID ArcticTaskbarHover(IN HWND hwndTask, IN const RECT *prcButton, IN DWORD dwFlags)
+{
+    typedef void (WINAPI *PFN_HOVER)(HWND, const RECT *, DWORD);
+    PFN_HOVER pHover = (PFN_HOVER)ArcticProc(L"twinui.dll", "ArcticTaskbarHover");
+
+    if (pHover)
+        pHover(hwndTask, prcButton, dwFlags);
+}
