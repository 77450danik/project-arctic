+/* Arctic: the program file of a window's process */
+static BOOL
+SHELL_GetWindowExePath(_In_ HWND hWnd, _Out_writes_(cch) LPWSTR pszPath, _In_ DWORD cch)
+{
+    typedef BOOL (WINAPI *PFN_QUERYIMAGENAME)(HANDLE, DWORD, LPWSTR, PDWORD);
+    static PFN_QUERYIMAGENAME pQueryImageName;
+    DWORD dwProcessId;
+
+    *pszPath = UNICODE_NULL;
+    if (!pQueryImageName)
+    {
+        pQueryImageName = (PFN_QUERYIMAGENAME)::GetProcAddress(::GetModuleHandleW(L"kernel32.dll"),
+                                                               "QueryFullProcessImageNameW");
+        if (!pQueryImageName)
+            return FALSE;
+    }
+    if (!::GetWindowThreadProcessId(hWnd, &dwProcessId))
+        return FALSE;
+
+    HANDLE hProcess = ::OpenProcess(0x1000 /* PROCESS_QUERY_LIMITED_INFORMATION */, FALSE, dwProcessId);
+    if (!hProcess)
+        return FALSE;
+    BOOL bRet = pQueryImageName(hProcess, 0, pszPath, &cch);
+    ::CloseHandle(hProcess);
+    if (!bRet)
+        *pszPath = UNICODE_NULL;
+    return bRet;
+}
