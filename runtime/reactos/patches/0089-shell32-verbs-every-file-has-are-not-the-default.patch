+/* Arctic: whether a class key is "*" or AllFilesystemObjects, whose verbs every
+ * file has. As in Windows, none of them is the default of an item: "Open with
+ * Code" a program adds to all files does not open a shortcut, whose Open comes
+ * from its handler */
+static BOOL
+IsClassOfEveryItem(HKEY hkClass)
+{
+    struct
+    {
+        KEY_BASIC_INFORMATION Info;
+        WCHAR Room[32];
+    } kbi;
+    ULONG cb;
+
+    if (!NT_SUCCESS(NtQueryKey(hkClass, KeyBasicInformation, &kbi, sizeof(kbi), &cb)))
+        return FALSE;
+    UINT cch = kbi.Info.NameLength / sizeof(WCHAR);
+    return (cch == 1 && kbi.Info.Name[0] == L'*') ||
+           (cch == _countof(L"AllFilesystemObjects") - 1 &&
+            !_wcsnicmp(kbi.Info.Name, L"AllFilesystemObjects", cch));
+}
+
 UINT
 CDefaultContextMenu::AddStaticContextMenusToMenu(
     HMENU hMenu,
