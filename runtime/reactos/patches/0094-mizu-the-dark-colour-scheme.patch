From: 77450danik <ddziuba1@stu.vistula.edu.pl>
Date: Wed, 4 Nov 2026 12:00:00 +0100
Subject: [PATCH] Mizu: the dark colour scheme.

Mizu has one colour scheme, light. Its second one, "Dark", has the same
parts, sizes and margins, its pictures and colours made from the light
ones by tools/make-dark-mizu.py (runtime/reactos/files): lightness turned
over, hue kept, the system colours Windows 11's dark ones. The taskbar's,
Start's and the clock's parts stay as they are: they follow the system's
mode, not the programs'. The Personalization page (startui.dll) switches
between the two.
---
--- a/media/themes/Mizu/mizu.msstyles/mizu.rc
+++ b/media/themes/Mizu/mizu.msstyles/mizu.rc
@@ -8,16 +8,20 @@
 
 LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
 
-1 COLORNAMES					{L"Normal Color\0\0"}
+1 COLORNAMES					{L"Normal Color\0Dark\0\0"}
 COMBO COMBODATA					{0x0003,0x0003, 0x0000, 0x0003, 0x0006, 0x0001,0x0004,0x0007,0x0002,0x0005,0x08,}
 1 PACKTHEM_VERSION				{0x03,}
-1 FILERESNAMES					{L"NORMALNORMAL_INI\0LARGEFONTSNORMAL_INI\0EXTRALARGENORMAL_INI\0\0"}
+1 FILERESNAMES					{L"NORMALNORMAL_INI\0LARGEFONTSNORMAL_INI\0EXTRALARGENORMAL_INI\0NORMALDARK_INI\0LARGEFONTSDARK_INI\0EXTRALARGEDARK_INI\0\0"}
 1 SIZENAMES						{L"Normal Size\0Large Fonts\0Extra Large Fonts\0\0"}
 1 MINDEPTH						{0x000F,0x000F,0x000F,0x000F,0x000F,0x000F,0x000F,0x000F,0x000F,0x0000,}
 
 EXTRALARGENORMAL_INI TEXTFILE	"textfiles/ExtraLargeNormal_utf16.INI"
 LARGEFONTSNORMAL_INI TEXTFILE	"textfiles/LargeFontsNormal_utf16.INI"
 NORMALNORMAL_INI TEXTFILE		"textfiles/NormalNormal_utf16.INI"
+/* Arctic: the dark colour scheme (tools/make-dark-mizu.py) */
+EXTRALARGEDARK_INI TEXTFILE		"textfiles/ExtraLargeDark_utf16.INI"
+LARGEFONTSDARK_INI TEXTFILE		"textfiles/LargeFontsDark_utf16.INI"
+NORMALDARK_INI TEXTFILE			"textfiles/NormalDark_utf16.INI"
 THEMES_INI TEXTFILE				{L"\r\n"}
 
 NORMAL_BALLOONCLOSE_BMP BITMAP "bitmaps/NORMAL_BALLOONCLOSE.bmp"
@@ -225,3 +229,114 @@
 #ifdef LANGUAGE_ZH_TW
