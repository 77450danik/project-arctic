+/* Arctic: a chevron pointing up, centred */
+static VOID ArcticDrawChevron(HDC hdc, const RECT *prc, COLORREF ink)
+{
+    enum { SAMPLES = 4 };
+    const int cxArt = ArcticDpiScale(10) + 2, cyArt = ArcticDpiScale(5) + 2;
+    const float half = ArcticDpiScale(115) / 200.0f;
+    const float ax = 1, ay = cyArt - 1.0f, mx = cxArt / 2.0f, my = 1, bx = cxArt - 1.0f;
+    BITMAPINFO bi = {{sizeof(bi.bmiHeader), cxArt, -cyArt, 1, 32, BI_RGB}};
+    BLENDFUNCTION bf = {AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
+    DWORD *pBits;
+    HBITMAP hbm = CreateDIBSection(hdc, &bi, DIB_RGB_COLORS, (void **)&pBits, NULL, 0);
+    HDC hdcMem;
+    HGDIOBJ hOld;
+
+    if (!hbm)
+        return;
+    for (int y = 0; y < cyArt; y++)
+    {
+        for (int x = 0; x < cxArt; x++)
+        {
+            int hits = 0;
+
+            for (int j = 0; j < SAMPLES; j++)
+            {
+                for (int i = 0; i < SAMPLES; i++)
+                {
+                    float px = x + (i + 0.5f) / SAMPLES, py = y + (j + 0.5f) / SAMPLES;
+                    float x0 = px < mx ? ax : bx, dx = mx - x0, dy = my - ay;
+                    float t = ((px - x0) * dx + (py - ay) * dy) / (dx * dx + dy * dy);
+                    float ex, ey;
+
+                    t = t < 0 ? 0 : t > 1 ? 1 : t;
+                    ex = x0 + t * dx - px;
+                    ey = ay + t * dy - py;
+                    if (ex * ex + ey * ey <= half * half)
+                        hits++;
+                }
+            }
+            DWORD a = hits * 255 / (SAMPLES * SAMPLES);
+            pBits[y * cxArt + x] = (a << 24) | ((GetRValue(ink) * a / 255) << 16) |
+                                   ((GetGValue(ink) * a / 255) << 8) | (GetBValue(ink) * a / 255);
+        }
+    }
+    hdcMem = CreateCompatibleDC(hdc);
+    hOld = SelectObject(hdcMem, hbm);
+    GdiAlphaBlend(hdc, (prc->left + prc->right - cxArt) / 2, (prc->top + prc->bottom - cyArt) / 2,
+                  cxArt, cyArt, hdcMem, 0, 0, cxArt, cyArt, bf);
+    SelectObject(hdcMem, hOld);
+    DeleteDC(hdcMem);
+    DeleteObject(hbm);
+}
+
+/* Arctic: the chevron left of the icons */
+class CTrayChevron :
+    public CWindowImpl<CTrayChevron, CWindow, CControlWinTraits>
+{
+    BOOL m_bHot, m_bOpen;
+
+public:
+    DECLARE_WND_CLASS_EX(L"ArcticTrayChevron", CS_HREDRAW | CS_VREDRAW, COLOR_3DFACE)
+
+    CTrayChevron() : m_bHot(FALSE), m_bOpen(FALSE) {}
+
+    VOID SetOpen(BOOL bOpen)
+    {
+        m_bOpen = bOpen;
+        Invalidate();
+    }
+
+    LRESULT OnPaint(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint(&ps);
+        BOOL bLight = ArcticTaskbarLight();
+        COLORREF ink = ARCTIC_INK(bLight);
+        RECT rc;
+
+        GetClientRect(&rc);
+        FillRect(hdc, &rc, (HBRUSH)GetStockObject(bLight ? WHITE_BRUSH : BLACK_BRUSH));
+        if (m_bHot || m_bOpen)
+        {
+            if (ArcticTaskbarStyle11())
+                ArcticTaskbarPaintButton(hdc, &rc, ARCTIC_BUTTON_START | (m_bOpen ? ARCTIC_BUTTON_PRESSED : ARCTIC_BUTTON_HOT));
+            else
+                ArcticFillAlpha(hdc, &rc, ink, m_bOpen ? 0x26 : 0x1a);
+        }
+        ArcticDrawChevron(hdc, &rc, ink);
+        EndPaint(&ps);
+        return 0;
+    }
+
+    LRESULT OnEraseBkgnd(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        return 1;
+    }
+
+    LRESULT OnMouseMove(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        if (!m_bHot)
+        {
+            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, m_hWnd, 0 };
+
+            TrackMouseEvent(&tme);
+            m_bHot = TRUE;
+            Invalidate();
+        }
+        return 0;
+    }
+
+    LRESULT OnMouseLeave(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        m_bHot = FALSE;
+        Invalidate();
+        return 0;
+    }
+
+    LRESULT OnLButtonUp(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        GetParent().PostMessage(SPM_CHEVRONCLICK);
+        return 0;
+    }
+
+    BEGIN_MSG_MAP(CTrayChevron)
+        MESSAGE_HANDLER(WM_PAINT, OnPaint)
+        MESSAGE_HANDLER(WM_ERASEBKGND, OnEraseBkgnd)
+        MESSAGE_HANDLER(WM_MOUSEMOVE, OnMouseMove)
+        MESSAGE_HANDLER(WM_MOUSELEAVE, OnMouseLeave)
+        MESSAGE_HANDLER(WM_LBUTTONUP, OnLButtonUp)
+    END_MSG_MAP()
+};
+
+/* Arctic: what is behind the chevron: a grid of icons over the shell's look,
+ * against the taskbar and square as Windows 10's, a little off it and
+ * rounded as Windows 11's. An icon dragged out onto the taskbar stays there. */
+class CTrayOverflow :
+    public CWindowImpl<CTrayOverflow, CWindow, CWinTraits<WS_POPUP, WS_EX_TOOLWINDOW | WS_EX_TOPMOST> >
+{
+    enum { MAX_ICONS = 64 };
+
+    CNotifyToolbar *m_pToolbar;
+    CTrayChevron *m_pChevron;
+    HWND m_hwndPager, m_hwndTip;
+    int m_indices[MAX_ICONS];
+    int m_count, m_columns, m_hot, m_pressed;
+    BOOL m_bLight;
+    POINT m_ptPressed;
+    DWORD m_dwClosed;
+
+    static int Cell() { return ArcticDpiScale(40); }
+    static int Pad() { return ArcticTaskbarStyle11() ? ArcticDpiScale(4) : ArcticDpiScale(2); }
+
+    VOID CellRect(int i, RECT *prc)
+    {
+        int x = Pad() + (i % m_columns) * Cell(), y = Pad() + (i / m_columns) * Cell();
+
+        SetRect(prc, x, y, x + Cell(), y + Cell());
+    }
+
+    int HitTest(POINT pt)
+    {
+        for (int i = 0; i < m_count; i++)
+        {
+            RECT rc;
+
+            CellRect(i, &rc);
+            if (PtInRect(&rc, pt))
+                return i;
+        }
+        return -1;
+    }
+
+    /* the icons there are now, and a tip over each */
+    VOID Collect()
+    {
+        TOOLINFOW ti = { sizeof(ti) };
+
+        ti.hwnd = m_hWnd;
+        for (UINT id = 1; id <= MAX_ICONS; id++)
+        {
+            ti.uId = id;
+            ::SendMessageW(m_hwndTip, TTM_DELTOOLW, 0, (LPARAM)&ti);
+        }
+        m_count = m_pToolbar->GetOverflow(m_indices, MAX_ICONS);
+        m_columns = 1;
+        while (m_columns < 5 && m_columns * m_columns < m_count)
+            m_columns++;
+        for (int i = 0; i < m_count; i++)
+        {
+            ZeroMemory(&ti, sizeof(ti));
+            ti.cbSize = sizeof(ti);
+            ti.uFlags = TTF_SUBCLASS;
+            ti.hwnd = m_hWnd;
+            ti.uId = i + 1;
+            CellRect(i, &ti.rect);
+            ti.lpszText = m_pToolbar->GetItemData(m_indices[i])->szTip;
+            ::SendMessageW(m_hwndTip, TTM_ADDTOOLW, 0, (LPARAM)&ti);
+        }
+    }
+
+    VOID Place()
+    {
+        BOOL b11 = ArcticTaskbarStyle11();
+        int rows = max(1, (m_count + m_columns - 1) / m_columns);
+        int cx = m_columns * Cell() + 2 * Pad(), cy = rows * Cell() + 2 * Pad();
+        int gap = b11 ? ArcticDpiScale(8) : 0, x, y;
+        RECT rcChevron, rcWork;
+
+        m_pChevron->GetWindowRect(&rcChevron);
+        SystemParametersInfoW(SPI_GETWORKAREA, 0, &rcWork, 0);
+        x = (rcChevron.left + rcChevron.right - cx) / 2;
+        x = max((int)rcWork.left, min(x, (int)rcWork.right - cx));
+        y = rcChevron.top > (rcWork.top + rcWork.bottom) / 2 ? rcWork.bottom - cy - gap : rcWork.top + gap;
+        SetWindowPos(HWND_TOPMOST, x, y, cx, cy, SWP_NOACTIVATE);
+    }
+
+public:
+    DECLARE_WND_CLASS_EX(L"ArcticTrayOverflow", CS_DBLCLKS, COLOR_WINDOW)
+
+    CTrayOverflow() : m_pToolbar(NULL), m_pChevron(NULL), m_hwndPager(NULL), m_hwndTip(NULL), m_count(0), m_columns(1),
+                      m_hot(-1), m_pressed(-1), m_bLight(FALSE), m_dwClosed(0)
+    {
+    }
+
+    BOOL IsOpen() { return m_hWnd && IsWindowVisible(); }
+    DWORD ClosedAt() { return m_dwClosed; }
+
+    VOID Open(CNotifyToolbar *pToolbar, CTrayChevron *pChevron, HWND hwndPager)
+    {
+        typedef BOOL (WINAPI *PFN_LOOKEX)(HWND);
+        HMODULE hModule = LoadLibraryW(L"startui.dll");
+        PFN_LOOKEX pLook = hModule ? (PFN_LOOKEX)GetProcAddress(hModule, "ArcticApplyShellLookEx") : NULL;
+        BOOL b11 = ArcticTaskbarStyle11();
+        DWORD dwTransition = b11 ? 2 /* fade */ : ARCTIC_TRANSITION_SLIDE_UP;
+        DWORD dwCorner = b11 ? 0x108 /* rounded by 8 */ : 1 /* DWMWCP_DONOTROUND */;
+
+        m_pToolbar = pToolbar;
+        m_pChevron = pChevron;
+        m_hwndPager = hwndPager;
+        if (!m_hWnd)
+        {
+            if (!Create(NULL))
+                return;
+            m_hwndTip = CreateWindowExW(WS_EX_TOPMOST, TOOLTIPS_CLASSW, NULL, WS_POPUP | TTS_NOPREFIX | TTS_ALWAYSTIP,
+                                        0, 0, 0, 0, m_hWnd, NULL, hExplorerInstance, NULL);
+        }
+        m_bLight = pLook ? pLook(m_hWnd) : FALSE;
+        ArcticSetWindowAttribute(m_hWnd, DWMWA_ARCTIC_TRANSITION, &dwTransition, sizeof(dwTransition));
+        ArcticSetWindowAttribute(m_hWnd, 33 /* DWMWA_WINDOW_CORNER_PREFERENCE */, &dwCorner, sizeof(dwCorner));
+        m_hot = m_pressed = -1;
+        Collect();
+        Place();
+        ShowWindow(SW_SHOW);
+        ::SetForegroundWindow(m_hWnd);
+        Invalidate();
+        m_pChevron->SetOpen(TRUE);
+    }
+
+    VOID Close()
+    {
+        if (!IsOpen())
+            return;
+        ShowWindow(SW_HIDE);
+        m_dwClosed = GetTickCount();
+        m_pChevron->SetOpen(FALSE);
+    }
+
+    /* the icons changed while it is open */
+    VOID Refresh()
+    {
+        if (!IsOpen())
+            return;
+        m_hot = m_pressed = -1;
+        Collect();
+        Place();
+        Invalidate();
+    }
+
+    /* an icon let go here: the toolbar's index of the one it goes before, -1 after them all */
+    int IndexAt(POINT ptScreen)
+    {
+        int hit;
+
+        ScreenToClient(&ptScreen);
+        hit = HitTest(ptScreen);
+        return hit >= 0 ? m_indices[hit] : -1;
+    }
+
+    LRESULT OnPaint(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        PAINTSTRUCT ps;
+        HDC hdcWnd = BeginPaint(&ps), hdc = CreateCompatibleDC(hdcWnd);
+        BITMAPINFO bi = {{sizeof(bi.bmiHeader), 0, 0, 1, 32, BI_RGB}};
+        void *pvBits;
+        HBITMAP hbm;
+        RECT rc;
+
+        GetClientRect(&rc);
+        bi.bmiHeader.biWidth = rc.right;
+        bi.bmiHeader.biHeight = -rc.bottom;
+        if ((hbm = CreateDIBSection(hdcWnd, &bi, DIB_RGB_COLORS, &pvBits, NULL, 0)))
+        {
+            HGDIOBJ hOld = SelectObject(hdc, hbm);
+            int cxIcon = GetSystemMetrics(SM_CXSMICON), cyIcon = GetSystemMetrics(SM_CYSMICON);
+
+            FillRect(hdc, &rc, (HBRUSH)GetStockObject(m_bLight ? WHITE_BRUSH : BLACK_BRUSH));
+            for (int i = 0; i < m_count; i++)
+            {
+                RECT rcCell;
+
+                CellRect(i, &rcCell);
+                if (i == m_hot || i == m_pressed)
+                {
+                    if (ArcticTaskbarStyle11())
+                        ArcticTaskbarPaintButton(hdc, &rcCell, ARCTIC_BUTTON_START |
+                                                 (i == m_pressed ? ARCTIC_BUTTON_PRESSED : ARCTIC_BUTTON_HOT));
+                    else
+                        ArcticFillAlpha(hdc, &rcCell, ARCTIC_INK(m_bLight), i == m_pressed ? 0x26 : 0x1a);
+                }
+                m_pToolbar->DrawIcon(m_indices[i], hdc, (rcCell.left + rcCell.right - cxIcon) / 2,
+                                     (rcCell.top + rcCell.bottom - cyIcon) / 2);
+            }
+            BitBlt(hdcWnd, 0, 0, rc.right, rc.bottom, hdc, 0, 0, SRCCOPY);
+            SelectObject(hdc, hOld);
+            DeleteObject(hbm);
+        }
+        DeleteDC(hdc);
+        EndPaint(&ps);
+        return 0;
+    }
+
+    LRESULT OnEraseBkgnd(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        return 1;
+    }
+
+    LRESULT OnMouse(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        POINT pt = { GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
+        int hit = HitTest(pt);
+
+        switch (uMsg)
+        {
+        case WM_MOUSEMOVE:
+        {
+            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, m_hWnd, 0 };
+
+            TrackMouseEvent(&tme);
+            if (m_pressed >= 0 && (abs(pt.x - m_ptPressed.x) > GetSystemMetrics(SM_CXDRAG) ||
+                                   abs(pt.y - m_ptPressed.y) > GetSystemMetrics(SM_CYDRAG)))
+            {
+                int index = m_indices[m_pressed];
+
+                m_pressed = -1;
+                if (GetCapture() == m_hWnd)
+                    ReleaseCapture();
+                Invalidate();
+                ::SendMessageW(m_hwndPager, SPM_BEGINDRAG, index, 0);
+                return 0;
+            }
+            if (hit != m_hot)
+            {
+                m_hot = hit;
+                Invalidate();
+            }
+            break;
+        }
+        case WM_LBUTTONDOWN:
+            m_pressed = hit;
+            m_ptPressed = pt;
+            SetCapture();
+            Invalidate();
+            break;
+        case WM_LBUTTONUP:
+            m_pressed = -1;
+            if (GetCapture() == m_hWnd)
+                ReleaseCapture();
+            Invalidate();
+            break;
+        }
+        if (hit >= 0)
+            m_pToolbar->IconMouse(m_indices[hit], uMsg);
+        return 0;
+    }
+
+    LRESULT OnMouseLeave(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        m_hot = -1;
+        Invalidate();
+        return 0;
+    }
+
+    LRESULT OnActivate(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        if (LOWORD(wParam) == WA_INACTIVE)
+            Close();
+        return 0;
+    }
+
+    LRESULT OnKeyDown(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        if (wParam == VK_ESCAPE)
+            Close();
+        return 0;
+    }
+
+    BEGIN_MSG_MAP(CTrayOverflow)
+        MESSAGE_HANDLER(WM_PAINT, OnPaint)
+        MESSAGE_HANDLER(WM_ERASEBKGND, OnEraseBkgnd)
+        MESSAGE_RANGE_HANDLER(WM_MOUSEFIRST, WM_MOUSELAST, OnMouse)
+        MESSAGE_HANDLER(WM_MOUSELEAVE, OnMouseLeave)
+        MESSAGE_HANDLER(WM_ACTIVATE, OnActivate)
+        MESSAGE_HANDLER(WM_KEYDOWN, OnKeyDown)
+    END_MSG_MAP()
+};
+
 
