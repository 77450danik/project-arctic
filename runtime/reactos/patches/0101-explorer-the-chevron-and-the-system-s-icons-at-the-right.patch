 };
 
+/* Arctic: where an icon stands. Network, sound and power are the system's:
+ * always on the taskbar, at its right, in that order. A program's icon goes
+ * behind the chevron, as in Windows 10 and 11, until it is dragged out onto
+ * the taskbar; an icon can be dragged there and back and among the others
+ * (HKCU\Software\Arctic\Tray: OnTaskbar and Order, by the program's file). */
+#define ARCTIC_TRAY_KEY     L"Software\\Arctic\\Tray\\OnTaskbar"
+#define ARCTIC_ORDER_KEY    L"Software\\Arctic\\Tray\\Order"
+#define ARCTIC_ORDER_NONE   0x7fffffff
+#define SPM_BEGINDRAG       (WM_USER + 0x122)
+#define SPM_ICONSCHANGED    (WM_USER + 0x120)
+#define SPM_CHEVRONCLICK    (WM_USER + 0x121)
+#define ARCTIC_CHEVRON      ArcticDpiScale(24)
+
+static INT ArcticIconRank(HWND hwnd)
+{
+    WCHAR szClass[32];
+
+    if (!GetClassNameW(hwnd, szClass, _countof(szClass)))
+        return 0;
+    if (!wcscmp(szClass, L"PniduiTray"))
+        return 1;
+    if (!wcscmp(szClass, L"ArcticVolumeTray"))
+        return 2;
+    if (!wcscmp(szClass, L"ArcticBatteryTray"))
+        return 3;
+    return 0;
+}
+
+/* the file of the program an icon belongs to; FALSE for the shell's own */
+static BOOL ArcticIconProgram(HWND hwnd, LPWSTR pszName, DWORD cchName)
+{
+    typedef BOOL (WINAPI *PFN_QUERY)(HANDLE, DWORD, LPWSTR, PDWORD);
+    PFN_QUERY pQuery = (PFN_QUERY)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "QueryFullProcessImageNameW");
+    WCHAR szPath[MAX_PATH];
+    DWORD pid = 0, cch = _countof(szPath);
+    HANDLE hProcess;
+    BOOL ok = FALSE;
+
+    if (!pQuery || !GetWindowThreadProcessId(hwnd, &pid) || pid == GetCurrentProcessId())
+        return FALSE;
+    if ((hProcess = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid)))
+    {
+        ok = pQuery(hProcess, 0, szPath, &cch);
+        CloseHandle(hProcess);
+    }
+    if (ok)
+        StringCchCopyW(pszName, cchName, PathFindFileNameW(szPath));
+    return ok;
+}
+
+static BOOL ArcticIconOnTaskbar(HWND hwnd)
+{
+    WCHAR szName[MAX_PATH];
+    DWORD dwValue = 0, cb = sizeof(dwValue);
+
+    if (!ArcticIconProgram(hwnd, szName, _countof(szName)))
+        return TRUE;
+    return !RegGetValueW(HKEY_CURRENT_USER, ARCTIC_TRAY_KEY, szName, RRF_RT_REG_DWORD, NULL, &dwValue, &cb) && dwValue;
+}
+
+static INT ArcticIconOrder(HWND hwnd)
+{
+    WCHAR szName[MAX_PATH];
+    DWORD dwValue = 0, cb = sizeof(dwValue);
+
+    if (!ArcticIconProgram(hwnd, szName, _countof(szName)) ||
+        RegGetValueW(HKEY_CURRENT_USER, ARCTIC_ORDER_KEY, szName, RRF_RT_REG_DWORD, NULL, &dwValue, &cb))
+        return ARCTIC_ORDER_NONE;
+    return (INT)dwValue;
+}
+
+static VOID ArcticIconRemember(HWND hwnd, BOOL bOnTaskbar)
+{
+    WCHAR szName[MAX_PATH];
+    DWORD dwValue = bOnTaskbar;
+    HKEY hKey;
+
+    if (!ArcticIconProgram(hwnd, szName, _countof(szName)))
+        return;
+    if (!RegCreateKeyExW(HKEY_CURRENT_USER, ARCTIC_TRAY_KEY, 0, NULL, 0, KEY_SET_VALUE, NULL, &hKey, NULL))
+    {
+        RegSetValueExW(hKey, szName, 0, REG_DWORD, (const BYTE *)&dwValue, sizeof(dwValue));
+        RegCloseKey(hKey);
+    }
+}
