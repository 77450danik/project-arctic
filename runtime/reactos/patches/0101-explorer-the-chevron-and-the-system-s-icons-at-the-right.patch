+/* Arctic: an icon went behind the chevron or came out */
+LRESULT CSysPagerWnd::OnIconsChanged(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+{
+    NMHDR nmh = {GetParent(), 0, NTNWM_REALIGN};
+
+    GetParent().SendMessage(WM_NOTIFY, 0, (LPARAM) &nmh);
+
+    /* the same width may hold other icons: they are laid out anyway */
+    RECT rc;
+    GetClientRect(&rc);
+    SIZE szClient = { rc.right, rc.bottom };
+    LayoutChildren(szClient);
+    m_Overflow.Refresh();
+    return 0;
+}
+
+/* Arctic: an icon is carried under the pointer until it is let go: behind
+ * the chevron, which opens when the pointer comes to it, or onto the taskbar */
+LRESULT CSysPagerWnd::OnBeginDrag(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+{
+    InternalIconData *data = Toolbar.GetItemData((int)wParam);
+    HWND hwndIcon = data->hWnd;
+    UINT uID = data->uID;
+    HICON hIcon = Toolbar.CopyIcon((int)wParam);
+    BOOL bDropped = FALSE;
+    POINT pt;
+    MSG msg;
+
+    SetCapture();
+    if (hIcon)
+        SetCursor(hIcon);
+    while (GetCapture() == m_hWnd && GetMessageW(&msg, NULL, 0, 0))
+    {
+        if (msg.message == WM_KEYDOWN && msg.wParam == VK_ESCAPE)
+            break;
+        if (msg.message == WM_LBUTTONUP)
+        {
+            bDropped = TRUE;
+            break;
+        }
+        if (msg.message == WM_MOUSEMOVE)
+        {
+            RECT rcChevron;
+
+            if (hIcon)
+                SetCursor(hIcon);
+            GetCursorPos(&pt);
+            m_Chevron.GetWindowRect(&rcChevron);
+            if (PtInRect(&rcChevron, pt) && !m_Overflow.IsOpen())
+                m_Overflow.Open(&Toolbar, &m_Chevron, m_hWnd);
+            continue;
+        }
+        if (msg.message >= WM_MOUSEFIRST && msg.message <= WM_MOUSELAST)
+            continue;
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+    if (GetCapture() == m_hWnd)
+        ReleaseCapture();
+    SetCursor(LoadCursorW(NULL, IDC_ARROW));
+    if (hIcon)
+        DestroyIcon(hIcon);
+
+    int index = Toolbar.FindItem(hwndIcon, uID, NULL);
+
+    if (bDropped && index >= 0)
+    {
+        RECT rcFlyout, rcTaskbar;
+
+        GetCursorPos(&pt);
+        ::GetWindowRect(GetAncestor(m_hWnd, GA_ROOT), &rcTaskbar);
+        if (m_Overflow.IsOpen() && m_Overflow.GetWindowRect(&rcFlyout) && PtInRect(&rcFlyout, pt))
+            Toolbar.PlaceIcon(index, TRUE, m_Overflow.IndexAt(pt));
+        else if (PtInRect(&rcTaskbar, pt))
+            Toolbar.PlaceIcon(index, FALSE, Toolbar.IndexBefore(pt));
+        BOOL bUnused = FALSE;
+        OnIconsChanged(0, 0, 0, bUnused);
+    }
+    return 0;
+}
+
+LRESULT CSysPagerWnd::OnChevronClick(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+{
+    /* the click that took the focus away has just closed it */
+    if (m_Overflow.IsOpen())
+        m_Overflow.Close();
+    else if (GetTickCount() - m_Overflow.ClosedAt() > 200)
+        m_Overflow.Open(&Toolbar, &m_Chevron, m_hWnd);
+    return 0;
+}
