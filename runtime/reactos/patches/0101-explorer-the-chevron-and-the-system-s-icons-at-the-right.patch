+/* Arctic: the toolbar's commands are its indices (CSysPagerWnd::OnCommand) */
+VOID CNotifyToolbar::RenumberButtons()
+{
+    int count = GetButtonCount();
+
+    for (int i = 0; i < count; i++)
+    {
+        TBBUTTONINFO tbbi = { 0 };
+
+        tbbi.cbSize = sizeof(tbbi);
+        tbbi.dwMask = TBIF_BYINDEX | TBIF_COMMAND;
+        tbbi.idCommand = i;
+        SetButtonInfo(i, &tbbi);
+    }
+}
+
+int CNotifyToolbar::GetOverflow(int *pIndices, int cMax)
+{
+    int count = GetButtonCount(), n = 0;
+
+    for (int i = 0; i < count; i++)
+    {
+        InternalIconData *data = GetItemData(i);
+
+        if (!data->bOverflow || (data->dwState & NIS_HIDDEN))
+            continue;
+        if (pIndices && n < cMax)
+            pIndices[n] = i;
+        n++;
+    }
+    return pIndices ? min(n, cMax) : n;
+}
+
+VOID CNotifyToolbar::DrawIcon(int index, HDC hdc, int x, int y)
+{
+    TBBUTTON btn;
+
+    if (GetButton(index, &btn) && btn.iBitmap >= 0)
+        ImageList_Draw(m_ImageList, btn.iBitmap, hdc, x, y, ILD_TRANSPARENT);
+}
+
+/* what a click on the icon in the taskbar sends */
+VOID CNotifyToolbar::IconMouse(int index, UINT uMsg)
+{
+    InternalIconData *data = GetItemData(index);
+    BOOL bNew = ::IsWindow(data->hWnd) && data->GetVersion() >= NOTIFYICON_VERSION;
+    HWND hWnd = data->hWnd;
+    UINT uCallback = data->uCallbackMessage, uID = data->uID;
+
+    SendMouseEvent((WORD)index, uMsg, 0);
+    if (bNew && uMsg == WM_LBUTTONUP)
+        ::SendNotifyMessage(hWnd, uCallback, uID, NIN_SELECT);
+    else if (bNew && uMsg == WM_RBUTTONUP)
+        ::SendNotifyMessage(hWnd, uCallback, uID, WM_CONTEXTMENU);
+}
+
+/* where the user put the programs' icons, for the next time they come */
+VOID CNotifyToolbar::SaveOrder()
+{
+    int count = GetButtonCount(), n = 0;
+    HKEY hKey;
+
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, ARCTIC_ORDER_KEY, 0, NULL, 0, KEY_SET_VALUE, NULL, &hKey, NULL))
+        return;
+    for (int i = 0; i < count; i++)
+    {
+        InternalIconData *data = GetItemData(i);
+        WCHAR szName[MAX_PATH];
+        DWORD dwValue = n;
+
+        if (data->nRank)
+            continue;
+        data->nOrder = n++;
+        if (ArcticIconProgram(data->hWnd, szName, _countof(szName)))
+            RegSetValueExW(hKey, szName, 0, REG_DWORD, (const BYTE *)&dwValue, sizeof(dwValue));
+    }
+    RegCloseKey(hKey);
+}
+
+/* behind the chevron or on the taskbar, before the icon of that index or after all the programs' */
+VOID CNotifyToolbar::PlaceIcon(int from, BOOL bOverflow, int before)
+{
+    int count = GetButtonCount(), to = before;
+
+    SetOverflow(from, bOverflow);
+    if (to < 0)
+    {
+        for (to = 0; to < count && !GetItemData(to)->nRank; to++)
+            ;
+    }
+    if (to > from)
+        to--;
+    if (to != from)
+    {
+        SendMessageW(TB_MOVEBUTTON, from, to);
+        RenumberButtons();
+    }
+    SaveOrder();
+    Invalidate();
+}
+
+HICON CNotifyToolbar::CopyIcon(int index)
+{
+    TBBUTTON btn;
+
+    return GetButton(index, &btn) && btn.iBitmap >= 0 ? ImageList_GetIcon(m_ImageList, btn.iBitmap, ILD_TRANSPARENT) : NULL;
+}
+
+/* let go on the taskbar: the program's icon on it that this goes before, -1 after them all */
+int CNotifyToolbar::IndexBefore(POINT ptScreen)
+{
+    int count = GetButtonCount();
+
+    ScreenToClient(&ptScreen);
+    for (int i = 0; i < count; i++)
+    {
+        InternalIconData *data = GetItemData(i);
+        RECT rc;
+
+        if (data->nRank || data->bOverflow || (data->dwState & NIS_HIDDEN) || !GetItemRect(i, &rc))
+            continue;
+        if (ptScreen.x < (rc.left + rc.right) / 2)
+            return i;
+    }
+    return -1;
+}
+
+VOID CNotifyToolbar::SetOverflow(int index, BOOL bOverflow)
+{
+    InternalIconData *data = GetItemData(index);
+    TBBUTTONINFO tbbi = { 0 };
+    TBBUTTON btn;
+
+    if (data->nRank || data->bOverflow == bOverflow || !GetButton(index, &btn))
+        return;
+    data->bOverflow = bOverflow;
+    tbbi.cbSize = sizeof(tbbi);
+    tbbi.dwMask = TBIF_BYINDEX | TBIF_STATE;
+    if (bOverflow || (data->dwState & NIS_HIDDEN))
+        tbbi.fsState = btn.fsState | TBSTATE_HIDDEN;
+    else
+        tbbi.fsState = btn.fsState & ~TBSTATE_HIDDEN;
+    SetButtonInfo(index, &tbbi);
+    if (!(data->dwState & NIS_HIDDEN))
+        m_VisibleButtonCount += bOverflow ? -1 : 1;
+    ArcticIconRemember(data->hWnd, !bOverflow);
+}
