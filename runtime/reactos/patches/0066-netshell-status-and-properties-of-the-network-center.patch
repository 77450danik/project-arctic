+/* Arctic: the status and the properties of a connection are Windows 7's,
+ * those of the Network and Sharing Center (netcenter.dll): Windows' dialogs
+ * with IPv4, IPv6 and DNS that the host applies */
+static HRESULT
+ShowNetCenterDialog(PCUITEMID_CHILD pidl, LPCWSTR pszEntry)
+{
+    PNETCONIDSTRUCT pdata = ILGetConnData(pidl);
+    WCHAR szGuid[40], szArgs[128];
+
+    if (!pdata || !StringFromGUID2(pdata->guidId, szGuid, _countof(szGuid)))
+        return E_FAIL;
+    _snwprintf(szArgs, _countof(szArgs), L"netcenter.dll,%s %s", pszEntry, szGuid);
+    szArgs[_countof(szArgs) - 1] = L'\0';
+    return (INT_PTR)ShellExecuteW(NULL, NULL, L"rundll32.exe", szArgs, NULL, SW_SHOWNORMAL) > 32 ? S_OK : E_FAIL;
+}
