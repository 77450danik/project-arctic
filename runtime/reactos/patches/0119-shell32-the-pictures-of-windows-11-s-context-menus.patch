+/* Arctic: a static verb's picture. The system's verbs have ours; then a
+   verb's own Icon value, as Windows shows it since 7; Open and Edit show the
+   program that does it, as in Windows 11 (a folder's is File Explorer) */
+BOOL CDefaultContextMenu::ArcticSetStaticIcon(HMENU hMenu, UINT uPos, const StaticShellEntry &Entry)
+{
+    LPCSTR pszPicture = SHELL_MenuPictureOfVerb(Entry.Verb);
+    if (pszPicture && _wcsicmp(Entry.Verb, L"open") && _wcsicmp(Entry.Verb, L"edit"))
+        return SHELL_SetMenuIcon(hMenu, uPos, TRUE, pszPicture);
+
+    CStringW strKey = L"shell\\" + Entry.Verb;
+    WCHAR szValue[MAX_PATH * 2];
+    DWORD cb = sizeof(szValue);
+    if (RegGetValueW(Entry.hkClass, strKey, L"Icon", RRF_RT_REG_SZ, NULL, szValue, &cb) == ERROR_SUCCESS &&
+        SHELL_SetMenuIconLocation(hMenu, uPos, TRUE, szValue))
+    {
+        return TRUE;
+    }
+
+    BOOL bOpen = !_wcsicmp(Entry.Verb, L"open"), bEdit = !_wcsicmp(Entry.Verb, L"edit");
+    if (!bOpen && !bEdit && _wcsicmp(Entry.Verb, L"play"))
+        return FALSE;
+
+    WCHAR szExe[MAX_PATH] = L"";
+    cb = sizeof(szValue);
+    if (RegGetValueW(Entry.hkClass, strKey + L"\\command", NULL, RRF_RT_REG_SZ, NULL, szValue, &cb) == ERROR_SUCCESS)
+    {
+        LPCWSTR p = szValue;
+        while (*p == L' ')
+            p++;
+        /* the item runs itself ("%1"): its own icon */
+        if ((!wcsncmp(p, L"\"%1\"", 4) || !wcsncmp(p, L"%1", 2)) && m_cidl == 1)
+        {
+            STRRET strret;
+            if (SUCCEEDED(m_psf->GetDisplayNameOf(m_apidl[0], SHGDN_FORPARSING, &strret)) &&
+                SUCCEEDED(StrRetToBufW(&strret, m_apidl[0], szExe, _countof(szExe))) &&
+                SHELL_SetMenuIconFile(hMenu, uPos, TRUE, szExe, 0))
+            {
+                return TRUE;
+            }
+            szExe[0] = 0;
+        }
+        else
+        {
+            SHELL_ProgramOfCommand(szValue, szExe, _countof(szExe));
+        }
+    }
+    if (!szExe[0] && bOpen && m_cidl)
+    {
+        SFGAOF att = SFGAO_FOLDER;
+        if (SUCCEEDED(m_psf->GetAttributesOf(1, m_apidl, &att)) && (att & SFGAO_FOLDER))
+            if (GetWindowsDirectoryW(szExe, _countof(szExe)))
+                PathAppendW(szExe, L"explorer.exe");
+    }
+    /* what File Explorer opens shows a folder */
+    if (szExe[0] && !_wcsicmp(PathFindFileNameW(szExe), L"explorer.exe"))
+        return SHELL_SetMenuIcon(hMenu, uPos, TRUE, "folder");
+    if (szExe[0] && SHELL_SetMenuIconFile(hMenu, uPos, TRUE, szExe, 0))
+        return TRUE;
+    return SHELL_SetMenuIcon(hMenu, uPos, TRUE, bEdit ? "edit" : "open");
+}
+
+/* Arctic: every item of the system gets the picture Windows 11 gives it:
+   static verbs by their name, the handlers' items by theirs (Copy as path,
+   Move to...), the default part (Cut, Copy...) by its own, and the folder's
+   own items (Properties, Format, Eject) by their text */
+void CDefaultContextMenu::ArcticSetIcons(HMENU hMenu, UINT idCmdFirst, UINT cIds)
+{
+    if (!SHELL_MenuIconsWanted())
+        return;
+
+    static const struct { UINT ids; LPCSTR pszPicture; } CallbackItems[] =
+    {
+        { IDS_PROPERTIES,  "properties" },
+        { IDS_FORMATDRIVE, "format" },
+        { IDS_EJECT,       "eject" },
+        { IDS_DISCONNECT,  "unmapdrive" },
+    };
+
+    int count = GetMenuItemCount(hMenu);
+    for (int pos = 0; pos < count; pos++)
+    {
+        UINT id = GetMenuItemID(hMenu, pos);
+        if (id == (UINT)-1 || id < idCmdFirst || id - idCmdFirst >= cIds)
+            continue;
+        UINT offset = id - idCmdFirst;
+
+        if (!m_StaticEntries.IsEmpty() && offset >= m_iIdSCMFirst && offset < m_iIdSCMLast)
+        {
+            POSITION it = m_StaticEntries.FindIndex(offset - m_iIdSCMFirst);
+            if (it)
+                ArcticSetStaticIcon(hMenu, pos, m_StaticEntries.GetAt(it));
+            continue;
+        }
+
+        if (m_iIdCBFirst != m_iIdCBLast && offset >= m_iIdCBFirst && offset < m_iIdCBLast)
+        {
+            WCHAR szText[128], szItem[128];
+            if (!GetMenuStringW(hMenu, pos, szItem, _countof(szItem), MF_BYPOSITION))
+                continue;
+            for (UINT i = 0; i < _countof(CallbackItems); i++)
+            {
+                if (LoadStringW(shell32_hInstance, CallbackItems[i].ids, szText, _countof(szText)) &&
+                    !wcscmp(szText, szItem))
+                {
+                    SHELL_SetMenuIcon(hMenu, pos, TRUE, CallbackItems[i].pszPicture);
+                    break;
+                }
+            }
+            continue;
+        }
+
+        WCHAR szVerb[MAX_VERB] = L"";
+        if (SUCCEEDED(GetCommandString(offset, GCS_VERBW, NULL, (LPSTR)szVerb, _countof(szVerb))) && szVerb[0])
+        {
+            if (LPCSTR pszPicture = SHELL_MenuPictureOfVerb(szVerb))
+                SHELL_SetMenuIcon(hMenu, pos, TRUE, pszPicture);
+        }
+    }
+}
