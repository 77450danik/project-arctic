+            { FCIDM_SHVIEW_SMALLICON,       "viewsmall" },
+            { FCIDM_SHVIEW_LISTVIEW,        "viewlist" },
+            { FCIDM_SHVIEW_REPORTVIEW,      "viewdetails" },
+            { FCIDM_SHVIEW_TILEVIEW,        "viewtiles" },
+            { FCIDM_SHVIEW_DESKICON_LARGE,  "viewlarge" },
+            { FCIDM_SHVIEW_DESKICON_MEDIUM, "viewmedium" },
+            { FCIDM_SHVIEW_DESKICON_SMALL,  "viewsmall" },
+            { FCIDM_SHVIEW_AUTOARRANGE,     "autoarrange" },
+            { FCIDM_SHVIEW_ALIGNTOGRID,     "aligngrid" },
+        };
+        for (UINT i = 0; i < _countof(Pictures); i++)
+            SHELL_SetMenuIcon(hMenu, Pictures[i].id, FALSE, Pictures[i].pszPicture);
     }
