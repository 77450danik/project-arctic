+/* Arctic: an applet named in "don't load" is not listed, as in Windows: it
+ * opens something the Control Panel lists otherwise (powercfg.cpl, the Power
+ * Options folder of powercpl.dll) */
+static BOOL CPanel_DontLoad(LPCWSTR pszFileName)
+{
+    static const WCHAR szKey[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Control Panel\\don't load";
+    HKEY hKey;
+    BOOL bSkip = FALSE;
+
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, szKey, 0, KEY_READ, &hKey) == ERROR_SUCCESS)
+    {
+        bSkip = RegQueryValueExW(hKey, pszFileName, NULL, NULL, NULL, NULL) == ERROR_SUCCESS;
+        RegCloseKey(hKey);
+    }
+    if (!bSkip && RegOpenKeyExW(HKEY_CURRENT_USER, szKey, 0, KEY_READ, &hKey) == ERROR_SUCCESS)
+    {
+        bSkip = RegQueryValueExW(hKey, pszFileName, NULL, NULL, NULL, NULL) == ERROR_SUCCESS;
+        RegCloseKey(hKey);
+    }
+    return bSkip;
+}
