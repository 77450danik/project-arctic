+/* Windows 11's notification center over its calendar (startui.dll): the
+ * clock opens it, and every notification goes there */
+BOOL ArcticClockFlyoutToggle(IN HWND hwndTray, IN const RECT *prcClock)
+{
+    typedef VOID (WINAPI *PFN_TOGGLE)(HWND, const RECT *);
+    PFN_TOGGLE pToggle = (PFN_TOGGLE)ArcticProc(L"startui.dll", "ArcticClockFlyoutToggle");
+
+    if (!pToggle)
+        return FALSE;
+    pToggle(hwndTray, prcClock);
+    return TRUE;
+}
+
+VOID ArcticNotificationAdd(IN LPCWSTR pszApp, IN LPCWSTR pszIcon, IN HICON hIcon, IN LPCWSTR pszTitle,
+                           IN LPCWSTR pszText, IN HWND hwndReply, IN UINT uMsg, IN WPARAM wParam, IN LPARAM lParam)
+{
+    typedef VOID (WINAPI *PFN_ADD)(LPCWSTR, LPCWSTR, HICON, LPCWSTR, LPCWSTR, HWND, UINT, WPARAM, LPARAM);
+    PFN_ADD pAdd = (PFN_ADD)ArcticProc(L"startui.dll", "ArcticNotificationAdd");
+
+    if (pAdd)
+        pAdd(pszApp, pszIcon, hIcon, pszTitle, pszText, hwndReply, uMsg, wParam, lParam);
+}
+
+/* Do not disturb: notifications go to the notification center only */
+BOOL ArcticNotificationsQuiet(VOID)
+{
+    typedef BOOL (WINAPI *PFN_QUIET)(VOID);
+    PFN_QUIET pQuiet = (PFN_QUIET)ArcticProc(L"startui.dll", "ArcticNotificationsQuiet");
+
+    return pQuiet && pQuiet();
+}
+
 /* the shell's flyouts and toasts draw dark on white */
