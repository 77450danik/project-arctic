+/* Arctic: as in Windows 11, a click opens the notification center over the
+ * calendar (startui.dll), and another one closes them. The Date and Time
+ * page opens from the calendar's date, or where startui.dll is missing. */
 LRESULT CTrayClockWnd::OnLButtonDblClick(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
 {
-    if (IsWindowVisible())
-    {
-        ShellExecuteW(m_hWnd, NULL, L"timedate.cpl", NULL, NULL, SW_NORMAL);
-    }
+    return TRUE;
+}
+
+/* Arctic: the time or the time zone changed (the Date and Time page): the
+ * clock shows the new time at once, not at the next minute */
+LRESULT CTrayClockWnd::OnTimeChange(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+{
+    ResetTime();
+    Update();
+    return 0;
+}
+
+LRESULT CTrayClockWnd::OnLButtonUp(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+{
+    RECT rcClock;
+
+    if (!IsWindowVisible())
+        return TRUE;
+    GetWindowRect(&rcClock);
+    if (!ArcticClockFlyoutToggle(GetAncestor(m_hWnd, GA_ROOT), &rcClock))
+        ShellExecuteW(m_hWnd, NULL, L"control.exe", L"timedate.cpl", NULL, SW_NORMAL);
     return TRUE;
 }
 
