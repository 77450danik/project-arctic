+/* Arctic: a wireless connection is told by its interface type */
+static BOOL
+IsWirelessConnection(const GUID *pGuid)
+{
+    IP_ADAPTER_INFO *pAdapterInfo, *pAdapter;
+    WCHAR szGuid[50];
+    GUID guid;
+    MIB_IFROW IfEntry;
+    DWORD dwSize = 0;
+    BOOL bWireless = FALSE;
+
+    if (GetAdaptersInfo(NULL, &dwSize) != ERROR_BUFFER_OVERFLOW)
+        return FALSE;
+    pAdapterInfo = static_cast<PIP_ADAPTER_INFO>(CoTaskMemAlloc(dwSize));
+    if (!pAdapterInfo)
+        return FALSE;
+    if (GetAdaptersInfo(pAdapterInfo, &dwSize) == NO_ERROR)
+    {
+        for (pAdapter = pAdapterInfo; pAdapter; pAdapter = pAdapter->Next)
+        {
+            if (!MultiByteToWideChar(CP_ACP, 0, pAdapter->AdapterName, -1, szGuid, _countof(szGuid)) ||
+                FAILED(CLSIDFromString(szGuid, &guid)) || !IsEqualGUID(guid, *pGuid))
+                continue;
+            ZeroMemory(&IfEntry, sizeof(IfEntry));
+            IfEntry.dwIndex = pAdapter->Index;
+            bWireless = GetIfEntry(&IfEntry) == NO_ERROR && IfEntry.dwType == IF_TYPE_IEEE80211;
+            break;
+        }
+    }
+    CoTaskMemFree(pAdapterInfo);
+    return bWireless;
+}
