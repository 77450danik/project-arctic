+static PWSTR
+DuplicateString(LPCWSTR pszSource)
+{
+    PWSTR pszCopy = static_cast<PWSTR>(CoTaskMemAlloc((wcslen(pszSource) + 1) * sizeof(WCHAR)));
+    if (pszCopy)
+        wcscpy(pszCopy, pszSource);
+    return pszCopy;
+}
