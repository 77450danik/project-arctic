+static VOID
+DefaultConnectionName(UINT uResId, UINT uNumber, LPWSTR pszName, UINT cchName)
+{
+    WCHAR szBase[100];
+
+    if (!LoadStringW(netshell_hInstance, uResId, szBase, _countof(szBase)))
+        szBase[0] = L'\0';
+    if (uNumber > 1)
+        _snwprintf(pszName, cchName, L"%s %u", szBase, uNumber);
+    else
+        _snwprintf(pszName, cchName, L"%s", szBase);
+    pszName[cchName - 1] = L'\0';
+}
