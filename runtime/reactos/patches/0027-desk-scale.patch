+/* Arctic: the scale of the monitor, "the size of text, apps and other items"
+ * of Windows 10, read and set as Windows' Settings do it, with the types of
+ * DisplayConfigGet/SetDeviceInfo it does not document; a choice applies at
+ * once, without a restart. The functions come from user32 at run time. */
+static const INT ScaleSteps[] = { 100, 125, 150, 175, 200, 225, 250, 300, 350, 400, 450, 500 };
+
+/* the layouts of Windows 7's display configuration, which the headers here
+   keep for later versions */
+typedef struct
+{
+    INT32 type;
+    UINT32 size;
+    LUID adapterId;
+    UINT32 id;
+} DC_HEADER;
+
+typedef struct
+{
+    LUID adapterId;
+    UINT32 id;
+    UINT32 modeInfoIdx;
+    UINT32 statusFlags;
+} DC_PATH_SOURCE_INFO;
+
+typedef struct
+{
+    DC_PATH_SOURCE_INFO sourceInfo;
+    BYTE targetInfo[48];
+    UINT32 flags;
+} DC_PATH_INFO;
+
+typedef struct
+{
+    BYTE data[64];
+} DC_MODE_INFO;
+
+typedef struct
+{
+    DC_HEADER header;
+    WCHAR viewGdiDeviceName[32];
+} DC_SOURCE_NAME;
+
+#define DC_QDC_ONLY_ACTIVE_PATHS  2
+#define DC_GET_SOURCE_NAME        1
+#define DC_GET_SOURCE_DPI_SCALE   (-3)
+#define DC_SET_SOURCE_DPI_SCALE   (-4)
+
+typedef struct
+{
+    DC_HEADER header;
+    INT32 minRel, curRel, maxRel;
+} SCALE_GET;
+
+typedef struct
+{
+    DC_HEADER header;
+    INT32 rel;
+} SCALE_SET;
+
+typedef LONG (WINAPI *PFN_QUERYDISPLAYCONFIG)(UINT32, UINT32 *, DC_PATH_INFO *, UINT32 *, DC_MODE_INFO *, PVOID);
+typedef LONG (WINAPI *PFN_DISPLAYCONFIGDEVICEINFO)(DC_HEADER *);
+
+static FARPROC
+User32Proc(LPCSTR Name)
+{
+    return GetProcAddress(GetModuleHandleW(L"user32.dll"), Name);
+}
+
+/* the adapter and the source of a display as \\.\DISPLAYn */
+static BOOL
+FindDisplaySource(IN LPCWSTR DeviceName, OUT LUID *pAdapter, OUT UINT32 *pId)
+{
+    PFN_QUERYDISPLAYCONFIG pQuery = (PFN_QUERYDISPLAYCONFIG)User32Proc("QueryDisplayConfig");
+    PFN_DISPLAYCONFIGDEVICEINFO pGet = (PFN_DISPLAYCONFIGDEVICEINFO)User32Proc("DisplayConfigGetDeviceInfo");
+    DC_PATH_INFO paths[16];
+    DC_MODE_INFO modes[32];
+    UINT32 nPaths = _countof(paths), nModes = _countof(modes), i;
+
+    if (!pQuery || !pGet) return FALSE;
+    if (pQuery(DC_QDC_ONLY_ACTIVE_PATHS, &nPaths, paths, &nModes, modes, NULL) != ERROR_SUCCESS) return FALSE;
+    for (i = 0; i < nPaths; i++)
+    {
+        DC_SOURCE_NAME name;
+
+        ZeroMemory(&name, sizeof(name));
+        name.header.type = DC_GET_SOURCE_NAME;
+        name.header.size = sizeof(name);
+        name.header.adapterId = paths[i].sourceInfo.adapterId;
+        name.header.id = paths[i].sourceInfo.id;
+        if (pGet(&name.header) != ERROR_SUCCESS || _wcsicmp(name.viewGdiDeviceName, DeviceName)) continue;
+        *pAdapter = paths[i].sourceInfo.adapterId;
+        *pId = paths[i].sourceInfo.id;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static VOID
+FillScale(IN HWND hwndDlg, IN PDISPLAY_DEVICE_ENTRY pDeviceEntry)
+{
+    PFN_DISPLAYCONFIGDEVICEINFO pGet = (PFN_DISPLAYCONFIGDEVICEINFO)User32Proc("DisplayConfigGetDeviceInfo");
+    HWND hCombo = GetDlgItem(hwndDlg, IDC_SETTINGS_SCALE);
+    WCHAR szFormat[64], szText[64];
+    SCALE_GET get;
+    INT rec, rel;
+    LRESULT index;
+
+    if (!hCombo) return;
+    SendMessageW(hCombo, CB_RESETCONTENT, 0, 0);
+    ZeroMemory(&get, sizeof(get));
+    get.header.type = DC_GET_SOURCE_DPI_SCALE;
+    get.header.size = sizeof(get);
+    if (!pGet || !FindDisplaySource(pDeviceEntry->DeviceName, &get.header.adapterId, &get.header.id) ||
+        pGet(&get.header) != ERROR_SUCCESS)
+    {
+        EnableWindow(hCombo, FALSE);
+        return;
+    }
+    rec = -get.minRel;
+    for (rel = get.minRel; rel <= get.maxRel; rel++)
+    {
+        if (rec + rel < 0 || rec + rel >= (INT)_countof(ScaleSteps)) continue;
+        LoadStringW(hApplet, rel ? IDS_SCALE_PERCENT : IDS_SCALE_RECOMMENDED, szFormat, _countof(szFormat));
+        _snwprintf(szText, _countof(szText) - 1, szFormat, ScaleSteps[rec + rel]);
+        szText[_countof(szText) - 1] = 0;
+        index = SendMessageW(hCombo, CB_ADDSTRING, 0, (LPARAM)szText);
+        SendMessageW(hCombo, CB_SETITEMDATA, index, rel);
+        if (rel == get.curRel) SendMessageW(hCombo, CB_SETCURSEL, index, 0);
+    }
+    EnableWindow(hCombo, get.maxRel > get.minRel);
+}
+
+static VOID
+OnScaleChanged(IN HWND hwndDlg, IN PSETTINGS_DATA pData)
+{
+    PFN_DISPLAYCONFIGDEVICEINFO pSet = (PFN_DISPLAYCONFIGDEVICEINFO)User32Proc("DisplayConfigSetDeviceInfo");
+    LRESULT index = SendDlgItemMessageW(hwndDlg, IDC_SETTINGS_SCALE, CB_GETCURSEL, 0, 0);
+    SCALE_SET set;
+
+    if (!pSet || index == CB_ERR) return;
+    ZeroMemory(&set, sizeof(set));
+    set.header.type = DC_SET_SOURCE_DPI_SCALE;
+    set.header.size = sizeof(set);
+    if (!FindDisplaySource(pData->CurrentDisplayDevice->DeviceName, &set.header.adapterId, &set.header.id)) return;
+    set.rel = (INT32)SendDlgItemMessageW(hwndDlg, IDC_SETTINGS_SCALE, CB_GETITEMDATA, index, 0);
+    pSet(&set.header);
+}
+
