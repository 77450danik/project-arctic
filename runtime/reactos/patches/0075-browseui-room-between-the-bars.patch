From: 77450danik <ddziuba1@stu.vistula.edu.pl>
Date: Wed, 14 Oct 2026 12:00:00 +0200
Subject: [PATCH] browseui: Room between the title bar, the toolbar and the address bar.

The bands of Explorer's rebar were exactly as tall as their windows: the
toolbar's buttons touched the title bar and the address bar touched the
toolbar. Each band now has 3 pixels (at the system's scale) above and
below its window, which stays its own height in the middle of the band
(RBN_CHILDSIZE). The address band asked for 22 pixels at every scale; it
takes the height of its combo box in the system's font.
---
--- a/dll/win32/browseui/internettoolbar.cpp
+++ b/dll/win32/browseui/internettoolbar.cpp
@@ -27,6 +27,25 @@
 
 /* Arctic: a private command of CGID_PrivCITCommands (shellbrowser.cpp has it too) */
 #define ITID_ARCTIC_MENUWINDOW 0x7F01
+
+/* Arctic: the room above and below each band's window, so that the title
+   bar, the toolbar and the address bar do not stand edge to edge: 3 pixels
+   at 100 %, at the system's scale */
+static int ArcticBandPadding()
+{
+    static int padding = -1;
+
+    if (padding < 0)
+    {
+        HDC hdc = GetDC(NULL);
+        int dpi = hdc ? GetDeviceCaps(hdc, LOGPIXELSY) : 96;
+
+        if (hdc)
+            ReleaseDC(NULL, hdc);
+        padding = MulDiv(3, dpi, 96);
+    }
+    return padding;
+}
 
 #if 1
 
@@ -285,10 +304,11 @@
     wcsncpy(bandInfo.lpText, fDeskBandInfo.wszTitle, bandInfo.cch);
     bandInfo.hwndChild = fChildWindow;
     bandInfo.cxMinChild = fDeskBandInfo.ptMinSize.x;
-    bandInfo.cyMinChild = fDeskBandInfo.ptMinSize.y;
+    /* Arctic: room above and below the band's window (CInternetToolbar::OnChildSize) */
+    bandInfo.cyMinChild = fDeskBandInfo.ptMinSize.y + 2 * ArcticBandPadding();
     bandInfo.wID = fBandID;
-    bandInfo.cyChild = fDeskBandInfo.ptActual.y;
-    bandInfo.cyMaxChild = fDeskBandInfo.ptMaxSize.y;
+    bandInfo.cyChild = fDeskBandInfo.ptActual.y + 2 * ArcticBandPadding();
+    bandInfo.cyMaxChild = fDeskBandInfo.ptMaxSize.y ? fDeskBandInfo.ptMaxSize.y + 2 * ArcticBandPadding() : 0;
     bandInfo.cyIntegral = fDeskBandInfo.ptIntegral.y;
     bandInfo.cxIdeal = fDeskBandInfo.ptActual.x;
     bandInfo.lParam = reinterpret_cast<LPARAM>(static_cast<CDockSite*>(this));
@@ -1934,6 +1954,22 @@
 
     return FAILED_UNEXPECTEDLY(hResult) ? 0 : theResult;
 }
+/* Arctic: each band is taller than its window by ArcticBandPadding() above and
+   below (CDockSite::GetRBBandInfo); the window keeps its own height, in the
+   middle of the band */
+LRESULT CInternetToolbar::OnChildSize(UINT idControl, NMHDR *pNMHDR, BOOL &bHandled)
+{
+    NMREBARCHILDSIZE *childSize = reinterpret_cast<NMREBARCHILDSIZE *>(pNMHDR);
+    int padding = ArcticBandPadding();
+
+    if (childSize->rcChild.bottom - childSize->rcChild.top > 2 * padding)
+    {
+        childSize->rcChild.top += padding;
+        childSize->rcChild.bottom -= padding;
+    }
+    return 0;
+}
