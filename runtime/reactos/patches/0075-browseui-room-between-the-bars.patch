+/* Arctic: as tall as the combo box's selection field and its frame in the
+   system's font, at any scale (the window itself also holds its list) */
+static LONG ArcticAddressHeight(HWND hwnd)
+{
+    LRESULT field = SendMessageW(hwnd, CB_GETITEMHEIGHT, (WPARAM)-1, 0);
+
+    if (field == CB_ERR || field + 6 < 22)
+        return 22;
+    return (LONG)field + 6;
+}
