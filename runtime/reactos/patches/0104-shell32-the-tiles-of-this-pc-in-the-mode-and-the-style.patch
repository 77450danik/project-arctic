From: 77450danik <dnsystems@email.ua>
Date: Sun, 8 Nov 2026 12:00:00 +0200
Subject: [PATCH] shell32: The tiles of This PC in the mode and the style.

A selected tile was Windows 10's light blue in the dark mode as well, under
white text. Its colours follow the mode now; the bars of the drives are thin
and round with the style of Windows 11.
---
diff --git a/dll/win32/shell32/CDefView.cpp b/dll/win32/shell32/CDefView.cpp
index 05a9453..e360eb7 100644
--- a/dll/win32/shell32/CDefView.cpp
+++ b/dll/win32/shell32/CDefView.cpp
@@ -37,6 +37,7 @@ TODO:
 
 #include <atlwin.h>
 #include <ui/rosctrls.h>
+#include <uxtheme.h>
 
 WINE_DEFAULT_DEBUG_CHANNEL(shell);
 
@@ -4237,6 +4238,64 @@ HICON CDefView::TileIcon(int iImage, PCUITEMID_CHILD pidl, int size)
     return icon;
 }
 
+/* Arctic: what the tiles of This PC follow */
+static BOOL ArcticWindowIsDark(void)
+{
+    COLORREF color = GetSysColor(COLOR_WINDOW);
+
+    return GetRValue(color) * 3 + GetGValue(color) * 6 + GetBValue(color) < 1280;
+}
+
+static BOOL ArcticStyle11(void)
+{
+    WCHAR size[64] = L"";
+
+    return SUCCEEDED(GetCurrentThemeName(NULL, 0, NULL, 0, size, _countof(size))) && !lstrcmpiW(size, L"Windows 11");
+}
+
+/* Arctic: a bar with round ends, its edges soft */
+static VOID ArcticFillPill(HDC hdc, const RECT *prc, COLORREF color)
+{
+    INT cx = prc->right - prc->left, cy = prc->bottom - prc->top;
+    FLOAT r = cy / 2.0f;
+    BITMAPINFO bmi = { { sizeof(bmi.bmiHeader), cx, -cy, 1, 32, BI_RGB } };
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    UINT32 *bits = NULL;
+    HBITMAP bitmap;
+    HDC mem;
+
+    if (cx <= 0 || cy <= 0 || !(bitmap = CreateDIBSection(hdc, &bmi, DIB_RGB_COLORS, (void **)&bits, NULL, 0)))
+        return;
+    for (INT y = 0; y < cy; y++)
+    {
+        for (INT x = 0; x < cx; x++)
+        {
+            INT hits = 0;
+
+            for (INT j = 0; j < 4; j++)
+            {
+                for (INT i = 0; i < 4; i++)
+                {
+                    FLOAT px = x + (i + 0.5f) / 4, py = y + (j + 0.5f) / 4;
+                    FLOAT dx = max(max(r - px, px - (cx - r)), 0.0f), dy = py - r;
+
+                    if (dx * dx + dy * dy <= r * r)
+                        hits++;
+                }
+            }
+            UINT a = hits * 255 / 16;
+            bits[y * cx + x] = (a << 24) | ((GetRValue(color) * a / 255) << 16) | ((GetGValue(color) * a / 255) << 8) |
+                               (GetBValue(color) * a / 255);
+        }
+    }
+    mem = CreateCompatibleDC(hdc);
+    HGDIOBJ old = SelectObject(mem, bitmap);
+    GdiAlphaBlend(hdc, prc->left, prc->top, cx, cy, mem, 0, 0, cx, cy, blend);
+    SelectObject(mem, old);
+    DeleteDC(mem);
+    DeleteObject(bitmap);
+}
+
 LRESULT CDefView::OnCustomDraw(LPNMLVCUSTOMDRAW cd)
 {
     if (m_FolderSettings.ViewMode != FVM_TILE)
@@ -4288,13 +4347,20 @@ void CDefView::DrawTile(LPNMLVCUSTOMDRAW cd)
