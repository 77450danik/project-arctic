diff --git a/dll/win32/shdocvw/CExplorerBand.cpp b/dll/win32/shdocvw/CExplorerBand.cpp
--- a/dll/win32/shdocvw/CExplorerBand.cpp
+++ b/dll/win32/shdocvw/CExplorerBand.cpp
@@ -395,10 +395,35 @@
         }
     }
 
-    // Find PIDL into our explorer
+    // Arctic: as Windows 10, the pane expands to the open folder only when
+    // "Expand to open folder" is on (NavPaneExpandToCurrentFolder); else the
+    // folder is selected where the tree shows it already, and nothing is
+    // selected when it is inside a collapsed folder
+    DWORD dwExpand = 0, cbExpand = sizeof(dwExpand);
+    SHGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
+                L"NavPaneExpandToCurrentFolder", NULL, &dwExpand, &cbExpand);
+
     ++m_mtxBlockNavigate;
     HTREEITEM hItem;
-    BOOL result = _NavigateToPIDL(pidl, &hItem, TRUE, FALSE, TRUE);
+    BOOL result;
+    if (dwExpand)
+    {
+        result = _NavigateToPIDL(pidl, &hItem, TRUE, FALSE, TRUE);
+    }
+    else
+    {
+        result = _NavigateToPIDL(pidl, &hItem, FALSE, FALSE, FALSE);
+        for (HTREEITEM hParent = result ? TreeView_GetParent(m_hwndTreeView, hItem) : NULL; hParent;
+             hParent = TreeView_GetParent(m_hwndTreeView, hParent))
+        {
+            if (!(TreeView_GetItemState(m_hwndTreeView, hParent, TVIS_EXPANDED) & TVIS_EXPANDED))
+            {
+                result = FALSE;
+                break;
+            }
+        }
+        TreeView_SelectItem(m_hwndTreeView, result ? hItem : NULL);
+    }
     --m_mtxBlockNavigate;
 
     return result;
