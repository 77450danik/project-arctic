From: 77450danik <dnsystems@email.ua>
Date: Tue, 10 Nov 2026 12:00:00 +0200
Subject: [PATCH] browseui: the Control Panel's items where the tree was, and the tree back in every tab.

In the looks of Windows 10 and 11 the Control Panel's items stand where the
tree was (startui.dll lays them out, ArcticExplorerLayout gives their
width), on all of its pages. Any other folder brings the tree back, also
when a tab or the way back and forward goes there: those browse without
BrowseObject, which alone did it. View, Show, Navigation pane turns both
off and on (NavPaneVisible, as in Windows), and the window no longer forces
the pane on.
---
diff --git a/dll/win32/browseui/shellbrowser.cpp b/dll/win32/browseui/shellbrowser.cpp
index 8bbad55..a768ac4 100644
--- a/dll/win32/browseui/shellbrowser.cpp
+++ b/dll/win32/browseui/shellbrowser.cpp
@@ -34,6 +34,22 @@ static BOOL MenusAlwaysShown()
  * 2 Windows 11): startui.dll draws the last two around the view */
 #define WM_ARCTIC_BROWSE (WM_APP + 0x51)
 #define WM_ARCTIC_SEARCH (WM_APP + 0x52)
+#define WM_ARCTIC_NAVPANE (WM_APP + 0x53)
+#define WM_ARCTIC_RELAYOUT (WM_APP + 0x54)
+
+/* Arctic: the Control Panel and its pages */
+static BOOL ArcticIsControlPanel(LPCITEMIDLIST pidl)
+{
+    PIDLIST_ABSOLUTE pidlControls = NULL;
+    BOOL bRet = FALSE;
+
+    if (pidl && SUCCEEDED(SHGetSpecialFolderLocation(NULL, CSIDL_CONTROLS, &pidlControls)))
+    {
+        bRet = ILIsEqual(pidlControls, pidl) || ILIsParent(pidlControls, pidl, FALSE);
+        ILFree(pidlControls);
+    }
+    return bRet;
+}
 
 static DWORD ArcticExplorerStyle()
 {
@@ -813,9 +829,38 @@ public:
         return 0;
     }
 
+    /* Arctic: View, Show, Navigation pane of the looks of Windows 10 and 11:
+       the tree, or in the Control Panel the list startui.dll shows there */
+    LRESULT OnArcticNavPane(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL &bHandled)
+    {
+        m_settings.fNavPaneVisible = wParam != 0;
+        m_settings.Save();
+        if (!wParam && IsEqualCLSID(CLSID_ExplorerBand, fCurrentVertBar))
+        {
+            IUnknown_ShowDW(fClientBars[BIVerticalBaseBar].clientBar.p, FALSE);
+            memset(&fCurrentVertBar, 0, sizeof(fCurrentVertBar));
+            FireCommandStateChangeAll();
+        }
+        else if (wParam && IsEqualCLSID(GUID_NULL, fCurrentVertBar) && !ArcticIsControlPanel(fCurrentDirectoryPIDL))
+        {
+            ShowBand(CLSID_ExplorerBand, true);
+        }
+        RepositionBars();
+        return 0;
+    }
+
+    /* Arctic: startui.dll's rows or side changed what they take */
+    LRESULT OnArcticRelayout(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL &bHandled)
+    {
+        RepositionBars();
+        return 0;
+    }
+
     BEGIN_MSG_MAP(CShellBrowser)
         MESSAGE_HANDLER(WM_ARCTIC_BROWSE, OnArcticBrowse)
         MESSAGE_HANDLER(WM_ARCTIC_SEARCH, OnArcticSearch)
+        MESSAGE_HANDLER(WM_ARCTIC_NAVPANE, OnArcticNavPane)
+        MESSAGE_HANDLER(WM_ARCTIC_RELAYOUT, OnArcticRelayout)
         MESSAGE_HANDLER(WM_CREATE, OnCreate)
         MESSAGE_HANDLER(WM_DESTROY, OnDestroy)
         MESSAGE_HANDLER(WM_SIZE, OnSize)
@@ -961,11 +1006,9 @@ HRESULT CShellBrowser::Initialize()
     DWORD dwArcticStyle = ArcticExplorerStyle();
     typedef HWND (WINAPI *PFN_ATTACH)(HWND, INT);
     PFN_ATTACH pAttach = dwArcticStyle ? (PFN_ATTACH)ArcticExplorerProc("ArcticExplorerAttach") : NULL;
+    /* the navigation pane as View, Show has it (NavPaneVisible, as in Windows) */
     if (pAttach)
-    {
-        m_settings.fNavPaneVisible = TRUE;
         m_ArcticChrome = pAttach(m_hWnd, dwArcticStyle);
-    }
 
     hResult = IUnknown_ShowDW(clientBar, m_ArcticChrome == NULL);
     if (FAILED_UNEXPECTEDLY(hResult))
@@ -1238,21 +1281,21 @@ HRESULT CShellBrowser::BrowseToPath(IShellFolder *newShellFolder,
     hResult = IUnknown_SetSite(newShellView, static_cast<IDropTarget *>(this));
 
     /* Arctic: the Control Panel and its pages have no navigation pane, as in
-     * Windows 10; any other folder brings it back (BrowseObject), unless it
-     * was hidden from the View menu */
-    if (IsEqualCLSID(CLSID_ExplorerBand, fCurrentVertBar))
+     * Windows 10 (the looks of Windows 10 and 11 show the Control Panel's
+     * items there, startui.dll); any other folder brings it back, unless it
+     * was hidden from the View menu: BrowseObject, and here what the tabs
+     * and their history browse to */
+    BOOL bArcticControls = ArcticIsControlPanel(absolutePIDL);
+    if (bArcticControls && IsEqualCLSID(CLSID_ExplorerBand, fCurrentVertBar))
     {
-        PIDLIST_ABSOLUTE pidlControls = NULL;
-        if (SUCCEEDED(SHGetSpecialFolderLocation(NULL, CSIDL_CONTROLS, &pidlControls)))
-        {
-            if (ILIsEqual(pidlControls, absolutePIDL) || ILIsParent(pidlControls, absolutePIDL, FALSE))
-            {
-                IUnknown_ShowDW(fClientBars[BIVerticalBaseBar].clientBar.p, FALSE);
-                memset(&fCurrentVertBar, 0, sizeof(fCurrentVertBar));
-                FireCommandStateChangeAll();
-            }
-            ILFree(pidlControls);
-        }
+        IUnknown_ShowDW(fClientBars[BIVerticalBaseBar].clientBar.p, FALSE);
+        memset(&fCurrentVertBar, 0, sizeof(fCurrentVertBar));
+        FireCommandStateChangeAll();
+    }
+    else if (!bArcticControls && m_ArcticChrome && m_settings.fNavPaneVisible &&
+             IsEqualCLSID(GUID_NULL, fCurrentVertBar))
+    {
+        ShowBand(CLSID_ExplorerBand, true);
     }
 
     // update folder and view
@@ -1743,14 +1786,16 @@ void CShellBrowser::RepositionBars()
 
     if (m_ArcticChrome)
     {
-        typedef VOID (WINAPI *PFN_LAYOUT)(HWND, INT, INT, INT *, INT *);
+        typedef VOID (WINAPI *PFN_LAYOUT)(HWND, INT, INT, INT *, INT *, INT *);
         PFN_LAYOUT pLayout = (PFN_LAYOUT)ArcticExplorerProc("ArcticExplorerLayout");
-        INT cyTop = 0, cyBottom = 0;
+        INT cyTop = 0, cyBottom = 0, cxLeft = 0;
 
+        /* in the Control Panel its items take the tree's place at the left */
         if (pLayout)
-            pLayout(m_ArcticChrome, clientRect.right, clientRect.bottom, &cyTop, &cyBottom);
+            pLayout(m_ArcticChrome, clientRect.right, clientRect.bottom, &cyTop, &cyBottom, &cxLeft);
         clientRect.top += cyTop;
         clientRect.bottom -= cyBottom;
+        clientRect.left += cxLeft;
     }
     else if (m_settings.fStatusBarVisible && fStatusBar)
     {
