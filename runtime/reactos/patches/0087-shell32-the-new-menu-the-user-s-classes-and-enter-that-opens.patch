@@ -443,13 +443,28 @@ LSTATUS AddClassKeyToArray(const WCHAR* szClass, HKEY* array, UINT* cKeys)
         return ERROR_MORE_DATA;
 
     HKEY hkey;
+    WCHAR szUser[MAX_PATH + 18];
+    LSTATUS user = ERROR_FILE_NOT_FOUND;
+
+    /* Arctic: HKCR is Windows' merge of the user's classes over the machine's,
+       Wine's only the machine's: what a program installed for one user put in
+       HKCU\Software\Classes (its verbs, context menu handlers) comes first */
+    if (SUCCEEDED(StringCchPrintfW(szUser, _countof(szUser), L"Software\\Classes\\%s", szClass)) &&
+        (user = RegOpenKeyExW(HKEY_CURRENT_USER, szUser, 0, KEY_READ | KEY_QUERY_VALUE, &hkey)) == ERROR_SUCCESS)
+    {
+        array[*cKeys] = hkey;
+        *cKeys += 1;
+        if (*cKeys >= 16)
+            return ERROR_SUCCESS;
+    }
+
     LSTATUS result = RegOpenKeyExW(HKEY_CLASSES_ROOT, szClass, 0, KEY_READ | KEY_QUERY_VALUE, &hkey);
     if (result == ERROR_SUCCESS)
     {
         array[*cKeys] = hkey;
         *cKeys += 1;
     }
-    return result;
+    return user == ERROR_SUCCESS ? ERROR_SUCCESS : result;
 }
 
