+/*
+ * Arctic: the title bars and frames follow the mode of Windows (desk.cpl,
+ * Personalization; SystemUsesLightTheme of HKCU\Software\Microsoft\Windows\
+ * CurrentVersion\Themes\Personalize), not the visual style's colours, which
+ * follow the programs' mode: white with black text in the light mode,
+ * #202020 with white text in the dark one. A program can ask for its window
+ * otherwise, as in Windows 11, through dwmapi (Wine patch "dwmapi-a-title-
+ * bar-over-a-backdrop", window properties Arctic.*): the dark or the light
+ * mode (DWMWA_USE_IMMERSIVE_DARK_MODE), the colours of the title bar, its
+ * text and the frame (DWMWA_CAPTION_COLOR, DWMWA_TEXT_COLOR,
+ * DWMWA_BORDER_COLOR).
+ *
+ * With an effect chosen for them (HKCU\Software\Arctic\Caption: Effect;
+ * Color, Opacity, Blur, Light), the title bar of a top-level window is drawn
+ * on the colour dwm.exe keys, black or white, and DWMWA_ARCTIC_CAPTION tells
+ * dwm.exe what goes behind it: acrylic, a blur or a see-through tint. Its
+ * tint is the mode's, as Windows 11's Mica, unless a colour is chosen. A
+ * solid colour is drawn here. desk.cpl says WM_SETTINGCHANGE
+ * "ImmersiveColorSet" when any of it changes.
+ */
+
+#define DWMWA_ARCTIC_CAPTION    0x1005
+#define CAPTION_ACCENT_SOLID    1   /* ARCTIC_ACCENT_ENABLE_GRADIENT */
+#define CAPTION_ACCENT_ACRYLIC  4   /* ARCTIC_ACCENT_ENABLE_ACRYLICBLURBEHIND */
+#define CAPTION_WHITE           RGB(0xff, 0xff, 0xff)
+#define CAPTION_DARK            RGB(0x20, 0x20, 0x20)
+#define CAPTION_LIGHT_TINT      RGB(0xf3, 0xf3, 0xf3)
+
+typedef struct
+{
+    BOOL     Loaded;
+    BOOL     SystemLight;   /* the mode of Windows */
+    BOOL     AppsLight;     /* the programs' */
+    DWORD    Effect;        /* 0: none, else ARCTIC_ACCENT_* */
+    BOOL     HasColor;      /* a tint of its own, not the mode's */
+    COLORREF Color;
+    DWORD    Opacity;       /* percent */
+    DWORD    Blur;          /* 1-100 */
+    BOOL     HasLight;      /* text chosen, or for the colour of its own */
+    BOOL     Light;         /* drawn dark on light over the effect */
+} CAPTION_LOOK;
+
+typedef struct
+{
+    BOOL     Keyed;         /* drawn on the colour dwm.exe keys */
+    BOOL     Light;
+    COLORREF Tint;
+    DWORD    Opacity;
+    COLORREF Back, Frame, Text, TextInactive, Glyph, GlyphInactive, GlyphDisabled;
+} CAPTION_COLORS;
+
+static CAPTION_LOOK CaptionLook;
+
+static BOOL ReadCaptionDword(HKEY hKey, LPCWSTR pszName, DWORD *pdwValue)
+{
+    DWORD dwValue, dwSize = sizeof(dwValue), dwType;
+
+    if (!hKey || RegQueryValueExW(hKey, pszName, NULL, &dwType, (BYTE *)&dwValue, &dwSize) || dwType != REG_DWORD)
+        return FALSE;
+    *pdwValue = dwValue;
+    return TRUE;
+}
+
+static const CAPTION_LOOK *GetCaptionLook(void)
+{
+    CAPTION_LOOK look;
+    DWORD dwValue;
+    HKEY hKey = NULL;
+
+    if (CaptionLook.Loaded)
+        return &CaptionLook;
+    RegOpenKeyExW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", 0,
+                  KEY_READ, &hKey);
+    /* Windows 10's default: Windows dark, programs light */
+    look.SystemLight = ReadCaptionDword(hKey, L"SystemUsesLightTheme", &dwValue) && dwValue;
+    look.AppsLight = !ReadCaptionDword(hKey, L"AppsUseLightTheme", &dwValue) || dwValue;
+    if (hKey)
+        RegCloseKey(hKey);
+    hKey = NULL;
+    RegOpenKeyExW(HKEY_CURRENT_USER, L"Software\\Arctic\\Caption", 0, KEY_READ, &hKey);
+    look.Effect = ReadCaptionDword(hKey, L"Effect", &dwValue) ? min(dwValue, CAPTION_ACCENT_ACRYLIC)
+                                                               : CAPTION_ACCENT_ACRYLIC;
+    look.HasColor = ReadCaptionDword(hKey, L"Color", &dwValue);
+    look.Color = look.HasColor ? dwValue & 0xffffff : 0;
+    look.Opacity = ReadCaptionDword(hKey, L"Opacity", &dwValue) ? min(dwValue, 100) : 75;
+    look.Blur = ReadCaptionDword(hKey, L"Blur", &dwValue) ? max(1, min(dwValue, 100)) : 60;
+    look.HasLight = ReadCaptionDword(hKey, L"Light", &dwValue);
+    look.Light = look.HasLight && dwValue;
+    if (hKey)
+        RegCloseKey(hKey);
+    look.Loaded = TRUE;
+    CaptionLook = look;
+    return &CaptionLook;
+}
+
+void UXTHEME_ResetCaptionLook(void)
+{
+    CaptionLook.Loaded = FALSE;
+}
+
+/* only the title bar of a top-level window that draws its own client area
+ * under it can be keyed: the rest of the window is not */
+static BOOL CanKeyCaption(PDRAW_CONTEXT pcontext)
+{
+    if (pcontext->wi.dwStyle & (WS_CHILD | WS_MINIMIZE))
+        return FALSE;
+    if (pcontext->wi.dwExStyle & WS_EX_LAYERED)
+        return FALSE;
+    /* not the hidden window of a preview (DrawNCPreview) */
+    if (!IsWindowVisible(pcontext->hWnd))
+        return FALSE;
+    if ((pcontext->wi.dwStyle & WS_CAPTION) != WS_CAPTION)
+        return FALSE;
+    return pcontext->wi.rcClient.top - pcontext->wi.rcWindow.top >= pcontext->CaptionHeight;
+}
+
+static COLORREF MixColor(COLORREF a, COLORREF b, DWORD percent)
+{
+    return RGB((GetRValue(a) * (100 - percent) + GetRValue(b) * percent) / 100,
+               (GetGValue(a) * (100 - percent) + GetGValue(b) * percent) / 100,
+               (GetBValue(a) * (100 - percent) + GetBValue(b) * percent) / 100);
+}
+
+static BOOL IsLightColor(COLORREF color)
+{
+    return GetRValue(color) * 299 + GetGValue(color) * 587 + GetBValue(color) * 114 > 150 * 1000;
+}
+
+/* a colour a program asked for (dwmapi): 0x01000000 with it, none: 0 */
+static ULONG_PTR WindowColor(HWND hWnd, LPCWSTR pszName)
+{
+    return (ULONG_PTR)GetPropW(hWnd, pszName);
+}
+
+static void GetCaptionColors(PDRAW_CONTEXT pcontext, CAPTION_COLORS *colors)
+{
+    const CAPTION_LOOK *look = GetCaptionLook();
+    BOOL top = !(pcontext->wi.dwStyle & WS_CHILD);
+    ULONG_PTR mode = (ULONG_PTR)GetPropW(pcontext->hWnd, L"Arctic.DarkMode");
+    ULONG_PTR caption = WindowColor(pcontext->hWnd, L"Arctic.CaptionColor");
+    ULONG_PTR text = WindowColor(pcontext->hWnd, L"Arctic.TextColor");
+    ULONG_PTR border = WindowColor(pcontext->hWnd, L"Arctic.BorderColor");
+    /* DWMWA_USE_IMMERSIVE_DARK_MODE: 1 light, 2 dark */
+    BOOL modeLight = mode ? mode == 1 : look->SystemLight;
+
+    colors->Keyed = FALSE;
+    colors->Tint = look->HasColor ? look->Color : modeLight ? CAPTION_LIGHT_TINT : CAPTION_DARK;
+    colors->Opacity = look->Opacity;
+    if (caption)
+    {
+        colors->Back = colors->Frame = (COLORREF)(caption & 0xffffff);
+        colors->Light = IsLightColor(colors->Back);
+    }
+    else if (top && look->Effect && look->Effect != CAPTION_ACCENT_SOLID && CanKeyCaption(pcontext))
+    {
+        colors->Keyed = TRUE;
+        colors->Light = look->HasLight ? look->Light : modeLight;
+        colors->Back = colors->Light ? CAPTION_WHITE : RGB(0, 0, 0);
+        /* the frame: the tint over the mode's colour */
+        colors->Frame = MixColor(modeLight ? CAPTION_WHITE : CAPTION_DARK, colors->Tint, colors->Opacity);
+    }
+    else if (top && look->Effect == CAPTION_ACCENT_SOLID)
+    {
+        colors->Light = look->HasLight ? look->Light : modeLight;
+        colors->Back = colors->Frame = colors->Tint;
+    }
+    else
+    {
+        colors->Light = modeLight;
+        colors->Back = colors->Frame = modeLight ? CAPTION_WHITE : CAPTION_DARK;
+    }
+    if (colors->Light)
+    {
+        colors->Text = RGB(0, 0, 0);
+        colors->TextInactive = RGB(0x8c, 0x8c, 0x8c);
+        colors->Glyph = RGB(0x1a, 0x1a, 0x1a);
+        colors->GlyphInactive = RGB(0xa3, 0xa3, 0xa3);
+        colors->GlyphDisabled = RGB(0xc8, 0xc8, 0xc8);
+    }
+    else
+    {
+        colors->Text = RGB(0xff, 0xff, 0xff);
+        colors->TextInactive = RGB(0x99, 0x99, 0x99);
+        colors->Glyph = RGB(0xff, 0xff, 0xff);
+        colors->GlyphInactive = RGB(0x88, 0x88, 0x88);
+        colors->GlyphDisabled = RGB(0x5c, 0x5c, 0x5c);
+    }
+    if (text)
+    {
+        colors->Text = colors->Glyph = (COLORREF)(text & 0xffffff);
+        colors->TextInactive = colors->GlyphInactive = MixColor(colors->Back, colors->Text, 60);
+    }
+    if (border)
+        colors->Frame = (COLORREF)(border & 0xffffff);
+}
+
+static void FillSolid(HDC hdc, const RECT *prc, COLORREF color)
+{
+    COLORREF old = SetBkColor(hdc, color);
+
+    ExtTextOutW(hdc, 0, 0, ETO_OPAQUE, prc, NULL, 0, NULL);
+    SetBkColor(hdc, old);
+}
+
+typedef HRESULT (WINAPI *PDWMSETWINDOWATTRIBUTE)(HWND, DWORD, LPCVOID, DWORD);
+
+/* tells dwm.exe what goes behind the title bar, when that changed */
+static void SetCaptionBackdrop(PDRAW_CONTEXT pcontext, const CAPTION_COLORS *colors)
+{
+    static PDWMSETWINDOWATTRIBUTE pDwmSetWindowAttribute;
+    static BOOL bLooked;
+    const CAPTION_LOOK *look = GetCaptionLook();
+    PWND_DATA pwndData = ThemeGetWndData(pcontext->hWnd);
+    UINT caption[5] = {0};   /* struct arctic_caption of wine/arctic_dwm.h */
+
+    if (pwndData == NULL)
+        return;
+    if (colors && colors->Keyed)
+    {
+        caption[0] = pcontext->CaptionHeight;
+        caption[1] = look->Effect;
+        caption[2] = ((colors->Opacity * 255 / 100) << 24) | (GetBValue(colors->Tint) << 16) |
+                     (GetGValue(colors->Tint) << 8) | GetRValue(colors->Tint);
+        caption[3] = look->Blur;
+        caption[4] = colors->Light;
+    }
+    if (!memcmp(caption, pwndData->CaptionBackdrop, sizeof(caption)))
+        return;
+    if (!bLooked)
+    {
+        HMODULE hDwm = LoadLibraryW(L"dwmapi.dll");
+
+        if (hDwm)
+            pDwmSetWindowAttribute = (PDWMSETWINDOWATTRIBUTE)GetProcAddress(hDwm, "DwmSetWindowAttribute");
+        bLooked = TRUE;
+    }
+    if (pDwmSetWindowAttribute &&
+        SUCCEEDED(pDwmSetWindowAttribute(pcontext->hWnd, DWMWA_ARCTIC_CAPTION, caption, sizeof(caption))))
+        memcpy(pwndData->CaptionBackdrop, caption, sizeof(caption));
+}
+
