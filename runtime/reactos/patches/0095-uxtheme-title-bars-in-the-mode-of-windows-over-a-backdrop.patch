+
+/*
+ * Arctic: what programs ask of the dark mode of Windows 10 and 11 by
+ * ordinal, as Notepad++, Qt and the like do. The modes are desk.cpl's
+ * (Personalization): SystemUsesLightTheme and AppsUseLightTheme of
+ * HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize. In
+ * the dark mode the visual style is dark for every program; these say so.
+ */
+
+static DWORD ReadPersonalizeValue(LPCWSTR pszName, DWORD dwDefault)
+{
+    DWORD dwValue, dwSize = sizeof(dwValue), dwType;
+    HKEY hKey;
+
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", 0,
+                      KEY_QUERY_VALUE, &hKey))
+        return dwDefault;
+    if (RegQueryValueExW(hKey, pszName, NULL, &dwType, (BYTE *)&dwValue, &dwSize) || dwType != REG_DWORD)
+        dwValue = dwDefault;
+    RegCloseKey(hKey);
+    return dwValue;
+}
+
+/* ordinal 138; Windows 10's default: Windows dark, programs light */
+BOOLEAN WINAPI ShouldSystemUseDarkMode(void)
+{
+    return !ReadPersonalizeValue(L"SystemUsesLightTheme", 0);
+}
+
+/* ordinal 132 */
+BOOLEAN WINAPI ShouldAppsUseDarkMode(void)
+{
+    return !ReadPersonalizeValue(L"AppsUseLightTheme", 1);
+}
+
+/* ordinal 104: the modes are read anew */
+void WINAPI RefreshImmersiveColorPolicyState(void)
+{
+    UXTHEME_ResetCaptionLook();
+}
+
+static LONG PreferredAppMode;  /* 0 default, 1 allow dark, 2 force dark, 3 force light */
+
+/* ordinal 135; AllowDarkModeForApp(BOOL) before Windows 10 1903 */
+int WINAPI SetPreferredAppMode(int iMode)
+{
+    return InterlockedExchange(&PreferredAppMode, iMode);
+}
+
+/* ordinal 139 */
+BOOLEAN WINAPI IsDarkModeAllowedForApp(void)
+{
+    return PreferredAppMode == 1 || PreferredAppMode == 2;
+}
+
+/* ordinal 133 */
+BOOLEAN WINAPI AllowDarkModeForWindow(HWND hWnd, BOOLEAN bAllow)
+{
