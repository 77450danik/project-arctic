+    /* Arctic: the task toolbar now and then reported a click on the active
+       window's button with the pointer nowhere near it (the Control Panel
+       opened from Start): the window minimized by itself, at once. A click
+       counts only when the mouse message it came from was on the button, as
+       one does in Windows; Enter and Space on a focused button still count. */
+    BOOL IsRealButtonClick(IN WORD wCommand)
+    {
+        DWORD pos = GetMessagePos();
+        POINT pt = { (SHORT)LOWORD(pos), (SHORT)HIWORD(pos) }, cursor;
+        INT index = (INT)m_TaskBar.SendMessageW(TB_COMMANDTOINDEX, wCommand, 0);
+        RECT rc;
+
+        if (GetKeyState(VK_RETURN) < 0 || GetKeyState(VK_SPACE) < 0)
+            return TRUE;
+        if (index < 0 || !m_TaskBar.SendMessageW(TB_GETITEMRECT, index, (LPARAM)&rc))
+            return TRUE;
+        m_TaskBar.MapWindowPoints(NULL, (LPPOINT)&rc, 2);
+        if (PtInRect(&rc, pt))
+            return TRUE;
+        GetCursorPos(&cursor);
+        ArcticLog("arctic-taskbar: a click on button %u (%ld,%ld-%ld,%ld) ignored: its message was at %ld,%ld, "
+                  "the pointer is at %ld,%ld, buttons %s%s\n", wCommand, rc.left, rc.top, rc.right, rc.bottom,
+                  pt.x, pt.y, cursor.x, cursor.y, GetKeyState(VK_LBUTTON) < 0 ? "L" : "",
+                  GetKeyState(VK_RBUTTON) < 0 ? "R" : "");
+        return FALSE;
+    }
