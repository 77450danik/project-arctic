+/* Arctic: into the system's log (Wine's debug output), which ReactOS's
+   ERR does not reach */
+static void ArcticLog(const char *format, ...)
+{
+    static int (__cdecl *output)(const char *);
+    char buffer[512];
+    va_list args;
+
+    if (!output)
+        output = (int (__cdecl *)(const char *))GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "__wine_dbg_output");
+    if (!output)
+        return;
+    va_start(args, format);
+    _vsnprintf(buffer, sizeof(buffer) - 1, format, args);
+    va_end(args);
+    buffer[sizeof(buffer) - 1] = 0;
+    output(buffer);
+}
