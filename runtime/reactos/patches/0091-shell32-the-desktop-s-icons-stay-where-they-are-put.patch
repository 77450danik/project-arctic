+/**********************************************************************
+ * Arctic: the desktop's icons where the user puts them
+ *
+ * As Windows 10 keeps them, Auto arrange off and Align to grid on by
+ * default: an icon dragged stays where it is dropped, in the nearest cell
+ * of the grid; one dropped over another goes to the nearest free cell; a new
+ * one takes the first free cell, top to bottom, then the next column; "Sort
+ * by" lays them all out again in that order. Where they are is kept in the
+ * desktop's bag (Bags\1\Desktop, "ArcticItemPos"), by the items' parsing
+ * names, in thousandths of a cell: the same cells at another icon size or
+ * scale. Windows keeps its own "ItemPos" there by the screen's size.
+ */
+
+#define DESKTOP_BAG L"Software\\Microsoft\\Windows\\Shell\\Bags\\1\\Desktop"
+#define DESKTOP_POS_MAGIC 0x534f5041 /* 'APOS' */
+
+void CDefView::DesktopGrid(SIZE *cell, POINT *offset, int *cols, int *rows)
+{
+    DWORD spacing = ListView_GetItemSpacing(m_ListView.m_hWnd, FALSE);
+    HIMAGELIST himl = ListView_GetImageList(m_ListView.m_hWnd, LVSIL_NORMAL);
+    int cx = 32, cy = 32;
+    RECT rc;
+
+    if (himl)
+        ImageList_GetIconSize(himl, &cx, &cy);
+    cell->cx = max(1, (int)LOWORD(spacing));
+    cell->cy = max(1, (int)HIWORD(spacing));
+    /* where the list view puts an icon in its cell (ICON_TOP_PADDING) */
+    offset->x = (cell->cx - cx) / 2;
+    offset->y = 4;
+    ::GetClientRect(m_ListView.m_hWnd, &rc);
+    *cols = max(1, (int)(rc.right / cell->cx));
+    *rows = max(1, (int)(rc.bottom / cell->cy));
+}
+
+BOOL CDefView::DesktopItemName(int nItem, WCHAR *name, UINT cch)
+{
+    PCUITEMID_CHILD pidl = _PidlByItem(nItem);
+    STRRET str;
+
+    if (!pidl || FAILED(m_pSFParent->GetDisplayNameOf(pidl, SHGDN_INFOLDER | SHGDN_FORPARSING, &str)))
+        return FALSE;
+    return SUCCEEDED(StrRetToBufW(&str, pidl, name, cch)) && name[0];
+}
+
+BOOL CDefView::DesktopCellOf(int nItem, POINT *cell)
+{
+    SIZE size;
+    POINT off, pt;
+    int cols, rows;
+
+    DesktopGrid(&size, &off, &cols, &rows);
+    if (!m_ListView.GetItemPosition(nItem, &pt))
+        return FALSE;
+    cell->x = max(0L, (pt.x - off.x + size.cx / 2) / size.cx);
+    cell->y = max(0L, (pt.y - off.y + size.cy / 2) / size.cy);
+    return TRUE;
+}
+
+void CDefView::DesktopPutInCell(int nItem, POINT cell)
+{
+    SIZE size;
+    POINT off, pt;
+    int cols, rows;
+
+    DesktopGrid(&size, &off, &cols, &rows);
+    pt.x = cell.x * size.cx + off.x;
+    pt.y = cell.y * size.cy + off.y;
+    m_ListView.SetItemPosition(nItem, &pt);
+}
+
+/* the first free cell, top to bottom and then the next column, or the one
+ * nearest to a cell */
+static BOOL DesktopFreeCell(const BYTE *taken, int cols, int rows, const POINT *nearTo, POINT *cell)
+{
+    LONG best = -1;
+
+    for (int x = 0; x < cols; x++)
+    {
+        for (int y = 0; y < rows; y++)
+        {
+            LONG d;
+
+            if (taken[x * rows + y])
+                continue;
+            if (!nearTo)
+            {
+                cell->x = x;
+                cell->y = y;
+                return TRUE;
+            }
+            d = (x - nearTo->x) * (x - nearTo->x) + (y - nearTo->y) * (y - nearTo->y);
+            if (best < 0 || d < best)
+            {
+                best = d;
+                cell->x = x;
+                cell->y = y;
+            }
+        }
+    }
+    return best >= 0;
+}
+
+/* what the bag keeps: the header, then for each item x, y (thousandths of a
+ * cell), the length of its name and the name */
+static BOOL DesktopFindSaved(const BYTE *data, DWORD size, const WCHAR *name, LONG *gx, LONG *gy)
+{
+    DWORD pos = sizeof(DWORD), len = lstrlenW(name);
+
+    if (size < sizeof(DWORD) || *(const DWORD *)data != DESKTOP_POS_MAGIC)
+        return FALSE;
+    while (pos + 2 * sizeof(LONG) + sizeof(WORD) <= size)
+    {
+        LONG x = *(const LONG *)(data + pos), y = *(const LONG *)(data + pos + sizeof(LONG));
+        WORD cch = *(const WORD *)(data + pos + 2 * sizeof(LONG));
+        const WCHAR *saved = (const WCHAR *)(data + pos + 2 * sizeof(LONG) + sizeof(WORD));
+
+        pos += 2 * sizeof(LONG) + sizeof(WORD) + cch * sizeof(WCHAR);
+        if (pos > size)
+            break;
+        if (cch == len && !_wcsnicmp(saved, name, cch))
+        {
+            *gx = x;
+            *gy = y;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+void CDefView::DesktopRestorePositions()
+{
+    int count = m_ListView.GetItemCount(), cols, rows;
+    DWORD size = 0;
+    BYTE *data = NULL, *taken, *placed;
+    SIZE cell;
+    POINT off;
+    RECT rc;
+
+    ::GetClientRect(m_ListView.m_hWnd, &rc);
+    if (rc.right <= 0 || rc.bottom <= 0)
+        return;
+    m_bDesktopPlaced = TRUE;
+    if (!count)
+        return;
+    DesktopGrid(&cell, &off, &cols, &rows);
+    if (SHGetValueW(HKEY_CURRENT_USER, DESKTOP_BAG, L"ArcticItemPos", NULL, NULL, &size) == ERROR_SUCCESS && size &&
+        (data = (BYTE *)HeapAlloc(GetProcessHeap(), 0, size)) != NULL &&
+        SHGetValueW(HKEY_CURRENT_USER, DESKTOP_BAG, L"ArcticItemPos", NULL, data, &size) != ERROR_SUCCESS)
+        size = 0;
+    taken = (BYTE *)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, cols * rows);
+    placed = (BYTE *)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, count);
+    if (!taken || !placed)
+        goto done;
+
+    m_ListView.SetRedraw(FALSE);
+    /* those the bag knows, in their cells while they are on the screen and free */
+    for (int i = 0; data && i < count; i++)
+    {
+        WCHAR name[MAX_PATH];
+        LONG gx, gy;
+        POINT c;
+
+        if (!DesktopItemName(i, name, _countof(name)) || !DesktopFindSaved(data, size, name, &gx, &gy))
+            continue;
+        c.x = (gx + 500) / 1000;
+        c.y = (gy + 500) / 1000;
+        if (gx < 0 || gy < 0 || c.x >= cols || c.y >= rows || taken[c.x * rows + c.y])
+            continue;
+        if (_GetSnapToGrid() == S_OK)
+            DesktopPutInCell(i, c);
+        else
+        {
+            POINT pt = { (LONG)((LONGLONG)gx * cell.cx / 1000) + off.x, (LONG)((LONGLONG)gy * cell.cy / 1000) + off.y };
+            m_ListView.SetItemPosition(i, &pt);
+        }
+        taken[c.x * rows + c.y] = placed[i] = 1;
+    }
+    /* the others in the first free cells */
+    for (int i = 0; i < count; i++)
+    {
+        POINT c;
+
+        if (placed[i])
+            continue;
+        if (!DesktopFreeCell(taken, cols, rows, NULL, &c))
+            break;
+        DesktopPutInCell(i, c);
+        taken[c.x * rows + c.y] = 1;
+    }
+    m_ListView.SetRedraw(TRUE);
+    m_ListView.Invalidate();
+    DesktopSavePositions();
+
+done:
+    if (data)
+        HeapFree(GetProcessHeap(), 0, data);
+    if (taken)
+        HeapFree(GetProcessHeap(), 0, taken);
+    if (placed)
+        HeapFree(GetProcessHeap(), 0, placed);
+}
+
+/* a new item: where its name was kept, or the first free cell */
+void CDefView::DesktopPlaceNewItem(int nItem)
+{
+    int count = m_ListView.GetItemCount(), cols, rows;
+    BYTE *taken;
+    SIZE cell;
+    POINT off, c;
+
+    DesktopGrid(&cell, &off, &cols, &rows);
+    if (!(taken = (BYTE *)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, cols * rows)))
+        return;
+    for (int i = 0; i < count; i++)
+    {
+        if (i != nItem && DesktopCellOf(i, &c) && c.x < cols && c.y < rows)
+            taken[c.x * rows + c.y] = 1;
+    }
+    if (DesktopFreeCell(taken, cols, rows, NULL, &c))
+        DesktopPutInCell(nItem, c);
+    HeapFree(GetProcessHeap(), 0, taken);
+    DesktopSavePositions();
+}
+
+/* No two icons in one cell, none beyond the screen: the selected ones (just
+ * dropped), or every one, go to the nearest free cell when theirs is taken */
+void CDefView::DesktopSettle(BOOL bSelectedOnly)
+{
+    int count = m_ListView.GetItemCount(), cols, rows;
+    BYTE *taken;
+    SIZE cell;
+    POINT off, c;
+    BOOL snap = _GetSnapToGrid() == S_OK;
+
+    if (!count)
+        return;
+    DesktopGrid(&cell, &off, &cols, &rows);
+    if (!(taken = (BYTE *)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, cols * rows)))
+        return;
+    /* first the icons that stay */
+    if (bSelectedOnly)
+    {
+        for (int i = 0; i < count; i++)
+        {
+            if (!(m_ListView.GetItemState(i, LVIS_SELECTED) & LVIS_SELECTED) && DesktopCellOf(i, &c) &&
+                c.x < cols && c.y < rows)
+                taken[c.x * rows + c.y] = 1;
+        }
+    }
+    for (int i = 0; i < count; i++)
+    {
+        POINT want, free;
+
+        if (bSelectedOnly && !(m_ListView.GetItemState(i, LVIS_SELECTED) & LVIS_SELECTED))
+            continue;
+        if (!DesktopCellOf(i, &want))
+            continue;
+        if (want.x < cols && want.y < rows && !taken[want.x * rows + want.y])
+        {
+            /* without the grid an icon stays where it was dropped, on the screen */
+            if (snap)
+                DesktopPutInCell(i, want);
+            taken[want.x * rows + want.y] = 1;
+            continue;
+        }
+        if (!snap && want.x < cols && want.y < rows)
+            continue;
+        want.x = min(want.x, (LONG)cols - 1);
+        want.y = min(want.y, (LONG)rows - 1);
+        if (!DesktopFreeCell(taken, cols, rows, &want, &free))
+            break;
+        DesktopPutInCell(i, free);
+        taken[free.x * rows + free.y] = 1;
+    }
+    HeapFree(GetProcessHeap(), 0, taken);
+}
+
+/* after "Sort by": in the list's new order, cell by cell */
+void CDefView::DesktopInOrder()
+{
+    int count = m_ListView.GetItemCount(), cols, rows;
+    SIZE cell;
+    POINT off;
+
+    DesktopGrid(&cell, &off, &cols, &rows);
+    m_ListView.SetRedraw(FALSE);
+    for (int i = 0; i < count; i++)
+    {
+        POINT c = { (LONG)(min(i / rows, cols - 1)), (LONG)(i % rows) };
+        DesktopPutInCell(i, c);
+    }
+    m_ListView.SetRedraw(TRUE);
+    m_ListView.Invalidate();
+    DesktopSavePositions();
+}
+
+void CDefView::DesktopSavePositions()
+{
+    int count, cols, rows;
+    SIZE cell;
+    POINT off;
+    BYTE *data;
+    DWORD size, pos;
+
+    if (!IsDesktop() || !m_ListView)
+        return;
+    SaveViewState();
+    if (!DesktopFreeLayout() || !m_bDesktopPlaced)
+        return;
+    count = m_ListView.GetItemCount();
+    DesktopGrid(&cell, &off, &cols, &rows);
+    size = sizeof(DWORD) + count * (2 * sizeof(LONG) + sizeof(WORD) + MAX_PATH * sizeof(WCHAR));
+    if (!(data = (BYTE *)HeapAlloc(GetProcessHeap(), 0, size)))
+        return;
+    *(DWORD *)data = DESKTOP_POS_MAGIC;
+    pos = sizeof(DWORD);
+    for (int i = 0; i < count; i++)
+    {
+        WCHAR name[MAX_PATH];
+        POINT pt;
+        WORD cch;
+
+        if (!DesktopItemName(i, name, _countof(name)) || !m_ListView.GetItemPosition(i, &pt))
+            continue;
+        cch = (WORD)lstrlenW(name);
+        *(LONG *)(data + pos) = (LONG)((LONGLONG)(pt.x - off.x) * 1000 / cell.cx);
+        *(LONG *)(data + pos + sizeof(LONG)) = (LONG)((LONGLONG)(pt.y - off.y) * 1000 / cell.cy);
+        *(WORD *)(data + pos + 2 * sizeof(LONG)) = cch;
+        memcpy(data + pos + 2 * sizeof(LONG) + sizeof(WORD), name, cch * sizeof(WCHAR));
+        pos += 2 * sizeof(LONG) + sizeof(WORD) + cch * sizeof(WCHAR);
+    }
+    SHSetValueW(HKEY_CURRENT_USER, DESKTOP_BAG, L"ArcticItemPos", REG_BINARY, data, pos);
+    HeapFree(GetProcessHeap(), 0, data);
+}
