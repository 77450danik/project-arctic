From: 77450danik <ddziuba1@stu.vistula.edu.pl>
Date: Tue, 3 Nov 2026 12:00:00 +0100
Subject: [PATCH] shell32, desk: The desktop shows the system icons checked, and only those.

Desktop Icon Settings and the desktop read HideDesktopIcons with opposite
defaults: with nothing written, the dialog showed every icon unchecked while
the desktop showed Network, Internet and Documents. Both now take the same
ones, This PC and the Recycle Bin shown, Windows' other system icons not,
and the dialog has Windows 10's choices: Computer, Recycle Bin, Documents,
Control Panel and Network.
---
--- a/dll/win32/shell32/folders/CDesktopFolder.cpp
+++ b/dll/win32/shell32/folders/CDesktopFolder.cpp
@@ -1070,14 +1070,47 @@
     return m_IsProgmanHosted == IsHosted;
 }
 
+/* Arctic: whether a system icon stays off the desktop. What Desktop Icon
+ * Settings (desk.cpl) wrote, under HideDesktopIcons as the Start menu's
+ * style has it (1: hidden); with nothing written, This PC and the Recycle
+ * Bin are shown and Windows' other system icons are not. The dialog takes
+ * the same defaults: it shows what the desktop shows. */
+static BOOL SHELL32_DesktopIconHidden(REFCLSID Clsid)
+{
+    static const GUID hiddenByDefault[] =
+    {
+        { 0x208d2c60, 0x3aea, 0x1069, { 0xa2, 0xd7, 0x08, 0x00, 0x2b, 0x30, 0x30, 0x9d } }, /* Network */
+        { 0x871c5380, 0x42a0, 0x1069, { 0xa2, 0xea, 0x08, 0x00, 0x2b, 0x30, 0x30, 0x9d } }, /* Internet */
+        { 0x450d8fba, 0xad25, 0x11d0, { 0x98, 0xa8, 0x08, 0x00, 0x36, 0x1b, 0x11, 0x03 } }, /* Documents */
+        { 0x59031a47, 0x3f72, 0x44a7, { 0x89, 0xc5, 0x55, 0x95, 0xfe, 0x6b, 0x30, 0xee } }, /* the user's files */
+        { 0x21ec2020, 0x3aea, 0x1069, { 0xa2, 0xdd, 0x08, 0x00, 0x2b, 0x30, 0x30, 0x9d } }, /* Control Panel */
+        { 0x5399e694, 0x6ce5, 0x4d6c, { 0x8f, 0xce, 0x1d, 0x88, 0x70, 0xfd, 0xcb, 0xa0 } }, /* ... as Windows 10 names it */
+    };
+    const BOOL NewStart = SHELL_GetSetting(SSF_STARTPANELON, fStartPanelOn);
+    WCHAR path[MAX_PATH], name[CHARS_IN_GUID];
+    BOOL bDefault = FALSE;
+
+    for (UINT i = 0; i < _countof(hiddenByDefault); i++)
+    {
+        if (IsEqualGUID(Clsid, hiddenByDefault[i]))
+            bDefault = TRUE;
+    }
+    wsprintfW(path, L"%s\\%s", REGSTR_PATH_EXPLORER,
+              NewStart ? L"HideDesktopIcons\\NewStartPanel" : L"HideDesktopIcons\\ClassicStartMenu");
+    SHELL32_GUIDToStringW(Clsid, name);
+    return SHRegGetBoolUSValueW(path, name, FALSE, bDefault);
+}
+
 HRESULT WINAPI CDesktopFolderViewCB::ShouldShow(IShellFolder *psf, PCIDLIST_ABSOLUTE pidlFolder, PCUITEMID_CHILD pidlItem)
 {
     const CLSID* pClsid;
     if (IsProgmanHostedBrowser() && (pClsid = IsRegItem(pidlItem)) != NULL)
     {
-        const BOOL NewStart = SHELL_GetSetting(SSF_STARTPANELON, fStartPanelOn);
-        LPCWSTR SubKey = NewStart ? L"HideDesktopIcons\\NewStartPanel" : L"HideDesktopIcons\\ClassicStartMenu";
-        return SHELL32_IsShellFolderNamespaceItemHidden(SubKey, *pClsid) ? S_FALSE : S_OK;
+        /* Arctic: what Desktop Icon Settings (desk.cpl) shows checked, and
+           nothing else: by default This PC and the Recycle Bin are there, the
+           network, the user's files, the Control Panel and Internet Explorer
+           are not, as the dialog says (SHELL32_DesktopIconHidden) */
+        return SHELL32_DesktopIconHidden(*pClsid) ? S_FALSE : S_OK;
     }
     return S_OK;
 }
