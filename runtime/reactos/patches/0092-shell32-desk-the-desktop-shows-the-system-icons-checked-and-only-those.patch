+    {TEXT("{645FF040-5081-101B-9F08-00AA002F954E}"), IDC_ICONS_RECYCLE, FALSE}, /* Recycle Bin */
+    {TEXT("{450D8FBA-AD25-11D0-98A8-0800361B1103}"), IDC_ICONS_MYDOCS, TRUE},   /* Documents */
+    {TEXT("{21EC2020-3AEA-1069-A2DD-08002B30309D}"), IDC_ICONS_CPANEL, TRUE},   /* Control Panel */
+    {TEXT("{208D2C60-3AEA-1069-A2D7-08002B30309D}"), IDC_ICONS_MYNET, TRUE},    /* Network */
 };
 
 static const TCHAR szUserClass[] = TEXT("Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\CLSID\\");
@@ -71,7 +76,8 @@
 
     for (i = 0; i < _countof(pData->optIcons); i++)
     {
-        pData->optIcons[i].bHideClassic = SHRegGetBoolUSValue(regPath, DesktopIcons[i].CLSID, FALSE, FALSE);
+        pData->optIcons[i].bHideClassic = SHRegGetBoolUSValue(regPath, DesktopIcons[i].CLSID, FALSE,
+                                                              DesktopIcons[i].HiddenByDefault);
     }
 
     StringCchCopy(regPath, _countof(regPath), szHideDesktopIcons);
@@ -79,7 +85,8 @@
 
     for (i = 0; i < _countof(pData->optIcons); i++)
     {
-        pData->optIcons[i].bHideNewStart = SHRegGetBoolUSValue(regPath, DesktopIcons[i].CLSID, FALSE, TRUE);
+        pData->optIcons[i].bHideNewStart = SHRegGetBoolUSValue(regPath, DesktopIcons[i].CLSID, FALSE,
+                                                               DesktopIcons[i].HiddenByDefault);
     }
 
     for (i = 0; i < _countof(IconChange); i++)
@@ -162,7 +169,7 @@
     StringCchCopy(regPath, _countof(regPath), szHideDesktopIcons);
     StringCchCat(regPath, _countof(regPath), bNewStart ? szNewStartPanel : szClassicStartMenu);
 
-    return SHRegGetBoolUSValue(regPath, DesktopIcons[i].CLSID, FALSE, bNewStart);
+    return SHRegGetBoolUSValue(regPath, DesktopIcons[i].CLSID, FALSE, DesktopIcons[i].HiddenByDefault);
 }
 
