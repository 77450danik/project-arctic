+/* Arctic: whether an item is checked by default (its DefaultValue is its CheckedValue) */
+static BOOL IsCheckedByDefault(HKEY hKey)
+{
+    DWORD dwDefault = 0, dwChecked = 0, cb = sizeof(DWORD);
+    if (SHRegGetValueW(hKey, NULL, L"DefaultValue", SRRF_RT_DWORD, NULL, &dwDefault, &cb) != ERROR_SUCCESS)
