+/* Arctic: Windows 10's friendly dates in the list (Folder Options: "Use friendly
+ * dates", Explorer\Advanced\FriendlyDates, on by default): within the hour "N
+ * minutes ago", earlier today "N hours ago", then "Yesterday, 12:30" */
+static BOOL FormatFriendlyDate(const FILETIME &ft, LPWSTR Buf, UINT cchBuf)
+{
+    DWORD dwFriendly = TRUE, cb = sizeof(dwFriendly);
+    SHGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
+                L"FriendlyDates", NULL, &dwFriendly, &cb);
+    if (!dwFriendly)
+        return FALSE;
+
+    FILETIME now, lft, lnow;
+    SYSTEMTIME st, stNow;
+    WCHAR szFormat[64], szTime[40];
+    GetSystemTimeAsFileTime(&now);
+    ULONGLONG then = ((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    ULONGLONG cur = ((ULONGLONG)now.dwHighDateTime << 32) | now.dwLowDateTime;
+    if (then > cur)
+        return FALSE; /* the future: the date itself */
+    ULONGLONG minutes = (cur - then) / (60ULL * 10000000ULL);
+
+    FileTimeToLocalFileTime(&ft, &lft);
+    FileTimeToSystemTime(&lft, &st);
+    FileTimeToLocalFileTime(&now, &lnow);
+    FileTimeToSystemTime(&lnow, &stNow);
+    BOOL today = st.wYear == stNow.wYear && st.wMonth == stNow.wMonth && st.wDay == stNow.wDay;
+
+    if (minutes < 60)
+    {
+        UINT n = max((UINT)minutes, 1u);
+        LoadStringW(shell32_hInstance, n == 1 ? IDS_FRIENDLY_MINUTE : IDS_FRIENDLY_MINUTES, szFormat, _countof(szFormat));
+        return SUCCEEDED(StringCchPrintfW(Buf, cchBuf, szFormat, n));
+    }
+    if (today)
+    {
+        UINT n = (UINT)(minutes / 60);
+        LoadStringW(shell32_hInstance, n == 1 ? IDS_FRIENDLY_HOUR : IDS_FRIENDLY_HOURS, szFormat, _countof(szFormat));
+        return SUCCEEDED(StringCchPrintfW(Buf, cchBuf, szFormat, n));
+    }
+    /* yesterday: the local day before today */
+    FILETIME yday = lnow;
+    ULARGE_INTEGER y;
+    y.LowPart = yday.dwLowDateTime;
+    y.HighPart = yday.dwHighDateTime;
+    y.QuadPart -= 24ULL * 60 * 60 * 10000000ULL;
+    yday.dwLowDateTime = y.LowPart;
+    yday.dwHighDateTime = y.HighPart;
+    SYSTEMTIME stY;
+    FileTimeToSystemTime(&yday, &stY);
+    if (st.wYear == stY.wYear && st.wMonth == stY.wMonth && st.wDay == stY.wDay)
+    {
+        LoadStringW(shell32_hInstance, IDS_FRIENDLY_YESTERDAY, szFormat, _countof(szFormat));
+        GetTimeFormatW(LOCALE_USER_DEFAULT, TIME_NOSECONDS, &st, NULL, szTime, _countof(szTime));
+        return SUCCEEDED(StringCchPrintfW(Buf, cchBuf, L"%s, %s", szFormat, szTime));
+    }
+    return FALSE;
+}
+
 HRESULT CFSFolder::FormatDateTime(const FILETIME &ft, LPWSTR Buf, UINT cchBuf)
 {
     FILETIME lft;
     SYSTEMTIME time;
+    if (FormatFriendlyDate(ft, Buf, cchBuf))
+        return S_OK;
     FileTimeToLocalFileTime(&ft, &lft);
     FileTimeToSystemTime(&lft, &time);
     UINT ret = GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, &time, NULL, Buf, cchBuf);
