+/* Arctic: Folder Options' "Hide empty drives" (Explorer\Advanced\
+ * HideDrivesWithNoMedia, on by default): a card reader or a disc drive with
+ * nothing in it is not shown in This PC, as in Windows */
+static BOOL HideEmptyDrive(LPCWSTR pszRoot)
+{
+    DWORD dwHide = TRUE, cb = sizeof(dwHide);
+    UINT uType = GetDriveTypeW(pszRoot);
+    if (uType != DRIVE_REMOVABLE && uType != DRIVE_CDROM)
+        return FALSE;
+    SHGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
+                L"HideDrivesWithNoMedia", NULL, &dwHide, &cb);
+    if (!dwHide)
+        return FALSE;
+    /* floppies are never asked: that would spin the drive */
+    extern BOOL IsDriveFloppyW(LPCWSTR pszDriveRoot);
+    if (uType == DRIVE_REMOVABLE && IsDriveFloppyW(pszRoot))
+        return FALSE;
+    UINT oldMode = SetErrorMode(SEM_FAILCRITICALERRORS);
+    BOOL bEmpty = !GetVolumeInformationW(pszRoot, NULL, 0, NULL, NULL, NULL, NULL, 0);
+    SetErrorMode(oldMode);
+    return bEmpty;
+}
