+/* Arctic: the pop-up description of a file or a folder (IQueryInfo), as
+ * Windows 10 shows it in File Explorer and on the desktop:
+ *   a file:   Item type / Size / Date modified
+ *   a folder: Date created, and with Folder Options' "Display file size
+ *             information in folder tips" its size (counted for a second at
+ *             most), the folders and the files in it */
+class CFSInfoTip : public IQueryInfo
+{
+    LONG m_cRef;
+    WCHAR m_szPath[MAX_PATH];
+
+    static void AppendLine(CStringW &tip, UINT idLabel, LPCWSTR pszValue)
+    {
+        WCHAR szLabel[80];
+        LoadStringW(shell32_hInstance, idLabel, szLabel, _countof(szLabel));
+        if (!tip.IsEmpty())
+            tip += L"\n";
+        tip += szLabel;
+        tip += L": ";
+        tip += pszValue;
+    }
+
+    static void FormatTime(const FILETIME *pft, LPWSTR pszOut, UINT cch)
+    {
+        FILETIME local;
+        SYSTEMTIME st;
+        WCHAR szTime[40];
+        FileTimeToLocalFileTime(pft, &local);
+        FileTimeToSystemTime(&local, &st);
+        GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, &st, NULL, pszOut, cch);
+        GetTimeFormatW(LOCALE_USER_DEFAULT, TIME_NOSECONDS, &st, NULL, szTime, _countof(szTime));
+        StringCchCatW(pszOut, cch, L" ");
+        StringCchCatW(pszOut, cch, szTime);
+    }
+
+    static BOOL Shown(const WIN32_FIND_DATAW &fd)
+    {
+        if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L".."))
+            return FALSE;
+        return !(fd.dwFileAttributes & (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM));
+    }
+
+    /* the size of a tree, until the deadline; FALSE when it was not reached */
+    static BOOL TreeSize(LPCWSTR pszDir, ULONGLONG &size, DWORD deadline)
+    {
+        WCHAR szFind[MAX_PATH];
+        WIN32_FIND_DATAW fd;
+        BOOL complete = TRUE;
+        PathCombineW(szFind, pszDir, L"*");
+        HANDLE hFind = FindFirstFileW(szFind, &fd);
+        if (hFind == INVALID_HANDLE_VALUE)
+            return TRUE;
+        do
+        {
+            if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L".."))
+                continue;
+            if ((LONG)(GetTickCount() - deadline) > 0)
+            {
+                complete = FALSE;
+                break;
+            }
+            if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+            {
+                if (fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)
+                    continue;
+                WCHAR szSub[MAX_PATH];
+                PathCombineW(szSub, pszDir, fd.cFileName);
+                if (!TreeSize(szSub, size, deadline))
+                {
+                    complete = FALSE;
+                    break;
+                }
+            }
+            else
+            {
+                size += ((ULONGLONG)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+            }
+        } while (FindNextFileW(hFind, &fd));
+        FindClose(hFind);
+        return complete;
+    }
+
+    void FolderTip(CStringW &tip, const WIN32_FILE_ATTRIBUTE_DATA &data)
+    {
+        WCHAR szValue[MAX_PATH], szFormat[80], szFind[MAX_PATH];
+        FormatTime(&data.ftCreationTime, szValue, _countof(szValue));
+        AppendLine(tip, IDS_INFOTIP_CREATED, szValue);
+
+        DWORD dwSizeTip = TRUE, cb = sizeof(dwSizeTip);
+        SHGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
+                    L"FolderContentsInfoTip", NULL, &dwSizeTip, &cb);
+        if (!dwSizeTip)
+            return;
+
+        CStringW folders, files;
+        WIN32_FIND_DATAW fd;
+        PathCombineW(szFind, m_szPath, L"*");
+        HANDLE hFind = FindFirstFileW(szFind, &fd);
+        BOOL empty = TRUE;
+        if (hFind != INVALID_HANDLE_VALUE)
+        {
+            do
+            {
+                if (!Shown(fd))
+                    continue;
+                empty = FALSE;
+                CStringW &list = (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) ? folders : files;
+                if (list.GetLength() > 60)
+                {
+                    if (list.Right(3) != L"...")
+                        list += L", ...";
+                    continue;
+                }
+                if (!list.IsEmpty())
+                    list += L", ";
+                list += fd.cFileName;
+            } while (FindNextFileW(hFind, &fd));
+            FindClose(hFind);
+        }
+        if (empty)
+        {
+            LoadStringW(shell32_hInstance, IDS_INFOTIP_EMPTYFOLDER, szValue, _countof(szValue));
+            tip += L"\n";
+            tip += szValue;
+            return;
+        }
+        ULONGLONG size = 0;
+        BOOL complete = TreeSize(m_szPath, size, GetTickCount() + 1000);
+        WCHAR szSize[64];
+        StrFormatByteSizeW(size, szSize, _countof(szSize));
+        LoadStringW(shell32_hInstance, complete ? IDS_INFOTIP_FOLDERSIZE : IDS_INFOTIP_FOLDERMORE, szFormat, _countof(szFormat));
+        StringCchPrintfW(szValue, _countof(szValue), szFormat, szSize);
+        tip += L"\n";
+        tip += szValue;
+        if (!folders.IsEmpty())
+        {
+            LoadStringW(shell32_hInstance, IDS_INFOTIP_FOLDERS, szFormat, _countof(szFormat));
+            CStringW line;
+            line.Format(szFormat, folders.GetString());
+            tip += L"\n" + line;
+        }
+        if (!files.IsEmpty())
+        {
+            LoadStringW(shell32_hInstance, IDS_INFOTIP_FILES, szFormat, _countof(szFormat));
+            CStringW line;
+            line.Format(szFormat, files.GetString());
+            tip += L"\n" + line;
+        }
+    }
+
+public:
+    CFSInfoTip(LPCWSTR pszPath) : m_cRef(1)
+    {
+        StringCchCopyW(m_szPath, _countof(m_szPath), pszPath);
+    }
+    virtual ~CFSInfoTip() {}
+
+    STDMETHODIMP QueryInterface(REFIID riid, void **ppv) override
+    {
+        if (IsEqualIID(riid, IID_IUnknown) || IsEqualIID(riid, IID_IQueryInfo))
+        {
+            *ppv = static_cast<IQueryInfo *>(this);
+            AddRef();
+            return S_OK;
+        }
+        *ppv = NULL;
+        return E_NOINTERFACE;
+    }
+    STDMETHODIMP_(ULONG) AddRef() override { return InterlockedIncrement(&m_cRef); }
+    STDMETHODIMP_(ULONG) Release() override
+    {
+        LONG ref = InterlockedDecrement(&m_cRef);
+        if (!ref)
+            delete this;
+        return ref;
+    }
+
+    STDMETHODIMP GetInfoTip(DWORD dwFlags, WCHAR **ppwszTip) override
+    {
+        WIN32_FILE_ATTRIBUTE_DATA data;
+        CStringW tip;
+        WCHAR szValue[MAX_PATH];
+
+        *ppwszTip = NULL;
+        if (!GetFileAttributesExW(m_szPath, GetFileExInfoStandard, &data))
+            return E_FAIL;
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        {
+            FolderTip(tip, data);
+        }
+        else
+        {
+            SHFILEINFOW sfi = {};
+            if (SHGetFileInfoW(m_szPath, data.dwFileAttributes, &sfi, sizeof(sfi), SHGFI_TYPENAME | SHGFI_USEFILEATTRIBUTES))
+                AppendLine(tip, IDS_INFOTIP_ITEMTYPE, sfi.szTypeName);
+            StrFormatByteSizeW(((ULONGLONG)data.nFileSizeHigh << 32) | data.nFileSizeLow, szValue, _countof(szValue));
+            AppendLine(tip, IDS_INFOTIP_SIZE, szValue);
+            FormatTime(&data.ftLastWriteTime, szValue, _countof(szValue));
+            AppendLine(tip, IDS_INFOTIP_MODIFIED, szValue);
+        }
+        return SHStrDupW(tip, ppwszTip);
+    }
+
+    STDMETHODIMP GetInfoFlags(DWORD *pdwFlags) override
+    {
+        *pdwFlags = 0;
+        return S_OK;
+    }
+};
