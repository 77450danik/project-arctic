+    cb = sizeof(DWORD);
+    if (SHRegGetValueW(hKey, NULL, L"CheckedValue", SRRF_RT_DWORD, NULL, &dwChecked, &cb) != ERROR_SUCCESS)
+        return FALSE;
+    return dwDefault == dwChecked;
+}
