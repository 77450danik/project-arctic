+/* Arctic: the top level, as Windows 10 has it: Quick access, This PC, Network;
+ * with "Show all folders", Quick access and the desktop with all under it */
+void CExplorerBand::_InsertRoots()
+{
+    m_bShowAllFolders = NavPaneShowsAllFolders();
+    _InsertQuickAccess();
+    if (m_bShowAllFolders)
+    {
+        CComHeapPtr<ITEMIDLIST> pidl;
+        if (SUCCEEDED(SHGetFolderLocation(NULL, CSIDL_DESKTOP, NULL, 0, &pidl)))
+        {
+            HTREEITEM hDesktop = _InsertItem(NULL, m_pDesktop, pidl, pidl, FALSE);
+            if (hDesktop)
+                TreeView_Expand(m_hwndTreeView, hDesktop, TVE_EXPAND);
+        }
+    }
+    else
+    {
+        _InsertTopFolder(CSIDL_DRIVES);
+        _InsertTopFolder(CSIDL_NETWORK);
+    }
+}
+
+void CExplorerBand::_OnSettingChange()
+{
+    if (!m_hwndTreeView || NavPaneShowsAllFolders() == m_bShowAllFolders)
+        return;
+    ++m_mtxBlockNavigate;
+    m_hwndTreeView.SendMessage(WM_SETREDRAW, FALSE, 0);
+    TreeView_DeleteAllItems(m_hwndTreeView);
+    m_hQuickAccess = NULL;
+    _InsertRoots();
+    m_hwndTreeView.SendMessage(WM_SETREDRAW, TRUE, 0);
+    --m_mtxBlockNavigate;
+    _NavigateToCurrentFolder();
+}
