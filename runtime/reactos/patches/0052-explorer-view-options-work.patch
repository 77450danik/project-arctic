 HRESULT STDMETHODCALLTYPE CShellBrowser::v_MayTranslateAccelerator(MSG *pmsg)
 {
+    /* Arctic: with the menu bar hidden, Alt alone or F10 shows it, Alt with a
+     * letter shows it and opens that menu (the menu band takes the key next);
+     * Esc, Alt again, a click outside it or a command hide it again */
+    /* the menu bar's keys work the same when it is always shown, it only does
+     * not hide then */
+    {
+        switch (pmsg->message)
+        {
+            case WM_SYSKEYDOWN:
+                if (pmsg->wParam == VK_MENU)
+                {
+                    if (!(pmsg->lParam & 0x40000000))
+                        m_bAltAlone = TRUE;
+                }
+                else
+                {
+                    m_bAltAlone = FALSE;
+                    if (pmsg->wParam == VK_F10 && !m_bMenuShownByKey)
+                    {
+                        _ShowKeyMenu();
+                        return S_OK;
+                    }
+                }
+                break;
+            case WM_SYSCHAR:
+            case WM_CHAR:
+            {
+                /* Alt+letter, or a letter while the menu bar has the keys: the
+                 * menu with that underlined letter opens. The typed character, so
+                 * that "&Файл" opens with Ф in the Ukrainian layout */
+                if (pmsg->message == WM_CHAR && !m_bMenuShownByKey)
+                    break;
+                int index = _FindMenuMnemonic((WCHAR)pmsg->wParam);
+                if (index >= 0)
+                {
+                    if (!m_bMenuShownByKey)
+                        _ShowKeyMenu();
+                    _OpenMenuItem(index);
+                    return S_OK;
+                }
+                break;
+            }
+            case WM_SYSKEYUP:
+                if (pmsg->wParam == VK_MENU && m_bAltAlone)
+                {
+                    m_bAltAlone = FALSE;
+                    if (m_bMenuShownByKey)
+                    {
+                        _HideKeyMenu();
+                        return S_OK;
+                    }
+                    _ShowKeyMenu();
+                    return S_OK;
+                }
+                break;
+            case WM_KEYDOWN:
+                m_bAltAlone = FALSE;
+                if (pmsg->wParam == VK_ESCAPE)
+                {
+                    if (m_bMenuShownByKey)
+                    {
+                        _HideKeyMenu();
+                        return S_OK;
+                    }
+                }
+                else if (m_bMenuShownByKey)
+                {
+                    /* the menu bar has the keys while it is shown by them */
+                    HWND hwndTb = _GetMenuToolbar();
+                    int count = hwndTb ? (int)::SendMessageW(hwndTb, TB_BUTTONCOUNT, 0, 0) : 0;
+                    int hot = hwndTb ? (int)::SendMessageW(hwndTb, TB_GETHOTITEM, 0, 0) : -1;
+                    if (count > 0 && (pmsg->wParam == VK_LEFT || pmsg->wParam == VK_RIGHT))
+                    {
+                        hot = (hot < 0 ? 0 : hot + (pmsg->wParam == VK_RIGHT ? 1 : count - 1)) % count;
+                        ::SendMessageW(hwndTb, TB_SETHOTITEM, hot, 0);
+                        return S_OK;
+                    }
+                    if (count > 0 && (pmsg->wParam == VK_DOWN || pmsg->wParam == VK_UP || pmsg->wParam == VK_RETURN))
+                    {
+                        _OpenMenuItem(hot < 0 ? 0 : hot);
+                        return S_OK;
+                    }
+                }
+                break;
+            case WM_LBUTTONDOWN:
+            case WM_RBUTTONDOWN:
+            case WM_NCLBUTTONDOWN:
+                m_bAltAlone = FALSE;
+                if (m_bMenuShownByKey)
+                {
+                    HWND hwndMenu = _GetMenuToolbar();
+                    if (!hwndMenu || (pmsg->hwnd != hwndMenu && !::IsChild(hwndMenu, pmsg->hwnd)))
+                        _HideKeyMenu();
+                }
+                break;
+        }
+    }
+
