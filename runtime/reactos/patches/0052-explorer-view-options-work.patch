+BOOL CShellBrowser::_IsMenuBandShown()
+{
+    OLECMD cmd = { ITID_MENUBANDSHOWN, 0 };
+    if (FAILED(IUnknown_QueryStatus(fClientBars[BIInternetToolbar].clientBar, CGID_PrivCITCommands, 1, &cmd, NULL)))
+        return TRUE;
+    return (cmd.cmdf & OLECMDF_LATCHED) != 0;
+}
+
+void CShellBrowser::_ShowMenuBand(BOOL bShow)
+{
+    if (!fClientBars[BIInternetToolbar].clientBar || !bShow == !_IsMenuBandShown())
+        return;
+    IUnknown_Exec(fClientBars[BIInternetToolbar].clientBar, CGID_PrivCITCommands, ITID_MENUBANDSHOWN, 0, NULL, NULL);
+}
+
+/* the toolbar of the menu band: its items are the menus */
+#define ITID_ARCTIC_MENUWINDOW 0x7F01 /* internettoolbar.cpp: the menu band's window */
+HWND CShellBrowser::_GetMenuToolbar()
+{
+    VARIANT var;
+    VariantInit(&var);
+    if (FAILED(IUnknown_Exec(fClientBars[BIInternetToolbar].clientBar, CGID_PrivCITCommands,
+                             ITID_ARCTIC_MENUWINDOW, 0, NULL, &var)) || V_VT(&var) != VT_I8)
+    {
+        return NULL;
+    }
+    HWND hwndMenu = (HWND)(LONG_PTR)V_I8(&var);
+    if (!hwndMenu)
+        return NULL;
+    WCHAR szClass[64];
+    if (GetClassNameW(hwndMenu, szClass, _countof(szClass)) && !wcscmp(szClass, TOOLBARCLASSNAMEW))
+        return hwndMenu;
+    return ::FindWindowExW(hwndMenu, NULL, TOOLBARCLASSNAMEW, NULL);
+}
+
+/* opens a menu as a click on it does */
+void CShellBrowser::_OpenMenuItem(int index)
+{
+    /* the menu band opens a menu on the toolbar's TBN_DROPDOWN, which the rebar
+     * passes up to the toolbars and they to the band (CMenuToolbarBase::ProcessClick) */
+    HWND hwndTb = _GetMenuToolbar();
+    TBBUTTON tb;
+    if (!hwndTb || index < 0 || !::SendMessageW(hwndTb, TB_GETBUTTON, index, (LPARAM)&tb))
+        return;
+    NMTOOLBARW nmtb = {};
+    nmtb.hdr.hwndFrom = hwndTb;
+    nmtb.hdr.idFrom = ::GetDlgCtrlID(hwndTb);
+    nmtb.hdr.code = TBN_DROPDOWN;
+    nmtb.iItem = tb.idCommand;
+    ::SendMessageW(hwndTb, TB_SETHOTITEM, index, 0);
+    ::SendMessageW(::GetParent(hwndTb), WM_NOTIFY, nmtb.hdr.idFrom, (LPARAM)&nmtb);
+}
+
+/* the menu whose underlined letter is ch, or -1 */
+int CShellBrowser::_FindMenuMnemonic(WCHAR ch)
+{
+    HWND hwndTb = _GetMenuToolbar();
+    if (!hwndTb)
+        return -1;
+    int count = (int)::SendMessageW(hwndTb, TB_BUTTONCOUNT, 0, 0);
+    for (int i = 0; i < count; i++)
+    {
+        TBBUTTON tb;
+        WCHAR szText[128];
+        if (!::SendMessageW(hwndTb, TB_GETBUTTON, i, (LPARAM)&tb) ||
+            ::SendMessageW(hwndTb, TB_GETBUTTONTEXTW, tb.idCommand, (LPARAM)szText) <= 0)
+        {
+            continue;
+        }
+        PCWSTR amp = wcschr(szText, L'&');
+        if (amp && amp[1] && towupper(amp[1]) == towupper(ch))
+            return i;
+    }
+    return -1;
+}
+
+/* Alt or F10: the menu bar comes, its first menu marked, as in Windows */
+void CShellBrowser::_ShowKeyMenu()
+{
+    _ShowMenuBand(TRUE);
+    m_bMenuShownByKey = TRUE;
+    if (HWND hwndTb = _GetMenuToolbar())
+        ::SendMessageW(hwndTb, TB_SETHOTITEM, 0, 0);
+}
+
+void CShellBrowser::_HideKeyMenu()
+{
+    if (!m_bMenuShownByKey)
+        return;
+    m_bMenuShownByKey = FALSE;
+    if (HWND hwndTb = _GetMenuToolbar())
+        ::SendMessageW(hwndTb, TB_SETHOTITEM, (WPARAM)-1, 0);
+    if (!MenusAlwaysShown())
+        _ShowMenuBand(FALSE);
+}
