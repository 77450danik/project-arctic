+/* Write where every monitor is to stand, without moving anything yet. Each
+ * one keeps the mode it is set to. */
+static LONG
+WriteMonitorLayout(IN PSETTINGS_DATA pData, IN BOOL bInitial)
+{
+    PDISPLAY_DEVICE_ENTRY Current;
+    LONG rc = DISP_CHANGE_SUCCESSFUL;
+
+    for (Current = pData->DisplayDeviceList; Current != NULL; Current = Current->Flink)
+    {
+        DEVMODE devmode;
+
+        ZeroMemory(&devmode, sizeof(devmode));
+        devmode.dmSize = (WORD)sizeof(devmode);
+        devmode.dmPelsWidth = Current->CurrentSettings->dmPelsWidth;
+        devmode.dmPelsHeight = Current->CurrentSettings->dmPelsHeight;
+        devmode.dmBitsPerPel = Current->CurrentSettings->dmBitsPerPel;
+        devmode.dmDisplayFrequency = Current->CurrentSettings->dmDisplayFrequency;
+        devmode.dmPosition.x = bInitial ? Current->InitialPosition.x : Current->Position.x;
+        devmode.dmPosition.y = bInitial ? Current->InitialPosition.y : Current->Position.y;
+        devmode.dmFields = DM_PELSWIDTH | DM_PELSHEIGHT | DM_BITSPERPEL |
+                           DM_DISPLAYFREQUENCY | DM_POSITION;
+
+        rc = ChangeDisplaySettingsEx(Current->DeviceName,
+                                     &devmode,
+                                     NULL,
+                                     CDS_UPDATEREGISTRY | CDS_NORESET,
+                                     NULL);
+        if (rc != DISP_CHANGE_SUCCESSFUL)
+            break;
+    }
+
+    return rc;
+}
+
+/* The layout the monitors were dragged into. The places go in one by one and
+ * nothing moves until the last call, so the screens switch together; the
+ * system then puts them side by side without gaps and holds the primary one
+ * at the origin, the way Windows does. */
+static VOID
+ApplyMonitorLayout(IN HWND hwndDlg, IN PSETTINGS_DATA pData)
+{
+    TCHAR Message[1024], Title[256];
+    LONG rc;
+
+    rc = WriteMonitorLayout(pData, FALSE);
+    if (rc == DISP_CHANGE_SUCCESSFUL)
+        rc = ChangeDisplaySettingsEx(NULL, NULL, NULL, 0, NULL);
+
+    if (rc == DISP_CHANGE_RESTART)
+    {
+        /* The places are written and the screens take them after a restart */
+        LoadString(hApplet, IDS_DISPLAY_SETTINGS, Title, _countof(Title));
+        LoadString(hApplet, IDS_APPLY_NEEDS_RESTART, Message, _countof(Message));
+        MessageBox(hwndDlg, Message, Title, MB_OK | MB_ICONINFORMATION);
+    }
+    else if (rc != DISP_CHANGE_SUCCESSFUL)
+    {
+        /* Nothing has moved, so the places written so far are taken back */
+        WriteMonitorLayout(pData, TRUE);
+
+        LoadString(hApplet, IDS_DISPLAY_SETTINGS, Title, _countof(Title));
+        LoadString(hApplet, IDS_APPLY_FAILED, Message, _countof(Message));
+        MessageBox(hwndDlg, Message, Title, MB_OK | MB_ICONSTOP);
+    }
+
+    /* Wherever the monitors ended up, that is what the page shows from now on */
+    ReloadMonitorPositions(pData);
+    UpdateMonitorLayout(hwndDlg, pData);
+}
+
 static VOID
 ApplyDisplaySettings(HWND hwndDlg, PSETTINGS_DATA pData)
 {
@@ -1150,6 +1307,9 @@ SettingsPageProc(IN HWND hwndDlg, IN UINT uMsg, IN WPARAM wParam, IN LPARAM lPar
                     /* Apply new settings */
                     ApplyDisplaySettings(hwndDlg, pData);
