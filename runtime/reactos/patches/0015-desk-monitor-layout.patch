     newEntry->DeviceKey = key;
     newEntry->DeviceID = devid;
     newEntry->DeviceStateFlags = DisplayDevice->StateFlags;
+
+    /* Where this monitor stands on the virtual screen. A device that names no
+     * position of its own stays at the origin. */
+    {
+        DEVMODE devmode;
