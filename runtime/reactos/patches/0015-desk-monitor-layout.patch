@@ -1160,6 +1320,17 @@ SettingsPageProc(IN HWND hwndDlg, IN UINT uMsg, IN WPARAM wParam, IN LPARAM lPar
                     Current = Current->Flink;
                 OnDisplayDeviceChanged(hwndDlg, pData, Current);
