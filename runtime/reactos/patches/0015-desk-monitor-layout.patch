+        ZeroMemory(&devmode, sizeof(devmode));
+        devmode.dmSize = (WORD)sizeof(devmode);
+        if (EnumDisplaySettingsEx(DisplayDevice->DeviceName, ENUM_CURRENT_SETTINGS, &devmode, 0) &&
