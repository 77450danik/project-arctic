@@ -427,6 +444,112 @@ OnDisplayDeviceChanged(IN HWND hwndDlg, IN PSETTINGS_DATA pData, IN PDISPLAY_DEV
     UpdateDisplay(hwndDlg, pData, TRUE);
 }
 
+/* How many display devices the list holds */
+static DWORD
+CountDisplayDevices(IN PSETTINGS_DATA pData)
+{
+    PDISPLAY_DEVICE_ENTRY Current;
+    DWORD Count = 0;
+
+    for (Current = pData->DisplayDeviceList; Current != NULL; Current = Current->Flink)
+        Count++;
+
+    return Count;
+}
+
+/* The monitor at this index of the selection control */
+static PDISPLAY_DEVICE_ENTRY
+FindDisplayDeviceByIndex(IN PSETTINGS_DATA pData, IN INT Index)
+{
+    PDISPLAY_DEVICE_ENTRY Current = pData->DisplayDeviceList;
+    INT i;
+
+    if (Index < 0)
+        return NULL;
+
+    for (i = 0; i < Index && Current != NULL; i++)
+        Current = Current->Flink;
+
+    return Current;
+}
+
+/* Show the monitors where they stand now, with the size of the mode each one
+ * is set to. */
+static VOID
+UpdateMonitorLayout(IN HWND hwndDlg, IN PSETTINGS_DATA pData)
+{
+    PDISPLAY_DEVICE_ENTRY Current;
+    PMONSL_MONINFO pMonitors;
+    DWORD Count, i;
+
+    Count = CountDisplayDevices(pData);
+    if (Count == 0)
+        return;
+
+    pMonitors = (PMONSL_MONINFO)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(MONSL_MONINFO) * Count);
+    if (pMonitors == NULL)
+        return;
+
+    Current = pData->DisplayDeviceList;
+    for (i = 0; i < Count && Current != NULL; i++, Current = Current->Flink)
+    {
+        pMonitors[i].Position = Current->Position;
+        pMonitors[i].Size.cx = Current->CurrentSettings->dmPelsWidth;
+        pMonitors[i].Size.cy = Current->CurrentSettings->dmPelsHeight;
+        pMonitors[i].Flags = 0;
+    }
+
+    SendDlgItemMessage(hwndDlg,
+                       IDC_SETTINGS_MONSEL,
+                       MSLM_SETMONITORSINFO,
+                       Count,
+                       (LPARAM)pMonitors);
+
+    HeapFree(GetProcessHeap(), 0, pMonitors);
+}
+
+/* Read back where the monitors ended up: the system puts them side by side
+ * without gaps and holds the primary one at the origin, so the places it
+ * chose are not always the ones that were asked for. */
+static VOID
+ReloadMonitorPositions(IN PSETTINGS_DATA pData)
+{
+    PDISPLAY_DEVICE_ENTRY Current;
+
+    for (Current = pData->DisplayDeviceList; Current != NULL; Current = Current->Flink)
+    {
+        DEVMODE devmode;
+
+        ZeroMemory(&devmode, sizeof(devmode));
+        devmode.dmSize = (WORD)sizeof(devmode);
+        if (EnumDisplaySettingsEx(Current->DeviceName, ENUM_CURRENT_SETTINGS, &devmode, 0) &&
+            (devmode.dmFields & DM_POSITION))
+        {
+            Current->Position.x = devmode.dmPosition.x;
+            Current->Position.y = devmode.dmPosition.y;
+        }
+        Current->InitialPosition = Current->Position;
+    }
+}
+
+/* Has a monitor been dragged somewhere else? */
+static BOOL
+MonitorLayoutChanged(IN PSETTINGS_DATA pData)
+{
+    PDISPLAY_DEVICE_ENTRY Current;
+
+    for (Current = pData->DisplayDeviceList; Current != NULL; Current = Current->Flink)
+    {
+        if (Current->Position.x != Current->InitialPosition.x ||
+            Current->Position.y != Current->InitialPosition.y)
+        {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
