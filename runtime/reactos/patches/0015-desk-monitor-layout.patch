+/* Where the dragged monitor was dropped, in monitor coordinates: the way
+ * back through the scaling MonSelUpdateMonitorsInfo did. */
+static VOID
+MonSelDragRectToPosition(IN PMONITORSELWND infoPtr,
+                         IN DWORD Index,
+                         OUT PPOINT pptPosition)
+{
+    SIZE Extent, Monitors;
+
+    Extent.cx = infoPtr->rcExtent.right - infoPtr->rcExtent.left;
+    Extent.cy = infoPtr->rcExtent.bottom - infoPtr->rcExtent.top;
+    Monitors.cx = infoPtr->rcMonitors.right - infoPtr->rcMonitors.left;
+    Monitors.cy = infoPtr->rcMonitors.bottom - infoPtr->rcMonitors.top;
+
+    if (Monitors.cx < 1 || Monitors.cy < 1)
+    {
+        *pptPosition = infoPtr->MonitorInfo[Index].Position;
+        return;
+    }
+
+    pptPosition->x = infoPtr->rcExtent.left +
+        (((infoPtr->rcDragging.left - infoPtr->rcMonitors.left) * Extent.cx) / Monitors.cx);
+    pptPosition->y = infoPtr->rcExtent.top +
+        (((infoPtr->rcDragging.top - infoPtr->rcMonitors.top) * Extent.cy) / Monitors.cy);
+}
+
+/* The user let a dragged monitor go: it stays where it was dropped and the
+ * parent is told, so that it can lay the monitors out and apply that. A
+ * press that never turned into a drag is just a click. */
+static VOID
+MonSelDropDragging(IN OUT PMONITORSELWND infoPtr)
+{
+    MONSL_MONNMHDR nmh;
+    POINT ptPosition;
+    DWORD Index;
+
+    if (infoPtr->DraggingMonitor < 0)
+        return;
+
+    if (!infoPtr->IsDraggingMonitor)
+    {
+        MonSelCancelDragging(infoPtr);
+        return;
+    }
+
+    Index = (DWORD)infoPtr->DraggingMonitor;
+    MonSelDragRectToPosition(infoPtr,
+                             Index,
+                             &ptPosition);
+
+    infoPtr->DraggingMonitor = -1;
+    infoPtr->IsDraggingMonitor = FALSE;
+
+    ReleaseCapture();
+
+    MonSelApplyCursorClipping(infoPtr,
+                              FALSE);
+
+    infoPtr->MonitorInfo[Index].Position = ptPosition;
+
+    /* The monitor that moved changes the extent of them all, so every
+     * rectangle is scaled anew */
+    MonSelUpdateMonitorsInfo(infoPtr,
+                             FALSE);
+
+    InvalidateRect(infoPtr->hSelf,
+                   NULL,
+                   TRUE);
+
+    MonSelNotifyMonitor(infoPtr,
+                        MSLN_MONITORSMOVED,
+                        (INT)Index,
+                        &nmh);
+}
+
 static VOID
 MonSelInitDragging(IN OUT PMONITORSELWND infoPtr,
                    IN DWORD Index,
