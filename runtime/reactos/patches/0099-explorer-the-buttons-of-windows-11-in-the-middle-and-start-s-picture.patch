+    /* Arctic: now and then the buttons were left at another height than the
+       row's, at the top of the taskbar, until a window came or went and
+       they were measured anew: seen when they are drawn, and measured anew */
+    VOID CheckButtonHeight()
+    {
+        RECT rcItem, rcClient;
+        DWORD dwNow = GetTickCount();
+
+        if (!m_ButtonCount || !m_Tray->IsHorizontal() || dwNow - m_dwHeightFixed < 1000 ||
+            !GetClientRect(&rcClient) || !m_TaskBar.SendMessageW(TB_GETITEMRECT, 0, (LPARAM)&rcItem))
+            return;
+        if (rcItem.bottom - rcItem.top != min((LONG)ArcticRowHeight(), rcClient.bottom))
+        {
+            m_dwHeightFixed = dwNow;
+            PostMessageW(TSWM_ARCTIC_RESIZE, 0, 0);
+        }
+    }
+
+    LRESULT OnArcticResize(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        UpdateButtonsSize(FALSE);
+        return 0;
+    }
+
+    /* Arctic: a taskbar with its buttons in the middle places them by this */
+    VOID ReportGroupWidth()
+    {
+        LONG cx = 0;
+
+        if (m_ButtonCount > 0)
+        {
+            if (m_Tray->IsHorizontal() && m_ButtonsPerLine >= m_ButtonCount)
+            {
+                TBMETRICS tbm = { 0 };
+                tbm.cbSize = sizeof(tbm);
+                tbm.dwMask = TBMF_BUTTONSPACING;
+                m_TaskBar.GetMetrics(&tbm);
+                cx = m_ButtonCount * (m_ButtonSize.cx + tbm.cxButtonSpacing) - tbm.cxButtonSpacing;
+            }
+            else
+                cx = -1;
+        }
+        if (cx != m_GroupWidth)
+        {
+            m_GroupWidth = cx;
+            ::SendMessageW(m_Tray->GetHWND(), TWM_ARCTICTASKSWIDTH, (WPARAM)cx, 0);
+        }
+    }
+
+    LRESULT OnArcticIndent(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        if ((INT)wParam != m_Indent)
+        {
+            m_Indent = (INT)wParam;
+            m_TaskBar.SendMessageW(TB_SETINDENT, m_Indent, 0);
+            PublishMinimizeRects();
+        }
+        return 0;
+    }
+
+    /* the page Buttons: other buttons, made anew */
+    LRESULT OnArcticTaskbarOptions(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
