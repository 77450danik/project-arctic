+/* how the task buttons look and where they stand, read once and again when
+ * the page says they changed */
+static DWORD s_dwTaskbarStyle = (DWORD)-1, s_dwTaskbarAlignment;
+
+VOID ArcticTaskbarOptionsReload(VOID)
+{
+    DWORD cb = sizeof(DWORD);
+
+    s_dwTaskbarStyle = s_dwTaskbarAlignment = 1;
+    RegGetValueW(HKEY_CURRENT_USER, L"Software\\Arctic\\Taskbar", L"ButtonStyle", RRF_RT_REG_DWORD, NULL,
+                 &s_dwTaskbarStyle, &cb);
+    cb = sizeof(DWORD);
+    RegGetValueW(HKEY_CURRENT_USER, L"Software\\Arctic\\Taskbar", L"Alignment", RRF_RT_REG_DWORD, NULL,
+                 &s_dwTaskbarAlignment, &cb);
+}
+
+BOOL ArcticTaskbarStyle11(VOID)
+{
+    if (s_dwTaskbarStyle == (DWORD)-1)
+        ArcticTaskbarOptionsReload();
+    return s_dwTaskbarStyle == 1;
+}
+
+BOOL ArcticTaskbarCentered(VOID)
+{
+    if (s_dwTaskbarStyle == (DWORD)-1)
+        ArcticTaskbarOptionsReload();
+    return s_dwTaskbarAlignment == 1;
+}
+
+HWND ArcticWidgetCreate(IN HWND hwndTray)
+{
+    typedef HWND (WINAPI *PFN_CREATE)(HWND);
+    PFN_CREATE pCreate = (PFN_CREATE)ArcticProc(L"startui.dll", "ArcticWidgetCreate");
+
+    return pCreate ? pCreate(hwndTray) : NULL;
+}
+
+INT ArcticWidgetWidth(VOID)
+{
+    typedef INT (WINAPI *PFN_WIDTH)(VOID);
+    PFN_WIDTH pWidth = (PFN_WIDTH)ArcticProc(L"startui.dll", "ArcticWidgetWidth");
+
+    return pWidth ? pWidth() : 0;
+}
+
+VOID ArcticTaskbarPaintButton(IN HDC hdc, IN const RECT *prc, IN DWORD dwFlags)
+{
+    typedef VOID (WINAPI *PFN_PAINT)(HDC, const RECT *, DWORD);
+    PFN_PAINT pPaint = (PFN_PAINT)ArcticProc(L"startui.dll", "ArcticTaskbarPaintButton");
+
+    if (pPaint)
+        pPaint(hdc, prc, dwFlags);
+}
+
+BOOL ArcticStartButtonImageSize(IN INT cyButton, OUT SIZE *pSize)
+{
+    typedef BOOL (WINAPI *PFN_SIZE)(INT, SIZE *);
+    PFN_SIZE pSizeOf = (PFN_SIZE)ArcticProc(L"startui.dll", "ArcticStartButtonImageSize");
+
+    return pSizeOf && pSizeOf(cyButton, pSize);
+}
+
+BOOL ArcticStartButtonImagePaint(IN HDC hdc, IN const RECT *prc, IN DWORD dwFlags)
+{
+    typedef BOOL (WINAPI *PFN_PAINT)(HDC, const RECT *, DWORD);
+    PFN_PAINT pPaint = (PFN_PAINT)ArcticProc(L"startui.dll", "ArcticStartButtonImagePaint");
+
+    return pPaint && pPaint(hdc, prc, dwFlags);
+}
+
+BOOL ArcticTaskbarJumpList(IN HWND hwndOwner, IN const HWND *phwnd, IN UINT cCount, IN const RECT *prcButton)
+{
+    typedef BOOL (WINAPI *PFN_JUMPLIST)(HWND, const HWND *, UINT, const RECT *);
+    PFN_JUMPLIST pJumpList = (PFN_JUMPLIST)ArcticProc(L"startui.dll", "ArcticTaskbarJumpList");
+
+    return pJumpList && pJumpList(hwndOwner, phwnd, cCount, prcButton);
+}
+
+/* the taskbar's own menu, its items as they are, drawn as the taskbar's style has it */
+BOOL ArcticTrackTaskbarMenu(IN HMENU hMenu, IN HWND hwndOwner, IN const POINT *ppt, OUT UINT *puCommand)
+{
+    typedef BOOL (WINAPI *PFN_TRACK)(HMENU, HWND, const POINT *, UINT *);
+    PFN_TRACK pTrack = (PFN_TRACK)ArcticProc(L"startui.dll", "ArcticTrackTaskbarMenu");
+
+    return pTrack && pTrack(hMenu, hwndOwner, ppt, puCommand);
+}
+
 /* Windows 11's notification center over its calendar (startui.dll): the
  * clock opens it, and every notification goes there */
 BOOL ArcticClockFlyoutToggle(IN HWND hwndTray, IN const RECT *prcClock)
