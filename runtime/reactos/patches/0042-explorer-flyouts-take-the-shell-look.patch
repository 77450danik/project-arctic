+/* the gear of Language preferences, as Segoe MDL2 Assets' Settings: a ring
+ * with eight teeth around a hole, sampled 4 x 4 a pixel on a 16 unit grid */
+static float GearRadius(float angle)
+{
+    const float tooth = 0.785398f; /* 45 degrees between teeth */
+    float a = fmodf(angle + 8 * tooth, tooth) - tooth / 2;
+
+    /* a tooth over 30 of the 45 degrees, slightly tapered */
+    return fabsf(a) < 0.20f ? 7.6f : fabsf(a) < 0.30f ? 7.6f - (fabsf(a) - 0.20f) * 18.0f : 5.8f;
+}
+
+static void DrawGear(HDC hdc, int x, int y, int size, COLORREF color)
+{
+    BITMAPINFO bi;
+    DWORD *pBits;
+    HBITMAP hbm;
+
+    ZeroMemory(&bi, sizeof(bi));
+    bi.bmiHeader.biSize = sizeof(bi.bmiHeader);
+    bi.bmiHeader.biWidth = size;
+    bi.bmiHeader.biHeight = -size;
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    hbm = CreateDIBSection(hdc, &bi, DIB_RGB_COLORS, (void **)&pBits, NULL, 0);
+    if (!hbm)
+        return;
+    for (int py = 0; py < size; py++)
+    {
+        for (int px = 0; px < size; px++)
+        {
+            int hits = 0;
+            for (int j = 0; j < 4; j++)
+            {
+                for (int i = 0; i < 4; i++)
+                {
+                    float sx = (px + (i + 0.5f) / 4) * 16.0f / size - 8, sy = (py + (j + 0.5f) / 4) * 16.0f / size - 8;
+                    float d = sqrtf(sx * sx + sy * sy), r = GearRadius(atan2f(sy, sx));
+                    /* the outline of the toothed ring, one unit wide, and the hole's edge */
+                    if ((d <= r && d >= r - 1.15f) || fabsf(d - 2.7f) <= 0.55f)
+                        hits++;
+                    else if (d <= r && d >= 5.8f - 1.15f && r > 6.0f && d <= 5.8f)
+                        hits++;
+                }
+            }
+            DWORD a = hits * 255 / 16;
+            pBits[py * size + px] = (a << 24) | ((GetRValue(color) * a / 255) << 16) |
+                                    ((GetGValue(color) * a / 255) << 8) | (GetBValue(color) * a / 255);
+        }
+    }
+    HDC hdcMem = CreateCompatibleDC(hdc);
+    HGDIOBJ hOld = SelectObject(hdcMem, hbm);
+    BLENDFUNCTION bf = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    GdiAlphaBlend(hdc, x, y, size, size, hdcMem, 0, 0, size, size, bf);
+    SelectObject(hdcMem, hOld);
+    DeleteDC(hdcMem);
+    DeleteObject(hbm);
+}
+
+/* Arctic: the shell's look (startui.dll, the taskbar's page Оформлення) */
+static void ArcticShellLook(HWND hWnd)
+{
+    typedef VOID (WINAPI *PFN_LOOK)(HWND);
+    HMODULE hModule = LoadLibraryW(L"startui.dll");
+    PFN_LOOK pLook = hModule ? (PFN_LOOK)GetProcAddress(hModule, "ArcticApplyShellLook") : NULL;
+
+    if (pLook)
+        pLook(hWnd);
+}
