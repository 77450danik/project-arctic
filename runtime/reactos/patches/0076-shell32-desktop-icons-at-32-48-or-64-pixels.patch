+/* Arctic: the desktop's icons at 32, 48 or 64 pixels (at 100 %), picked in
+ * its View menu (kept where Windows keeps it) or in the Display panel, which
+ * says so with WM_SETTINGCHANGE "DesktopIconSize". The icons are laid out
+ * again in the grid of the new size. */
+void CDefView::SetDesktopIconSize(INT nLogical, BOOL bSave)
+{
+    HIMAGELIST old;
+
+    if (!IsDesktop())
+        return;
+    if (bSave)
+    {
+        DWORD dwSize = nLogical;
+        SHSetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\Shell\\Bags\\1\\Desktop",
+                    L"IconSize", REG_DWORD, &dwSize, sizeof(dwSize));
+    }
+    if (!(old = SIC_SetDesktopIconSize(nLogical)))
+        return;
+    m_ListView.SetImageList(SIC_GetDesktopImageList(), LVSIL_NORMAL);
+    ImageList_Destroy(old);
+    m_ListView.Arrange(LVA_DEFAULT);
+    m_ListView.Invalidate();
+}
+
 LRESULT CDefView::OnSettingChange(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL &bHandled)
 {
