+/* Arctic: the size of the desktop's icons, 32, 48 (the default, Windows 10's
+ * "Medium icons") or 64 pixels at 100 %, as the desktop's View menu and the
+ * Display panel set it, where Windows keeps it; at the system's scale. The
+ * shell's other views keep the large icons of the system's metrics. */
+INT
+SIC_GetDesktopIconLogicalSize(VOID)
+{
+    DWORD dwSize = 48, cbSize = sizeof(dwSize);
+
+    if (SHGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\Shell\\Bags\\1\\Desktop",
+                    L"IconSize", NULL, &dwSize, &cbSize) != ERROR_SUCCESS ||
+        (dwSize != 32 && dwSize != 48 && dwSize != 64))
+    {
+        dwSize = 48;
+    }
+    return dwSize;
+}
+
+static INT
+SIC_DesktopIconPixels(INT nLogical)
+{
+    HDC hdc = GetDC(NULL);
+    INT dpi = hdc ? GetDeviceCaps(hdc, LOGPIXELSY) : 96;
+
+    if (hdc)
+        ReleaseDC(NULL, hdc);
+    return MulDiv(nLogical, dpi, 96);
+}
