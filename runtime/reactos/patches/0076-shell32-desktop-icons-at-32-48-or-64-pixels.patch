+/* Arctic: large, medium and small icons, 64, 48 and 32 pixels at 100 % (the
+   Display panel offers the same), the one in use checked */
+void CDefViewBckgrndMenu::_FillDesktopViewMenu(HMENU hMenuPart)
+{
+    static const struct { UINT id, text, size; LPCWSTR fallback; } items[] =
+    {
+        { FCIDM_SHVIEW_DESKICON_LARGE,  IDS_DESKICON_LARGE,  64, L"&Large icons" },
+        { FCIDM_SHVIEW_DESKICON_MEDIUM, IDS_DESKICON_MEDIUM, 48, L"&Medium icons" },
+        { FCIDM_SHVIEW_DESKICON_SMALL,  IDS_DESKICON_SMALL,  32, L"&Small icons" },
+    };
+    MENUITEMINFOW mii = { sizeof(mii), MIIM_SUBMENU };
+    INT size = SIC_GetDesktopIconLogicalSize();
+    WCHAR text[64];
+    HMENU hView;
+
+    if (!GetMenuItemInfoW(hMenuPart, FCIDM_SHVIEW_VIEW, FALSE, &mii) || !(hView = mii.hSubMenu))
+    {
+        DeleteMenu(hMenuPart, FCIDM_SHVIEW_VIEW, MF_BYCOMMAND);
+        return;
+    }
+    while (GetMenuItemCount(hView) > 0)
+        DeleteMenu(hView, 0, MF_BYPOSITION);
+    for (UINT i = 0; i < _countof(items); i++)
+    {
+        if (!LoadStringW(shell32_hInstance, items[i].text, text, _countof(text)))
+            StringCchCopyW(text, _countof(text), items[i].fallback);
+        AppendMenuW(hView, MF_STRING, items[i].id, text);
+        if (items[i].size == (UINT)size)
+            CheckMenuRadioItem(hView, FCIDM_SHVIEW_DESKICON_LARGE, FCIDM_SHVIEW_DESKICON_SMALL, items[i].id, MF_BYCOMMAND);
+    }
 }
 
