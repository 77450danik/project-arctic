+/*************************************************************************
+ * Arctic: the desktop's icons
+ *
+ * The list the desktop's view shows, index for index the same icons as the
+ * system's lists, at the size of SIC_GetDesktopIconLogicalSize.
+ */
+HIMAGELIST SIC_GetDesktopImageList(void)
+{
+    if (!sic_hdpa)
+        SIC_Initialize();
+    return ShellDesktopIconList;
+}
+
+/* The desktop's icons at another size: every icon in the cache is taken
+ * again from its file at that size, under the same index. Returns the list
+ * that was in use, for the caller to destroy once its view shows the new one
+ * (SIC_GetDesktopImageList), or NULL if the size stays. */
+HIMAGELIST SIC_SetDesktopIconSize(INT nLogical)
+{
+    INT size = SIC_DesktopIconPixels(nLogical), count, i, pass;
+    HIMAGELIST list, old;
+
+    if (!sic_hdpa)
+        SIC_Initialize();
+    if (!ShellDesktopIconList || size == ShellDesktopIconSize)
+        return NULL;
+
+    EnterCriticalSection(&SHELL32_SicCS);
+    count = ImageList_GetImageCount(ShellBigIconList);
+    list = ImageList_Create(size, size, ImageList_GetFlags(ShellDesktopIconList), count, 100);
+    if (!list || !ImageList_SetImageCount(list, count))
+    {
+        if (list) ImageList_Destroy(list);
+        LeaveCriticalSection(&SHELL32_SicCS);
+        return NULL;
+    }
+    old = ShellDesktopIconList;
+    ShellDesktopIconList = list;
+    ShellDesktopIconSize = size;
+
+    /* plain icons first: a shortcut's arrow is one of them, drawn over the
+       others from the new list */
+    for (pass = 0; pass < 2; pass++)
+    {
+        for (i = 0; i < DPA_GetPtrCount(sic_hdpa); i++)
+        {
+            LPSIC_ENTRY entry = (LPSIC_ENTRY)DPA_GetPtr(sic_hdpa, i);
+            HICON hicon;
+
+            if (!entry || (entry->dwFlags & GIL_FORSHORTCUT) != (pass ? GIL_FORSHORTCUT : 0) ||
+                (INT)entry->dwListIndex >= count)
+                continue;
+            hicon = SIC_LoadDesktopIcon(entry->sSourceFile, entry->dwSourceIndex, entry->dwFlags);
+            if (!hicon)
+                hicon = ImageList_GetIcon(ShellBigIconList, entry->dwListIndex, ILD_TRANSPARENT);
+            if (hicon)
+            {
+                ImageList_ReplaceIcon(list, entry->dwListIndex, hicon);
+                DestroyIcon(hicon);
+            }
+        }
+    }
+    LeaveCriticalSection(&SHELL32_SicCS);
+    TRACE("desktop icons of %d pixels\n", size);
+    return old;
 }
 
