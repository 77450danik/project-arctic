+/* The folders of the user's profile that Windows 10 names and draws its own
+ * way. Windows takes both from each folder's desktop.ini; this table stands
+ * in for those files, as C: cannot hide them yet. */
+static const struct
+{
+    INT csidl; /* -1: the profile's Downloads, which has no CSIDL */
+    UINT idsName;
+    INT idIcon;
+} g_UserFolders[] =
+{
+    { CSIDL_DESKTOPDIRECTORY, IDS_USERFOLDER_DESKTOP,   IDI_SHELL_DESKTOP },
+    { CSIDL_PERSONAL,         IDS_USERFOLDER_DOCUMENTS, IDI_SHELL_MY_DOCUMENTS },
+    { -1,                     IDS_USERFOLDER_DOWNLOADS, IDI_SHELL_DOWNLOADS },
+    { CSIDL_MYMUSIC,          IDS_USERFOLDER_MUSIC,     IDI_SHELL_MY_MUSIC },
+    { CSIDL_MYPICTURES,       IDS_USERFOLDER_PICTURES,  IDI_SHELL_MY_PICTURES },
+    { CSIDL_MYVIDEO,          IDS_USERFOLDER_VIDEOS,    IDI_SHELL_MY_MOVIES },
+};
+
+static BOOL
+SHELL_IsProfile(LPCWSTR pszPath)
+{
+    WCHAR szProfile[MAX_PATH];
+
+    return pszPath && SUCCEEDED(SHGetFolderPathW(NULL, CSIDL_PROFILE, NULL, SHGFP_TYPE_CURRENT, szProfile)) &&
+           !lstrcmpiW(szProfile, pszPath);
+}
+
+/* the index in g_UserFolders of the folder at that path in the profile, or -1 */
+static INT
+SHELL_FindUserFolder(LPCWSTR pszPath)
+{
+    WCHAR szParent[MAX_PATH], szFolder[MAX_PATH];
+
+    StringCchCopyW(szParent, _countof(szParent), pszPath);
+    if (!PathRemoveFileSpecW(szParent) || !SHELL_IsProfile(szParent))
+        return -1;
+
+    for (UINT i = 0; i < _countof(g_UserFolders); i++)
+    {
+        INT csidl = g_UserFolders[i].csidl < 0 ? CSIDL_PROFILE : g_UserFolders[i].csidl;
+        if (FAILED(SHGetFolderPathW(NULL, csidl, NULL, SHGFP_TYPE_CURRENT, szFolder)))
+            continue;
+        if (g_UserFolders[i].csidl < 0 && !PathAppendW(szFolder, L"Downloads"))
+            continue;
+        if (!lstrcmpiW(szFolder, pszPath))
+            return i;
+    }
+    return -1;
+}
