From: 77450danik <dnsystems@email.ua>
Date: Sun, 8 Nov 2026 12:00:00 +0200
Subject: [PATCH] shell32: Folder Options chooses the look of File Explorer.

Windows 11, Windows 10 or classic, on the General page.
---
diff --git a/dll/win32/shell32/dialogs/general.cpp b/dll/win32/shell32/dialogs/general.cpp
index 9e414f3..0631d77 100644
--- a/dll/win32/shell32/dialogs/general.cpp
+++ b/dll/win32/shell32/dialogs/general.cpp
@@ -186,6 +186,7 @@ typedef struct GENERAL_DIALOG
  * privacy boxes are Explorer\ShowRecent and ShowFrequent (1 by default). */
 #define EXPLORER_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer"
 #define LAUNCHTO_THISPC      1
+#define ARCTIC_EXPLORER_KEY  L"Software\\Arctic\\Explorer"
 #define LAUNCHTO_QUICKACCESS 2
 
 static DWORD
@@ -375,6 +376,20 @@ GeneralDlg_OnInitDialog(HWND hwndDlg, PGENERAL_DIALOG pGeneral)
     SendMessageW(hCombo, CB_SETITEMDATA, SendMessageW(hCombo, CB_ADDSTRING, 0, (LPARAM)szText), LAUNCHTO_QUICKACCESS);
     LoadStringW(shell32_hInstance, IDS_LAUNCHTO_THISPC, szText, _countof(szText));
     SendMessageW(hCombo, CB_SETITEMDATA, SendMessageW(hCombo, CB_ADDSTRING, 0, (LPARAM)szText), LAUNCHTO_THISPC);
+    /* Arctic: the look of File Explorer */
+    hCombo = GetDlgItem(hwndDlg, IDC_FOLDER_OPTIONS_EXPLORERSTYLE);
+    for (UINT i = 0; i < 3; i++)
+    {
+        static const struct { UINT ids; DWORD style; } looks[] = { { IDS_EXPLORERSTYLE_WIN11, 2 }, { IDS_EXPLORERSTYLE_WIN10, 1 }, { IDS_EXPLORERSTYLE_CLASSIC, 0 } };
+        DWORD style = GeneralDlg_GetDword(ARCTIC_EXPLORER_KEY, L"Style", 2);
+
+        LoadStringW(shell32_hInstance, looks[i].ids, szText, _countof(szText));
+        INT iItem = (INT)SendMessageW(hCombo, CB_ADDSTRING, 0, (LPARAM)szText);
+        SendMessageW(hCombo, CB_SETITEMDATA, iItem, looks[i].style);
+        if (looks[i].style == style)
+            SendMessageW(hCombo, CB_SETCURSEL, iItem, 0);
+    }
+
     GeneralDlg_StorePrivacyToUI(hwndDlg,
                                 GeneralDlg_GetDword(EXPLORER_KEY L"\\Advanced", L"LaunchTo", LAUNCHTO_QUICKACCESS),
                                 GeneralDlg_GetDword(EXPLORER_KEY, L"ShowRecent", TRUE),
@@ -418,6 +433,10 @@ GeneralDlg_OnApply(HWND hwndDlg, PGENERAL_DIALOG pGeneral)
     INT iSel = (INT)SendMessageW(hCombo, CB_GETCURSEL, 0, 0);
     if (iSel != CB_ERR)
         GeneralDlg_SetDword(EXPLORER_KEY L"\\Advanced", L"LaunchTo", (DWORD)SendMessageW(hCombo, CB_GETITEMDATA, iSel, 0));
+    hCombo = GetDlgItem(hwndDlg, IDC_FOLDER_OPTIONS_EXPLORERSTYLE);
+    iSel = (INT)SendMessageW(hCombo, CB_GETCURSEL, 0, 0);
+    if (iSel != CB_ERR)
+        GeneralDlg_SetDword(ARCTIC_EXPLORER_KEY, L"Style", (DWORD)SendMessageW(hCombo, CB_GETITEMDATA, iSel, 0));
     BOOL bShowRecent = IsDlgButtonChecked(hwndDlg, IDC_FOLDER_OPTIONS_SHOWRECENT) == BST_CHECKED;
     BOOL bShowFrequent = IsDlgButtonChecked(hwndDlg, IDC_FOLDER_OPTIONS_SHOWFREQUENT) == BST_CHECKED;
     if (bShowRecent != !!GeneralDlg_GetDword(EXPLORER_KEY, L"ShowRecent", TRUE) ||
@@ -474,6 +493,7 @@ FolderOptionsGeneralDlg(
                         PropSheet_Changed(GetParent(hwndDlg), hwndDlg);
                     break;
                 case IDC_FOLDER_OPTIONS_LAUNCHTO:
+                case IDC_FOLDER_OPTIONS_EXPLORERSTYLE:
                     if (HIWORD(wParam) == CBN_SELCHANGE)
                         PropSheet_Changed(GetParent(hwndDlg), hwndDlg);
                     break;
