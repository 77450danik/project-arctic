  *              command (it'll be used afterwards for more information
  *              on the operation)
  */
+/* Arctic: the class a verb on a directory comes from: Directory when it has
+ * the verb (shell\cmd, shell\Powershell...), as in Windows, else Folder.
+ * Folder alone fell back to opening the folder with explorer. */
+static LPCWSTR SHELL_DirectoryClass(LPCWSTR lpVerb)
+{
+    WCHAR szKey[MAX_PATH];
+    HKEY hKey;
+
+    if (lpVerb && *lpVerb &&
+        SUCCEEDED(StringCchPrintfW(szKey, _countof(szKey), L"Directory\\shell\\%s\\command", lpVerb)) &&
+        RegOpenKeyExW(HKEY_CLASSES_ROOT, szKey, 0, KEY_READ, &hKey) == ERROR_SUCCESS)
+    {
+        RegCloseKey(hKey);
+        return L"Directory";
+    }
+    return L"Folder";
+}
