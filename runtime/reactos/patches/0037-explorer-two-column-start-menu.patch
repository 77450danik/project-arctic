+    /* Arctic: the menu of startui.dll opens, or closes when it is open */
+    BOOL ArcticToggleStartMenu(BOOL bClick)
+    {
+        typedef VOID (WINAPI *PFN_TOGGLE)(HWND, const RECT *, BOOL);
+        PFN_TOGGLE pToggle;
+        RECT rcButton;
+
+        if (!ArcticStartPanelOn() || !(pToggle = (PFN_TOGGLE)ArcticStartUiProc("ArcticStartMenuToggle")))
+            return FALSE;
+        m_StartButton.GetWindowRect(&rcButton);
+        pToggle(m_hWnd, &rcButton, bClick);
+        m_StartButton.SendMessageW(BM_SETSTATE, ArcticStartMenuVisible(), 0);
+        return TRUE;
+    }
+
+    LRESULT OnArcticStartMenuClosed(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
+    {
+        RaiseStartButton();
+        return 0;
+    }
