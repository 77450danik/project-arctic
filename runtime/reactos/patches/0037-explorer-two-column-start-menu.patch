 #define AUTOHIDE_SHOWN 2
 #define AUTOHIDE_HIDING 3
 
+/* Arctic: the two-column Start menu of startui.dll (docs/start-menu.md),
+ * unless "Classic Start menu" is chosen in the taskbar's properties
+ * (HKCU\Software\Arctic\StartMenu, Classic). It says when it closed. */
+static const UINT g_uArcticStartMenuClosed = RegisterWindowMessageW(L"ArcticStartMenuClosed");
+
+static FARPROC ArcticStartUiProc(LPCSTR pszName)
+{
+    HMODULE hModule = GetModuleHandleW(L"startui.dll");
+
+    if (!hModule)
+        hModule = LoadLibraryW(L"startui.dll");
+    return hModule ? GetProcAddress(hModule, pszName) : NULL;
+}
+
+BOOL ArcticStartPanelOn()
+{
+    DWORD dwClassic = 0, cbData = sizeof(dwClassic);
+
+    SHGetValueW(HKEY_CURRENT_USER, L"Software\\Arctic\\StartMenu", L"Classic", NULL, &dwClassic, &cbData);
+    return !dwClassic && ArcticStartUiProc("ArcticStartMenuToggle") != NULL;
+}
+
+static BOOL ArcticStartMenuVisible()
+{
+    typedef BOOL (WINAPI *PFN_VISIBLE)(VOID);
+    PFN_VISIBLE pVisible = (PFN_VISIBLE)ArcticStartUiProc("ArcticStartMenuVisible");
+
+    return pVisible && pVisible();
+}
+
+static VOID ArcticStartMenuHide()
+{
+    typedef VOID (WINAPI *PFN_HIDE)(VOID);
+    PFN_HIDE pHide = (PFN_HIDE)ArcticStartUiProc("ArcticStartMenuHide");
+
+    if (pHide)
+        pHide();
+}
+
