 }
 
+/* The refresh rates the monitor takes at one resolution and colour depth,
+ * slowest first. */
+static DWORD
+GetRefreshRates(IN LPCTSTR DeviceName, IN PSETTINGS_ENTRY pSettings,
+                OUT DWORD *pRates, IN DWORD cRates)
+{
+    DEVMODE devmode;
+    DWORD iMode = 0, count = 0, i;
+
+    devmode.dmSize = (WORD)sizeof(devmode);
+    devmode.dmDriverExtra = 0;
+
+    while (count < cRates && EnumDisplaySettingsEx(DeviceName, iMode++, &devmode, 0))
+    {
+        if (devmode.dmPelsWidth != pSettings->dmPelsWidth ||
+            devmode.dmPelsHeight != pSettings->dmPelsHeight ||
+            devmode.dmBitsPerPel != pSettings->dmBitsPerPel ||
+            devmode.dmDisplayFrequency <= 1) /* 0 and 1 mean the hardware default */
+        {
+            continue;
+        }
+
+        for (i = 0; i < count; i++)
+        {
+            if (pRates[i] == devmode.dmDisplayFrequency)
+                break;
+        }
+        if (i < count)
+            continue;
+
+        for (i = count; i > 0 && pRates[i - 1] > devmode.dmDisplayFrequency; i--)
+            pRates[i] = pRates[i - 1];
+        pRates[i] = devmode.dmDisplayFrequency;
+        count++;
+    }
+
+    return count;
+}
+
+/* The refresh rate list under the resolution, with the rate of the mode that
+ * is chosen. Nothing to choose from leaves it greyed, as Windows does. */
+static VOID
+UpdateRefreshRates(IN HWND hwndDlg, IN PSETTINGS_DATA pData)
+{
+    PSETTINGS_ENTRY pSettings = pData->CurrentDisplayDevice->CurrentSettings;
+    HWND hwndCombo = GetDlgItem(hwndDlg, IDC_SETTINGS_REFRESH);
+    TCHAR Buffer[64], Hertz[64];
+    DWORD rates[64], count, i;
+
+    if (hwndCombo == NULL)
+        return;
+
+    count = GetRefreshRates(pData->CurrentDisplayDevice->DeviceName, pSettings, rates, _countof(rates));
+    LoadString(hApplet, IDS_HERTZ, Hertz, _countof(Hertz));
+
+    SendMessage(hwndCombo, CB_RESETCONTENT, 0, 0);
+    for (i = 0; i < count; i++)
+    {
+        DWORD index;
+
+        _stprintf(Buffer, Hertz, rates[i]);
+        index = (DWORD)SendMessage(hwndCombo, CB_ADDSTRING, 0, (LPARAM)Buffer);
+        SendMessage(hwndCombo, CB_SETITEMDATA, index, rates[i]);
+        if (rates[i] == pSettings->dmDisplayFrequency)
+            SendMessage(hwndCombo, CB_SETCURSEL, index, 0);
+    }
+    if (count != 0 && SendMessage(hwndCombo, CB_GETCURSEL, 0, 0) == CB_ERR)
+        SendMessage(hwndCombo, CB_SETCURSEL, count - 1, 0);
+
+    EnableWindow(hwndCombo, count > 1);
+    EnableWindow(GetDlgItem(hwndDlg, IDC_SETTINGS_REFRESH_TEXT), count > 1);
+}
