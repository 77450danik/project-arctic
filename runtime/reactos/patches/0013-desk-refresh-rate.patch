diff --git a/dll/cpl/desk/monitorname.c b/dll/cpl/desk/monitorname.c
new file mode 100644
index 0000000..32922e1
--- /dev/null
+++ b/dll/cpl/desk/monitorname.c
@@ -0,0 +1,87 @@
+/*
+ * COPYRIGHT:       See COPYING in the top level directory
+ * PROJECT:         ReactOS Display Control Panel
+ * PURPOSE:         The name a monitor gives for itself in its EDID
+ * PROGRAMMERS:     Project Arctic contributors
+ */
+
+/* The display configuration API is Windows 7, and the applet is built for
+ * Vista; this file is the only one that needs it, and it is kept out of the
+ * shared header so that nothing else changes. */
+#undef WINVER
+#define WINVER 0x601
+#undef _WIN32_WINNT
+#define _WIN32_WINNT 0x601
+
+#include <windows.h>
+#include <string.h>
+#include <strsafe.h>
+
+/* Walks the active display paths and takes the friendly name of the monitor
+ * on the given adapter, the way the display settings of Windows show it. */
+BOOL
+GetMonitorName(IN LPCWSTR pszDevice, OUT LPWSTR pszName, IN DWORD cchName)
+{
+    typedef LONG (WINAPI *PGETSIZES)(UINT32, UINT32 *, UINT32 *);
+    typedef LONG (WINAPI *PQUERY)(UINT32, UINT32 *, DISPLAYCONFIG_PATH_INFO *, UINT32 *,
+                                  DISPLAYCONFIG_MODE_INFO *, DISPLAYCONFIG_TOPOLOGY_ID *);
+    typedef LONG (WINAPI *PGETINFO)(DISPLAYCONFIG_DEVICE_INFO_HEADER *);
+    DISPLAYCONFIG_PATH_INFO *pPaths;
+    DISPLAYCONFIG_MODE_INFO *pModes;
+    PGETSIZES pGetSizes;
+    PGETINFO pGetInfo;
+    PQUERY pQuery;
+    HMODULE hUser32;
+    UINT32 cPaths = 0, cModes = 0, i;
+    BOOL bFound = FALSE;
+
+    hUser32 = GetModuleHandleW(L"user32.dll");
+    pGetSizes = (PGETSIZES)GetProcAddress(hUser32, "GetDisplayConfigBufferSizes");
+    pQuery = (PQUERY)GetProcAddress(hUser32, "QueryDisplayConfig");
+    pGetInfo = (PGETINFO)GetProcAddress(hUser32, "DisplayConfigGetDeviceInfo");
+    if (pGetSizes == NULL || pQuery == NULL || pGetInfo == NULL)
+        return FALSE;
+
+    if (pGetSizes(QDC_ONLY_ACTIVE_PATHS, &cPaths, &cModes) != ERROR_SUCCESS || cPaths == 0)
+        return FALSE;
+
+    pPaths = HeapAlloc(GetProcessHeap(), 0, cPaths * sizeof(*pPaths));
+    pModes = HeapAlloc(GetProcessHeap(), 0, cModes * sizeof(*pModes));
+    if (pPaths != NULL && pModes != NULL &&
+        pQuery(QDC_ONLY_ACTIVE_PATHS, &cPaths, pPaths, &cModes, pModes, NULL) == ERROR_SUCCESS)
+    {
+        for (i = 0; i < cPaths && !bFound; i++)
+        {
+            DISPLAYCONFIG_SOURCE_DEVICE_NAME Source;
+            DISPLAYCONFIG_TARGET_DEVICE_NAME Target;
+
+            ZeroMemory(&Source, sizeof(Source));
+            Source.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+            Source.header.size = sizeof(Source);
+            Source.header.adapterId = pPaths[i].sourceInfo.adapterId;
+            Source.header.id = pPaths[i].sourceInfo.id;
+            if (pGetInfo(&Source.header) != ERROR_SUCCESS ||
+                _wcsicmp(Source.viewGdiDeviceName, pszDevice) != 0)
+            {
+                continue;
+            }
+
+            ZeroMemory(&Target, sizeof(Target));
+            Target.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_TARGET_NAME;
+            Target.header.size = sizeof(Target);
+            Target.header.adapterId = pPaths[i].targetInfo.adapterId;
+            Target.header.id = pPaths[i].targetInfo.id;
+            if (pGetInfo(&Target.header) == ERROR_SUCCESS && Target.monitorFriendlyDeviceName[0] != 0)
+            {
+                StringCchCopyW(pszName, cchName, Target.monitorFriendlyDeviceName);
+                bFound = TRUE;
+            }
+        }
+    }
+
+    if (pPaths != NULL)
+        HeapFree(GetProcessHeap(), 0, pPaths);
+    if (pModes != NULL)
+        HeapFree(GetProcessHeap(), 0, pModes);
+    return bFound;
+}
