+/* Arctic: where File Explorer opens with no folder given, as Windows 10's
+ * Folder Options sets it (Explorer\Advanced\LaunchTo): 1 This PC,
+ * 2 Quick access (the default). With no Quick access folder, This PC. */
+static LPITEMIDLIST _GetLaunchToPidl()
+{
+    DWORD dwLaunchTo = 2, cb = sizeof(dwLaunchTo);
+    LPITEMIDLIST pidl = NULL;
+
+    SHGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
+                L"LaunchTo", NULL, &dwLaunchTo, &cb);
+    if (dwLaunchTo != 1)
+    {
+        WCHAR szQuickAccess[] = L"::{679f85cb-0220-4080-b29b-5540cc05aab6}";
+        if (SUCCEEDED(_ParsePathToPidl(szQuickAccess, &pidl)))
+            return pidl;
+    }
+    if (SUCCEEDED(SHGetSpecialFolderLocation(NULL, CSIDL_DRIVES, &pidl)))
+        return pidl;
+    return _GetDocumentsPidl();
+}
