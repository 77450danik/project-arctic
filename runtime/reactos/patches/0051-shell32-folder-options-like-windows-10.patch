+/* Arctic: the rest of Windows 10's page. "Open File Explorer to" is
+ * Explorer\Advanced\LaunchTo (1 This PC, 2 Quick access, its default); the
+ * privacy boxes are Explorer\ShowRecent and ShowFrequent (1 by default). */
+#define EXPLORER_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer"
+#define LAUNCHTO_THISPC      1
+#define LAUNCHTO_QUICKACCESS 2
+
+static DWORD
+GeneralDlg_GetDword(LPCWSTR pszSubKey, LPCWSTR pszValue, DWORD dwDefault)
+{
+    DWORD dwValue = dwDefault, cb = sizeof(dwValue);
+    if (SHGetValueW(HKEY_CURRENT_USER, pszSubKey, pszValue, NULL, &dwValue, &cb) != ERROR_SUCCESS)
+        return dwDefault;
+    return dwValue;
+}
+
+static void
+GeneralDlg_SetDword(LPCWSTR pszSubKey, LPCWSTR pszValue, DWORD dwValue)
+{
+    SHSetValueW(HKEY_CURRENT_USER, pszSubKey, pszValue, REG_DWORD, &dwValue, sizeof(dwValue));
+}
+
+static void
+GeneralDlg_StorePrivacyToUI(HWND hwndDlg, DWORD dwLaunchTo, BOOL bShowRecent, BOOL bShowFrequent)
+{
+    HWND hCombo = GetDlgItem(hwndDlg, IDC_FOLDER_OPTIONS_LAUNCHTO);
+    /* item data: the LaunchTo value of the choice */
+    for (INT i = 0; i < (INT)SendMessageW(hCombo, CB_GETCOUNT, 0, 0); ++i)
+    {
+        if ((DWORD)SendMessageW(hCombo, CB_GETITEMDATA, i, 0) == dwLaunchTo)
+            SendMessageW(hCombo, CB_SETCURSEL, i, 0);
+    }
+    CheckDlgButton(hwndDlg, IDC_FOLDER_OPTIONS_SHOWRECENT, bShowRecent ? BST_CHECKED : BST_UNCHECKED);
+    CheckDlgButton(hwndDlg, IDC_FOLDER_OPTIONS_SHOWFREQUENT, bShowFrequent ? BST_CHECKED : BST_UNCHECKED);
+}
+
+/* "Clear File Explorer history", as Windows does it at once: the recent
+ * items, the Run box's list, the paths typed in the address bar and what was
+ * searched for */
+static void
+GeneralDlg_ClearHistory(HWND hwndDlg)
+{
+    SHAddToRecentDocs(SHARD_PIDL, NULL);
+    SHDeleteKeyW(HKEY_CURRENT_USER, EXPLORER_KEY L"\\RunMRU");
+    SHDeleteKeyW(HKEY_CURRENT_USER, EXPLORER_KEY L"\\TypedPaths");
+    SHDeleteKeyW(HKEY_CURRENT_USER, EXPLORER_KEY L"\\WordWheelQuery");
+    SHDeleteKeyW(HKEY_CURRENT_USER, EXPLORER_KEY L"\\FrequentFolders");
+    SHChangeNotify(SHCNE_UPDATEDIR, SHCNF_IDLIST | SHCNF_FLUSHNOWAIT, NULL, NULL);
+    EnableWindow(GetDlgItem(hwndDlg, IDC_FOLDER_OPTIONS_CLEARHISTORY), FALSE);
+}
