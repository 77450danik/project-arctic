diff --git a/dll/win32/shell32/dialogs/search.cpp b/dll/win32/shell32/dialogs/search.cpp
new file mode 100644
--- /dev/null
+++ b/dll/win32/shell32/dialogs/search.cpp
@@ -0,0 +1,91 @@
+/*
+ * PROJECT:     Arctic
+ * LICENSE:     LGPL-2.1-or-later (https://spdx.org/licenses/LGPL-2.1-or-later)
+ * PURPOSE:     Folder Options' Search page, as in Windows 10
+ */
+
+#include "precomp.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL (fprop);
+
+/* Where Windows 10 keeps them; the search of Arctic's File Explorer reads them */
+#define SEARCH_PREFS_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Search\\Preferences"
+#define SEARCH_UNINDEXED_KEY L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Search\\PrimaryProperties\\UnindexedLocations"
+
+static DWORD
+SearchDlg_GetDword(LPCWSTR pszSubKey, LPCWSTR pszValue, DWORD dwDefault)
+{
+    DWORD dwValue = dwDefault, cb = sizeof(dwValue);
+    if (SHGetValueW(HKEY_CURRENT_USER, pszSubKey, pszValue, NULL, &dwValue, &cb) != ERROR_SUCCESS)
+        return dwDefault;
+    return dwValue;
+}
+
+static void
+SearchDlg_SetDword(LPCWSTR pszSubKey, LPCWSTR pszValue, DWORD dwValue)
+{
+    SHSetValueW(HKEY_CURRENT_USER, pszSubKey, pszValue, REG_DWORD, &dwValue, sizeof(dwValue));
+}
+
+static void
+SearchDlg_StoreToUI(HWND hwndDlg, BOOL bNoIndex, BOOL bSystemFolders, BOOL bArchives, BOOL bContents)
+{
+    CheckDlgButton(hwndDlg, IDC_SEARCH_NOINDEX, bNoIndex ? BST_CHECKED : BST_UNCHECKED);
+    CheckDlgButton(hwndDlg, IDC_SEARCH_SYSTEMFOLDERS, bSystemFolders ? BST_CHECKED : BST_UNCHECKED);
+    CheckDlgButton(hwndDlg, IDC_SEARCH_ARCHIVES, bArchives ? BST_CHECKED : BST_UNCHECKED);
+    CheckDlgButton(hwndDlg, IDC_SEARCH_CONTENTS, bContents ? BST_CHECKED : BST_UNCHECKED);
+}
+
+static void
+SearchDlg_OnApply(HWND hwndDlg)
+{
+    SearchDlg_SetDword(SEARCH_PREFS_KEY, L"WholeFileSystem", IsDlgButtonChecked(hwndDlg, IDC_SEARCH_NOINDEX) == BST_CHECKED);
+    SearchDlg_SetDword(SEARCH_PREFS_KEY, L"SystemFolders", IsDlgButtonChecked(hwndDlg, IDC_SEARCH_SYSTEMFOLDERS) == BST_CHECKED);
+    SearchDlg_SetDword(SEARCH_PREFS_KEY, L"ArchivedFiles", IsDlgButtonChecked(hwndDlg, IDC_SEARCH_ARCHIVES) == BST_CHECKED);
+    /* "always search names and contents" is SearchOnly = 0 */
+    SearchDlg_SetDword(SEARCH_UNINDEXED_KEY, L"SearchOnly", IsDlgButtonChecked(hwndDlg, IDC_SEARCH_CONTENTS) != BST_CHECKED);
+}
+
+INT_PTR CALLBACK
+FolderOptionsSearchDlg(HWND hwndDlg, UINT uMsg, WPARAM wParam, LPARAM lParam)
+{
+    switch (uMsg)
+    {
+        case WM_INITDIALOG:
+            SearchDlg_StoreToUI(hwndDlg,
+                                SearchDlg_GetDword(SEARCH_PREFS_KEY, L"WholeFileSystem", FALSE),
+                                SearchDlg_GetDword(SEARCH_PREFS_KEY, L"SystemFolders", TRUE),
+                                SearchDlg_GetDword(SEARCH_PREFS_KEY, L"ArchivedFiles", FALSE),
+                                !SearchDlg_GetDword(SEARCH_UNINDEXED_KEY, L"SearchOnly", TRUE));
+            return TRUE;
+
+        case WM_COMMAND:
+            switch (LOWORD(wParam))
+            {
+                case IDC_SEARCH_NOINDEX:
+                case IDC_SEARCH_SYSTEMFOLDERS:
+                case IDC_SEARCH_ARCHIVES:
+                case IDC_SEARCH_CONTENTS:
+                    if (HIWORD(wParam) == BN_CLICKED)
+                        PropSheet_Changed(GetParent(hwndDlg), hwndDlg);
+                    break;
+                case IDC_SEARCH_RESTORE:
+                    if (HIWORD(wParam) == BN_CLICKED)
+                    {
+                        SearchDlg_StoreToUI(hwndDlg, FALSE, TRUE, FALSE, FALSE);
+                        PropSheet_Changed(GetParent(hwndDlg), hwndDlg);
+                    }
+                    break;
+            }
+            break;
+
+        case WM_NOTIFY:
+            if (((LPNMHDR)lParam)->code == PSN_APPLY)
+            {
+                SearchDlg_OnApply(hwndDlg);
+                return TRUE;
+            }
+            break;
+    }
+    return FALSE;
+}
