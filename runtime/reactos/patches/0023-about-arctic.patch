diff --git a/dll/win32/shell32/wine/shell32_main.c b/dll/win32/shell32/wine/shell32_main.c
index 919b168e..552aa4e0 100644
--- a/dll/win32/shell32/wine/shell32_main.c
+++ b/dll/win32/shell32/wine/shell32_main.c
@@ -1317,6 +1317,46 @@ BOOL WINAPI ShellAboutA( HWND hWnd, LPCSTR szApp, LPCSTR szOtherStuff, HICON hIc
 }
 
 
+#ifdef __REACTOS__
+/* Arctic: the version line is Arctic's, with the build number and the date
+ * the image was built (HKLM\Software\Arctic, which ci/build-rootfs.sh
+ * writes): "Version pre-alpha (build 214, 03.10.2026)" */
+static BOOL GetArcticVersion(LPWSTR pszBuf, UINT cchBuf)
+{
+    WCHAR szVersion[64] = L"", szBuild[32] = L"", szDate[32] = L"", szShown[64], szFormat[128];
+    SYSTEMTIME st = { 0 };
+    DWORD cb;
+    HKEY hKey;
+
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Arctic", 0, KEY_QUERY_VALUE, &hKey) != ERROR_SUCCESS)
+        return FALSE;
+    cb = sizeof(szVersion) - sizeof(WCHAR);
+    RegQueryValueExW(hKey, L"Version", NULL, NULL, (LPBYTE)szVersion, &cb);
+    cb = sizeof(szBuild) - sizeof(WCHAR);
+    RegQueryValueExW(hKey, L"Build", NULL, NULL, (LPBYTE)szBuild, &cb);
+    cb = sizeof(szDate) - sizeof(WCHAR);
+    RegQueryValueExW(hKey, L"BuildDate", NULL, NULL, (LPBYTE)szDate, &cb);
+    RegCloseKey(hKey);
+
+    /* the date as the user's locale writes it */
+    StringCchCopyW(szShown, _countof(szShown), szDate);
+    if (wcslen(szDate) == 10 && szDate[4] == L'-' && szDate[7] == L'-')
+    {
+        for (int i = 0; i < 10; i++)
+        {
+            WORD *pPart = i < 4 ? &st.wYear : i < 7 ? &st.wMonth : &st.wDay;
+            if (i == 4 || i == 7) continue;
+            *pPart = *pPart * 10 + (szDate[i] - L'0');
+        }
+        GetDateFormatW(LOCALE_USER_DEFAULT, DATE_SHORTDATE, &st, NULL, szShown, _countof(szShown));
+    }
+    if (!LoadStringW(shell32_hInstance, IDS_ARCTIC_VERSION, szFormat, _countof(szFormat)))
+        StringCchCopyW(szFormat, _countof(szFormat), L"Version %s (build %s, %s)");
+    StringCchPrintfW(pszBuf, cchBuf, szFormat, szVersion, szBuild, szShown);
+    return TRUE;
+}
+#endif
+
 /*************************************************************************
  * ShellAboutW                [SHELL32.289]
  */
@@ -1345,8 +1385,11 @@ BOOL WINAPI ShellAboutW( HWND hWnd, LPCWSTR szApp, LPCWSTR szOtherStuff,
 
 #ifdef __REACTOS__
     /* Output the version OS kernel strings */
-    LoadStringW(shell32_hInstance, IDS_ABOUT_VERSION_STRING, szFormat, _countof(szFormat));
-    StringCchPrintfW(szVersionString, _countof(szVersionString), szFormat, KERNEL_VERSION_STR, KERNEL_VERSION_BUILD_STR);
+    if (!GetArcticVersion(szVersionString, _countof(szVersionString)))
+    {
+        LoadStringW(shell32_hInstance, IDS_ABOUT_VERSION_STRING, szFormat, _countof(szFormat));
+        StringCchPrintfW(szVersionString, _countof(szVersionString), szFormat, KERNEL_VERSION_STR, KERNEL_VERSION_BUILD_STR);
+    }
 #endif
 
     info.szApp        = szApp;
