diff --git a/base/shell/explorer/precomp.h b/base/shell/explorer/precomp.h
index e1616587..f14f31f5 100644
--- a/base/shell/explorer/precomp.h
+++ b/base/shell/explorer/precomp.h
@@ -439,4 +439,15 @@ static inline int ArcticDpiScale(int px)
     return ::MulDiv(px, s_dpi, 96);
 }
 
+/* Arctic: the system's DPI the processes started now get (LogPixels, which
+   the scale of the primary monitor sets) */
+static inline int ArcticNewSystemDpi()
+{
+    DWORD dpi = 0, size = sizeof(dpi);
+    if (::RegGetValueW(HKEY_CURRENT_USER, L"Control Panel\Desktop", L"LogPixels", RRF_RT_REG_DWORD, NULL,
+                       &dpi, &size) != ERROR_SUCCESS || !dpi)
+        dpi = 96;
+    return (int)dpi;
+}
+
 #endif /* _EXPLORER_PRECOMP__H_ */
diff --git a/base/shell/explorer/traywnd.cpp b/base/shell/explorer/traywnd.cpp
index 3bbde8be..07f98a5a 100644
--- a/base/shell/explorer/traywnd.cpp
+++ b/base/shell/explorer/traywnd.cpp
@@ -18,6 +18,7 @@ HRESULT TrayWindowCtxMenuCreator(ITrayWindow * TrayWnd, IN HWND hWndOwner, ICont
 
 #define TIMER_ID_AUTOHIDE 1
 #define TIMER_ID_MOUSETRACK 2
+#define TIMER_ID_ARCTIC_SETTLE 3 /* Arctic: the shell's geometry once more after it came up */
 #define MOUSETRACK_INTERVAL 100
 #define AUTOHIDE_DELAY_HIDE 2000
 #define AUTOHIDE_DELAY_SHOW 50
@@ -2489,6 +2490,11 @@ ChangePos:
         ArcticSetTrayBand(m_hWnd, TRUE);
         ArcticStartTaskSwitcher();
 
+        /* Arctic: the shell came up while a new scale was still reaching every
+           process, now and then: a little later the desktop and the taskbar
+           take their place once more, with what everyone knows by then */
+        SetTimer(TIMER_ID_ARCTIC_SETTLE, 3000, NULL);
+
         return TRUE;
     }
 
@@ -2575,6 +2581,18 @@ ChangePos:
 
     LRESULT OnDisplayChange(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL& bHandled)
     {
+        /* Arctic: the scale of the primary monitor changed on the fly: the
+           shell draws itself at the system's DPI of when it started, so it
+           leaves as when it is told to (its desktop, DDE and COM objects go
+           with it), and winlogon starts it again (AutoRestartShell), sharp
+           at the new scale, as "Restart Explorer" does; programs put their
+           notification icons back when they hear TaskbarCreated */
+        if (ArcticNewSystemDpi() != ArcticDpiScale(96))
+        {
+            PostQuitMessage(0);
+            return TRUE;
+        }
+
         /* Refresh workareas */
         RecomputeAllWorkareas();
 
@@ -3265,6 +3283,16 @@ HandleTrayContextMenu:
             case TIMER_ID_AUTOHIDE:
                 ProcessAutoHide();
                 break;
+            case TIMER_ID_ARCTIC_SETTLE:
+                KillTimer(TIMER_ID_ARCTIC_SETTLE);
+                RegLoadSettings();
+                CheckTrayWndPosition();
+                if (HWND hwndDesktop = ::GetShellWindow())
+                {
+                    ::SendMessageW(hwndDesktop, WM_DISPLAYCHANGE, 0, 0);
+                    ::RedrawWindow(hwndDesktop, NULL, NULL, RDW_INVALIDATE | RDW_ERASE | RDW_ALLCHILDREN);
+                }
+                break;
             default:
                 WARN("Invalid timer ID: %u\n", (UINT)wParam);
                 bHandled = FALSE;
