+/* Arctic: the look of the open Start menu, which its submenus take too:
+ * 0 none, 1 white on black, 2 dark on white */
+static int g_ArcticMenuLook;
+
+static VOID ArcticSetMenuLook(HWND hWnd, BOOL bStartMenu)
+{
+    typedef BOOL (WINAPI *PFN_LOOK)(HWND, BOOL *);
+    typedef BOOL (WINAPI *PFN_SETWCA)(HWND, PVOID);
+    typedef HRESULT (WINAPI *PFN_SETATTR)(HWND, DWORD, LPCVOID, DWORD);
+    HMODULE hStartUi = GetModuleHandleW(L"startui.dll");
+    PFN_LOOK pLook = hStartUi ? (PFN_LOOK)GetProcAddress(hStartUi, "ArcticApplyClassicMenuLook") : NULL;
+    BOOL bLight = FALSE;
+
+    /* only the Start menu, which explorer has opened with startui.dll loaded */
+    if (bStartMenu)
+        g_ArcticMenuLook = pLook && pLook(hWnd, &bLight) ? (bLight ? 2 : 1) : 0;
+    else if (g_ArcticMenuLook && !(pLook && pLook(hWnd, &bLight)))
+        g_ArcticMenuLook = 0;
+
+    if (g_ArcticMenuLook)
+    {
+        SetPropW(hWnd, ARCTIC_MENU_LOOK, (HANDLE)(INT_PTR)g_ArcticMenuLook);
+    }
+    else if (RemovePropW(hWnd, ARCTIC_MENU_LOOK))
+    {
+        /* back to the classic look: no backdrop, keyed as ever */
+        struct { DWORD AccentState, AccentFlags, GradientColor, AnimationId; } policy = { 0, 0, 0, 0 };
+        struct { DWORD Attrib; PVOID pvData; SIZE_T cbData; } data = { 19 /* WCA_ACCENT_POLICY */, &policy, sizeof(policy) };
+        PFN_SETWCA pSetWca = (PFN_SETWCA)GetProcAddress(GetModuleHandleW(L"user32.dll"), "SetWindowCompositionAttribute");
+        PFN_SETATTR pSetAttr = (PFN_SETATTR)GetProcAddress(LoadLibraryW(L"dwmapi.dll"), "DwmSetWindowAttribute");
+        DWORD dwLight = FALSE;
+
+        if (pSetWca)
+            pSetWca(hWnd, &data);
+        if (pSetAttr)
+            pSetAttr(hWnd, 0x1004 /* DWMWA_ARCTIC_LIGHT */, &dwLight, sizeof(dwLight));
+    }
+}
