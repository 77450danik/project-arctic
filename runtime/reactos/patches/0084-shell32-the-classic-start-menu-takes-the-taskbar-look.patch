+/* Arctic: with the taskbar's look, what shows the backdrop through */
+LRESULT CMenuDeskBar::_OnEraseBkgnd(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL &bHandled)
+{
+    int look = ArcticMenuLookOf(m_hWnd);
+    RECT rc;
+
+    if (!look)
+    {
+        bHandled = FALSE;
+        return 0;
+    }
+    GetClientRect(&rc);
+    FillRect((HDC)wParam, &rc, (HBRUSH)GetStockObject(look == 2 ? WHITE_BRUSH : BLACK_BRUSH));
+    return 1;
+}
