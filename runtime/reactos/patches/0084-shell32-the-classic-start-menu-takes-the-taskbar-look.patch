 #include <wine/debug.h>
 
+/* Arctic: the classic Start menu with the taskbar's look (startui.dll, the
+ * page "Меню «Пуск»"): its windows carry ARCTIC_MENU_LOOK, 1 when they draw
+ * white on black over the acrylic, 2 dark on white; none, the classic look */
+#define ARCTIC_MENU_LOOK L"ArcticMenuLook"
+static inline int ArcticMenuLookOf(HWND hWnd)
+{
+    HWND hRoot = GetAncestor(hWnd, GA_ROOT);
+    return hRoot ? (int)(INT_PTR)GetPropW(hRoot, ARCTIC_MENU_LOOK) : 0;
+}
+static inline void ArcticMenuFill(HDC hdc, const RECT *prc, COLORREF color, BYTE alpha)
+{
+    BITMAPINFO bi = { { sizeof(bi.bmiHeader), 1, 1, 1, 32, BI_RGB } };
+    BLENDFUNCTION bf = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    DWORD *pBits;
+    HBITMAP hbm = CreateDIBSection(hdc, &bi, DIB_RGB_COLORS, (void **)&pBits, NULL, 0);
+    HDC hdcMem;
+    HGDIOBJ hOld;
+
+    if (!hbm)
+        return;
+    *pBits = ((DWORD)alpha << 24) | ((GetRValue(color) * alpha / 255) << 16) |
+             ((GetGValue(color) * alpha / 255) << 8) | (GetBValue(color) * alpha / 255);
+    hdcMem = CreateCompatibleDC(hdc);
+    hOld = SelectObject(hdcMem, hbm);
+    GdiAlphaBlend(hdc, prc->left, prc->top, prc->right - prc->left, prc->bottom - prc->top, hdcMem, 0, 0, 1, 1, bf);
+    SelectObject(hdcMem, hOld);
+    DeleteDC(hdcMem);
+    DeleteObject(hbm);
+}
