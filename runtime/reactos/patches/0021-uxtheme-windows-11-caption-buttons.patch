+/*
+ * Arctic: the caption buttons of Windows 11. They are 46 pixels wide (at 96
+ * dpi), as tall as the caption, and reach the window's top and right edges;
+ * their glyphs are 10 pixels across, drawn with one pixel strokes and
+ * smoothed edges. Under the pointer the minimize and maximize buttons darken
+ * the caption a little, the close button turns red.
+ */
+
+#define WIN11_BUTTON_WIDTH 46
+#define WIN11_GLYPH_SIZE   10
+
+static BOOL UseWin11Buttons(DWORD dwStyle, DWORD dwExStyle)
+{
+    return !(dwExStyle & WS_EX_TOOLWINDOW) && !(dwStyle & WS_MINIMIZE);
+}
+
+static INT ScreenDpi(void)
+{
+    HDC hdc = GetDC(NULL);
+    INT dpi = hdc ? GetDeviceCaps(hdc, LOGPIXELSX) : 96;
+
+    if (hdc)
+        ReleaseDC(NULL, hdc);
+    return dpi ? dpi : 96;
+}
+
+/* a colour at some opacity over what is there */
+static void FillAlpha(HDC hdc, const RECT *prc, COLORREF color, BYTE alpha)
+{
+    BITMAPINFO bi = {{sizeof(bi.bmiHeader), 1, 1, 1, 32, BI_RGB}};
+    BLENDFUNCTION bf = {AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
+    DWORD *pBits;
+    HBITMAP hbm = CreateDIBSection(hdc, &bi, DIB_RGB_COLORS, (void **)&pBits, NULL, 0);
+    HDC hdcMem;
+    HGDIOBJ hOld;
+
+    if (!hbm)
+        return;
+    *pBits = ((DWORD)alpha << 24) | ((GetRValue(color) * alpha / 255) << 16) |
+             ((GetGValue(color) * alpha / 255) << 8) | (GetBValue(color) * alpha / 255);
+    hdcMem = CreateCompatibleDC(hdc);
+    hOld = SelectObject(hdcMem, hbm);
+    GdiAlphaBlend(hdc, prc->left, prc->top, prc->right - prc->left, prc->bottom - prc->top, hdcMem, 0, 0, 1, 1, bf);
+    SelectObject(hdcMem, hOld);
+    DeleteDC(hdcMem);
+    DeleteObject(hbm);
+}
+
+typedef struct { float x0, y0, x1, y1; } GLYPH_STROKE;
+
+/* how much of the pixel at (px, py) the strokes cover, sampled 4 x 4 */
+static int GlyphCoverage(const GLYPH_STROKE *strokes, int count, float scale, int px, int py)
+{
+    float half = 0.5f * scale;
+    int hits = 0;
+
+    for (int sy = 0; sy < 4; sy++)
+    {
+        for (int sx = 0; sx < 4; sx++)
+        {
+            float x = px + (sx + 0.5f) / 4, y = py + (sy + 0.5f) / 4;
+
+            for (int i = 0; i < count; i++)
+            {
+                float x0 = strokes[i].x0 * scale, y0 = strokes[i].y0 * scale;
+                float dx = strokes[i].x1 * scale - x0, dy = strokes[i].y1 * scale - y0;
+                float len2 = dx * dx + dy * dy, t = 0, ex, ey;
+
+                if (len2 > 0)
+                {
+                    t = ((x - x0) * dx + (y - y0) * dy) / len2;
+                    if (t < 0) t = 0;
+                    if (t > 1) t = 1;
+                }
+                ex = x0 + t * dx - x;
+                ey = y0 + t * dy - y;
+                if (ex * ex + ey * ey <= half * half)
+                {
+                    hits++;
+                    break;
+                }
+            }
+        }
+    }
+    return hits * 255 / 16;
+}
+
+static void DrawWin11Glyph(HDC hdc, const RECT *prcButton, int iPartId, COLORREF color, INT dpi)
+{
+    /* in glyph units, 10 across; strokes run through pixel centres */
+    static const GLYPH_STROKE minimize[] = {{0.5f, 5.5f, 9.5f, 5.5f}};
+    static const GLYPH_STROKE maximize[] =
+    {
+        {0.5f, 0.5f, 9.5f, 0.5f}, {9.5f, 0.5f, 9.5f, 9.5f}, {9.5f, 9.5f, 0.5f, 9.5f}, {0.5f, 9.5f, 0.5f, 0.5f}
+    };
+    static const GLYPH_STROKE restore[] =
+    {
+        {0.5f, 2.5f, 7.5f, 2.5f}, {7.5f, 2.5f, 7.5f, 9.5f}, {7.5f, 9.5f, 0.5f, 9.5f}, {0.5f, 9.5f, 0.5f, 2.5f},
+        {2.5f, 2.5f, 2.5f, 0.5f}, {2.5f, 0.5f, 9.5f, 0.5f}, {9.5f, 0.5f, 9.5f, 7.5f}, {9.5f, 7.5f, 7.5f, 7.5f}
+    };
+    static const GLYPH_STROKE cross[] = {{0.5f, 0.5f, 9.5f, 9.5f}, {9.5f, 0.5f, 0.5f, 9.5f}};
+    const GLYPH_STROKE *strokes;
+    int count, size = MulDiv(WIN11_GLYPH_SIZE, dpi, 96);
+    float scale = (float)size / WIN11_GLYPH_SIZE;
+    BITMAPINFO bi = {{sizeof(bi.bmiHeader), 0, 0, 1, 32, BI_RGB}};
+    BLENDFUNCTION bf = {AC_SRC_OVER, 0, 255, AC_SRC_ALPHA};
+    DWORD *pBits;
+    HBITMAP hbm;
+    HDC hdcMem;
+    HGDIOBJ hOld;
+    int x, y;
+
+    switch (iPartId)
+    {
+    case WP_MINBUTTON:     strokes = minimize; count = ARRAYSIZE(minimize); break;
+    case WP_MAXBUTTON:     strokes = maximize; count = ARRAYSIZE(maximize); break;
+    case WP_RESTOREBUTTON: strokes = restore;  count = ARRAYSIZE(restore);  break;
+    default:               strokes = cross;    count = ARRAYSIZE(cross);    break;
+    }
+
+    bi.bmiHeader.biWidth = size;
+    bi.bmiHeader.biHeight = -size;
+    hbm = CreateDIBSection(hdc, &bi, DIB_RGB_COLORS, (void **)&pBits, NULL, 0);
+    if (!hbm)
+        return;
+    for (y = 0; y < size; y++)
+    {
+        for (x = 0; x < size; x++)
+        {
+            int a = GlyphCoverage(strokes, count, scale, x, y);
+            pBits[y * size + x] = ((DWORD)a << 24) | ((GetRValue(color) * a / 255) << 16) |
+                                  ((GetGValue(color) * a / 255) << 8) | (GetBValue(color) * a / 255);
+        }
+    }
+    hdcMem = CreateCompatibleDC(hdc);
+    hOld = SelectObject(hdcMem, hbm);
+    GdiAlphaBlend(hdc, (prcButton->left + prcButton->right - size) / 2, (prcButton->top + prcButton->bottom - size) / 2,
+                  size, size, hdcMem, 0, 0, size, size, bf);
+    SelectObject(hdcMem, hOld);
+    DeleteDC(hdcMem);
+    DeleteObject(hbm);
+}
+
+static void DrawWin11CaptionButton(PDRAW_CONTEXT pcontext, const RECT *prc, int iPartId, INT iStateId)
+{
+    BOOL bClose = iPartId == WP_CLOSEBUTTON;
+    BOOL bHot = iStateId == BUTTON_HOT || iStateId == BUTTON_INACTIVE_HOT;
+    BOOL bPressed = iStateId == BUTTON_PRESSED || iStateId == BUTTON_INACTIVE_PRESSED;
+    BOOL bDisabled = iStateId == BUTTON_DISABLED || iStateId == BUTTON_INACTIVE_DISABLED;
+    RECT rcCaption;
+    int iCaptionPart = pcontext->wi.dwStyle & WS_MAXIMIZE ? WP_MAXCAPTION : WP_CAPTION;
+    COLORREF glyph;
+
+    /* the caption under it, as it would be without the button */
+    SetRect(&rcCaption, 0, 0, pcontext->wi.rcWindow.right - pcontext->wi.rcWindow.left, pcontext->CaptionHeight);
+    FillRect(pcontext->hDC, prc, GetSysColorBrush(pcontext->Active ? COLOR_ACTIVECAPTION : COLOR_INACTIVECAPTION));
+    DrawThemeBackground(pcontext->theme, pcontext->hDC, iCaptionPart, pcontext->Active ? FS_ACTIVE : FS_INACTIVE,
+                        &rcCaption, prc);
+
+    if (bClose && bHot)
+    {
+        HBRUSH hbr = CreateSolidBrush(RGB(0xc4, 0x2b, 0x1c));
+        FillRect(pcontext->hDC, prc, hbr);
+        DeleteObject(hbr);
+        glyph = RGB(255, 255, 255);
+    }
+    else if (bClose && bPressed)
+    {
+        HBRUSH hbr = CreateSolidBrush(RGB(0xca, 0x40, 0x33));
+        FillRect(pcontext->hDC, prc, hbr);
+        DeleteObject(hbr);
+        glyph = RGB(0xf0, 0xf0, 0xf0);
+    }
+    else
+    {
+        if (bHot)
+            FillAlpha(pcontext->hDC, prc, RGB(0, 0, 0), 0x17);
+        else if (bPressed)
+            FillAlpha(pcontext->hDC, prc, RGB(0, 0, 0), 0x0f);
+        if (bDisabled)
+            glyph = RGB(0xc8, 0xc8, 0xc8);
+        else if (bHot || bPressed || pcontext->Active)
+            glyph = RGB(0x1a, 0x1a, 0x1a);
+        else
+            glyph = RGB(0xa3, 0xa3, 0xa3);
+    }
+    DrawWin11Glyph(pcontext->hDC, prc, iPartId, glyph, ScreenDpi());
+}
