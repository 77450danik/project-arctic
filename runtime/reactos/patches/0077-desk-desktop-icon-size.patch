+/* Arctic: the size of the desktop's icons, 32, 48 or 64 pixels at 100 %, at
+ * the system's scale: kept where Windows keeps it, the desktop's View menu
+ * offers the same. The desktop takes it at once on WM_SETTINGCHANGE
+ * "DesktopIconSize". */
+#define DESKTOP_BAG_KEY L"Software\\Microsoft\\Windows\\Shell\\Bags\\1\\Desktop"
+
+static DWORD InitialDesktopIconSize;
+
+static DWORD
+ReadDesktopIconSize(VOID)
+{
+    DWORD Value = 48, Size = sizeof(Value), Type;
+    HKEY hKey;
+
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, DESKTOP_BAG_KEY, 0, KEY_QUERY_VALUE, &hKey) == ERROR_SUCCESS)
+    {
+        if (RegQueryValueExW(hKey, L"IconSize", NULL, &Type, (LPBYTE)&Value, &Size) != ERROR_SUCCESS ||
+            Type != REG_DWORD)
+        {
+            Value = 48;
+        }
+        RegCloseKey(hKey);
+    }
+    return (Value == 32 || Value == 64) ? Value : 48;
+}
+
+static VOID
+FillDesktopIconSize(IN HWND hwndDlg)
+{
+    static const struct { UINT Text; DWORD Size; } Choices[] =
+    {
+        { IDS_ICONSIZE_SMALL,  32 },
+        { IDS_ICONSIZE_MEDIUM, 48 },
+        { IDS_ICONSIZE_LARGE,  64 },
+    };
+    HWND hCombo = GetDlgItem(hwndDlg, IDC_SETTINGS_ICONSIZE);
+    WCHAR szText[64];
+    LRESULT index;
+    UINT i;
+
+    if (!hCombo) return;
+    InitialDesktopIconSize = ReadDesktopIconSize();
+    for (i = 0; i < _countof(Choices); i++)
+    {
+        LoadStringW(hApplet, Choices[i].Text, szText, _countof(szText));
+        index = SendMessageW(hCombo, CB_ADDSTRING, 0, (LPARAM)szText);
+        SendMessageW(hCombo, CB_SETITEMDATA, index, Choices[i].Size);
+        if (Choices[i].Size == InitialDesktopIconSize) SendMessageW(hCombo, CB_SETCURSEL, index, 0);
+    }
+}
+
+static VOID
+ApplyDesktopIconSize(IN HWND hwndDlg)
+{
+    LRESULT index = SendDlgItemMessageW(hwndDlg, IDC_SETTINGS_ICONSIZE, CB_GETCURSEL, 0, 0);
+    DWORD Value;
+    HKEY hKey;
+
+    if (index == CB_ERR) return;
+    Value = (DWORD)SendDlgItemMessageW(hwndDlg, IDC_SETTINGS_ICONSIZE, CB_GETITEMDATA, index, 0);
+    if (Value == InitialDesktopIconSize) return;
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, DESKTOP_BAG_KEY, 0, NULL, 0, KEY_SET_VALUE, NULL, &hKey, NULL) != ERROR_SUCCESS)
+        return;
+    if (RegSetValueExW(hKey, L"IconSize", 0, REG_DWORD, (const BYTE *)&Value, sizeof(Value)) == ERROR_SUCCESS)
+        InitialDesktopIconSize = Value;
+    RegCloseKey(hKey);
+    SendMessageTimeoutW(HWND_BROADCAST, WM_SETTINGCHANGE, 0, (LPARAM)L"DesktopIconSize",
+                        SMTO_ABORTIFHUNG, 5000, NULL);
+}
+
 static VOID
 FillScaling(IN HWND hwndDlg, IN PDISPLAY_DEVICE_ENTRY pDeviceEntry)
