+    /* Arctic: the dialog draws at the screen's scale, as in Windows: from
+       rundll32 (Control Panel's "File Explorer Options"), which is not DPI
+       aware, dwm stretched it, blurred, from 96 DPI */
+    {
+        typedef HANDLE (WINAPI *PFN_SETTHREADDPI)(HANDLE);
+        PFN_SETTHREADDPI pSetThreadDpi =
+            (PFN_SETTHREADDPI)GetProcAddress(GetModuleHandleW(L"user32.dll"), "SetThreadDpiAwarenessContext");
+
+        if (pSetThreadDpi)
+            pSetThreadDpi((HANDLE)(LONG_PTR)-2 /* DPI_AWARENESS_CONTEXT_SYSTEM_AWARE */);
+    }
+
