+/* Arctic: takes one entry out of a FILE_LIST */
+static void remove_file_from_list(FILE_LIST *flList, DWORD i)
+{
+    HeapFree(GetProcessHeap(), 0, flList->feFiles[i].szDirectory);
+    HeapFree(GetProcessHeap(), 0, flList->feFiles[i].szFilename);
+    HeapFree(GetProcessHeap(), 0, flList->feFiles[i].szFullPath);
+    MoveMemory(&flList->feFiles[i], &flList->feFiles[i + 1],
+               (flList->dwNumFiles - i - 1) * sizeof(FILE_ENTRY));
+    flList->dwNumFiles--;
+}
+
+/* Arctic: Windows keeps its own folders to itself. Moving, deleting or
+ * renaming what is in them asks for administrator permission, and the
+ * folders themselves need TrustedInstaller. Arctic has neither, so the shell
+ * asks instead (Continue, Skip, Cancel) and refuses the folders themselves.
+ * Without it a drag of System32 into SysWOW64 went without a word and left a
+ * system that started no program. */
+enum SYSPROT { SYSPROT_NONE, SYSPROT_ASK, SYSPROT_DENY };
+
+/* is Path Root itself (*pbSame) or in it? */
+static BOOL SHELL_PathInFolder(LPCWSTR Path, LPCWSTR Root, BOOL *pbSame)
+{
+    size_t cch = wcslen(Root);
+    while (cch && Root[cch - 1] == L'\\')
+        cch--;
+    if (!cch || _wcsnicmp(Path, Root, cch))
+        return FALSE;
+    if (!Path[cch] || (Path[cch] == L'\\' && !Path[cch + 1]))
+    {
+        *pbSame = TRUE;
+        return TRUE;
+    }
+    *pbSame = FALSE;
+    return Path[cch] == L'\\';
+}
+
+static SYSPROT SHELL_SystemProtection(LPCWSTR pszPath)
+{
+    WCHAR szFull[MAX_PATH], szPath[MAX_PATH], szWin[MAX_PATH], szDir[MAX_PATH];
+    BOOL bSame;
+
+    if (!GetFullPathNameW(pszPath, _countof(szFull), szFull, NULL) ||
+        !GetWindowsDirectoryW(szWin, _countof(szWin)))
+        return SYSPROT_NONE;
+    if (!GetLongPathNameW(szFull, szPath, _countof(szPath)))
+        StringCchCopyW(szPath, _countof(szPath), szFull);
+
+    /* the root of the system's drive and the folders at its top */
+    WCHAR szRoot[] = { szWin[0], L':', L'\\', 0 };
+    if (SHELL_PathInFolder(szPath, szRoot, &bSame) && bSame)
+        return SYSPROT_DENY;
+    static const int TopFolders[] = { CSIDL_PROGRAM_FILES, CSIDL_PROGRAM_FILESX86,
+                                      CSIDL_COMMON_APPDATA, CSIDL_PROFILES };
+    for (UINT i = 0; i < _countof(TopFolders); ++i)
+    {
+        if (SHGetFolderPathW(NULL, TopFolders[i], NULL, SHGFP_TYPE_CURRENT, szDir) == S_OK &&
+            SHELL_PathInFolder(szPath, szDir, &bSame) && bSame)
+            return SYSPROT_DENY;
+    }
+
+    /* the registry and the host system: nothing in them is the user's to move */
+    static const PCWSTR Locked[] = { L"System32\\config", L"System32\\Host" };
+    for (UINT i = 0; i < _countof(Locked); ++i)
+    {
+        PathCombineW(szDir, szWin, Locked[i]);
+        if (SHELL_PathInFolder(szPath, szDir, &bSame))
+            return SYSPROT_DENY;
+    }
+
+    static const PCWSTR Folders[] = { L"System32", L"SysWOW64" };
+    for (UINT i = 0; i < _countof(Folders); ++i)
+    {
+        PathCombineW(szDir, szWin, Folders[i]);
+        if (SHELL_PathInFolder(szPath, szDir, &bSame) && bSame)
+            return SYSPROT_DENY;
+    }
+
+    if (SHELL_PathInFolder(szPath, szWin, &bSame))
+    {
+        if (bSame)
+            return SYSPROT_DENY;
+        /* Temp is everybody's */
+        PathCombineW(szDir, szWin, L"Temp");
+        if (SHELL_PathInFolder(szPath, szDir, &bSame) && !bSame)
+            return SYSPROT_NONE;
+        return SYSPROT_ASK;
+    }
+
+    static const int AppFolders[] = { CSIDL_PROGRAM_FILES, CSIDL_PROGRAM_FILESX86 };
+    for (UINT i = 0; i < _countof(AppFolders); ++i)
+    {
+        if (SHGetFolderPathW(NULL, AppFolders[i], NULL, SHGFP_TYPE_CURRENT, szDir) == S_OK &&
+            SHELL_PathInFolder(szPath, szDir, &bSame))
+            return SYSPROT_ASK;
+    }
+    return SYSPROT_NONE;
+}
+
+/* the question for one item: IDOK goes on, IDIGNORE skips it, IDCANCEL stops */
+static int SHELL_ConfirmSystemItem(FILE_OPERATION *op, const FILE_ENTRY *fe, SYSPROT prot,
+                                   BOOL bMore, BOOL *pbForAll)
+{
+    const BOOL bDir = IsAttribDir(fe->attributes);
+    const UINT wFunc = op->req->wFunc;
+    CStringW strTitle(MAKEINTRESOURCEW(bDir ? IDS_SYSPROT_FOLDER_TITLE : IDS_SYSPROT_FILE_TITLE));
+    CStringW strThis(MAKEINTRESOURCEW(bDir ? IDS_SYSPROT_THISFOLDER : IDS_SYSPROT_THISFILE));
+    CStringW strContinue(MAKEINTRESOURCEW(IDS_SYSPROT_CONTINUE));
+    CStringW strSkip(MAKEINTRESOURCEW(IDS_SYSPROT_SKIP));
+    CStringW strCancel(MAKEINTRESOURCEW(IDS_SYSPROT_CANCEL));
+    CStringW strForAll(MAKEINTRESOURCEW(IDS_SYSPROT_FORALL));
+    CStringW strMain, strText;
+
+    if (prot == SYSPROT_DENY)
+    {
+        strMain.LoadStringW(IDS_SYSPROT_DENY);
+        strText.Format(IDS_SYSPROT_DENY_TEXT, fe->szFullPath);
+    }
+    else
+    {
+        strMain.Format(wFunc == FO_DELETE ? IDS_SYSPROT_ASK_DELETE :
+                       wFunc == FO_RENAME ? IDS_SYSPROT_ASK_RENAME : IDS_SYSPROT_ASK_MOVE,
+                       (PCWSTR)strThis);
+        strText.Format(IDS_SYSPROT_ASK_TEXT, fe->szFullPath);
+    }
+
+    TASKDIALOG_BUTTON Buttons[3];
+    UINT cButtons = 0;
+    if (prot == SYSPROT_ASK)
+        Buttons[cButtons++] = { IDOK, strContinue };
+    if (bMore)
+        Buttons[cButtons++] = { IDIGNORE, strSkip };
+    Buttons[cButtons++] = { IDCANCEL, strCancel };
+
+    TASKDIALOGCONFIG tdc = { sizeof(tdc) };
+    tdc.hwndParent = op->hWndOwner;
+    tdc.hInstance = shell32_hInstance;
+    tdc.dwFlags = TDF_ALLOW_DIALOG_CANCELLATION | TDF_POSITION_RELATIVE_TO_WINDOW;
+    tdc.pszWindowTitle = strTitle;
+    tdc.pszMainIcon = prot == SYSPROT_ASK ? TD_WARNING_ICON : TD_ERROR_ICON;
+    tdc.pszMainInstruction = strMain;
+    tdc.pszContent = strText;
+    tdc.cButtons = cButtons;
+    tdc.pButtons = Buttons;
+    /* an Enter by habit must not move the system */
+    tdc.nDefaultButton = IDCANCEL;
+    if (bMore)
+        tdc.pszVerificationText = strForAll;
+
+    int Button = IDCANCEL;
+    BOOL bForAll = FALSE;
+    if (FAILED(TaskDialogIndirect(&tdc, &Button, NULL, &bForAll)))
+    {
+        CStringW strMsg = strMain + L"\n\n" + strText;
+        if (prot == SYSPROT_ASK)
+            Button = MessageBoxW(op->hWndOwner, strMsg, strTitle,
+                                 MB_OKCANCEL | MB_ICONWARNING | MB_DEFBUTTON2) == IDOK ? IDOK : IDCANCEL;
+        else
+            Button = (MessageBoxW(op->hWndOwner, strMsg, strTitle, MB_OK | MB_ICONERROR), IDCANCEL);
+    }
+    *pbForAll = bForAll;
+    return Button;
+}
+
+/* asks for the system's items before anything is done; what is skipped
+ * leaves the lists */
+static DWORD SHELL_CheckSystemItems(FILE_OPERATION *op, FILE_LIST *flFrom, FILE_LIST *flTo)
+{
+    const UINT wFunc = op->req->wFunc;
+    const FILEOP_FLAGS fFlags = op->req->fFlags;
+
+    if (wFunc != FO_MOVE && wFunc != FO_DELETE && wFunc != FO_RENAME)
+        return ERROR_SUCCESS;
+
+    /* a program that moves its own files without a word is not asked; the
+     * system's folders themselves it still may not move */
+    const BOOL bAsk = CanShowFileOpErrorUI(*op->req) &&
+                      !((fFlags & FOF_NOCONFIRMATION) && (fFlags & FOF_SILENT));
+    const BOOL bMultiDest = wFunc == FO_MOVE && (fFlags & FOF_MULTIDESTFILES);
+    const BOOL bMore = flFrom->dwNumFiles > 1;
+    int ForAll[SYSPROT_DENY + 1] = { 0 };
+    BOOL bAnySkipped = FALSE;
+
+    for (DWORD i = 0; i < flFrom->dwNumFiles;)
+    {
+        const FILE_ENTRY *fe = &flFrom->feFiles[i];
+        /* (an entry of a wildcard has its attributes, not bExists) */
+        SYSPROT prot = fe->attributes != INVALID_FILE_ATTRIBUTES ?
+                       SHELL_SystemProtection(fe->szFullPath) : SYSPROT_NONE;
+        int Answer = IDOK;
+
+        if (prot == SYSPROT_DENY && !bAsk)
+        {
+            Answer = IDIGNORE;
+        }
+        else if (prot != SYSPROT_NONE && bAsk)
+        {
+            Answer = ForAll[prot];
+            if (!Answer)
+            {
+                BOOL bForAll = FALSE;
+                Answer = SHELL_ConfirmSystemItem(op, fe, prot, bMore, &bForAll);
+                if (bForAll && Answer != IDCANCEL)
+                    ForAll[prot] = Answer;
+            }
+        }
+
+        if (Answer == IDCANCEL)
+        {
+            op->bCancelled = TRUE;
+            op->bHasDisplayedError = TRUE;
+            op->req->fAnyOperationsAborted = TRUE;
+            return ERROR_CANCELLED;
+        }
+        if (Answer == IDIGNORE)
+        {
+            TRACE("system item %s left out\n", debugstr_w(fe->szFullPath));
+            remove_file_from_list(flFrom, i);
+            if (bMultiDest && i < flTo->dwNumFiles)
+                remove_file_from_list(flTo, i);
+            bAnySkipped = TRUE;
+            continue;
+        }
+        ++i;
+    }
+
+    if (bAnySkipped)
+    {
+        op->req->fAnyOperationsAborted = TRUE;
+        if (!flFrom->dwNumFiles)
+        {
+            op->bHasDisplayedError = TRUE;
+            return bAsk ? ERROR_CANCELLED : ERROR_ACCESS_DENIED;
+        }
+    }
+    return ERROR_SUCCESS;
+}
