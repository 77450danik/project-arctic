+    /* Arctic: the button of the window in front minimizes it, that of any
+       other brings it up, as Windows decides it: by what is on the screen.
+       m_ActiveTaskItem, kept from the shell hook, could still name a window
+       that another had covered or taken the foreground from (Chrome, once
+       the Control Panel or Antigravity came up), and the click meant to
+       bring it back minimized it instead. In front: it, or a window it owns,
+       has the foreground, and its middle shows it, not one laid over it. */
+    static BOOL IsWindowInFront(HWND hwnd)
+    {
+        HWND foreground = ::GetForegroundWindow(), top;
+        POINT middle;
+        RECT rc;
+
+        if (!foreground || (foreground != hwnd && ::GetAncestor(foreground, GA_ROOTOWNER) != hwnd))
+            return FALSE;
+        if (!::GetWindowRect(hwnd, &rc))
+            return TRUE;
+        middle.x = (rc.left + rc.right) / 2;
+        middle.y = (rc.top + rc.bottom) / 2;
+        if (!(top = ::WindowFromPoint(middle)))
+            return TRUE;
+        top = ::GetAncestor(top, GA_ROOT);
+        return top == hwnd || ::GetAncestor(top, GA_ROOTOWNER) == hwnd;
+    }
