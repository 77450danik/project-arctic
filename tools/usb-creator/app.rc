  BEGIN
    BLOCK "042204B0"
    BEGIN
      VALUE "CompanyName", "Project Arctic"
      VALUE "FileDescription", "Arctic USB Creator"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "arctic-usb-creator"
      VALUE "OriginalFilename", "ArcticUsbCreator.exe"
      VALUE "ProductName", "Arctic USB Creator"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0422, 1200
  END
END
