diff -ruN a/drivers/misc/ntsync.c b/drivers/misc/ntsync.c
--- a/drivers/misc/ntsync.c	2026-11-22 16:35:40.953327400 +0100
+++ b/drivers/misc/ntsync.c	2026-11-22 16:36:42.198323500 +0100
@@ -22,6 +22,7 @@
 #include <linux/time_namespace.h>
 #include <uapi/linux/ntsync.h>
 #include <linux/win32k.h>
+#include <linux/ntos.h>
 
 #define NTSYNC_NAME	"ntsync"
 
@@ -1234,6 +1235,118 @@
 	return 0;
 }
 
+/*
+ * Arctic: the executive is in the kernel (drivers/ntos) and makes the objects
+ * of its in-process synchronization here, as NTSYNC_IOC_CREATE_* and the
+ * objects' ioctls make and change them, for a caller that keeps the files
+ * itself (and gives them to its clients).
+ */
+struct file *ntsync_kernel_create(struct file *dev_file, unsigned int cmd, const void *args)
+{
+	struct ntsync_device *dev;
+	struct ntsync_obj *obj;
+	struct file *file;
+
+	if (dev_file->f_op != &ntsync_fops)
+		return ERR_PTR(-EINVAL);
+	dev = dev_file->private_data;
+	switch (cmd) {
+	case NTSYNC_IOC_CREATE_SEM: {
+		const struct ntsync_sem_args *a = args;
+
+		if (a->count > a->max)
+			return ERR_PTR(-EINVAL);
+		if (!(obj = ntsync_alloc_obj(dev, NTSYNC_TYPE_SEM)))
+			return ERR_PTR(-ENOMEM);
+		obj->u.sem.count = a->count;
+		obj->u.sem.max = a->max;
+		break;
+	}
+	case NTSYNC_IOC_CREATE_MUTEX: {
+		const struct ntsync_mutex_args *a = args;
+
+		if (!a->owner != !a->count)
+			return ERR_PTR(-EINVAL);
+		if (!(obj = ntsync_alloc_obj(dev, NTSYNC_TYPE_MUTEX)))
+			return ERR_PTR(-ENOMEM);
+		obj->u.mutex.count = a->count;
+		obj->u.mutex.owner = a->owner;
+		break;
+	}
+	case NTSYNC_IOC_CREATE_EVENT: {
+		const struct ntsync_event_args *a = args;
+
+		if (!(obj = ntsync_alloc_obj(dev, NTSYNC_TYPE_EVENT)))
+			return ERR_PTR(-ENOMEM);
+		obj->u.event.manual = a->manual;
+		obj->u.event.signaled = a->signaled;
+		break;
+	}
+	default:
+		return ERR_PTR(-EINVAL);
+	}
+	file = anon_inode_getfile("ntsync", &ntsync_obj_fops, obj, O_RDWR);
+	if (IS_ERR(file)) {
+		ntsync_free_obj(obj);
+		return file;
+	}
+	obj->file = file;
+	return file;
+}
+
+int ntsync_kernel_ioctl(struct file *file, unsigned int cmd, __u32 *arg)
+{
+	struct ntsync_obj *obj;
+	struct ntsync_device *dev;
+	__u32 prev;
+	bool all;
+	int ret = 0;
+
+	if (file->f_op != &ntsync_obj_fops)
+		return -EINVAL;
+	obj = file->private_data;
+	dev = obj->dev;
+	switch (cmd) {
+	case NTSYNC_IOC_EVENT_SET:
+	case NTSYNC_IOC_EVENT_PULSE:
+		if (obj->type != NTSYNC_TYPE_EVENT)
+			return -EINVAL;
+		all = ntsync_lock_obj(dev, obj);
+		prev = obj->u.event.signaled;
+		obj->u.event.signaled = true;
+		if (all)
+			try_wake_all_obj(dev, obj);
+		try_wake_any_event(obj);
+		if (cmd == NTSYNC_IOC_EVENT_PULSE)
+			obj->u.event.signaled = false;
+		ntsync_unlock_obj(dev, obj, all);
+		*arg = prev;
+		return 0;
+	case NTSYNC_IOC_EVENT_RESET:
+		if (obj->type != NTSYNC_TYPE_EVENT)
+			return -EINVAL;
+		all = ntsync_lock_obj(dev, obj);
+		prev = obj->u.event.signaled;
+		obj->u.event.signaled = false;
+		ntsync_unlock_obj(dev, obj, all);
+		*arg = prev;
+		return 0;
+	case NTSYNC_IOC_MUTEX_KILL:
+		if (!*arg || obj->type != NTSYNC_TYPE_MUTEX)
+			return -EINVAL;
+		all = ntsync_lock_obj(dev, obj);
+		ret = kill_mutex_state(obj, *arg);
+		if (!ret) {
+			if (all)
+				try_wake_all_obj(dev, obj);
+			try_wake_any_mutex(obj);
+		}
+		ntsync_unlock_obj(dev, obj, all);
+		return ret;
+	}
+	return -EINVAL;
+}
+
 module_misc_device(ntsync_misc);
 
 MODULE_AUTHOR("Elizabeth Figura <zfigura@codeweavers.com>");
