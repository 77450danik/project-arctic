diff -ruN a/fs/notify/inotify/inotify_user.c b/fs/notify/inotify/inotify_user.c
--- a/fs/notify/inotify/inotify_user.c	2026-11-22 16:35:40.941327400 +0100
+++ b/fs/notify/inotify/inotify_user.c	2026-11-22 20:00:42.940536900 +0100
@@ -26,6 +26,7 @@
 #include <linux/syscalls.h>
 #include <linux/types.h>
 #include <linux/anon_inodes.h>
+#include <linux/ntos.h>
 #include <linux/uaccess.h>
 #include <linux/poll.h>
 #include <linux/wait.h>
@@ -771,6 +772,107 @@
 	return ret;
 }
 
+/*
+ * Arctic: an inotify instance of the executive's own (drivers/ntos): a file
+ * that is in no process's table, watched and read as one from inotify_init1;
+ * its watches added and removed as inotify_add_watch and inotify_rm_watch do
+ */
+struct file *inotify_kernel_file(void)
+{
+	struct fsnotify_group *group = inotify_new_group(inotify_max_queued_events);
+	struct file *file;
+
+	if (IS_ERR(group))
+		return ERR_CAST(group);
+	file = anon_inode_getfile("inotify", &inotify_fops, group, O_RDONLY | O_NONBLOCK);
+	if (IS_ERR(file))
+		fsnotify_destroy_group(group);
+	return file;
+}
+
+int inotify_kernel_add_watch(struct file *file, const struct path *path, u32 mask)
+{
+	int ret;
+
+	if (file->f_op != &inotify_fops)
+		return -EINVAL;
+	if (unlikely(mask & ~ALL_INOTIFY_BITS) || unlikely(!(mask & ALL_INOTIFY_BITS)))
+		return -EINVAL;
+	if (unlikely((mask & IN_MASK_ADD) && (mask & IN_MASK_CREATE)))
+		return -EINVAL;
+	if ((mask & IN_ONLYDIR) && !d_is_dir(path->dentry))
+		return -ENOTDIR;
+	ret = path_permission(path, MAY_READ);
+	if (!ret)
+		ret = security_path_notify(path, mask, FSNOTIFY_OBJ_TYPE_INODE);
+	if (ret)
+		return ret;
+	return inotify_update_watch(file->private_data, d_inode(path->dentry), mask);
+}
+
+/* the events waiting, into a buffer of the kernel's: inotify_read of an
+ * O_NONBLOCK instance, which copies to user memory only. -ENOTTY: not an
+ * inotify instance */
+ssize_t inotify_kernel_read(struct file *file, void *buf, size_t count)
+{
+	struct fsnotify_group *group;
+	struct fsnotify_event *kevent;
+	char *start = buf, *pos = buf;
+
+	if (file->f_op != &inotify_fops)
+		return -ENOTTY;
+	group = file->private_data;
+	for (;;) {
+		struct inotify_event_info *event;
+		struct inotify_event ev;
+		size_t name_len, pad_name_len;
+
+		spin_lock(&group->notification_lock);
+		kevent = get_one_event(group, count);
+		spin_unlock(&group->notification_lock);
+		if (!kevent)
+			break;
+		if (IS_ERR(kevent)) {
+			if (pos == start)
+				return PTR_ERR(kevent);
+			break;
+		}
+		event = INOTIFY_E(kevent);
+		name_len = event->name_len;
+		pad_name_len = round_event_name_len(kevent);
+		ev.len = pad_name_len;
+		ev.mask = inotify_mask_to_arg(event->mask);
+		ev.wd = event->wd;
+		ev.cookie = event->sync_cookie;
+		memcpy(pos, &ev, sizeof(ev));
+		pos += sizeof(ev);
+		if (pad_name_len) {
+			memcpy(pos, event->name, name_len);
+			memset(pos + name_len, 0, pad_name_len - name_len);
+			pos += pad_name_len;
+		}
+		count -= sizeof(ev) + pad_name_len;
+		fsnotify_destroy_event(group, kevent);
+	}
+	return pos == start ? -EAGAIN : pos - start;
+}
+
+int inotify_kernel_rm_watch(struct file *file, int wd)
+{
+	struct fsnotify_group *group;
+	struct inotify_inode_mark *i_mark;
+
+	if (file->f_op != &inotify_fops)
+		return -EINVAL;
+	group = file->private_data;
+	i_mark = inotify_idr_find(group, wd);
+	if (unlikely(!i_mark))
+		return -EINVAL;
+	fsnotify_destroy_mark(&i_mark->fsn_mark, group);
+	fsnotify_put_mark(&i_mark->fsn_mark);
+	return 0;
+}
+
 SYSCALL_DEFINE2(inotify_rm_watch, int, fd, __s32, wd)
 {
 	struct fsnotify_group *group;
diff -ruN a/include/linux/ntos.h b/include/linux/ntos.h
--- a/include/linux/ntos.h	1970-01-01 01:00:00.000000000 +0100
+++ b/include/linux/ntos.h	2026-11-22 20:00:50.517536400 +0100
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Arctic: ntos, NT's executive in the kernel (drivers/ntos, docs/ntos.md):
+ * what the rest of the kernel calls, and what it gives the executive.
+ */
+#ifndef _LINUX_NTOS_H
+#define _LINUX_NTOS_H
+
+#include <linux/types.h>
+#include <uapi/linux/ntos.h>
+
+struct task_struct;
+struct file;
+struct path;
+struct win32k_callout;
+struct tty_struct;
+
+/* do_exit of every task: the thread of NT it was ends (kernel/exit.c) */
+void ntos_thread_exit(struct task_struct *tsk);
+
+/* fs/notify/inotify/inotify_user.c: an instance in no process's table */
+struct file *inotify_kernel_file(void);
+int inotify_kernel_add_watch(struct file *file, const struct path *path, u32 mask);
+int inotify_kernel_rm_watch(struct file *file, int wd);
+ssize_t inotify_kernel_read(struct file *file, void *buf, size_t count);
+
+/* arch/x86/kernel/ptrace.c: a thread's debug registers, as ptrace has them */
+unsigned long ptrace_get_debugreg(struct task_struct *tsk, int n);
+int ptrace_set_debugreg(struct task_struct *tsk, int n, unsigned long val);
+
+/* drivers/misc/ntsync.c: objects made and changed by the executive itself */
+struct file *ntsync_kernel_create(struct file *dev_file, unsigned int cmd, const void *args);
+int ntsync_kernel_ioctl(struct file *file, unsigned int cmd, __u32 *arg);
+
+/* drivers/tty/tty_io.c: a terminal's tty, referenced; NULL if not a terminal */
+struct tty_struct *tty_kref_get_file(struct file *file);
+
+/* drivers/win32k: the executive is the object manager */
+void win32k_ntos_register(void);
+long win32k_kernel_callout(struct win32k_callout *co);
+
+#endif
