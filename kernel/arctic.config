# Arctic kernel fragment, merged on top of Arch Linux's config.
# Everything not listed here stays as Arch has it: every driver built as a module.

CONFIG_LOCALVERSION="-arctic"
# CONFIG_LOCALVERSION_AUTO is not set

# NT runtime support (Syscall User Dispatch needs no option: x86 always has it)
CONFIG_NTSYNC=y

# No Linux console on screen: the display belongs to dwm.exe
# (VT can only be switched off with EXPERT)
CONFIG_EXPERT=y
# CONFIG_VT is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# Early display for the boot logo
CONFIG_DRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# The initrd carries no modules, so everything needed to find and mount the
# system image is built in
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# C: is NTFS. ntfs3 cannot be built in next to it; it stays a module as a fallback
CONFIG_NTFS_FS=y

# Live mode: C: is a device-mapper snapshot with its changes kept in zram
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y
CONFIG_ZRAM=y

# Boot media: USB, SATA, NVMe, optical, virtio
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y

# Serial console for development builds and QEMU
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Build speed and size: no debug info
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
