# The whole NT world runs as the single user "nt"
KERNEL=="ntsync", MODE="0666"
SUBSYSTEM=="drm", KERNEL=="card*|renderD*", OWNER="nt"
SUBSYSTEM=="input", KERNEL=="event*", OWNER="nt"
SUBSYSTEM=="sound", OWNER="nt"
SUBSYSTEM=="hidraw", OWNER="nt"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", OWNER="nt"

# Power (docs/power.md): the power policy of the NT world sets the panel's
# brightness and USB selective suspend itself, on devices that come later too
SUBSYSTEM=="backlight", ACTION=="add", RUN+="/usr/bin/busybox chown nt /sys%p/brightness"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ACTION=="add", TEST=="power/control", \
    RUN+="/usr/bin/busybox chown nt /sys%p/power/control"

# Volumes that get a drive letter: arctic-volume mounts them and mountmgr.sys
# gives each its letter; a CD's medium comes and goes with change events
SUBSYSTEM=="block", ACTION=="add|change", ENV{ID_FS_USAGE}=="filesystem", RUN+="/usr/bin/arctic-volume add"
SUBSYSTEM=="block", ACTION=="change", ENV{ID_FS_USAGE}!="filesystem", RUN+="/usr/bin/arctic-volume remove"
SUBSYSTEM=="block", ACTION=="remove", RUN+="/usr/bin/arctic-volume remove"

# Display adapters: after module autoloading, arctic-gpu finishes choosing the
# driver (nouveau for NVIDIA cards older than Turing, nvidia_drm for the rest)
SUBSYSTEM=="pci", ACTION=="add", ATTR{class}=="0x03*", RUN+="/usr/bin/arctic-gpu"
